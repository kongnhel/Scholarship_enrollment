<h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6 flex items-center gap-2"><i class="bi bi-file-earmark-text text-blue-600 dark:text-blue-400"></i><%= currentLang === 'km' ? 'ពាក្យសុំអនុម័ត' : 'Approved Applications' %></h1>

<div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-5 mb-6">
  <form action="/committee/applications" method="GET" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
    <div>
      <input type="text" name="search" placeholder="<%= currentLang === 'km' ? 'ស្វែងរកតាមឈ្មោះ...' : 'Search by name...' %>" value="<%= filters.search || '' %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none">
    </div>
    <div>
      <select name="major" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800">
        <option value=""><%= currentLang === 'km' ? 'ជំនាញទាំងអស់' : 'All Majors' %></option>
        <% majors.forEach(function(major) { %>
          <option value="<%= major.id %>" <%= filters.major == major.id ? 'selected' : '' %>><%= currentLang === 'km' ? major.name_kh : major.name_en %></option>
        <% }); %>
      </select>
    </div>
    <div>
      <select name="category" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800">
        <option value=""><%= currentLang === 'km' ? 'ប្រភេទទាំងអស់' : 'All Categories' %></option>
        <% categories.forEach(function(cat) { %>
          <option value="<%= cat.id %>" <%= filters.category == cat.id ? 'selected' : '' %>><%= currentLang === 'km' ? cat.name_kh : cat.name_en %></option>
        <% }); %>
      </select>
    </div>
    <div class="flex gap-2">
      <button type="submit" class="px-5 py-2.5 bg-blue-500 text-white rounded-xl text-sm font-medium hover:bg-blue-600 transition-all"><i class="bi bi-search mr-1"></i><%= currentLang === 'km' ? 'ត្រួតពិនិត្យ' : 'Filter' %></button>
      <a href="/committee/applications" class="px-5 py-2.5 border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-200 rounded-xl text-sm font-medium hover:bg-gray-50 dark:hover:bg-gray-700 transition-all"><%= currentLang === 'km' ? 'សម្អាត' : 'Clear' %></a>
    </div>
  </form>
</div>

<div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
  <div class="px-6 py-4 bg-gray-50 dark:bg-gray-800/50 border-b border-gray-100 dark:border-gray-700 flex items-center justify-between">
    <span class="text-sm text-gray-600 dark:text-gray-300"><%= currentLang === 'km' ? 'សរុប' : 'Total' %>: <strong><%= totalRecords %></strong> <%= currentLang === 'km' ? 'ពាក្យសុំ' : 'applications' %></span>
  </div>
  <div class="overflow-x-auto">
    <table class="w-full">
      <thead class="bg-gray-50 dark:bg-gray-800/50">
        <tr>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase">ID</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase"><%= currentLang === 'km' ? 'ឈ្មោះ' : 'Name' %></th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase"><%= currentLang === 'km' ? 'ជំនាញ' : 'Major' %></th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase"><%= currentLang === 'km' ? 'ប្រភេទ' : 'Category' %></th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase"><%= currentLang === 'km' ? 'ភេទ' : 'Gender' %></th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase"><%= currentLang === 'km' ? 'កាលបរិច្ឆេទ' : 'Date' %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-50 dark:divide-gray-700">
        <% if (applications && applications.length > 0) { %>
          <% applications.forEach(function(app) { %>
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors cursor-pointer" onclick="window.location='/committee/applications/<%= app.id %>'">
              <td class="px-5 py-4 text-sm text-gray-500 dark:text-gray-400"><%= app.id %></td>
              <td class="px-5 py-4 text-sm text-gray-700 dark:text-gray-200"><%= app.student_name || app.english_first_name + ' ' + app.english_last_name %></td>
              <td class="px-5 py-4 text-sm text-gray-700 dark:text-gray-200"><%= currentLang === 'km' ? app.major_name_kh : app.major_name_en %></td>
              <td class="px-5 py-4 text-sm text-gray-700 dark:text-gray-200"><%= currentLang === 'km' ? app.category_name_kh : app.category_name_en %></td>
              <td class="px-5 py-4 text-sm text-gray-700 dark:text-gray-200"><%= app.gender === 'male' ? (currentLang === 'km' ? 'ប្រុស' : 'Male') : (currentLang === 'km' ? 'ស្រី' : 'Female') %></td>
              <td class="px-5 py-4 text-sm text-gray-500 dark:text-gray-400"><%= app.submitted_at ? new Date(app.submitted_at).toLocaleDateString() : 'N/A' %></td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="6" class="px-5 py-10 text-sm text-gray-400 dark:text-gray-500 text-center"><%= currentLang === 'km' ? 'មិនរកឃើញពាក្យសុំ' : 'No applications found' %></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <% if (totalPages > 1) { %>
    <div class="px-6 py-4 border-t border-gray-100 dark:border-gray-700 flex justify-center gap-1">
      <% const comQs = 'search=' + encodeURIComponent(filters.search || '') + '&major=' + encodeURIComponent(filters.major || '') + '&category=' + encodeURIComponent(filters.category || ''); %>
      <a href="?page=<%= currentPage - 1 %>&<%= comQs %>" class="px-4 py-2 rounded-xl text-sm font-medium <%= currentPage === 1 ? 'text-gray-300 pointer-events-none' : 'text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700' %>"><%= currentLang === 'km' ? 'មុន' : 'Previous' %></a>
      <%
        let comPages = [];
        if (totalPages <= 7) {
          for (let i = 1; i <= totalPages; i++) comPages.push(i);
        } else {
          comPages.push(1);
          if (currentPage > 3) comPages.push('...');
          for (let i = Math.max(2, currentPage - 1); i <= Math.min(totalPages - 1, currentPage + 1); i++) {
            comPages.push(i);
          }
          if (currentPage < totalPages - 2) comPages.push('...');
          comPages.push(totalPages);
        }
      %>
      <% comPages.forEach(function(p) { %>
        <% if (p === '...') { %>
          <span class="px-3 py-2 text-sm text-gray-400 dark:text-gray-500">...</span>
        <% } else { %>
          <a href="?page=<%= p %>&<%= comQs %>" class="px-4 py-2 rounded-xl text-sm font-medium <%= currentPage === p ? 'bg-blue-500 text-white' : 'text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700' %>"><%= p %></a>
        <% } %>
      <% }); %>
      <a href="?page=<%= currentPage + 1 %>&<%= comQs %>" class="px-4 py-2 rounded-xl text-sm font-medium <%= currentPage === totalPages ? 'text-gray-300 pointer-events-none' : 'text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700' %>"><%= currentLang === 'km' ? 'បន្ទាប់' : 'Next' %></a>
    </div>
  <% } %>
</div>
