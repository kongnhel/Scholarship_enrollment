<div class="max-w-7xl mx-auto space-y-6">
  <div class="relative overflow-hidden rounded-3xl bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 shadow-sm">
    <div class="absolute top-0 right-0 w-40 h-40 bg-blue-50 dark:bg-blue-900/20 rounded-bl-[6rem] -mr-10 -mt-10"></div>
    <div class="relative px-4 sm:px-6 py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 sm:gap-4">
      <div class="flex items-center gap-3 sm:gap-4 min-w-0">
        <div class="w-11 h-11 sm:w-12 sm:h-12 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-2xl flex items-center justify-center shadow-md shadow-blue-500/20 flex-shrink-0">
          <i class="bi bi-file-earmark-text text-white text-lg sm:text-xl"></i>
        </div>
        <div class="min-w-0">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 text-xs font-bold mb-1">
            <i class="bi bi-collection"></i>
            <%= totalRecords %> <%= currentLang === 'km' ? 'ពាក្យសុំ' : 'applications' %>
          </div>
          <h1 class="text-lg sm:text-xl font-bold text-gray-900 dark:text-gray-100 truncate"><%= currentLang === 'km' ? 'ពាក្យសុំអនុម័ត' : 'Approved Applications' %></h1>
          <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 truncate"><%= currentLang === 'km' ? 'មើលនិងស្វែងរកពាក្យសុំដែលបានអនុម័ត' : 'Browse and search approved applications' %></p>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
    <div class="px-4 sm:px-6 py-3.5 border-b border-gray-100 dark:border-gray-700 flex items-center gap-2.5">
      <div class="w-8 h-8 bg-blue-100 dark:bg-blue-900/40 rounded-lg flex items-center justify-center flex-shrink-0">
        <i class="bi bi-funnel text-blue-600 dark:text-blue-400 text-sm"></i>
      </div>
      <span class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'តម្រង' : 'Filters' %></span>
    </div>
    <form action="/committee/applications" method="GET" class="p-4 sm:p-5">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <div class="relative">
          <i class="bi bi-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 dark:text-gray-500 pointer-events-none"></i>
          <input type="text" name="search" placeholder="<%= currentLang === 'km' ? 'ស្វែងរកតាមឈ្មោះ...' : 'Search by name...' %>" value="<%= filters.search || '' %>" class="w-full pl-9 pr-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
        </div>
        <div>
          <select name="major" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
            <option value=""><%= currentLang === 'km' ? 'ជំនាញទាំងអស់' : 'All Majors' %></option>
            <% majors.forEach(function(major) { %>
              <option value="<%= major.id %>" <%= filters.major == major.id ? 'selected' : '' %>><%= currentLang === 'km' ? major.name_kh : major.name_en %></option>
            <% }); %>
          </select>
        </div>
        <div>
          <select name="category" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
            <option value=""><%= currentLang === 'km' ? 'ប្រភេទទាំងអស់' : 'All Categories' %></option>
            <% categories.forEach(function(cat) { %>
              <option value="<%= cat.id %>" <%= filters.category == cat.id ? 'selected' : '' %>><%= currentLang === 'km' ? cat.name_kh : cat.name_en %></option>
            <% }); %>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-2">
          <button type="submit" class="w-full justify-center px-5 py-2.5 bg-gradient-to-r from-blue-600 to-indigo-500 text-white rounded-xl text-sm font-semibold hover:from-blue-700 hover:to-indigo-600 transition-all shadow-sm flex items-center gap-2">
            <i class="bi bi-search"></i><span class="truncate"><%= currentLang === 'km' ? 'ត្រង' : 'Filter' %></span>
          </button>
          <a href="/committee/applications" class="w-full justify-center px-5 py-2.5 border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-400 rounded-xl text-sm font-medium hover:bg-gray-50 dark:hover:bg-gray-700 hover:text-gray-900 dark:hover:text-white transition-all flex items-center gap-1">
            <i class="bi bi-x-lg"></i><span class="truncate"><%= currentLang === 'km' ? 'សម្អាត' : 'Clear' %></span>
          </a>
        </div>
      </div>
    </form>
  </div>

  <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
    <div class="px-4 sm:px-6 py-3.5 border-b border-gray-100 dark:border-gray-700 flex items-center gap-2.5">
      <div class="w-8 h-8 bg-blue-100 dark:bg-blue-900/40 rounded-lg flex items-center justify-center flex-shrink-0">
        <i class="bi bi-list-ul text-blue-600 dark:text-blue-400 text-sm"></i>
      </div>
      <span class="text-sm font-semibold text-gray-900 dark:text-gray-100 truncate"><%= currentLang === 'km' ? 'ពាក្យសុំអនុម័តទាំងអស់' : 'All approved applications' %></span>
    </div>
    <div class="hidden md:block overflow-x-auto">
      <table class="w-auto min-w-full">
        <thead class="bg-gray-50 dark:bg-gray-800/50">
          <tr>
            <th class="px-5 py-3 whitespace-nowrap text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase">ID</th>
            <th class="px-5 py-3 whitespace-nowrap text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase"><%= currentLang === 'km' ? 'ឈ្មោះ' : 'Name' %></th>
            <th class="px-5 py-3 whitespace-nowrap text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase"><%= currentLang === 'km' ? 'ជំនាញ' : 'Major' %></th>
            <th class="px-5 py-3 whitespace-nowrap text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase"><%= currentLang === 'km' ? 'ប្រភេទ' : 'Category' %></th>
            <th class="px-5 py-3 whitespace-nowrap text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase"><%= currentLang === 'km' ? 'ភេទ' : 'Gender' %></th>
            <th class="px-5 py-3 whitespace-nowrap text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase"><%= currentLang === 'km' ? 'កាលបរិច្ឆេទ' : 'Date' %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50 dark:divide-gray-700">
          <% if (applications && applications.length > 0) { %>
            <% applications.forEach(function(app) { %>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors cursor-pointer" onclick="window.location='/committee/applications/<%= app.id %>'">
                <td class="px-5 py-4 text-sm text-gray-500 dark:text-gray-400 whitespace-nowrap"><%= app.id %></td>
                <td class="px-5 py-4">
                  <div class="flex items-center gap-3 min-w-0">
                    <div class="w-8 h-8 rounded-full bg-gradient-to-br from-blue-400 to-indigo-500 flex items-center justify-center text-white font-bold text-xs flex-shrink-0 shadow-sm">
                      <%= (app.student_name || app.english_first_name || 'N').charAt(0).toUpperCase() %>
                    </div>
                    <span class="text-sm text-gray-900 dark:text-gray-100 truncate"><%= app.student_name || app.english_first_name + ' ' + app.english_last_name %></span>
                  </div>
                </td>
                <td class="px-5 py-4 text-sm text-gray-700 dark:text-gray-200"><%= currentLang === 'km' ? app.major_name_kh : app.major_name_en %></td>
                <td class="px-5 py-4 text-sm text-gray-700 dark:text-gray-200"><%= currentLang === 'km' ? app.category_name_kh : app.category_name_en %></td>
                <td class="px-5 py-4 text-sm text-gray-700 dark:text-gray-200 whitespace-nowrap"><%= app.gender === 'male' ? (currentLang === 'km' ? 'ប្រុស' : 'Male') : (currentLang === 'km' ? 'ស្រី' : 'Female') %></td>
                <td class="px-5 py-4 text-sm text-gray-500 dark:text-gray-400 whitespace-nowrap"><%= app.submitted_at ? formatDateOnly(app.submitted_at) : 'N/A' %></td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="6" class="px-5 py-12 text-center">
                <div class="flex flex-col items-center gap-2">
                  <i class="bi bi-inbox text-4xl text-gray-300 dark:text-gray-600"></i>
                  <p class="text-sm text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'មិនរកឃើញពាក្យសុំ' : 'No applications found' %></p>
                </div>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <div class="md:hidden divide-y divide-gray-100 dark:divide-gray-700">
      <% if (applications && applications.length > 0) { %>
        <% applications.forEach(function(app) { %>
          <div class="px-4 py-4 cursor-pointer" onclick="window.location='/committee/applications/<%= app.id %>'">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-gradient-to-br from-blue-400 to-indigo-500 flex items-center justify-center text-white font-bold text-sm flex-shrink-0 shadow-sm">
                <%= (app.student_name || app.english_first_name || 'N').charAt(0).toUpperCase() %>
              </div>
              <div class="flex-1 min-w-0">
                <div class="text-sm font-semibold text-gray-900 dark:text-gray-100 truncate"><%= app.student_name || app.english_first_name + ' ' + app.english_last_name %></div>
              </div>
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-[11px] font-bold rounded-full flex-shrink-0 whitespace-nowrap <%= app.status === 'approved' ? 'bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300' : 'bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300' %>">
                <span class="w-1.5 h-1.5 rounded-full <%= app.status === 'approved' ? 'bg-green-500' : 'bg-blue-500' %>"></span>
                <%= app.status === 'approved' ? (currentLang === 'km' ? 'អនុម័ត' : 'Approved') : (currentLang === 'km' ? 'កំពុងពិនិត្យ' : 'Review') %>
              </span>
            </div>

            <dl class="mt-3 space-y-1.5 text-xs">
              <div class="flex gap-2">
                <dt class="w-20 flex-shrink-0 text-gray-400 dark:text-gray-500">ID</dt>
                <dd class="min-w-0 text-gray-700 dark:text-gray-200"><%= app.id %></dd>
              </div>
              <div class="flex gap-2">
                <dt class="w-20 flex-shrink-0 text-gray-400 dark:text-gray-500"><%= currentLang === 'km' ? 'ជំនាញ' : 'Major' %></dt>
                <dd class="min-w-0 text-gray-700 dark:text-gray-200 break-words"><%= currentLang === 'km' ? app.major_name_kh : app.major_name_en %></dd>
              </div>
              <div class="flex gap-2">
                <dt class="w-20 flex-shrink-0 text-gray-400 dark:text-gray-500"><%= currentLang === 'km' ? 'ប្រភេទ' : 'Category' %></dt>
                <dd class="min-w-0 text-gray-700 dark:text-gray-200 break-words"><%= currentLang === 'km' ? app.category_name_kh : app.category_name_en %></dd>
              </div>
              <div class="flex gap-2">
                <dt class="w-20 flex-shrink-0 text-gray-400 dark:text-gray-500"><%= currentLang === 'km' ? 'ភេទ' : 'Gender' %></dt>
                <dd class="min-w-0 text-gray-700 dark:text-gray-200"><%= app.gender === 'male' ? (currentLang === 'km' ? 'ប្រុស' : 'Male') : (currentLang === 'km' ? 'ស្រី' : 'Female') %></dd>
              </div>
              <div class="flex gap-2">
                <dt class="w-20 flex-shrink-0 text-gray-400 dark:text-gray-500"><%= currentLang === 'km' ? 'កាលបរិច្ឆេទ' : 'Date' %></dt>
                <dd class="min-w-0 text-gray-700 dark:text-gray-200"><%= app.submitted_at ? formatDateOnly(app.submitted_at) : 'N/A' %></dd>
              </div>
            </dl>

            <div class="mt-3 grid grid-cols-2 gap-2">
              <a href="/committee/applications/<%= app.id %>" class="col-span-2 w-full px-3 py-2.5 rounded-xl text-xs font-semibold bg-gradient-to-r from-blue-600 to-indigo-500 text-white hover:from-blue-700 hover:to-indigo-600 transition-all shadow-sm flex items-center justify-center gap-1.5">
                <i class="bi bi-eye"></i><span class="truncate"><%= currentLang === 'km' ? 'មើលលម្អិត' : 'View Details' %></span>
              </a>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="px-5 py-12 text-center">
          <div class="flex flex-col items-center gap-2">
            <i class="bi bi-inbox text-4xl text-gray-300 dark:text-gray-600"></i>
            <p class="text-sm text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'មិនរកឃើញពាក្យសុំ' : 'No applications found' %></p>
          </div>
        </div>
      <% } %>
    </div>

    <% if (totalPages > 1) { %>
      <div class="px-4 sm:px-6 py-4 border-t border-gray-100 dark:border-gray-700 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <p class="text-sm text-gray-500 dark:text-gray-400 text-center sm:text-left">
          <%= currentLang === 'km' ? 'ទំព័រ' : 'Page' %> <%= currentPage %> <%= currentLang === 'km' ? 'នៃ' : 'of' %> <%= totalPages %>
        </p>
        <div class="flex gap-1 overflow-x-auto pb-1 sm:pb-0 -mx-4 px-4 sm:mx-0 sm:px-0">
          <% const comQs = 'search=' + encodeURIComponent(filters.search || '') + '&major=' + encodeURIComponent(filters.major || '') + '&category=' + encodeURIComponent(filters.category || ''); %>
          <a href="?page=<%= currentPage - 1 %>&<%= comQs %>" class="px-4 py-2 rounded-xl text-sm font-medium transition-all flex-shrink-0 <%= currentPage === 1 ? 'text-gray-300 dark:text-gray-600 cursor-not-allowed' : 'text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 hover:text-gray-900 dark:hover:text-white' %>">
            <i class="bi bi-chevron-left"></i>
            <span class="hidden sm:inline ml-1"><%= currentLang === 'km' ? 'មុន' : 'Previous' %></span>
          </a>
          <%
            let comPages = [];
            if (totalPages <= 7) {
              for (let i = 1; i <= totalPages; i++) comPages.push(i);
            } else {
              comPages.push(1);
              if (currentPage > 3) comPages.push('...');
              for (let i = Math.max(2, currentPage - 1); i <= Math.min(totalPages - 1, currentPage + 1); i++) {
                comPages.push(i);
              }
              if (currentPage < totalPages - 2) comPages.push('...');
              comPages.push(totalPages);
            }
          %>
          <% comPages.forEach(function(p) { %>
            <% if (p === '...') { %>
              <span class="px-2 py-2 text-sm text-gray-400 dark:text-gray-500">...</span>
            <% } else { %>
              <a href="?page=<%= p %>&<%= comQs %>" class="px-3.5 py-2 rounded-xl text-sm font-bold transition-all flex-shrink-0 <%= currentPage === p ? 'bg-gradient-to-r from-blue-600 to-indigo-500 text-white shadow-md' : 'text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 hover:text-gray-900 dark:hover:text-white' %>"><%= p %></a>
            <% } %>
          <% }); %>
          <a href="?page=<%= currentPage + 1 %>&<%= comQs %>" class="px-4 py-2 rounded-xl text-sm font-medium transition-all flex-shrink-0 <%= currentPage === totalPages ? 'text-gray-300 dark:text-gray-600 cursor-not-allowed' : 'text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 hover:text-gray-900 dark:hover:text-white' %>">
            <span class="hidden sm:inline mr-1"><%= currentLang === 'km' ? 'បន្ទាប់' : 'Next' %></span>
            <i class="bi bi-chevron-right"></i>
          </a>
        </div>
      </div>
    <% } %>
  </div>
</div>