<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-6">
  <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 flex items-center gap-2"><i class="bi bi-speedometer2 text-blue-600 dark:text-blue-400"></i><%= currentLang === 'km' ? 'តារាងព័ត៌មានគណៈកម្មការ' : 'Committee Dashboard' %></h1>
  <div class="flex gap-2">
    <a href="/committee/applications" class="px-4 py-2 bg-blue-500 text-white rounded-xl text-sm font-medium hover:bg-blue-600 transition-all"><i class="bi bi-file-earmark-text mr-1"></i><%= currentLang === 'km' ? 'មើលពាក្យសុំ' : 'View Applications' %></a>
    <a href="/committee/reports" class="px-4 py-2 border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-200 rounded-xl text-sm font-medium hover:bg-gray-50 dark:hover:bg-gray-700 transition-all"><i class="bi bi-graph-up mr-1"></i><%= currentLang === 'km' ? 'របាយការណ៍' : 'Reports' %></a>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
  <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-5">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-medium text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'ពាក្យសុំអនុម័តសរុប' : 'Total Approved' %></p>
        <h3 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mt-1"><%= totalApproved %></h3>
      </div>
      <div class="w-12 h-12 rounded-xl bg-green-100 dark:bg-green-900/30 flex items-center justify-center"><i class="bi bi-check-circle text-green-600 dark:text-green-400 text-xl"></i></div>
    </div>
  </div>
  <% byMajor.forEach(function(m) { %>
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-5">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-medium text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? m.name_kh : m.name_en %></p>
          <h4 class="text-xl font-bold text-gray-900 dark:text-gray-100 mt-1"><%= m.count %></h4>
        </div>
        <div class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center"><i class="bi bi-book text-blue-600 dark:text-blue-400"></i></div>
      </div>
    </div>
  <% }); %>
</div>

<div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
  <div class="px-6 py-4 bg-gray-50 dark:bg-gray-800/50 border-b border-gray-100 dark:border-gray-700 flex items-center justify-between">
    <h5 class="font-bold text-gray-900 dark:text-gray-100 flex items-center gap-2"><i class="bi bi-clock-history text-blue-600 dark:text-blue-400"></i><%= currentLang === 'km' ? 'ពាក្យសុំអនុម័តថ្មីៗ' : 'Recent Approved Applications' %></h5>
    <a href="/committee/applications" class="text-sm text-blue-600 dark:text-blue-400 hover:text-blue-700 font-medium"><%= currentLang === 'km' ? 'មើលទាំងអស់' : 'View All' %> →</a>
  </div>
  <div class="overflow-x-auto">
    <table class="w-full">
      <thead class="bg-gray-50 dark:bg-gray-800/50">
        <tr>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase">ID</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase"><%= currentLang === 'km' ? 'ឈ្មោះ' : 'Name' %></th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase"><%= currentLang === 'km' ? 'ជំនាញ' : 'Major' %></th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase"><%= currentLang === 'km' ? 'ប្រភេទ' : 'Category' %></th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase"><%= currentLang === 'km' ? 'កាលបរិច្ឆេទ' : 'Date' %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-50 dark:divide-gray-700">
        <% if (recent && recent.length > 0) { %>
          <% recent.forEach(function(app) { %>
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors cursor-pointer" onclick="window.location='/committee/applications/<%= app.id %>'">
              <td class="px-5 py-4 text-sm text-gray-500 dark:text-gray-400"><%= app.id %></td>
              <td class="px-5 py-4 text-sm text-gray-700 dark:text-gray-200"><%= app.student_name || app.english_first_name + ' ' + app.english_last_name %></td>
              <td class="px-5 py-4 text-sm text-gray-700 dark:text-gray-200"><%= currentLang === 'km' ? app.major_name_kh : app.major_name_en %></td>
              <td class="px-5 py-4 text-sm text-gray-700 dark:text-gray-200"><%= currentLang === 'km' ? app.category_name_kh : app.category_name_en %></td>
              <td class="px-5 py-4 text-sm text-gray-500 dark:text-gray-400"><%= app.submitted_at ? new Date(app.submitted_at).toLocaleDateString() : 'N/A' %></td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="5" class="px-5 py-10 text-sm text-gray-400 dark:text-gray-500 text-center"><%= currentLang === 'km' ? 'មិនរកឃើញពាក្យសុំអនុម័ត' : 'No approved applications found' %></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
