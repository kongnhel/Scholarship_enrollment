<div class="max-w-7xl mx-auto space-y-6">
  <div class="relative overflow-hidden rounded-3xl bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 shadow-sm">
    <div class="absolute top-0 right-0 w-40 h-40 bg-blue-50 dark:bg-blue-900/20 rounded-bl-[6rem] -mr-10 -mt-10"></div>
    <div class="relative px-4 sm:px-6 py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 sm:gap-4">
      <div class="flex items-center gap-3 sm:gap-4 min-w-0">
        <div class="w-11 h-11 sm:w-12 sm:h-12 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-2xl flex items-center justify-center shadow-md shadow-blue-500/20 flex-shrink-0">
          <i class="bi bi-speedometer2 text-white text-lg sm:text-xl"></i>
        </div>
        <div class="min-w-0">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 text-xs font-bold mb-1">
            <i class="bi bi-collection"></i>
            <%= totalApproved %> <%= currentLang === 'km' ? 'អនុម័ត' : 'approved' %>
          </div>
          <h1 class="text-lg sm:text-xl font-bold text-gray-900 dark:text-gray-100 truncate"><%= currentLang === 'km' ? 'តារាងព័ត៌មានអ្នកគ្រប់គ្រងទី២' : 'Committee Dashboard' %></h1>
          <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 truncate"><%= currentLang === 'km' ? 'មើលពាក្យសុំអនុម័តថ្មីៗ និងស្ថិតិតាមជំនាញ' : 'Recently approved applications and major statistics' %></p>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:flex-row sm:items-center gap-2 w-full sm:w-auto flex-shrink-0">
        <a href="/committee/applications" class="w-full sm:w-auto px-5 py-2.5 bg-gradient-to-r from-blue-600 to-indigo-500 text-white rounded-xl text-sm font-semibold hover:from-blue-700 hover:to-indigo-600 transition-all shadow-sm flex items-center justify-center gap-2">
          <i class="bi bi-file-earmark-text"></i><span class="truncate"><%= currentLang === 'km' ? 'មើលពាក្យសុំ' : 'View Applications' %></span>
        </a>
        <a href="/committee/reports" class="w-full sm:w-auto px-5 py-2.5 border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-400 rounded-xl text-sm font-medium hover:bg-gray-50 dark:hover:bg-gray-700 hover:text-gray-900 dark:hover:text-white transition-all flex items-center justify-center gap-2">
          <i class="bi bi-graph-up"></i><span class="truncate"><%= currentLang === 'km' ? 'របាយការណ៍' : 'Reports' %></span>
        </a>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-4 sm:p-5">
      <div class="flex items-center justify-between gap-3">
        <div class="min-w-0">
          <p class="text-sm font-medium text-gray-500 dark:text-gray-400 truncate"><%= currentLang === 'km' ? 'ពាក្យសុំអនុម័តសរុប' : 'Total Approved' %></p>
          <h3 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mt-1"><%= totalApproved %></h3>
        </div>
        <div class="w-12 h-12 rounded-xl bg-green-100 dark:bg-green-900/30 flex items-center justify-center flex-shrink-0"><i class="bi bi-check-circle text-green-600 dark:text-green-400 text-xl"></i></div>
      </div>
    </div>
    <% byMajor.forEach(function(m) { %>
      <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-4 sm:p-5">
        <div class="flex items-center justify-between gap-3">
          <div class="min-w-0">
            <p class="text-xs font-medium text-gray-500 dark:text-gray-400 truncate"><%= currentLang === 'km' ? m.name_kh : m.name_en %></p>
            <h4 class="text-xl font-bold text-gray-900 dark:text-gray-100 mt-1"><%= m.count %></h4>
          </div>
          <div class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center flex-shrink-0"><i class="bi bi-book text-blue-600 dark:text-blue-400"></i></div>
        </div>
      </div>
    <% }); %>
  </div>

  <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
    <div class="px-4 sm:px-6 py-3.5 border-b border-gray-100 dark:border-gray-700 flex items-center justify-between gap-3">
      <div class="flex items-center gap-2.5 min-w-0">
        <div class="w-8 h-8 bg-blue-100 dark:bg-blue-900/40 rounded-lg flex items-center justify-center flex-shrink-0">
          <i class="bi bi-clock-history text-blue-600 dark:text-blue-400 text-sm"></i>
        </div>
        <h5 class="text-sm font-semibold text-gray-900 dark:text-gray-100 truncate"><%= currentLang === 'km' ? 'ពាក្យសុំអនុម័តថ្មីៗ' : 'Recent Approved Applications' %></h5>
      </div>
      <a href="/committee/applications" class="px-3 py-1.5 bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-lg text-xs font-semibold hover:bg-blue-100 dark:hover:bg-blue-900/50 transition-colors inline-flex items-center gap-1 flex-shrink-0"><span class="truncate"><%= currentLang === 'km' ? 'មើលទាំងអស់' : 'View All' %></span><i class="bi bi-arrow-right"></i></a>
    </div>
    <div class="hidden md:block overflow-x-auto">
      <table class="w-auto min-w-full">
        <thead class="bg-gray-50 dark:bg-gray-800/50">
          <tr>
            <th class="px-5 py-3 whitespace-nowrap text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase">ID</th>
            <th class="px-5 py-3 whitespace-nowrap text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase"><%= currentLang === 'km' ? 'ឈ្មោះ' : 'Name' %></th>
            <th class="px-5 py-3 whitespace-nowrap text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase"><%= currentLang === 'km' ? 'ជំនាញ' : 'Major' %></th>
            <th class="px-5 py-3 whitespace-nowrap text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase"><%= currentLang === 'km' ? 'ប្រភេទ' : 'Category' %></th>
            <th class="px-5 py-3 whitespace-nowrap text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase"><%= currentLang === 'km' ? 'កាលបរិច្ឆេទ' : 'Date' %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50 dark:divide-gray-700">
          <% if (recent && recent.length > 0) { %>
            <% recent.forEach(function(app) { %>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors cursor-pointer" onclick="window.location='/committee/applications/<%= app.id %>'">
                <td class="px-5 py-4 text-sm text-gray-500 dark:text-gray-400 whitespace-nowrap"><%= app.id %></td>
                <td class="px-5 py-4">
                  <div class="flex items-center gap-3 min-w-0">
                    <div class="w-8 h-8 rounded-full bg-gradient-to-br from-blue-400 to-indigo-500 flex items-center justify-center text-white font-bold text-xs flex-shrink-0 shadow-sm">
                      <%= (app.student_name || app.english_first_name || 'N').charAt(0).toUpperCase() %>
                    </div>
                    <span class="text-sm text-gray-900 dark:text-gray-100 truncate"><%= app.student_name || app.english_first_name + ' ' + app.english_last_name %></span>
                  </div>
                </td>
                <td class="px-5 py-4 text-sm text-gray-700 dark:text-gray-200"><%= currentLang === 'km' ? app.major_name_kh : app.major_name_en %></td>
                <td class="px-5 py-4 text-sm text-gray-700 dark:text-gray-200"><%= currentLang === 'km' ? app.category_name_kh : app.category_name_en %></td>
                <td class="px-5 py-4 text-sm text-gray-500 dark:text-gray-400 whitespace-nowrap"><%= app.submitted_at ? formatDateOnly(app.submitted_at) : 'N/A' %></td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="5" class="px-5 py-12 text-center">
                <div class="flex flex-col items-center gap-2">
                  <i class="bi bi-inbox text-4xl text-gray-300 dark:text-gray-600"></i>
                  <p class="text-sm text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'មិនរកឃើញពាក្យសុំអនុម័ត' : 'No approved applications found' %></p>
                </div>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <div class="md:hidden divide-y divide-gray-100 dark:divide-gray-700">
      <% if (recent && recent.length > 0) { %>
        <% recent.forEach(function(app) { %>
          <div class="px-4 py-4 cursor-pointer" onclick="window.location='/committee/applications/<%= app.id %>'">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-gradient-to-br from-blue-400 to-indigo-500 flex items-center justify-center text-white font-bold text-sm flex-shrink-0 shadow-sm">
                <%= (app.student_name || app.english_first_name || 'N').charAt(0).toUpperCase() %>
              </div>
              <div class="flex-1 min-w-0">
                <div class="text-sm font-semibold text-gray-900 dark:text-gray-100 truncate"><%= app.student_name || app.english_first_name + ' ' + app.english_last_name %></div>
              </div>
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-[11px] font-bold rounded-full flex-shrink-0 whitespace-nowrap <%= app.status === 'approved' ? 'bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300' : 'bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300' %>">
                <span class="w-1.5 h-1.5 rounded-full <%= app.status === 'approved' ? 'bg-green-500' : 'bg-blue-500' %>"></span>
                <%= app.status === 'approved' ? (currentLang === 'km' ? 'អនុម័ត' : 'Approved') : (currentLang === 'km' ? 'កំពុងពិនិត្យ' : 'Review') %>
              </span>
            </div>

            <dl class="mt-3 space-y-1.5 text-xs">
              <div class="flex gap-2">
                <dt class="w-20 flex-shrink-0 text-gray-400 dark:text-gray-500">ID</dt>
                <dd class="min-w-0 text-gray-700 dark:text-gray-200"><%= app.id %></dd>
              </div>
              <div class="flex gap-2">
                <dt class="w-20 flex-shrink-0 text-gray-400 dark:text-gray-500"><%= currentLang === 'km' ? 'ជំនាញ' : 'Major' %></dt>
                <dd class="min-w-0 text-gray-700 dark:text-gray-200 break-words"><%= currentLang === 'km' ? app.major_name_kh : app.major_name_en %></dd>
              </div>
              <div class="flex gap-2">
                <dt class="w-20 flex-shrink-0 text-gray-400 dark:text-gray-500"><%= currentLang === 'km' ? 'ប្រភេទ' : 'Category' %></dt>
                <dd class="min-w-0 text-gray-700 dark:text-gray-200 break-words"><%= currentLang === 'km' ? app.category_name_kh : app.category_name_en %></dd>
              </div>
              <div class="flex gap-2">
                <dt class="w-20 flex-shrink-0 text-gray-400 dark:text-gray-500"><%= currentLang === 'km' ? 'កាលបរិច្ឆេទ' : 'Date' %></dt>
                <dd class="min-w-0 text-gray-700 dark:text-gray-200"><%= app.submitted_at ? formatDateOnly(app.submitted_at) : 'N/A' %></dd>
              </div>
            </dl>

            <div class="mt-3 grid grid-cols-2 gap-2">
              <a href="/committee/applications/<%= app.id %>" class="col-span-2 w-full px-3 py-2.5 rounded-xl text-xs font-semibold bg-gradient-to-r from-blue-600 to-indigo-500 text-white hover:from-blue-700 hover:to-indigo-600 transition-all shadow-sm flex items-center justify-center gap-1.5">
                <i class="bi bi-eye"></i><span class="truncate"><%= currentLang === 'km' ? 'មើលលម្អិត' : 'View Details' %></span>
              </a>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="px-5 py-12 text-center">
          <div class="flex flex-col items-center gap-2">
            <i class="bi bi-inbox text-4xl text-gray-300 dark:text-gray-600"></i>
            <p class="text-sm text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'មិនរកឃើញពាក្យសុំអនុម័ត' : 'No approved applications found' %></p>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>