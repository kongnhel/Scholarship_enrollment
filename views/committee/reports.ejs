<h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6 flex items-center gap-2"><i class="bi bi-graph-up text-blue-600 dark:text-blue-400"></i><%= currentLang === 'km' ? 'របាយការណ៍និងស្ថិតិ' : 'Reports & Statistics' %></h1>

<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
  <div class="bg-gradient-to-br from-blue-500 to-blue-600 rounded-2xl p-6 text-white">
    <p class="text-blue-100 text-sm font-medium"><%= currentLang === 'km' ? 'សរុបពាក្យសុំ' : 'Total Applications' %></p>
    <h3 class="text-3xl font-bold mt-1"><%= total %></h3>
  </div>
  <div class="bg-gradient-to-br from-green-500 to-green-600 rounded-2xl p-6 text-white">
    <p class="text-green-100 text-sm font-medium"><%= currentLang === 'km' ? 'អនុម័ត' : 'Approved' %></p>
    <h3 class="text-3xl font-bold mt-1"><%= approvedTotal %></h3>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
  <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
    <div class="px-6 py-4 bg-gray-50 dark:bg-gray-800/50 border-b border-gray-100 dark:border-gray-700">
      <h5 class="font-bold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ពាក្យសុំតាមជំនាញ' : 'Applications by Major' %></h5>
    </div>
    <div class="p-6 overflow-x-auto">
      <table class="w-full">
        <thead class="bg-gray-50 dark:bg-gray-800/50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase"><%= currentLang === 'km' ? 'ជំនាញ' : 'Major' %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase"><%= currentLang === 'km' ? 'ចំនួន' : 'Count' %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase"><%= currentLang === 'km' ? 'ភាគរយ' : 'Percentage' %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50 dark:divide-gray-700">
          <% byMajor.forEach(function(m) { %>
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
              <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-200"><%= currentLang === 'km' ? (m.name_kh || 'N/A') : (m.name_en || 'N/A') %></td>
              <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-200"><%= m.count %></td>
              <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-200"><%= approvedTotal > 0 ? ((m.count / approvedTotal) * 100).toFixed(1) : 0 %>%</td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
    <div class="px-6 py-4 bg-gray-50 dark:bg-gray-800/50 border-b border-gray-100 dark:border-gray-700">
      <h5 class="font-bold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ពាក្យសុំតាមប្រភេទ' : 'Applications by Category' %></h5>
    </div>
    <div class="p-6 overflow-x-auto">
      <table class="w-full">
        <thead class="bg-gray-50 dark:bg-gray-800/50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase"><%= currentLang === 'km' ? 'ប្រភេទ' : 'Category' %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase"><%= currentLang === 'km' ? 'ចំនួន' : 'Count' %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase"><%= currentLang === 'km' ? 'ភាគរយ' : 'Percentage' %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50 dark:divide-gray-700">
          <% byCategory.forEach(function(c) { %>
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
              <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-200"><%= currentLang === 'km' ? (c.name_kh || 'N/A') : (c.name_en || 'N/A') %></td>
              <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-200"><%= c.count %></td>
              <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-200"><%= approvedTotal > 0 ? ((c.count / approvedTotal) * 100).toFixed(1) : 0 %>%</td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
    <div class="px-6 py-4 bg-gray-50 dark:bg-gray-800/50 border-b border-gray-100 dark:border-gray-700">
      <h5 class="font-bold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ពាក្យសុំតាមខេត្ត' : 'Applications by Province' %></h5>
    </div>
    <div class="p-6 overflow-x-auto">
      <table class="w-full">
        <thead class="bg-gray-50 dark:bg-gray-800/50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase"><%= currentLang === 'km' ? 'ខេត្ត' : 'Province' %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase"><%= currentLang === 'km' ? 'ចំនួន' : 'Count' %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase"><%= currentLang === 'km' ? 'ភាគរយ' : 'Percentage' %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50 dark:divide-gray-700">
          <% byProvince.forEach(function(p) { %>
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
              <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-200"><%= currentLang === 'km' ? (p.province_kh || 'N/A') : (p.province_en || 'N/A') %></td>
              <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-200"><%= p.count %></td>
              <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-200"><%= approvedTotal > 0 ? ((p.count / approvedTotal) * 100).toFixed(1) : 0 %>%</td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
    <div class="px-6 py-4 bg-gray-50 dark:bg-gray-800/50 border-b border-gray-100 dark:border-gray-700">
      <h5 class="font-bold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ពាក្យសុំតាមភេទ' : 'Applications by Gender' %></h5>
    </div>
    <div class="p-6 overflow-x-auto">
      <table class="w-full">
        <thead class="bg-gray-50 dark:bg-gray-800/50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase"><%= currentLang === 'km' ? 'ភេទ' : 'Gender' %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase"><%= currentLang === 'km' ? 'ចំនួន' : 'Count' %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase"><%= currentLang === 'km' ? 'ភាគរយ' : 'Percentage' %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50 dark:divide-gray-700">
          <% byGender.forEach(function(g) { %>
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
              <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-200"><%= g.gender === 'male' ? (currentLang === 'km' ? 'ប្រុស' : 'Male') : (currentLang === 'km' ? 'ស្រី' : 'Female') %></td>
              <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-200"><%= g.count %></td>
              <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-200"><%= approvedTotal > 0 ? ((g.count / approvedTotal) * 100).toFixed(1) : 0 %>%</td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>
