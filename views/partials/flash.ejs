<% if (typeof messages !== 'undefined') { %>
  <script type="application/json" id="flash-data">
  {
    "success": <%- messages.success && messages.success.length > 0 ? JSON.stringify(messages.success[0]) : 'null' %>,
    "error": <%- messages.error && messages.error.length > 0 ? JSON.stringify(messages.error[0]) : 'null' %>,
    "warning": <%- messages.warning && messages.warning.length > 0 ? JSON.stringify(messages.warning[0]) : 'null' %>
  }
  </script>
<% } %>