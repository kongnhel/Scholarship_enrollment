<% if (user) { %>
<nav class="fixed top-0 left-0 lg:left-[260px] right-0 h-14 bg-white/80 dark:bg-gray-800/80 backdrop-blur-lg border-b border-gray-100 dark:border-gray-700 z-30 flex items-center justify-end px-4 sm:px-6 gap-3">
  <div class="flex items-center gap-3 ml-auto">
    <button id="themeToggleTop" class="p-2 rounded-lg text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-all" title="Toggle theme">
      <i class="bi bi-moon-fill dark:hidden"></i>
      <i class="bi bi-sun-fill hidden dark:inline"></i>
    </button>
  </div>
</nav>
<% } else { %>
<nav class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-lg border-b border-gray-100 dark:border-gray-700 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14">
      <div class="flex items-center min-w-0 flex-1 overflow-hidden mr-2">
        <a href="/" class="flex items-center gap-2 min-w-0 overflow-hidden">
          <img src="/images/nmu-logo.jpg" alt="NMU" class="h-7 w-7 sm:h-8 sm:w-8 rounded-full ring-2 ring-green-100 dark:ring-green-900 shrink-0">
          <span class="font-bold text-gray-900 dark:text-white text-xs sm:text-sm md:text-base block truncate">NMU <span class="text-green-600 dark:text-green-400">Scholarship & Enroll Online</span></span>
        </a>
      </div>

      <div class="hidden md:flex items-center gap-1 shrink-0" id="desktopNav">
        <a href="/" class="px-3 py-2 rounded-lg text-sm font-medium text-gray-600 dark:text-gray-300 hover:bg-green-50 dark:hover:bg-green-900/20 hover:text-green-600 dark:hover:text-green-400 transition-all <%= typeof title !== 'undefined' && title === 'Home' ? 'bg-green-50 dark:bg-green-900/20 text-green-600 dark:text-green-400' : '' %>">
          <i class="bi bi-house mr-1"></i><%= currentLang === 'km' ? 'ទំព័រដើម' : 'Home' %>
        </a>
      </div>

      <div class="hidden md:flex items-center gap-3 shrink-0">
        <button id="themeToggleTop" class="p-2 rounded-lg text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-all" title="Toggle theme">
          <i class="bi bi-moon-fill dark:hidden"></i>
          <i class="bi bi-sun-fill hidden dark:inline"></i>
        </button>
        <div class="flex bg-gray-100 dark:bg-gray-700 rounded-lg p-0.5">
          <a href="?lang=km" class="px-3 py-1 rounded-md text-xs font-bold transition-all <%= currentLang === 'km' ? 'bg-white dark:bg-gray-600 text-green-600 dark:text-green-400 shadow-sm' : 'text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300' %>">KM</a>
          <a href="?lang=en" class="px-3 py-1 rounded-md text-xs font-bold transition-all <%= currentLang === 'en' ? 'bg-white dark:bg-gray-600 text-green-600 dark:text-green-400 shadow-sm' : 'text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300' %>">EN</a>
        </div>
        <a href="/auth/login" class="px-4 py-1.5 bg-green-500 text-white rounded-lg text-sm font-medium hover:bg-green-600 transition-all shadow-sm">
          <i class="bi bi-box-arrow-in-right mr-1"></i><%= currentLang === 'km' ? 'ចូល' : 'Login' %>
        </a>
        <a href="/auth/register" class="px-4 py-1.5 bg-green-500 text-white rounded-lg text-sm font-medium hover:bg-green-600 transition-all shadow-sm">
          <i class="bi bi-pencil-square mr-1"></i><%= currentLang === 'km' ? 'ចុះឈ្មោះ' : 'Register' %>
        </a>
      </div>

      <button id="menuBtn" class="md:hidden p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-all shrink-0">
        <i class="bi bi-list text-xl text-gray-700 dark:text-gray-300"></i>
      </button>
    </div>
  </div>

  <div id="mobileMenu" class="md:hidden slide-down hidden bg-white dark:bg-gray-800 border-b border-gray-100 dark:border-gray-700 shadow-lg">
    <div class="max-w-7xl mx-auto px-4 py-3 space-y-2">
      <a href="/" class="flex items-center gap-2 px-3 py-2.5 rounded-lg text-gray-700 dark:text-gray-200 hover:bg-green-50 dark:hover:bg-green-900/20 hover:text-green-600 dark:hover:text-green-400 font-medium"><i class="bi bi-house"></i><%= currentLang === 'km' ? 'ទំព័រដើម' : 'Home' %></a>
      <a href="/auth/login" class="flex items-center justify-center gap-2 px-3 py-2.5 rounded-lg bg-green-500 text-white font-medium hover:bg-green-600"><i class="bi bi-box-arrow-in-right"></i><%= currentLang === 'km' ? 'ចូល' : 'Login' %></a>
      <a href="/auth/register" class="flex items-center justify-center gap-2 px-3 py-2.5 rounded-lg bg-green-500 text-white font-medium hover:bg-green-600"><i class="bi bi-pencil-square"></i><%= currentLang === 'km' ? 'ចុះឈ្មោះ' : 'Register' %></a>
      <button id="themeToggleMobile" class="w-full flex items-center gap-2 px-3 py-2.5 rounded-lg text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700 font-medium">
        <i class="bi bi-moon-fill dark:hidden"></i>
        <i class="bi bi-sun-fill hidden dark:inline"></i>
        <span><%= currentLang === 'km' ? 'របៀបងងឹត' : 'Dark Mode' %></span>
      </button>
      <div class="flex gap-2 pt-1">
        <a href="?lang=km" class="flex-1 text-center py-2 rounded-lg text-sm font-bold border border-gray-200 dark:border-gray-600 transition-all <%= currentLang === 'km' ? 'bg-green-50 dark:bg-green-900/30 text-green-600 dark:text-green-400 border-green-300 dark:border-green-700' : 'text-gray-500 dark:text-gray-400' %>">🇰🇭 ខ្មែរ</a>
        <a href="?lang=en" class="flex-1 text-center py-2 rounded-lg text-sm font-bold border border-gray-200 dark:border-gray-600 transition-all <%= currentLang === 'en' ? 'bg-green-50 dark:bg-green-900/30 text-green-600 dark:text-green-400 border-green-300 dark:border-green-700' : 'text-gray-500 dark:text-gray-400' %>">🇬🇧 English</a>
      </div>
    </div>
  </div>
</nav>
<% } %>

<script>
document.getElementById('menuBtn')?.addEventListener('click', function() {
  const menu = document.getElementById('mobileMenu');
  menu.classList.toggle('hidden');
});
document.addEventListener('click', function(e) {
  const menu = document.getElementById('mobileMenu');
  const btn = document.getElementById('menuBtn');
  if (menu && btn && !menu.contains(e.target) && !btn.contains(e.target)) {
    menu.classList.add('hidden');
  }
});

function toggleTheme() {
  const html = document.documentElement;
  if (html.classList.contains('dark')) {
    html.classList.remove('dark');
    localStorage.setItem('theme', 'light');
  } else {
    html.classList.add('dark');
    localStorage.setItem('theme', 'dark');
  }
}
document.getElementById('themeToggleTop')?.addEventListener('click', toggleTheme);
document.getElementById('themeToggleMobile')?.addEventListener('click', toggleTheme);
</script>
