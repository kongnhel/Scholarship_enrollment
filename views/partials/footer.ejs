<footer class="bg-gray-900 dark:bg-gray-950 text-white mt-16 <%= user ? 'lg:ml-[260px]' : '' %>">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div>
        <div class="flex items-center gap-2.5 mb-4">
          <img src="/images/nmu-logo.jpg" alt="NMU" class="h-10 w-10 rounded-full">
          <span class="font-bold text-lg">NMU <span class="text-green-400">Scholarship & Enroll Online</span></span>
        </div>
        <p class="text-gray-400 text-sm leading-relaxed"><%= currentLang === 'km' ? 'ប្រព័ន្ធស្នើរសុំអាហារូបករណ៍ និងចុះឈ្មោះតាមonlineរបស់សាកលវិទ្យាល័យជាតិមានជ័យ' : 'Scholarship Online System - National Meanchey University' %></p>
      </div>
      <div>
        <h4 class="font-semibold mb-4"><%= currentLang === 'km' ? 'តំណភ្ជាប់' : 'Quick Links' %></h4>
        <ul class="space-y-2">
          <li><a href="/" class="text-gray-400 hover:text-white text-sm transition-colors"><%= currentLang === 'km' ? 'ទំព័រដើម' : 'Home' %></a></li>
          <li><a href="/auth/login" class="text-gray-400 hover:text-white text-sm transition-colors"><%= currentLang === 'km' ? 'ចូល' : 'Login' %></a></li>
          <li><a href="/auth/register" class="text-gray-400 hover:text-white text-sm transition-colors"><%= currentLang === 'km' ? 'ចុះឈ្មោះ' : 'Register' %></a></li>
          <li><a href="/faq" class="text-gray-400 hover:text-white text-sm transition-colors"><%= currentLang === 'km' ? 'សំណួរញឹកញាប់' : 'FAQ' %></a></li>
          <li><a href="/terms" class="text-gray-400 hover:text-white text-sm transition-colors"><%= currentLang === 'km' ? 'លក្ខខណ្ឌ' : 'Terms' %></a></li>
        </ul>
      </div>
      <div>
        <h4 class="font-semibold mb-4"><%= currentLang === 'km' ? 'ទំនាក់ទំនង' : 'Contact' %></h4>
        <%
          // Public contact details, editable by an admin at /admin/contact. Injected into
          // res.locals by server.js. The literal defaults below are the safety net: if the
          // settings query ever fails the footer must still render something sensible
          // rather than an empty block.
          var cWebsite = (typeof contactInfo !== 'undefined' && contactInfo.website) || 'https://nmu.edu.kh/';
          var cEmail = (typeof contactInfo !== 'undefined' && contactInfo.email) || 'info@nmu.edu.kh';
          var cPhone = (typeof contactInfo !== 'undefined' && contactInfo.phone) || '+855 12 345 678';
          var cAddress = (typeof contactInfo !== 'undefined' && contactInfo.address) || 'Meanchey, Cambodia';
          // Show the host without the scheme so it reads as a domain, not a URL.
          var cHost = String(cWebsite).replace(/^https?:\/\//i, '').replace(/\/+$/, '');
        %>
        <ul class="space-y-2 text-gray-400 text-sm">
          <% if (cWebsite) { %>
            <li class="flex items-center gap-2"><i class="bi bi-globe"></i> <a href="<%= cWebsite %>" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors"><%= cHost %></a></li>
          <% } %>
          <% if (cEmail) { %>
            <li class="flex items-center gap-2"><i class="bi bi-envelope"></i> <a href="mailto:<%= cEmail %>" class="hover:text-white transition-colors"><%= cEmail %></a></li>
          <% } %>
          <% if (cPhone) { %>
            <li class="flex items-center gap-2"><i class="bi bi-phone"></i> <a href="tel:<%= String(cPhone).replace(/[^+\d]/g, '') %>" class="hover:text-white transition-colors"><%= cPhone %></a></li>
          <% } %>
          <% if (cAddress) { %>
            <li class="flex items-center gap-2"><i class="bi bi-geo-alt"></i> <%= cAddress %></li>
          <% } %>
        </ul>
      </div>
    </div>
    <hr class="border-gray-800 my-8">
    <p class="text-center text-gray-500 text-sm">&copy; 2026 National Meanchey University. <%= currentLang === 'km' ? 'រក្សាសិទ្ធិគ្រប់យ៉ាង។' : 'All rights reserved.' %></p>
  </div>
</footer>
