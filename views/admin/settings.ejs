<div class="max-w-4xl mx-auto space-y-6">
  <%
    var now = new Date();

    var enrollOpen = settings.enrollment_open === '1';
    var enrollStart = settings.enrollment_start ? new Date(settings.enrollment_start) : null;
    var enrollEnd = settings.enrollment_end ? new Date(settings.enrollment_end) : null;
    var enrollWithinRange = (!enrollStart || enrollStart <= now) && (!enrollEnd || enrollEnd >= now);
    var enrollActive = enrollOpen && enrollWithinRange;
    var enrollStatusLabel = enrollActive ? (currentLang === 'km' ? 'បើកដំណើរការ' : 'Active')
                  : enrollOpen ? (currentLang === 'km' ? 'ក្រៅម៉ោងកំណត់' : 'Out of Period')
                  : (currentLang === 'km' ? 'បិទ' : 'Closed');
    var enrollStatusColor = enrollActive ? 'green'
                    : enrollOpen ? 'yellow'
                    : 'red';

    var scholOpen = settings.scholarship_open === '1';
    var scholStart = settings.scholarship_start ? new Date(settings.scholarship_start) : null;
    var scholEnd = settings.scholarship_end ? new Date(settings.scholarship_end) : null;
    var scholWithinRange = (!scholStart || scholStart <= now) && (!scholEnd || scholEnd >= now);
    var scholActive = scholOpen && scholWithinRange;
    var scholStatusLabel = scholActive ? (currentLang === 'km' ? 'បើកដំណើរការ' : 'Active')
                  : scholOpen ? (currentLang === 'km' ? 'ក្រៅម៉ោងកំណត់' : 'Out of Period')
                  : (currentLang === 'km' ? 'បិទ' : 'Closed');
    var scholStatusColor = scholActive ? 'green'
                    : scholOpen ? 'yellow'
                    : 'red';
  %>

  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 bg-gradient-to-br from-green-500 to-emerald-600 rounded-xl flex items-center justify-center shadow-lg shadow-green-500/20">
        <i class="bi bi-gear text-white text-lg"></i>
      </div>
      <div>
        <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ការកំណត់ប្រព័ន្ធ' : 'System Settings' %></h1>
        <p class="text-sm text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'គ្រប់គ្រងការកំណត់រចនាសម្ព័ន្ធកម្មវិធី' : 'Manage application configuration' %></p>
      </div>
    </div>
    <div class="flex items-center gap-2 px-3 py-2 rounded-full border <%= enrollStatusColor === 'green' ? 'bg-green-50 dark:bg-green-900/20 border-green-200 dark:border-green-800' : enrollStatusColor === 'yellow' ? 'bg-yellow-50 dark:bg-yellow-900/20 border-yellow-200 dark:border-yellow-800' : 'bg-red-50 dark:bg-red-900/20 border-red-200 dark:border-red-800' %>">
      <span class="w-2 h-2 rounded-full bg-<%= enrollStatusColor %>-500"></span>
      <span class="text-xs font-semibold text-<%= enrollStatusColor %>-700 dark:text-<%= enrollStatusColor %>-300"><%= currentLang === 'km' ? 'ការចុះឈ្មោះចូលរៀន៖ ' : 'Enrollment: ' %><%= enrollStatusLabel %></span>
    </div>
    <div class="flex items-center gap-2 px-3 py-2 rounded-full border <%= scholStatusColor === 'green' ? 'bg-green-50 dark:bg-green-900/20 border-green-200 dark:border-green-800' : scholStatusColor === 'yellow' ? 'bg-yellow-50 dark:bg-yellow-900/20 border-yellow-200 dark:border-yellow-800' : 'bg-red-50 dark:bg-red-900/20 border-red-200 dark:border-red-800' %>">
      <span class="w-2 h-2 rounded-full bg-<%= scholStatusColor %>-500"></span>
      <span class="text-xs font-semibold text-<%= scholStatusColor %>-700 dark:text-<%= scholStatusColor %>-300"><%= currentLang === 'km' ? 'អាហារូបករណ៍៖ ' : 'Scholarship: ' %><%= scholStatusLabel %></span>
    </div>
  </div>

  <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
    <div class="px-6 py-4 bg-gradient-to-r from-green-600 to-emerald-500 flex items-center gap-3">
      <div class="w-8 h-8 bg-white/20 rounded-lg flex items-center justify-center">
        <i class="bi bi-person-plus text-white"></i>
      </div>
      <div>
        <h3 class="font-bold text-white"><%= currentLang === 'km' ? 'ការកំណត់ការចុះឈ្មោះគណនី' : 'Registration Settings' %></h3>
        <p class="text-green-100 text-xs"><%= currentLang === 'km' ? 'គ្រប់គ្រងការចុះឈ្មោះគណនីសិស្សថ្មី' : 'Control new student account registration' %></p>
      </div>
    </div>

    <form action="/admin/settings" method="POST" class="p-6 space-y-6">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="flex items-start justify-between p-4 bg-gray-50 dark:bg-gray-700/30 rounded-xl">
        <div class="flex items-start gap-3">
          <div class="w-9 h-9 bg-green-100 dark:bg-green-900/30 rounded-lg flex items-center justify-center flex-shrink-0">
            <i class="bi bi-toggle-on text-green-600 dark:text-green-400"></i>
          </div>
          <div>
            <label class="font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'បើកការចុះឈ្មោះគណនី' : 'Registration Open' %></label>
            <p class="text-sm text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'អនុញ្ញាតឱ្យសិស្សថ្មីចុះឈ្មោះគណនី' : 'Allow new students to register accounts' %></p>
          </div>
        </div>
        <label class="relative inline-flex items-center cursor-pointer">
          <input type="hidden" name="registration_open" value="0">
          <input type="checkbox" name="registration_open" value="1" class="sr-only peer" <%= settings.registration_open === '1' ? 'checked' : '' %>>
          <div class="w-11 h-6 bg-gray-300 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-green-300/50 rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-green-500"></div>
        </label>
      </div>

      <hr class="border-gray-100 dark:border-gray-700">

      <div>
        <div class="flex items-center gap-2 mb-4">
          <i class="bi bi-calendar-range text-green-600 dark:text-green-400"></i>
          <span class="font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'រយៈពេលចុះឈ្មោះគណនី' : 'Registration Period' %></span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5">
              <i class="bi bi-play-circle mr-1 text-green-500"></i><%= currentLang === 'km' ? 'ថ្ងៃចាប់ផ្តើម' : 'Start Date' %>
            </label>
            <div class="relative">
              <i class="bi bi-calendar3 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 dark:text-gray-500 pointer-events-none"></i>
              <input type="datetime-local" name="registration_start" value="<%= settings.registration_start || '' %>" class="w-full pl-10 pr-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5">
              <i class="bi bi-stop-circle mr-1 text-red-500"></i><%= currentLang === 'km' ? 'ថ្ងៃបិទ' : 'End Date' %>
            </label>
            <div class="relative">
              <i class="bi bi-calendar3 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 dark:text-gray-500 pointer-events-none"></i>
              <input type="datetime-local" name="registration_end" value="<%= settings.registration_end || '' %>" class="w-full pl-10 pr-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
            </div>
          </div>
        </div>
      </div>

      <hr class="border-gray-100 dark:border-gray-700">

      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-center gap-2 text-xs text-gray-400 dark:text-gray-500">
          <i class="bi bi-info-circle"></i>
          <span><%= currentLang === 'km' ? 'ការផ្លាស់ប្តូរត្រូវបានអនុវត្តភ្លាមៗ' : 'Changes are applied immediately' %></span>
        </div>
        <button type="submit" class="w-full sm:w-auto px-8 py-3 bg-gradient-to-r from-green-600 to-emerald-500 text-white rounded-xl font-bold hover:from-green-700 hover:to-emerald-600 transition-all shadow-lg shadow-green-500/20 flex items-center justify-center gap-2">
          <i class="bi bi-check-circle"></i>
          <span><%= currentLang === 'km' ? 'រក្សាទុក' : 'Save Settings' %></span>
        </button>
      </div>
    </form>
  </div>

  <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
    <div class="px-6 py-4 bg-gradient-to-r from-blue-600 to-indigo-500 flex items-center gap-3">
      <div class="w-8 h-8 bg-white/20 rounded-lg flex items-center justify-center">
        <i class="bi bi-person-check text-white"></i>
      </div>
      <div>
        <h3 class="font-bold text-white"><%= currentLang === 'km' ? 'ការកំណត់ការចុះឈ្មោះចូលរៀន' : 'Enrollment Settings' %></h3>
        <p class="text-blue-100 text-xs"><%= currentLang === 'km' ? 'គ្រប់គ្រងលំហូរការចុះឈ្មោះចូលរៀនរបស់សិស្ស' : 'Control student enrollment flow' %></p>
      </div>
    </div>

    <form action="/admin/settings" method="POST" class="p-6 space-y-6">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="flex items-start justify-between p-4 bg-gray-50 dark:bg-gray-700/30 rounded-xl">
        <div class="flex items-start gap-3">
          <div class="w-9 h-9 bg-blue-100 dark:bg-blue-900/30 rounded-lg flex items-center justify-center flex-shrink-0">
            <i class="bi bi-toggle-on text-blue-600 dark:text-blue-400"></i>
          </div>
          <div>
            <label class="font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'បើកការចុះឈ្មោះចូលរៀន' : 'Enrollment Open' %></label>
            <p class="text-sm text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'អនុញ្ញាតឱ្យសិស្សចុះឈ្មោះចូលរៀន' : 'Allow students to enroll in majors' %></p>
          </div>
        </div>
        <label class="relative inline-flex items-center cursor-pointer">
          <input type="hidden" name="enrollment_open" value="0">
          <input type="checkbox" name="enrollment_open" value="1" class="sr-only peer" <%= settings.enrollment_open === '1' ? 'checked' : '' %>>
          <div class="w-11 h-6 bg-gray-300 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300/50 rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-500"></div>
        </label>
      </div>

      <hr class="border-gray-100 dark:border-gray-700">

      <div>
        <div class="flex items-center gap-2 mb-4">
          <i class="bi bi-calendar-range text-blue-600 dark:text-blue-400"></i>
          <span class="font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'រយៈពេលចុះឈ្មោះចូលរៀន' : 'Enrollment Period' %></span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5">
              <i class="bi bi-play-circle mr-1 text-blue-500"></i><%= currentLang === 'km' ? 'ថ្ងៃចាប់ផ្តើម' : 'Start Date' %>
            </label>
            <div class="relative">
              <i class="bi bi-calendar3 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 dark:text-gray-500 pointer-events-none"></i>
              <input type="datetime-local" name="enrollment_start" value="<%= settings.enrollment_start || '' %>" class="w-full pl-10 pr-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5">
              <i class="bi bi-stop-circle mr-1 text-red-500"></i><%= currentLang === 'km' ? 'ថ្ងៃបិទ' : 'End Date' %>
            </label>
            <div class="relative">
              <i class="bi bi-calendar3 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 dark:text-gray-500 pointer-events-none"></i>
              <input type="datetime-local" name="enrollment_end" value="<%= settings.enrollment_end || '' %>" class="w-full pl-10 pr-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
            </div>
          </div>
        </div>
      </div>

      <hr class="border-gray-100 dark:border-gray-700">

      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-center gap-2 text-xs text-gray-400 dark:text-gray-500">
          <i class="bi bi-info-circle"></i>
          <span><%= currentLang === 'km' ? 'ការផ្លាស់ប្តូរត្រូវបានអនុវត្តភ្លាមៗ' : 'Changes are applied immediately' %></span>
        </div>
        <button type="submit" class="w-full sm:w-auto px-8 py-3 bg-gradient-to-r from-blue-600 to-indigo-500 text-white rounded-xl font-bold hover:from-blue-700 hover:to-indigo-600 transition-all shadow-lg shadow-blue-500/20 flex items-center justify-center gap-2">
          <i class="bi bi-check-circle"></i>
          <span><%= currentLang === 'km' ? 'រក្សាទុក' : 'Save Settings' %></span>
        </button>
      </div>
    </form>
  </div>

  <% if (enrollStart || enrollEnd) { %>
  <div class="bg-white dark:bg-gray-800 rounded-2xl p-4 shadow-sm border border-gray-100 dark:border-gray-700">
    <div class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400">
      <i class="bi bi-clock-history text-blue-500"></i>
      <span><%= currentLang === 'km' ? 'ស្ថានភាពការចុះឈ្មោះចូលរៀន' : 'Enrollment Status' %>:</span>
      <% if (!enrollStart || enrollStart <= now) { %>
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300"><i class="bi bi-check-circle-fill"></i><%= currentLang === 'km' ? 'រយៈពេលចុះឈ្មោះចូលរៀនបានចាប់ផ្តើម' : 'Enrollment period has started' %></span>
      <% } else { %>
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-300"><i class="bi bi-clock"></i><%= currentLang === 'km' ? 'រយៈពេលចុះឈ្មោះចូលរៀនមិនទាន់ចាប់ផ្តើម' : 'Enrollment period has not started' %></span>
      <% } %>
      <% if (enrollEnd) { %>
        <span class="text-gray-400 dark:text-gray-500">|</span>
        <% if (enrollEnd >= now) { %>
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300"><i class="bi bi-hourglass-split"></i><%= currentLang === 'km' ? 'នៅសល់ពេល' : 'Ends' %> <%= enrollEnd.toLocaleDateString() %></span>
        <% } else { %>
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300"><i class="bi bi-x-circle-fill"></i><%= currentLang === 'km' ? 'រយៈពេលចុះឈ្មោះចូលរៀនបានបញ្ចប់' : 'Enrollment period has ended' %></span>
        <% } %>
      <% } %>
    </div>
  </div>
  <% } %>

  <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
    <div class="px-6 py-4 bg-gradient-to-r from-rose-500 to-pink-600 flex items-center gap-3">
      <div class="w-8 h-8 bg-white/20 rounded-lg flex items-center justify-center">
        <i class="bi bi-qr-code text-white"></i>
      </div>
      <div>
        <h3 class="font-bold text-white"><%= currentLang === 'km' ? 'ការកំណត់ QR Code ការទូទាត់' : 'Payment QR Code Settings' %></h3>
        <p class="text-rose-100 text-xs"><%= currentLang === 'km' ? 'ផ្លាស់ប្តូររូបភាព QR Code សម្រាប់ការទូទាត់' : 'Change the QR code image for payments' %></p>
      </div>
    </div>
    <div class="p-6">
      <form action="/admin/settings" method="POST" enctype="multipart/form-data" class="space-y-4">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="form_type" value="qr_upload">
        <div class="flex items-start gap-6">
          <div class="flex-shrink-0">
            <% if (settings.payment_qr_path) { %>
              <img src="<%= settings.payment_qr_path %>" alt="Current QR" class="w-40 h-40 object-cover rounded-xl border border-gray-200 dark:border-gray-600 shadow-sm">
            <% } else { %>
              <div class="w-40 h-40 bg-gray-100 dark:bg-gray-700 rounded-xl flex items-center justify-center border border-gray-200 dark:border-gray-600">
                <i class="bi bi-qr-code text-gray-300 text-4xl"></i>
              </div>
            <% } %>
          </div>
          <div class="flex-1 space-y-3">
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'រូបភាព QR Code បច្ចុប្បន្ន' : 'Current QR Code Image' %></label>
              <p class="text-xs text-gray-400 dark:text-gray-500"><%= currentLang === 'km' ? 'រូបភាព QR Code ដែលសិស្សឃើញនៅពេលទូទាត់' : 'The QR code students see when making payment' %></p>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'ផ្ទុករូបភាព QR Code ថ្មី' : 'Upload New QR Code' %></label>
              <input type="file" name="payment_qr_file" accept=".jpg,.jpeg,.png" class="w-full text-sm text-gray-500 dark:text-gray-400 file:mr-4 file:py-2.5 file:px-5 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-rose-50 file:text-rose-700 dark:file:bg-rose-900/30 dark:file:text-rose-300 hover:file:bg-rose-100 dark:hover:file:bg-rose-900/50">
              <p class="text-xs text-gray-400 dark:text-gray-500 mt-1"><%= currentLang === 'km' ? 'ទម្រង់៖ JPG, PNG។ រូបភាពថ្មីនឹងជំនួសរូបភាពបច្ចុប្បន្ន។' : 'Format: JPG, PNG. New image will replace the current one.' %></p>
            </div>
            <button type="submit" class="px-5 py-2 bg-gradient-to-r from-rose-500 to-pink-600 text-white rounded-xl text-sm font-semibold hover:from-rose-600 hover:to-pink-700 transition-all shadow-sm flex items-center gap-2">
              <i class="bi bi-upload"></i><%= currentLang === 'km' ? 'ផ្ទុករូបភាពថ្មី' : 'Upload New Image' %>
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
    <div class="px-6 py-4 bg-gradient-to-r from-purple-600 to-violet-500 flex items-center gap-3">
      <div class="w-8 h-8 bg-white/20 rounded-lg flex items-center justify-center">
        <i class="bi bi-award text-white"></i>
      </div>
      <div>
        <h3 class="font-bold text-white"><%= currentLang === 'km' ? 'ការកំណត់អាហារូបករណ៍' : 'Scholarship Settings' %></h3>
        <p class="text-purple-100 text-xs"><%= currentLang === 'km' ? 'គ្រប់គ្រងលំហូរការដាក់ពាក្យអាហារូបករណ៍' : 'Control scholarship application flow' %></p>
      </div>
    </div>

    <form action="/admin/settings" method="POST" class="p-6 space-y-6">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="flex items-start justify-between p-4 bg-gray-50 dark:bg-gray-700/30 rounded-xl">
        <div class="flex items-start gap-3">
          <div class="w-9 h-9 bg-purple-100 dark:bg-purple-900/30 rounded-lg flex items-center justify-center flex-shrink-0">
            <i class="bi bi-toggle-on text-purple-600 dark:text-purple-400"></i>
          </div>
          <div>
            <label class="font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'បើកការដាក់ពាក្យអាហារូបករណ៍' : 'Scholarship Application Open' %></label>
            <p class="text-sm text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'អនុញ្ញាតឱ្យសិស្សដាក់ពាក្យសុំអាហារូបករណ៍' : 'Allow students to submit scholarship applications' %></p>
          </div>
        </div>
        <label class="relative inline-flex items-center cursor-pointer">
          <input type="hidden" name="scholarship_open" value="0">
          <input type="checkbox" name="scholarship_open" value="1" class="sr-only peer" <%= settings.scholarship_open === '1' ? 'checked' : '' %>>
          <div class="w-11 h-6 bg-gray-300 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-purple-300/50 rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-purple-500"></div>
        </label>
      </div>

      <hr class="border-gray-100 dark:border-gray-700">

      <div>
        <div class="flex items-center gap-2 mb-4">
          <i class="bi bi-calendar-range text-purple-600 dark:text-purple-400"></i>
          <span class="font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'រយៈពេលដាក់ពាក្យអាហារូបករណ៍' : 'Scholarship Application Period' %></span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5">
              <i class="bi bi-play-circle mr-1 text-purple-500"></i><%= currentLang === 'km' ? 'ថ្ងៃចាប់ផ្តើម' : 'Start Date' %>
            </label>
            <div class="relative">
              <i class="bi bi-calendar3 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 dark:text-gray-500 pointer-events-none"></i>
              <input type="datetime-local" name="scholarship_start" value="<%= settings.scholarship_start || '' %>" class="w-full pl-10 pr-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-purple-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5">
              <i class="bi bi-stop-circle mr-1 text-red-500"></i><%= currentLang === 'km' ? 'ថ្ងៃបិទ' : 'End Date' %>
            </label>
            <div class="relative">
              <i class="bi bi-calendar3 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 dark:text-gray-500 pointer-events-none"></i>
              <input type="datetime-local" name="scholarship_end" value="<%= settings.scholarship_end || '' %>" class="w-full pl-10 pr-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-purple-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
            </div>
          </div>
        </div>
      </div>

      <hr class="border-gray-100 dark:border-gray-700">

      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-center gap-2 text-xs text-gray-400 dark:text-gray-500">
          <i class="bi bi-info-circle"></i>
          <span><%= currentLang === 'km' ? 'ការផ្លាស់ប្តូរត្រូវបានអនុវត្តភ្លាមៗ' : 'Changes are applied immediately' %></span>
        </div>
        <button type="submit" class="w-full sm:w-auto px-8 py-3 bg-gradient-to-r from-purple-600 to-violet-500 text-white rounded-xl font-bold hover:from-purple-700 hover:to-violet-600 transition-all shadow-lg shadow-purple-500/20 flex items-center justify-center gap-2">
          <i class="bi bi-check-circle"></i>
          <span><%= currentLang === 'km' ? 'រក្សាទុក' : 'Save Settings' %></span>
        </button>
      </div>
    </form>
  </div>

  <% if (scholStart || scholEnd) { %>
  <div class="bg-white dark:bg-gray-800 rounded-2xl p-4 shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
    <div class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400">
      <i class="bi bi-clock-history text-purple-500"></i>
      <span><%= currentLang === 'km' ? 'ស្ថានភាពអាហារូបករណ៍' : 'Scholarship Status' %>:</span>
      <% if (!scholStart || scholStart <= now) { %>
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300"><i class="bi bi-check-circle-fill"></i><%= currentLang === 'km' ? 'រយៈពេលដាក់ពាក្យបានចាប់ផ្តើម' : 'Scholarship period has started' %></span>
      <% } else { %>
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-300"><i class="bi bi-clock"></i><%= currentLang === 'km' ? 'រយៈពេលដាក់ពាក្យមិនទាន់ចាប់ផ្តើម' : 'Scholarship period has not started' %></span>
      <% } %>
      <% if (scholEnd) { %>
        <span class="text-gray-400 dark:text-gray-500">|</span>
        <% if (scholEnd >= now) { %>
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300"><i class="bi bi-hourglass-split"></i><%= currentLang === 'km' ? 'នៅសល់ពេល' : 'Ends' %> <%= scholEnd.toLocaleDateString() %></span>
        <% } else { %>
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300"><i class="bi bi-x-circle-fill"></i><%= currentLang === 'km' ? 'រយៈពេលដាក់ពាក្យបានបញ្ចប់' : 'Scholarship period has ended' %></span>
        <% } %>
      <% } %>
    </div>
  </div>
  <% } %>
</div>