<div class="max-w-6xl mx-auto space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 bg-gradient-to-br from-green-500 to-emerald-600 rounded-xl flex items-center justify-center shadow-lg shadow-green-500/20">
        <i class="bi bi-geo-alt text-white text-lg"></i>
      </div>
      <div>
        <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ការគ្រប់គ្រងខេត្ត' : 'Provinces Management' %></h1>
        <p class="text-sm text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'គ្រប់គ្រងខេត្តទាំងអស់' : 'Manage all provinces' %></p>
      </div>
    </div>
    <div class="flex items-center gap-3">
      <div class="flex items-center gap-2 px-4 py-2 bg-white dark:bg-gray-800 rounded-xl border border-gray-100 dark:border-gray-700 shadow-sm">
        <i class="bi bi-geo-alt text-gray-400"></i>
        <span class="text-sm text-gray-600 dark:text-gray-300"><%= totalRecords %> <%= currentLang === 'km' ? 'ខេត្ត' : 'provinces' %></span>
      </div>
      <button onclick="document.getElementById('addProvinceModal').classList.remove('hidden')" class="px-5 py-2.5 bg-gradient-to-r from-green-600 to-emerald-500 text-white rounded-xl text-sm font-semibold hover:from-green-700 hover:to-emerald-600 transition-all shadow-sm flex items-center gap-2">
        <i class="bi bi-plus-circle"></i><%= currentLang === 'km' ? 'បន្ថែមខេត្តថ្មី' : 'Add New Province' %>
      </button>
    </div>
  </div>

  <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
    <div class="px-6 py-3 bg-gradient-to-r from-green-600 to-emerald-500 flex items-center gap-2">
      <i class="bi bi-sliders text-white/80 text-sm"></i>
      <span class="text-sm font-semibold text-white"><%= currentLang === 'km' ? 'តម្រង' : 'Filters' %></span>
    </div>
    <form action="/admin/provinces" method="GET" class="p-5">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <div class="relative sm:col-span-2 lg:col-span-3">
          <i class="bi bi-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 dark:text-gray-500 pointer-events-none"></i>
          <input type="text" class="w-full pl-9 pr-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" name="search" placeholder="<%= currentLang === 'km' ? 'ស្វែងរកតាមឈ្មោះខេត្ត...' : 'Search by province name...' %>" value="<%= filters.search || '' %>">
        </div>
        <div class="flex gap-2 items-end">
          <button type="submit" class="px-5 py-2.5 bg-gradient-to-r from-green-600 to-emerald-500 text-white rounded-xl text-sm font-semibold hover:from-green-700 hover:to-emerald-600 transition-all shadow-sm flex items-center gap-2">
            <i class="bi bi-search"></i><%= currentLang === 'km' ? 'ត្រង' : 'Filter' %>
          </button>
          <a href="/admin/provinces" class="px-5 py-2.5 border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-400 rounded-xl text-sm font-medium hover:bg-gray-50 dark:hover:bg-gray-700 hover:text-gray-900 dark:hover:text-white transition-all flex items-center gap-1">
            <i class="bi bi-x-lg"></i><%= currentLang === 'km' ? 'សម្អាត' : 'Clear' %>
          </a>
        </div>
      </div>
    </form>
  </div>

  <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="bg-gray-50 dark:bg-gray-800/50 border-b border-gray-100 dark:border-gray-700">
            <th class="px-5 py-3.5 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">ID</th>
            <th class="px-5 py-3.5 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= currentLang === 'km' ? 'ឈ្មោះខ្មែរ' : 'Name (Khmer)' %></th>
            <th class="px-5 py-3.5 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= currentLang === 'km' ? 'ឈ្មោះអង់គ្លេស' : 'Name (English)' %></th>
            <th class="px-5 py-3.5 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= currentLang === 'km' ? 'សកម្មភាព' : 'Actions' %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50 dark:divide-gray-700">
          <% if (provinces.length === 0) { %>
            <tr>
              <td colspan="4" class="px-5 py-12 text-center">
                <div class="flex flex-col items-center gap-2">
                  <i class="bi bi-geo-alt text-4xl text-gray-300 dark:text-gray-600"></i>
                  <p class="text-sm text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'មិនមានខេត្តទេ' : 'No provinces found' %></p>
                </div>
              </td>
            </tr>
          <% } else { %>
            <% provinces.forEach(function(province) { %>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
                <td class="px-5 py-4">
                  <span class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-gray-100 dark:bg-gray-700 text-xs font-bold text-gray-500 dark:text-gray-400"><%= province.id %></span>
                </td>
                <td class="px-5 py-4 text-sm font-medium text-gray-900 dark:text-gray-100"><%= province.name_kh %></td>
                <td class="px-5 py-4 text-sm text-gray-700 dark:text-gray-200"><%= province.name_en %></td>
                <td class="px-5 py-4">
                  <div class="flex gap-1.5">
                    <button onclick='editProvince(<%= JSON.stringify(province) %>)' class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-green-200 text-green-600 dark:text-green-400 hover:bg-green-50 dark:hover:bg-green-900/20 transition-all flex items-center gap-1"><i class="bi bi-pencil"></i><%= currentLang === 'km' ? 'កែ' : 'Edit' %></button>
                    <button type="button" onclick="confirmDeleteProvince(<%= province.id %>, '<%= province.name_kh %>', event)" class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-red-200 text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 transition-all flex items-center gap-1"><i class="bi bi-trash"></i><%= currentLang === 'km' ? 'លុប' : 'Delete' %></button>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>

    <% if (totalPages > 1) { %>
      <div class="px-6 py-4 border-t border-gray-100 dark:border-gray-700 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <p class="text-sm text-gray-500 dark:text-gray-400">
          <%= currentLang === 'km' ? 'ទំព័រ' : 'Page' %> <%= currentPage %> <%= currentLang === 'km' ? 'នៃ' : 'of' %> <%= totalPages %>
        </p>
        <div class="flex gap-1">
          <% const provQs = 'search=' + encodeURIComponent(filters.search || ''); %>
          <a href="?page=<%= currentPage - 1 %>&<%= provQs %>" class="px-4 py-2 rounded-xl text-sm font-medium transition-all <%= currentPage === 1 ? 'text-gray-300 dark:text-gray-600 cursor-not-allowed' : 'text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 hover:text-gray-900 dark:hover:text-white' %>">
            <i class="bi bi-chevron-left"></i>
            <span class="hidden sm:inline ml-1"><%= currentLang === 'km' ? 'មុន' : 'Previous' %></span>
          </a>
          <%
            let provPages = [];
            if (totalPages <= 7) {
              for (let i = 1; i <= totalPages; i++) provPages.push(i);
            } else {
              provPages.push(1);
              if (currentPage > 3) provPages.push('...');
              for (let i = Math.max(2, currentPage - 1); i <= Math.min(totalPages - 1, currentPage + 1); i++) {
                provPages.push(i);
              }
              if (currentPage < totalPages - 2) provPages.push('...');
              provPages.push(totalPages);
            }
          %>
          <% provPages.forEach(function(p) { %>
            <% if (p === '...') { %>
              <span class="px-2 py-2 text-sm text-gray-400 dark:text-gray-500">...</span>
            <% } else { %>
              <a href="?page=<%= p %>&<%= provQs %>" class="px-3.5 py-2 rounded-xl text-sm font-bold transition-all <%= currentPage === p ? 'bg-gradient-to-r from-green-600 to-emerald-500 text-white shadow-md' : 'text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 hover:text-gray-900 dark:hover:text-white' %>"><%= p %></a>
            <% } %>
          <% }); %>
          <a href="?page=<%= currentPage + 1 %>&<%= provQs %>" class="px-4 py-2 rounded-xl text-sm font-medium transition-all <%= currentPage === totalPages ? 'text-gray-300 dark:text-gray-600 cursor-not-allowed' : 'text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 hover:text-gray-900 dark:hover:text-white' %>">
            <span class="hidden sm:inline mr-1"><%= currentLang === 'km' ? 'បន្ទាប់' : 'Next' %></span>
            <i class="bi bi-chevron-right"></i>
          </a>
        </div>
      </div>
    <% } %>
  </div>
</div>

<div id="addProvinceModal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4" onclick="if(event.target===this)this.classList.add('hidden')">
  <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl w-full max-w-md" onclick="event.stopPropagation()">
    <form action="/admin/provinces" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="px-6 py-4 bg-gradient-to-r from-green-600 to-emerald-500 text-white flex items-center justify-between rounded-t-2xl">
        <h5 class="font-bold flex items-center gap-2"><i class="bi bi-plus-circle"></i><%= currentLang === 'km' ? 'បន្ថែមខេត្តថ្មី' : 'Add New Province' %></h5>
        <button type="button" onclick="this.closest('[id$=Modal]').classList.add('hidden')" class="text-white/80 hover:text-white"><i class="bi bi-x-lg"></i></button>
      </div>
      <div class="p-6 space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'ឈ្មោះខ្មែរ' : 'Name (Khmer)' %></label>
          <input type="text" name="name_kh" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" required>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'ឈ្មោះអង់គ្លេស' : 'Name (English)' %></label>
          <input type="text" name="name_en" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" required>
        </div>
      </div>
      <div class="px-6 py-4 bg-gray-50 dark:bg-gray-800/50 flex justify-end gap-2 border-t border-gray-100 dark:border-gray-700 rounded-b-2xl">
        <button type="button" onclick="this.closest('[id$=Modal]').classList.add('hidden')" class="px-4 py-2 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-200 rounded-xl text-sm font-medium hover:bg-gray-200 dark:hover:bg-gray-600 transition-all"><%= currentLang === 'km' ? 'បោះបង់' : 'Cancel' %></button>
        <button type="submit" class="px-5 py-2 bg-gradient-to-r from-green-600 to-emerald-500 text-white rounded-xl text-sm font-semibold hover:from-green-700 hover:to-emerald-600 transition-all shadow-sm flex items-center gap-1.5"><i class="bi bi-check-lg"></i><%= currentLang === 'km' ? 'រក្សាទុក' : 'Save' %></button>
      </div>
    </form>
  </div>
</div>

<div id="editProvinceModal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4" onclick="if(event.target===this)this.classList.add('hidden')">
  <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl w-full max-w-md" onclick="event.stopPropagation()">
    <form id="editProvinceForm" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="px-6 py-4 bg-gradient-to-r from-green-600 to-emerald-500 text-white flex items-center justify-between rounded-t-2xl">
        <h5 class="font-bold flex items-center gap-2"><i class="bi bi-pencil"></i><%= currentLang === 'km' ? 'កែប្រែខេត្ត' : 'Edit Province' %></h5>
        <button type="button" onclick="document.getElementById('editProvinceModal').classList.add('hidden')" class="text-white/80 hover:text-white"><i class="bi bi-x-lg"></i></button>
      </div>
      <div class="p-6 space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'ឈ្មោះខ្មែរ' : 'Name (Khmer)' %></label>
          <input type="text" name="name_kh" id="edit_name_kh" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" required>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'ឈ្មោះអង់គ្លេស' : 'Name (English)' %></label>
          <input type="text" name="name_en" id="edit_name_en" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" required>
        </div>
      </div>
      <div class="px-6 py-4 bg-gray-50 dark:bg-gray-800/50 flex justify-end gap-2 border-t border-gray-100 dark:border-gray-700 rounded-b-2xl">
        <button type="button" onclick="document.getElementById('editProvinceModal').classList.add('hidden')" class="px-4 py-2 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-200 rounded-xl text-sm font-medium hover:bg-gray-200 dark:hover:bg-gray-600 transition-all"><%= currentLang === 'km' ? 'បោះបង់' : 'Cancel' %></button>
        <button type="submit" class="px-5 py-2 bg-gradient-to-r from-green-600 to-emerald-500 text-white rounded-xl text-sm font-semibold hover:from-green-700 hover:to-emerald-600 transition-all shadow-sm flex items-center gap-1.5"><i class="bi bi-check-lg"></i><%= currentLang === 'km' ? 'អាប់ដេត' : 'Update' %></button>
      </div>
    </form>
  </div>
</div>

<div id="deleteProvincePopover" class="hidden fixed z-50 bg-white dark:bg-gray-800 rounded-xl shadow-2xl border border-gray-200 dark:border-gray-700 p-4 w-72" onclick="event.stopPropagation()">
  <div class="flex items-center gap-3 mb-3">
    <div class="w-10 h-10 bg-red-100 dark:bg-red-900/30 rounded-full flex items-center justify-center flex-shrink-0">
      <i class="bi bi-exclamation-triangle text-red-600 dark:text-red-400"></i>
    </div>
    <div>
      <p class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'លុបខេត្ត' : 'Delete Province' %></p>
      <p class="text-xs text-gray-500 dark:text-gray-400 truncate max-w-[180px]" id="deleteProvinceName"></p>
    </div>
  </div>
  <div class="flex gap-2">
    <button onclick="closeDeleteProvincePopover()" class="flex-1 px-3 py-2 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-lg text-xs font-semibold hover:bg-gray-200 dark:hover:bg-gray-600 transition"><%= currentLang === 'km' ? 'បោះបង់' : 'Cancel' %></button>
    <form id="deleteProvinceForm" method="POST" class="flex-1">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="w-full px-3 py-2 bg-red-600 text-white rounded-lg text-xs font-semibold hover:bg-red-700 transition shadow-sm"><%= currentLang === 'km' ? 'លុប' : 'Delete' %></button>
    </form>
  </div>
</div>

<script>
function editProvince(province) {
  document.getElementById('editProvinceForm').action = '/admin/provinces/' + province.id + '/edit';
  document.getElementById('edit_name_kh').value = province.name_kh;
  document.getElementById('edit_name_en').value = province.name_en;
  document.getElementById('editProvinceModal').classList.remove('hidden');
}
function confirmDeleteProvince(id, name, e) {
  var pop = document.getElementById('deleteProvincePopover');
  document.getElementById('deleteProvinceForm').action = '/admin/provinces/' + id + '/delete';
  document.getElementById('deleteProvinceName').textContent = name;
  pop.classList.remove('hidden');
  var rect = e.currentTarget.getBoundingClientRect();
  var popW = 288;
  var popH = pop.offsetHeight || 140;
  var left = rect.right + 8;
  if (left + popW > window.innerWidth) left = rect.left - popW - 8;
  var top = rect.top + (rect.height / 2) - (popH / 2);
  if (top < 8) top = 8;
  if (top + popH > window.innerHeight - 8) top = window.innerHeight - popH - 8;
  pop.style.left = left + 'px';
  pop.style.top = top + 'px';
}
function closeDeleteProvincePopover() {
  document.getElementById('deleteProvincePopover').classList.add('hidden');
}
document.addEventListener('click', function(e) {
  var pop = document.getElementById('deleteProvincePopover');
  if (!pop.classList.contains('hidden') && !pop.contains(e.target) && !e.target.closest('[onclick*="confirmDeleteProvince"]')) {
    closeDeleteProvincePopover();
  }
});
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') closeDeleteProvincePopover();
});
</script>