<div class="max-w-5xl mx-auto space-y-6">
  <div class="relative overflow-hidden rounded-3xl bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 shadow-sm">
    <div class="absolute top-0 right-0 w-40 h-40 bg-emerald-50 dark:bg-emerald-900/20 rounded-bl-[6rem] -mr-10 -mt-10"></div>
    <div class="relative px-6 py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 bg-gradient-to-br from-emerald-500 to-teal-600 rounded-2xl flex items-center justify-center shadow-md shadow-emerald-500/20 flex-shrink-0">
          <i class="bi bi-qr-code text-white text-xl"></i>
        </div>
        <div>
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-100 dark:bg-emerald-900/40 text-emerald-700 dark:text-emerald-300 text-xs font-bold mb-1">
            <i class="bi bi-collection"></i>
            <%= banks.length %> <%= currentLang === 'km' ? 'ធនាគារ' : 'banks' %>
          </div>
          <h1 class="text-xl font-bold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ធនាគារសម្រាប់ទូទាត់' : 'Payment Banks' %></h1>
          <p class="text-sm text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'សិស្សជ្រើសបានធនាគារដែលត្រូវបង់ប្រាក់' : 'Students pick which bank to pay through' %></p>
        </div>
      </div>
      <a href="/admin/payments" class="self-start sm:self-auto px-4 py-2 border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-400 rounded-xl text-sm font-medium hover:bg-gray-50 dark:hover:bg-gray-700 transition-all flex items-center gap-1.5"><i class="bi bi-cash-stack"></i><%= currentLang === 'km' ? 'ការទូទាត់' : 'Payments' %></a>
    </div>
  </div>

  <% if (banks.length === 0) { %>
    <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 p-12 text-center">
      <div class="w-16 h-16 rounded-full bg-gray-100 dark:bg-gray-700 flex items-center justify-center mx-auto mb-4">
        <i class="bi bi-qr-code text-3xl text-gray-300 dark:text-gray-600"></i>
      </div>
      <p class="text-gray-500 dark:text-gray-400 font-medium"><%= currentLang === 'km' ? 'មិនមានធនាគារទេ' : 'No banks yet' %></p>
      <p class="text-sm text-gray-400 dark:text-gray-500 mt-1"><%= currentLang === 'km' ? 'បញ្ចូលធនាគារដំបូងខាងក្រោម។' : 'Add your first bank using the form below.' %></p>
    </div>
  <% } else { %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <% banks.forEach(function (b) { %>
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border <%= b.is_active ? 'border-gray-100 dark:border-gray-700' : 'border-amber-300 dark:border-amber-700/50' %> p-5">
          <div class="flex items-start gap-4">
            <div class="w-20 h-20 rounded-xl bg-gray-100 dark:bg-gray-700 flex items-center justify-center flex-shrink-0 overflow-hidden">
              <% if (b.qr_path) { %>
                <img src="<%= b.qr_path %>" alt="<%= currentLang === 'km' ? b.name_kh : b.name_en %> QR" class="w-full h-full object-contain">
              <% } else { %>
                <i class="bi bi-image text-gray-300 dark:text-gray-600"></i>
              <% } %>
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex items-start justify-between gap-2 mb-1">
                <p class="font-semibold text-gray-900 dark:text-gray-100 text-sm"><%= currentLang === 'km' ? b.name_kh : b.name_en %></p>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 text-[11px] font-bold rounded-full flex-shrink-0 <%= b.is_active ? 'bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300' : 'bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300' %>">
                  <span class="w-1.5 h-1.5 rounded-full <%= b.is_active ? 'bg-emerald-500' : 'bg-amber-500' %>"></span>
                  <%= b.is_active ? (currentLang === 'km' ? 'សកម្ម' : 'Active') : (currentLang === 'km' ? 'មិនសកម្ម' : 'Inactive') %>
                </span>
              </div>
              <% if (b.account_name) { %>
                <p class="text-xs text-gray-500 dark:text-gray-400 truncate"><i class="bi bi-person-badge mr-1"></i><%= b.account_name %></p>
              <% } %>
              <% if (b.account_number) { %>
                <p class="text-xs text-gray-500 dark:text-gray-400 truncate"><i class="bi bi-credit-card mr-1"></i><%= b.account_number %></p>
              <% } %>
              <p class="text-xs text-gray-400 dark:text-gray-500 mt-1">
                <i class="bi bi-sort-down mr-1"></i><%= currentLang === 'km' ? 'លំដាប់' : 'Order' %>: <%= b.sort_order %>
                <% if (usedBy[b.id]) { %>
                  · <i class="bi bi-receipt mr-1"></i><%= usedBy[b.id] %> <%= currentLang === 'km' ? 'ការទូទាត់' : 'payments' %>
                <% } %>
              </p>
            </div>
          </div>

          <% if (b.instructions) { %>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-3 bg-gray-50 dark:bg-gray-800/60 rounded-lg px-3 py-2"><%= b.instructions %></p>
          <% } %>

          <div class="flex items-center gap-1.5 flex-wrap mt-4 pt-3 border-t border-gray-100 dark:border-gray-700">
            <button type="button" onclick="document.getElementById('bank-<%= b.id %>').classList.toggle('hidden')" class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-emerald-200 text-emerald-600 dark:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-900/20 transition-all flex items-center gap-1"><i class="bi bi-pencil"></i><%= currentLang === 'km' ? 'កែ' : 'Edit' %></button>
            <form action="/admin/payment-banks/<%= b.id %>/toggle" method="POST" class="inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="px-3 py-1.5 rounded-lg text-xs font-semibold border transition-all flex items-center gap-1 <%= b.is_active ? 'border-orange-200 text-orange-600 hover:bg-orange-50 dark:hover:bg-orange-900/20' : 'border-emerald-200 text-emerald-600 dark:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-900/20' %>">
                <i class="bi <%= b.is_active ? 'bi-pause-circle' : 'bi-play-circle' %>"></i>
                <%= b.is_active ? (currentLang === 'km' ? 'បិទ' : 'Off') : (currentLang === 'km' ? 'បើក' : 'On') %>
              </button>
            </form>
            <form action="/admin/payment-banks/<%= b.id %>/delete" method="POST" class="inline" data-confirm-delete="<%= currentLang === 'km' ? 'តើត្រូវលុបធនាគារនេះទេ?' : 'Delete this bank?' %>">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-red-200 text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 transition-all flex items-center gap-1"><i class="bi bi-trash"></i><%= currentLang === 'km' ? 'លុប' : 'Delete' %></button>
            </form>
          </div>

          <form id="bank-<%= b.id %>" action="/admin/payment-banks/<%= b.id %>" method="POST" enctype="multipart/form-data" class="hidden mt-4 pt-4 border-t border-gray-100 dark:border-gray-700 space-y-3">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-medium text-gray-600 dark:text-gray-300 mb-1"><%= currentLang === 'km' ? 'ឈ្មោះធនាគារ (ខ្មែរ)' : 'Bank name (Khmer)' %></label>
                <input type="text" name="name_kh" value="<%= b.name_kh %>" maxlength="120" class="w-full px-3 py-2 border border-gray-200 dark:border-gray-700 rounded-lg text-sm bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-emerald-500 outline-none">
              </div>
              <div>
                <label class="block text-xs font-medium text-gray-600 dark:text-gray-300 mb-1"><%= currentLang === 'km' ? 'ឈ្មោះធនាគារ (អង់គ្លេស)' : 'Bank name (English)' %></label>
                <input type="text" name="name_en" value="<%= b.name_en %>" maxlength="120" class="w-full px-3 py-2 border border-gray-200 dark:border-gray-700 rounded-lg text-sm bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-emerald-500 outline-none">
              </div>
              <div>
                <label class="block text-xs font-medium text-gray-600 dark:text-gray-300 mb-1"><%= currentLang === 'km' ? 'ឈ្មោះអាជីវកម្ម' : 'Account name' %></label>
                <input type="text" name="account_name" value="<%= b.account_name || '' %>" maxlength="160" class="w-full px-3 py-2 border border-gray-200 dark:border-gray-700 rounded-lg text-sm bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-emerald-500 outline-none">
              </div>
              <div>
                <label class="block text-xs font-medium text-gray-600 dark:text-gray-300 mb-1"><%= currentLang === 'km' ? 'លេខគណនី' : 'Account number' %></label>
                <input type="text" name="account_number" value="<%= b.account_number || '' %>" maxlength="80" class="w-full px-3 py-2 border border-gray-200 dark:border-gray-700 rounded-lg text-sm bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-emerald-500 outline-none">
              </div>
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-600 dark:text-gray-300 mb-1"><%= currentLang === 'km' ? 'ក្រាមដែន' : 'Sort order' %> <span class="text-gray-400 font-normal">(<%= currentLang === 'km' ? 'លេខតូចបំផុតបង្ហាញមុន' : 'lower shows first' %>)</span></label>
              <input type="number" name="sort_order" value="<%= b.sort_order %>" class="w-24 px-3 py-2 border border-gray-200 dark:border-gray-700 rounded-lg text-sm bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-emerald-500 outline-none">
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-600 dark:text-gray-300 mb-1"><%= currentLang === 'km' ? 'ក្រាមដែនបន្ទាន់' : 'Instructions' %></label>
              <textarea name="instructions" rows="2" maxlength="2000" class="w-full px-3 py-2 border border-gray-200 dark:border-gray-700 rounded-lg text-sm bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-emerald-500 outline-none"><%= b.instructions || '' %></textarea>
            </div>
            <div class="flex flex-col sm:flex-row sm:items-center gap-3">
              <div class="flex-1">
                <label class="block text-xs font-medium text-gray-600 dark:text-gray-300 mb-1"><%= currentLang === 'km' ? 'រូបភាព QR ថ្មី' : 'New QR image' %> <span class="text-gray-400 font-normal">(<%= currentLang === 'km' ? 'ទុកទទេដើម្បីប្រើរូបភាពដដែល' : 'leave blank to keep the current one' %>)</span></label>
                <input type="file" name="qr_file" accept=".jpg,.jpeg,.png,.pdf" class="w-full text-xs text-gray-600 dark:text-gray-300 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-2">
              </div>
              <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300 flex-shrink-0">
                <input type="checkbox" name="is_active" value="1" <%= b.is_active ? 'checked' : '' %> class="w-4 h-4 text-emerald-600 rounded">
                <%= currentLang === 'km' ? 'សកម្ម' : 'Active' %>
              </label>
            </div>
            <button type="submit" class="w-full sm:w-auto px-5 py-2 bg-gradient-to-r from-emerald-600 to-teal-500 text-white rounded-lg text-sm font-semibold hover:from-emerald-700 hover:to-teal-600 transition-all shadow-sm flex items-center justify-center gap-1.5">
              <i class="bi bi-check-lg"></i><%= currentLang === 'km' ? 'រក្សាទុក' : 'Save changes' %>
            </button>
          </form>
        </div>
      <% }); %>
    </div>
  <% } %>

  <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700">
    <div class="px-6 py-4 border-b border-gray-100 dark:border-gray-700 flex items-center gap-2.5">
      <div class="w-8 h-8 bg-emerald-100 dark:bg-emerald-900/40 rounded-lg flex items-center justify-center">
        <i class="bi bi-plus-circle text-emerald-600 dark:text-emerald-400 text-sm"></i>
      </div>
      <span class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'បញ្ចូលធនាគារថ្មី' : 'Add a new bank' %></span>
    </div>
    <form action="/admin/payment-banks" method="POST" enctype="multipart/form-data" class="p-6 space-y-5">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'ឈ្មោះធនាគារ (ខ្មែរ)' : 'Bank name (Khmer)' %></label>
          <input type="text" name="name_kh" maxlength="120" placeholder="<%= currentLang === 'km' ? 'ឧ. ធនាគារពន្ធដារ' : 'e.g. Canadia Bank' %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-emerald-500 outline-none">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'ឈ្មោះធនាគារ (អង់គ្លេស)' : 'Bank name (English)' %></label>
          <input type="text" name="name_en" maxlength="120" placeholder="<%= currentLang === 'km' ? 'ឧ. Canadia Bank' : 'e.g. Canadia Bank' %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-emerald-500 outline-none">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'ឈ្មោះអាជីវកម្ម' : 'Account name' %></label>
          <input type="text" name="account_name" maxlength="160" placeholder="<%= currentLang === 'km' ? 'ឧ. ហុ្គល្គង' : 'e.g. National Meanchey University' %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-emerald-500 outline-none">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'លេខគណនី' : 'Account number' %></label>
          <input type="text" name="account_number" maxlength="80" placeholder="<%= currentLang === 'km' ? 'ឧ. 0001 2345 6789' : 'e.g. 0001 2345 6789' %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-emerald-500 outline-none">
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'ក្រាមដែន' : 'Sort order' %> <span class="text-gray-400 font-normal text-xs">(<%= currentLang === 'km' ? 'លេខតូចបំផុតបង្ហាញមុន' : 'lower shows first' %>)</span></label>
        <input type="number" name="sort_order" value="0" class="w-32 px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-emerald-500 outline-none">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'ក្រាមដែនបន្ទាន់' : 'Instructions for students' %></label>
        <textarea name="instructions" rows="2" maxlength="2000" placeholder="<%= currentLang === 'km' ? 'ឧ. ស្កេនកូដ QR ដោយកម្មវិធីធនាគារកម្មវិធី...' : 'e.g. Scan the QR with any Cambodia QR app, then upload your slip.' %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-emerald-500 outline-none"></textarea>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'រូបភាព QR' : 'QR image' %> <span class="text-red-500">*</span></label>
        <input type="file" name="qr_file" required accept=".jpg,.jpeg,.png,.pdf" class="w-full text-sm text-gray-600 dark:text-gray-300 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-2.5">
        <p class="text-xs text-gray-400 dark:text-gray-500 mt-1"><%= currentLang === 'km' ? 'JPG, PNG ឬ PDF។ ស្របក្បួរជាមួយ QR ពីធនាគារ។' : 'JPG, PNG or PDF. Best results with the QR straight from your bank.' %></p>
      </div>
      <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
        <input type="checkbox" name="is_active" value="1" checked class="w-4 h-4 text-emerald-600 rounded">
        <%= currentLang === 'km' ? 'សកម្ម (សិស្សឃើញភ្លាម)' : 'Active (visible to students immediately)' %>
      </label>
      <button type="submit" class="px-6 py-2.5 bg-gradient-to-r from-emerald-600 to-teal-500 text-white rounded-xl text-sm font-semibold hover:from-emerald-700 hover:to-teal-600 transition-all shadow-sm flex items-center gap-1.5">
        <i class="bi bi-plus-lg"></i><%= currentLang === 'km' ? 'បញ្ចូលធនាគារ' : 'Add bank' %>
      </button>
    </form>
  </div>
</div>