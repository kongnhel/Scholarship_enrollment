<%
  // Shared by two flows: "reset" (an existing account) and "created" (a brand new one
  // provisioned from /admin/users). Defaults to reset so an unpassed local still works.
  var isCreated = (typeof mode !== 'undefined' && mode === 'created');
  var roleLabel = role === 'admin'
    ? (currentLang === 'km' ? 'អ្នកគ្រប់គ្រង' : 'Administrator')
    : role === 'committee'
      ? (currentLang === 'km' ? 'អ្នកគ្រប់គ្រងទី២' : 'Committee')
      : (currentLang === 'km' ? 'សិស្ស' : 'Student');
%>
<div class="max-w-3xl mx-auto space-y-6">
  <div class="relative overflow-hidden rounded-3xl bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 shadow-sm">
    <div class="absolute top-0 right-0 w-40 h-40 bg-blue-50 dark:bg-blue-900/20 rounded-bl-[6rem] -mr-10 -mt-10"></div>
    <div class="relative px-6 py-5 flex items-center gap-4 border-b border-gray-100 dark:border-gray-700">
      <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-sky-500 rounded-2xl flex items-center justify-center shadow-lg shadow-blue-600/30 flex-shrink-0">
        <i class="<%= isCreated ? 'bi bi-person-plus' : 'bi bi-key' %> text-white text-xl"></i>
      </div>
      <div class="min-w-0">
        <h1 class="text-xl font-bold text-gray-900 dark:text-gray-100">
          <%= isCreated
            ? (currentLang === 'km' ? 'បានបង្កើតអ្នកប្រើប្រាស់' : 'User Created')
            : (currentLang === 'km' ? 'កំណត់ពាក្យមេងឡើងវិញ' : 'Password Reset') %>
        </h1>
        <p class="text-sm text-gray-500 dark:text-gray-400 truncate"><%= email %> &middot; <%= roleLabel %></p>
      </div>
    </div>

    <div class="p-6 space-y-5">
      <div class="rounded-2xl border border-amber-200 bg-amber-50 dark:bg-amber-900/20 dark:border-amber-800 p-4">
        <div class="flex items-start gap-3">
          <i class="bi bi-exclamation-triangle text-amber-600 dark:text-amber-400 text-lg mt-0.5"></i>
          <p class="text-sm text-amber-800 dark:text-amber-200">
            <%= isCreated
              ? (currentLang === 'km'
                ? 'ពាក្យសម្ងាត់នេះត្រូវបានបង្កើតដោយប្រព័ន្ធ សូមប្រគល់វាឲ្យអ្នកប្រើប្រាស់ភ្លាមៗ អ្នកប្រើប្រាស់អាចផ្លាស់ប្តូរវាបានបន្ទាប់ពីចូលប្រព័ន្ធលើកទីមួយ។'
                : 'This password was generated automatically. Send it to the new user now - they can change it after they first sign in.')
              : (currentLang === 'km'
                ? 'ពាក្យមេងនេះត្រូវបានបង្ហាញតែម្ដងប៉ុណ្ណោះ។ សូមចាក់ចូលទៅកាន់អ្នកប្រើប្រាស់ដើម្បីផ្ដល់វាមកភ្លាម។'
                : 'This password is shown only once. Copy it and send it to the user now - it cannot be retrieved later.') %>
          </p>
        </div>
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">
          <%= currentLang === 'km' ? 'ពាក្យមេង' : 'Password' %>
        </label>
        <div class="flex items-center gap-2">
          <input type="text" id="newPassword" readonly value="<%= newPassword %>"
                 class="flex-1 px-4 py-3 border border-gray-200 dark:border-gray-700 rounded-xl bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100 font-mono text-lg tracking-wider focus:border-green-500 focus:ring-2 focus:ring-green-500/20 outline-none"
                 onclick="this.select()">
          <button type="button" onclick="navigator.clipboard && navigator.clipboard.writeText(document.getElementById('newPassword').value)"
                  class="px-4 py-3 rounded-xl bg-green-600 hover:bg-green-700 text-white text-sm font-semibold transition-colors flex items-center gap-2 flex-shrink-0">
            <i class="bi bi-clipboard"></i><%= currentLang === 'km' ? 'ចម្លង' : 'Copy' %>
          </button>
        </div>
      </div>

      <% if (!isCreated) { %>
      <div class="rounded-2xl border border-gray-100 dark:border-gray-700 p-4">
        <p class="text-sm text-gray-600 dark:text-gray-300">
          <i class="bi bi-box-arrow-right text-gray-400"></i>
          <% if (revokedSessions > 0) { %>
            <%= currentLang === 'km'
              ? 'បានបញ្ហាចោលសម័យចូលច្រើន ' + revokedSessions + ' នៅលើគណនីនេះ។'
              : revokedSessions + ' active session(s) were signed out, including any on other devices.' %>
          <% } else { %>
            <%= currentLang === 'km'
              ? 'មិនទាន់រកឃើញសម័យចូលសកម្មណាស់សម្រាប់គណនីនេះទេ។'
              : 'No active sessions were found for this account.' %>
          <% } %>
        </p>
      </div>
      <% } %>

      <div class="flex flex-col sm:flex-row gap-3">
        <a href="/admin/users" class="px-5 py-2.5 bg-green-600 hover:bg-green-700 text-white rounded-xl text-sm font-semibold transition-colors inline-flex items-center justify-center gap-2">
          <i class="bi bi-arrow-left"></i><%= currentLang === 'km' ? 'ត្រឡប់ទៅបញ្ជីអ្នកប្រើប្រាស់' : 'Back to users' %>
        </a>
        <a href="/admin/dashboard" class="px-5 py-2.5 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-200 rounded-xl text-sm font-semibold transition-colors inline-flex items-center justify-center gap-2">
          <i class="bi bi-grid"></i><%= currentLang === 'km' ? 'ទំព័រព័ត៌មាន' : 'Dashboard' %>
        </a>
      </div>
    </div>
  </div>
</div>
