<%
  var kmDigitMap = { '0': '០', '1': '១', '2': '២', '3': '៣', '4': '៤', '5': '៥', '6': '៦', '7': '៧', '8': '៨', '9': '៩' };
  function toKh(str) { return String(str == null ? '' : str).replace(/[0-9]/g, function (d) { return kmDigitMap[d]; }); }
  function esc(s) {
    return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
  function v(x) { return (x === null || x === undefined || x === '') ? '—' : x; }

  var KHMER_MONTHS = ['មករា', 'កុម្ភៈ', 'មីនា', 'មេសា', 'ឧសភា', 'មិថុនា', 'កក្កដា', 'សីហា', 'កញ្ញា', 'តុលា', 'វិច្ឆិកា', 'ធ្នូ'];
  var EN_MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  function fmtDate(str, lang) {
    if (!str) return '—';
    var m = String(str).match(/^(\d{4})-(\d{2})-(\d{2})/);
    var y, mo, d;
    if (m) { y = parseInt(m[1], 10); mo = parseInt(m[2], 10); d = parseInt(m[3], 10); }
    else {
      var dt = new Date(str);
      if (isNaN(dt.getTime())) return '—';
      y = dt.getFullYear(); mo = dt.getMonth() + 1; d = dt.getDate();
    }
    if (lang === 'km') return toKh(d) + ' ' + (KHMER_MONTHS[mo - 1] || '') + ' ' + toKh(y);
    return d + ' ' + (EN_MONTHS[mo - 1] || '') + ' ' + y;
  }

  var STATUS_MAP = {
    pending: { km: 'រង់ចាំ', en: 'PENDING', pill: 'bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-300', dot: 'bg-yellow-500', txt: 'text-yellow-600 dark:text-yellow-400', line: 'border-yellow-400 dark:border-yellow-500' },
    under_review: { km: 'កំពុងពិនិត្យ', en: 'UNDER REVIEW', pill: 'bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300', dot: 'bg-blue-500', txt: 'text-blue-600 dark:text-blue-400', line: 'border-blue-400 dark:border-blue-500' },
    approved: { km: 'អនុម័ត', en: 'APPROVED', pill: 'bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300', dot: 'bg-green-500', txt: 'text-green-600 dark:text-green-400', line: 'border-green-400 dark:border-green-500' },
    rejected: { km: 'បដិសេធ', en: 'REJECTED', pill: 'bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300', dot: 'bg-red-500', txt: 'text-red-600 dark:text-red-400', line: 'border-red-400 dark:border-red-500' },
    correction_requested: { km: 'តម្រូវកែ', en: 'CORRECTION', pill: 'bg-orange-100 dark:bg-orange-900/30 text-orange-700 dark:text-orange-300', dot: 'bg-orange-500', txt: 'text-orange-600 dark:text-orange-400', line: 'border-orange-400 dark:border-orange-500' }
  };
  var STATUS_FALLBACK = { km: '—', en: '—', pill: 'bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300', dot: 'bg-gray-400', txt: 'text-gray-500 dark:text-gray-400', line: 'border-gray-300 dark:border-gray-600' };
  function statusInfo(s) {
    return STATUS_MAP[s] || Object.assign({}, STATUS_FALLBACK, { en: String(s || 'UNKNOWN').replace('_', ' ').toUpperCase() });
  }

  var TONES = {
    green: { head: 'bg-green-100 dark:bg-green-900/40', icon: 'text-green-600 dark:text-green-400', soft: 'bg-green-100 dark:bg-green-900/30' },
    purple: { head: 'bg-purple-100 dark:bg-purple-900/40', icon: 'text-purple-600 dark:text-purple-400', soft: 'bg-purple-100 dark:bg-purple-900/30' },
    emerald: { head: 'bg-emerald-100 dark:bg-emerald-900/40', icon: 'text-emerald-600 dark:text-emerald-400', soft: 'bg-emerald-100 dark:bg-emerald-900/30' },
    blue: { head: 'bg-blue-100 dark:bg-blue-900/40', icon: 'text-blue-600 dark:text-blue-400', soft: 'bg-blue-100 dark:bg-blue-900/30' },
    gray: { head: 'bg-gray-100 dark:bg-gray-900/40', icon: 'text-gray-600 dark:text-gray-400', soft: 'bg-gray-100 dark:bg-gray-700/60' },
    orange: { head: 'bg-orange-100 dark:bg-orange-900/40', icon: 'text-orange-600 dark:text-orange-400', soft: 'bg-orange-100 dark:bg-orange-900/30' }
  };

  function field(icon, labelKm, labelEn, value, toneKey) {
    var t = TONES[toneKey] || TONES.green;
    return '<div class="flex items-start gap-3">' +
      '<div class="w-8 h-8 rounded-full ' + t.soft + ' flex items-center justify-center flex-shrink-0"><i class="bi ' + icon + ' text-sm ' + t.icon + '"></i></div>' +
      '<div class="min-w-0"><p class="text-xs text-gray-400 dark:text-gray-500">' + esc(currentLang === 'km' ? labelKm : labelEn) + '</p>' +
      '<p class="text-sm font-medium text-gray-900 dark:text-gray-100 break-words">' + esc(value == null || value === '' ? '—' : value) + '</p></div>' +
      '</div>';
  }

  var a = application;
  var stInfo = statusInfo(a.status);
  var khmerName = [a.khmer_last_name, a.khmer_first_name].filter(Boolean).join(' ');
  var latinName = [a.english_first_name, a.english_last_name].filter(Boolean).join(' ');
  var genderText = a.gender === 'male' ? (currentLang === 'km' ? 'ប្រុស' : 'Male') : (a.gender === 'female' ? (currentLang === 'km' ? 'ស្រី' : 'Female') : '—');
  var addressText = a.current_address || [a.address_village, a.address_commune, a.address_district, a.address_province].filter(Boolean).join(', ');
  var photoSrc = a.photo_path || a.photo_3x4_path || '';

  var EDU_KH = {
    none: 'គ្មាន', primary: 'បឋមសិក្សា', lower_secondary: 'ឌីប្លូម', upper_secondary: 'បាក់ឌុប',
    higher_education: 'ឧត្តមសិក្សា', bachelor: 'បរិញ្ញាបត្រ', master: 'អនុបណ្ឌិត', phd: 'បណ្ឌិត'
  };
  var LEVEL_KH = { bachelor: 'បរិញ្ញាបត្រ', associate: 'បរិញ្ញាបត្ររង', master: 'អនុបណ្ឌិត', phd: 'បណ្ឌិត' };
  var PERIOD_KH = { mon_fri: 'ចន្ទ-សុក្រ', sat_sun: 'សៅរ៍-អាទិត្យ' };
  var SHIFT_KH = { morning: 'ព្រឹក', afternoon: 'រសៀល' };
  var eduText = EDU_KH[a.education_level] || a.education_level || '—';
  var studyInfo = [LEVEL_KH[a.study_level] || a.study_level, PERIOD_KH[a.study_period] || a.study_period, SHIFT_KH[a.study_shift] || a.study_shift]
    .filter(Boolean).join(' · ') || '—';

  var optVal = a.scholarship_option ? String(a.scholarship_option) : '';
  var optParts = optVal.split('/');
  var optPct = optParts[0] || '';
  var optYears = optParts[1] || '';
  var optLabel = optPct ? (currentLang === 'km'
    ? toKh(optPct) + '%' + (optYears ? ' · ' + toKh(optYears) + ' ឆ្នាំ' : '')
    : optPct + '%' + (optYears ? ' · ' + optYears + ' years' : '')) : '';
%>

<div class="max-w-7xl mx-auto space-y-6">
  <!-- ================= HERO ================= -->
  <div class="relative overflow-hidden rounded-3xl bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 shadow-sm">
    <div class="absolute top-0 right-0 w-40 h-40 bg-green-50 dark:bg-green-900/20 rounded-bl-[6rem] -mr-10 -mt-10"></div>
    <div class="relative px-6 py-5 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
      <div class="min-w-0 flex-1">
      <div class="flex items-center gap-4 min-w-0">
        <a href="/admin/applications" class="px-4 py-2 border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-400 rounded-xl text-sm font-medium hover:bg-gray-50 dark:hover:bg-gray-700 hover:text-gray-900 dark:hover:text-white transition-all flex items-center gap-1.5 flex-shrink-0">
          <i class="bi bi-arrow-left"></i><%= currentLang === 'km' ? 'ត្រឡប់' : 'Back' %>
        </a>
        <% if (photoSrc) { %>
          <div class="w-16 h-20 rounded-2xl overflow-hidden border-2 border-white dark:border-gray-700 shadow-md flex-shrink-0 cursor-zoom-in ring-2 ring-green-500/40 doc-preview-btn" data-doc-src="<%= photoSrc %>" data-doc-title="<%= currentLang === 'km' ? 'រូបថត 4x6' : 'Photo 4x6' %>" title="<%= currentLang === 'km' ? 'មើលរូប' : 'View photo' %>">
            <img src="<%= photoSrc %>" alt="photo" class="w-full h-full object-cover">
          </div>
        <% } else { %>
          <div class="w-16 h-20 bg-gradient-to-br from-green-500 to-emerald-600 rounded-2xl flex items-center justify-center shadow-md flex-shrink-0">
            <i class="bi bi-person text-white text-2xl"></i>
          </div>
        <% } %>
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-2 mb-1">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full bg-green-100 dark:bg-green-900/40 text-green-700 dark:text-green-300 text-xs font-bold">#<%= a.id %></span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold <%= stInfo.pill %>">
              <span class="w-1.5 h-1.5 rounded-full <%= stInfo.dot %>"></span><%= currentLang === 'km' ? stInfo.km : stInfo.en %>
            </span>
          </div>
          <h1 class="text-xl font-bold text-gray-900 dark:text-gray-100 truncate"><%= currentLang === 'km' ? khmerName : (latinName || khmerName) %></h1>
          <p class="text-sm text-gray-500 dark:text-gray-400 truncate">
            <%= currentLang === 'km' ? (latinName || '—') : khmerName %>
            <% if (a.user_email) { %><span class="mx-1.5">·</span><i class="bi bi-envelope"></i> <%= a.user_email %><% } %>
          </p>
        </div>
      </div>
      <!-- កាលបរិច្ឆេទប្រឡង -->
      <div class="flex flex-wrap items-center gap-2 mt-3">
        <% if (optLabel && a.scholarship_name_kh) { %>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 text-xs font-bold max-w-full">
            <i class="bi bi-star-fill flex-shrink-0"></i><span class="min-w-0" style="overflow-wrap:anywhere;max-width:100%"><%= currentLang === 'km' ? a.scholarship_name_kh : (a.scholarship_name_en || a.scholarship_name_kh) %> · <%= optLabel %></span>
          </span>
        <% } %>
        <% if (a.submitted_at) { %>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-gray-50 dark:bg-gray-900/60 text-gray-600 dark:text-gray-300 text-xs font-medium">
            <i class="bi bi-clock"></i><%= currentLang === 'km' ? 'ដាក់ស្នើ ' : 'Submitted ' %><%= fmtDate(a.submitted_at, currentLang) %>
          </span>
        <% } %>
        <% if (a.phone) { %>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-gray-50 dark:bg-gray-900/60 text-gray-600 dark:text-gray-300 text-xs font-medium">
            <i class="bi bi-phone"></i><%= a.phone %>
          </span>
        <% } %>
      </div>
      </div>
      <a href="/admin/applications/<%= a.id %>/print" target="_blank" class="px-5 py-2.5 bg-gradient-to-r from-green-600 to-emerald-500 text-white rounded-xl text-sm font-semibold hover:from-green-700 hover:to-emerald-600 transition-all shadow-sm flex items-center gap-2 self-start lg:self-auto flex-shrink-0">
        <i class="bi bi-printer"></i><%= currentLang === 'km' ? 'បោះពុម្ព' : 'Print' %>
      </a>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-6">
      <!-- Personal -->
      <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
        <div class="px-6 py-3.5 border-b border-gray-100 dark:border-gray-700 flex items-center gap-2.5">
          <div class="w-8 h-8 bg-green-100 dark:bg-green-900/40 rounded-lg flex items-center justify-center">
            <i class="bi bi-person text-green-600 dark:text-green-400 text-sm"></i>
          </div>
          <span class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ព័ត៌មានផ្ទាល់ខ្លួន' : 'Personal Information' %></span>
        </div>
        <div class="p-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-3.5">
              <%- field('bi-person', 'ឈ្មោះខ្មែរ', 'Khmer Name', [a.khmer_last_name, a.khmer_first_name].filter(Boolean).join(' ') || '—', 'green') %>
              <%- field('bi-translate', 'ឈ្មោះអង់គ្លេស', 'English Name', latinName || '—', 'green') %>
              <%- field('bi-gender-ambiguous', 'ភេទ', 'Gender', genderText, 'green') %>
              <%- field('bi-calendar-heart', 'ថ្ងៃខែឆ្នាំកំណើត', 'Date of Birth', fmtDate(a.date_of_birth, currentLang), 'green') %>
              <%- field('bi-geo-alt', 'ទីកន្លែងកំណើត', 'Place of Birth', a.birth_place || '—', 'green') %>
              <%- field('bi-flag', 'សញ្ជាតិ', 'Nationality', a.nationality || (currentLang === 'km' ? 'ខ្មែរ' : 'Cambodian'), 'green') %>
            </div>
            <div class="space-y-3.5">
              <%- field('bi-phone', 'ទូរស័ព្ទ', 'Phone', a.phone || '—', 'green') %>
              <%- field('bi-house', 'អាស័យដ្ឋាន', 'Address', addressText || '—', 'green') %>
              <%- field('bi-person-vcard', 'ឪពុកឈ្មោះ', "Father's Name", a.parent_name || '—', 'green') %>
              <%- field('bi-person-vcard', 'ម្ដាយឈ្មោះ', "Mother's Name", a.mother_name || '—', 'green') %>
              <%- field('bi-telephone', 'ទូរស័ព្ទអាណាព្យាបាល', 'Parent Phone', a.parent_phone || '—', 'green') %>
              <%- field('bi-briefcase', 'មុខរបរ', 'Occupation', a.occupation || '—', 'green') %>
            </div>
          </div>
        </div>
      </div>

      <!-- Education -->
      <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
        <div class="px-6 py-3.5 border-b border-gray-100 dark:border-gray-700 flex items-center gap-2.5">
          <div class="w-8 h-8 bg-purple-100 dark:bg-purple-900/40 rounded-lg flex items-center justify-center">
            <i class="bi bi-book text-purple-600 dark:text-purple-400 text-sm"></i>
          </div>
          <span class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ព័ត៌មានការសិក្សា' : 'Education' %></span>
        </div>
        <div class="p-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-3.5">
              <%- field('bi-building', 'សាលា', 'School', a.school_name || '—', 'purple') %>
              <%- field('bi-geo-alt', 'ខេត្ត/រាជធានី', 'Province', (currentLang === 'km' ? a.province_name_kh : a.province_name_en) || '—', 'purple') %>
              <%- field('bi-mortarboard', 'កម្រិតវប្បធម៌', 'Education Level', eduText, 'purple') %>
            </div>
            <div class="space-y-3.5">
              <%- field('bi-calendar-event', 'សម័យប្រឡង', 'Exam Session', a.exam_session || '—', 'purple') %>
              <%- field('bi-geo-alt2', 'មណ្ឌលប្រឡង', 'Exam Center', a.exam_center || '—', 'purple') %>
              <%- field('bi-bar-chart', 'លទ្ធផលប្រឡង', 'Exam Result', a.exam_result || '—', 'purple') %>
              <%- field('bi-calendar-check', 'ឆ្នាំបញ្ចប់', 'Graduation Year', a.graduation_year || '—', 'purple') %>
            </div>
          </div>
        </div>
      </div>

      <!-- Scholarship -->
      <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
        <div class="px-6 py-3.5 border-b border-gray-100 dark:border-gray-700 flex items-center gap-2.5">
          <div class="w-8 h-8 bg-emerald-100 dark:bg-emerald-900/40 rounded-lg flex items-center justify-center">
            <i class="bi bi-star text-emerald-600 dark:text-emerald-400 text-sm"></i>
          </div>
          <span class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ព័ត៌មានអាហារូបករណ៍' : 'Scholarship' %></span>
        </div>
        <div class="p-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-3.5">
              <%- field('bi-1-circle', 'ជម្រើសទី ១', 'First Choice', (currentLang === 'km' ? a.major_name_kh : a.major_name_en) || '—', 'emerald') %>
              <%- field('bi-2-circle', 'ជម្រើសទី ២', 'Second Choice', (currentLang === 'km' ? (a.major2_name_kh || '—') : (a.major2_name_en || '—')), 'emerald') %>
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-full bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center flex-shrink-0"><i class="bi bi-mortarboard text-emerald-600 dark:text-emerald-400 text-sm"></i></div>
                <div class="min-w-0">
                  <p class="text-xs text-gray-400 dark:text-gray-500"><%= currentLang === 'km' ? 'កម្មវិធីអាហារូបករណ៍' : 'Scholarship Program' %></p>
                  <p class="text-sm font-medium text-gray-900 dark:text-gray-100 break-words"><%= currentLang === 'km' ? (a.scholarship_name_kh || '—') : (a.scholarship_name_en || a.scholarship_name_kh || '—') %></p>
                  <% if (optLabel || a.scholarship_provider) { %>
                  <p class="text-xs text-gray-400 dark:text-gray-500 break-words"><% if (optLabel) { %><%= optLabel %><% } %><% if (optLabel && a.scholarship_provider) { %> · <% } %><% if (a.scholarship_provider) { %><%= a.scholarship_provider %><% } %></p>
                  <% } %>
                </div>
              </div>
            </div>
            <div class="space-y-3.5">
              <%- field('bi-tag', 'ប្រភេទ', 'Category', (currentLang === 'km' ? a.category_name_kh : a.category_name_en) || '—', 'emerald') %>
              <%- field('bi-percent', 'កម្រិតអាហារូបករណ៍', 'Scholarship Level', optLabel || '—', 'emerald') %>
              <%- field('bi-clock-history', 'កាលវិភាគសិក្សា', 'Study Schedule', studyInfo, 'emerald') %>
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-full bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center flex-shrink-0"><i class="bi bi-info-circle text-emerald-600 dark:text-emerald-400 text-sm"></i></div>
                <div>
                  <p class="text-xs text-gray-400 dark:text-gray-500"><%= currentLang === 'km' ? 'ស្ថានភាព' : 'Status' %></p>
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 mt-0.5 text-xs font-bold rounded-full <%= stInfo.pill %>">
                    <span class="w-1.5 h-1.5 rounded-full <%= stInfo.dot %>"></span><%= currentLang === 'km' ? stInfo.km : stInfo.en %>
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Documents -->
      <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
        <div class="px-6 py-3.5 border-b border-gray-100 dark:border-gray-700 flex items-center gap-2.5">
          <div class="w-8 h-8 bg-gray-100 dark:bg-gray-900/40 rounded-lg flex items-center justify-center">
            <i class="bi bi-files text-gray-600 dark:text-gray-400 text-sm"></i>
          </div>
          <span class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ឯកសារដែលបានបង្ហោះ' : 'Uploaded Documents' %></span>
        </div>
        <div class="p-6">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

            <% function renderDoc(docPath, label, iconClass, colorClass) { %>
              <div class="flex items-center gap-3 p-3 border border-gray-100 dark:border-gray-700 rounded-2xl hover:border-green-300 dark:hover:border-green-700 hover:bg-green-50/40 dark:hover:bg-green-900/10 transition-all">
                <% if (docPath) { %>
                  <% var isImg = /\.(jpg|jpeg|png|gif|webp)$/i.test(docPath); %>
                  <% if (isImg) { %>
                    <div class="doc-thumb relative w-14 h-14 rounded-xl overflow-hidden border-2 border-gray-200 dark:border-gray-600 shadow-sm cursor-pointer hover:shadow-lg hover:scale-105 hover:border-green-400 dark:hover:border-green-500 transition-all duration-200 flex-shrink-0" class="doc-preview-btn" data-doc-src="<%= docPath %>" data-doc-title="<%= label %>">
                      <img src="<%= docPath %>" alt="<%= label %>" class="w-full h-full object-cover">
                      <div class="absolute inset-0 bg-black/0 hover:bg-black/20 transition-all flex items-center justify-center">
                        <i class="bi bi-arrows-fullscreen text-white text-xs opacity-0 hover:opacity-100 drop-shadow-lg"></i>
                      </div>
                    </div>
                  <% } else { %>
                    <div class="w-14 h-14 rounded-xl bg-red-50 dark:bg-red-900/20 border-2 border-red-200 dark:border-red-800 flex items-center justify-center flex-shrink-0">
                      <i class="bi bi-file-earmark-pdf text-red-500 text-xl"></i>
                    </div>
                  <% } %>
                  <div class="min-w-0 flex-1">
                    <p class="text-sm font-semibold text-gray-900 dark:text-gray-100 truncate"><%= label %></p>
                    <p class="text-[11px] text-gray-400 dark:text-gray-500 truncate"><%= docPath.split('/').pop() %></p>
                  </div>
      <% if (isImg) { %>
      <button type="button" class="doc-preview-btn p-2 rounded-lg text-gray-400 hover:text-green-600 transition-colors" data-doc-src="<%= docPath %>" data-doc-title="<%= label %>" title="<%= label %>">
        <i class="bi bi-eye-fill text-lg"></i>
      </button>
      <% } else { %>
                    <a href="<%= docPath %>" target="_blank" class="p-2 rounded-lg text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-all flex-shrink-0" title="<%= currentLang === 'km' ? 'បើក' : 'Open' %>">
                      <i class="bi bi-box-arrow-up-right text-lg"></i>
                    </a>
                  <% } %>
                <% } else { %>
                  <div class="w-14 h-14 rounded-xl bg-gray-50 dark:bg-gray-700/30 border-2 border-dashed border-gray-200 dark:border-gray-700 flex items-center justify-center flex-shrink-0">
                    <i class="bi bi-dash text-gray-300 dark:text-gray-600"></i>
                  </div>
                  <div class="min-w-0 flex-1">
                    <p class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= label %></p>
                    <p class="text-xs text-gray-400 dark:text-gray-500"><%= currentLang === 'km' ? 'មិនទាន់បង្ហោះ' : 'Not uploaded' %></p>
                  </div>
                <% } %>
              </div>
            <% } %>

            <%- renderDoc(application.photo_path, (currentLang === 'km' ? 'រូបថត 4×6' : 'Photo 4x6'), 'bi-image', 'blue') %>
            <%- renderDoc(application.photo_3x4_path, (currentLang === 'km' ? 'រូបថត 3×4' : 'Photo 3x4'), 'bi-image', 'blue') %>
            <%- renderDoc(application.transcript_path, (currentLang === 'km' ? 'សំណុំបែបបទ' : 'Transcript'), 'bi-file-text', 'green') %>
            <%
              var extraDocs = (application.additional_documents_path || '').split(',').filter(Boolean);
              extraDocs.forEach(function(docUrl, di) {
            %>
              <%- renderDoc(docUrl, (currentLang === 'km' ? 'ឯកសារបន្ថែម' : 'Additional Document') + (extraDocs.length > 1 ? ' ' + (di + 1) : ''), 'bi-file-earmark', 'blue') %>
            <% }); %>

          </div>
        </div>
      </div>
    </div>

    <div class="space-y-6">
      <!-- Actions -->
      <% if (application.status === 'pending' || application.status === 'under_review') { %>
        <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
