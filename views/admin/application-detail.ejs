                  data-confirm-title="<%= currentLang === 'km' ? 'ស្នើកែប្រែ' : 'Request correction' %>"
                  data-confirm-type="info">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <p class="flex items-center gap-2 text-sm font-bold text-gray-900 dark:text-gray-100">
                <span class="w-7 h-7 rounded-lg bg-orange-100 dark:bg-orange-900/40 text-orange-600 dark:text-orange-400 flex items-center justify-center"><i class="bi bi-pencil"></i></span>
                <%= currentLang === 'km' ? 'ស្នើកែប្រែ' : 'Request Correction' %>
              </p>
              <div>
                <textarea name="correction_notes" placeholder="<%= currentLang === 'km' ? 'កំណត់សម្គាល់កែប្រែ...' : 'Correction notes...' %>" rows="2" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm resize-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-orange-500 focus:border-transparent outline-none" required></textarea>
              </div>
              <button type="submit" class="w-full px-4 py-2.5 bg-orange-500 hover:bg-orange-600 text-white rounded-xl text-sm font-bold transition-all shadow-sm flex items-center justify-center gap-2"><i class="bi bi-pencil-fill"></i><%= currentLang === 'km' ? 'ស្នើកែប្រែ' : 'Request Correction' %></button>
