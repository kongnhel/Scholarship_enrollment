<div class="max-w-7xl mx-auto space-y-6">
  <div class="relative overflow-hidden rounded-3xl bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 shadow-sm">
    <div class="absolute top-0 right-0 w-40 h-40 bg-green-50 dark:bg-green-900/20 rounded-bl-[6rem] -mr-10 -mt-10"></div>
    <div class="relative px-6 py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <a href="/admin/applications" class="px-4 py-2 border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-400 rounded-xl text-sm font-medium hover:bg-gray-50 dark:hover:bg-gray-700 hover:text-gray-900 dark:hover:text-white transition-all flex items-center gap-1.5 flex-shrink-0">
          <i class="bi bi-arrow-left"></i><%= currentLang === 'km' ? 'ត្រឡប់' : 'Back' %>
        </a>
        <div class="w-12 h-12 bg-gradient-to-br from-green-500 to-emerald-600 rounded-2xl flex items-center justify-center shadow-md shadow-green-500/20 flex-shrink-0">
          <i class="bi bi-file-earmark-text text-white text-xl"></i>
        </div>
        <div>
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-green-100 dark:bg-green-900/40 text-green-700 dark:text-green-300 text-xs font-bold mb-1">#<%= application.id %></div>
          <h1 class="text-xl font-bold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ពាក្យសុំ #' : 'Application #' %><%= application.id %></h1>
          <p class="text-sm text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'ព័ត៌មានលម្អិតនៃពាក្យសុំ' : 'Application details' %></p>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-6">
      <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
        <div class="px-6 py-3.5 border-b border-gray-100 dark:border-gray-700 flex items-center gap-2.5">
          <div class="w-8 h-8 bg-green-100 dark:bg-green-900/40 rounded-lg flex items-center justify-center">
            <i class="bi bi-person text-green-600 dark:text-green-400 text-sm"></i>
          </div>
          <span class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ព័ត៌មានផ្ទាល់ខ្លួន' : 'Personal Information' %></span>
        </div>
        <div class="p-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-3.5">
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-full bg-green-100 dark:bg-green-900/30 flex items-center justify-center flex-shrink-0"><i class="bi bi-person text-green-600 dark:text-green-400 text-sm"></i></div>
                <div>
                  <p class="text-xs text-gray-400 dark:text-gray-500"><%= currentLang === 'km' ? 'ឈ្មោះខ្មែរ' : 'Khmer Name' %></p>
                  <p class="text-sm font-medium text-gray-900 dark:text-gray-100"><%= application.khmer_first_name %> <%= application.khmer_last_name %></p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-full bg-green-100 dark:bg-green-900/30 flex items-center justify-center flex-shrink-0"><i class="bi bi-person text-green-600 dark:text-green-400 text-sm"></i></div>
                <div>
                  <p class="text-xs text-gray-400 dark:text-gray-500"><%= currentLang === 'km' ? 'ឈ្មោះអង់គ្លេស' : 'English Name' %></p>
                  <p class="text-sm font-medium text-gray-900 dark:text-gray-100"><%= application.english_first_name %> <%= application.english_last_name %></p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-full bg-green-100 dark:bg-green-900/30 flex items-center justify-center flex-shrink-0"><i class="bi bi-gender-ambiguous text-green-600 dark:text-green-400 text-sm"></i></div>
                <div>
                  <p class="text-xs text-gray-400 dark:text-gray-500"><%= currentLang === 'km' ? 'ភេទ' : 'Gender' %></p>
                  <p class="text-sm font-medium text-gray-900 dark:text-gray-100"><%= application.gender === 'male' ? (currentLang === 'km' ? 'ប្រុស' : 'Male') : (currentLang === 'km' ? 'ស្រី' : 'Female') %></p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-full bg-green-100 dark:bg-green-900/30 flex items-center justify-center flex-shrink-0"><i class="bi bi-calendar text-green-600 dark:text-green-400 text-sm"></i></div>
                <div>
                  <p class="text-xs text-gray-400 dark:text-gray-500"><%= currentLang === 'km' ? 'ថ្ងៃខែឆ្នាំកំណើត' : 'Date of Birth' %></p>
                  <p class="text-sm font-medium text-gray-900 dark:text-gray-100"><%= application.date_of_birth ? new Date(application.date_of_birth).toLocaleDateString() : '—' %></p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-full bg-green-100 dark:bg-green-900/30 flex items-center justify-center flex-shrink-0"><i class="bi bi-flag text-green-600 dark:text-green-400 text-sm"></i></div>
                <div>
                  <p class="text-xs text-gray-400 dark:text-gray-500"><%= currentLang === 'km' ? 'សញ្ជាតិ' : 'Nationality' %></p>
                  <p class="text-sm font-medium text-gray-900 dark:text-gray-100"><%= application.nationality || 'Cambodian' %></p>
                </div>
              </div>
            </div>
            <div class="space-y-3.5">
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-full bg-green-100 dark:bg-green-900/30 flex items-center justify-center flex-shrink-0"><i class="bi bi-phone text-green-600 dark:text-green-400 text-sm"></i></div>
                <div>
                  <p class="text-xs text-gray-400 dark:text-gray-500"><%= currentLang === 'km' ? 'ទូរស័ព្ទ' : 'Phone' %></p>
                  <p class="text-sm font-medium text-gray-900 dark:text-gray-100"><%= application.phone %></p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-full bg-green-100 dark:bg-green-900/30 flex items-center justify-center flex-shrink-0"><i class="bi bi-house text-green-600 dark:text-green-400 text-sm"></i></div>
                <div>
                  <p class="text-xs text-gray-400 dark:text-gray-500"><%= currentLang === 'km' ? 'អាស័យដ្ឋាន' : 'Address' %></p>
                  <p class="text-sm font-medium text-gray-900 dark:text-gray-100"><%= application.current_address || '—' %></p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
        <div class="px-6 py-3.5 border-b border-gray-100 dark:border-gray-700 flex items-center gap-2.5">
          <div class="w-8 h-8 bg-purple-100 dark:bg-purple-900/40 rounded-lg flex items-center justify-center">
            <i class="bi bi-book text-purple-600 dark:text-purple-400 text-sm"></i>
          </div>
          <span class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ព័ត៌មានការសិក្សា' : 'Education' %></span>
        </div>
        <div class="p-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-3.5">
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-full bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center flex-shrink-0"><i class="bi bi-building text-purple-600 dark:text-purple-400 text-sm"></i></div>
                <div>
                  <p class="text-xs text-gray-400 dark:text-gray-500"><%= currentLang === 'km' ? 'សាលា' : 'School' %></p>
                  <p class="text-sm font-medium text-gray-900 dark:text-gray-100"><%= application.school_name %></p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-full bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center flex-shrink-0"><i class="bi bi-geo-alt text-purple-600 dark:text-purple-400 text-sm"></i></div>
                <div>
                  <p class="text-xs text-gray-400 dark:text-gray-500"><%= currentLang === 'km' ? 'ខេត្ត' : 'Province' %></p>
                  <p class="text-sm font-medium text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? application.province_name_kh : application.province_name_en %></p>
                </div>
              </div>
            </div>
            <div class="space-y-3.5">
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-full bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center flex-shrink-0"><i class="bi bi-calendar-check text-purple-600 dark:text-purple-400 text-sm"></i></div>
                <div>
                  <p class="text-xs text-gray-400 dark:text-gray-500"><%= currentLang === 'km' ? 'ឆ្នាំបញ្ចប់' : 'Graduation Year' %></p>
                  <p class="text-sm font-medium text-gray-900 dark:text-gray-100"><%= application.graduation_year %></p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-full bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center flex-shrink-0"><i class="bi bi-bar-chart text-purple-600 dark:text-purple-400 text-sm"></i></div>
                <div>
                  <p class="text-xs text-gray-400 dark:text-gray-500"><%= currentLang === 'km' ? 'លទ្ធផលប្រឡង' : 'Exam Result' %></p>
                  <p class="text-sm font-medium text-gray-900 dark:text-gray-100"><%= application.exam_result || '—' %></p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
        <div class="px-6 py-3.5 border-b border-gray-100 dark:border-gray-700 flex items-center gap-2.5">
          <div class="w-8 h-8 bg-emerald-100 dark:bg-emerald-900/40 rounded-lg flex items-center justify-center">
            <i class="bi bi-star text-emerald-600 dark:text-emerald-400 text-sm"></i>
          </div>
          <span class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ព័ត៌មានអាហារូបករណ៍' : 'Scholarship' %></span>
        </div>
        <div class="p-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-3.5">
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-full bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center flex-shrink-0"><i class="bi bi-1-circle text-emerald-600 dark:text-emerald-400 text-sm"></i></div>
                <div>
                  <p class="text-xs text-gray-400 dark:text-gray-500"><%= currentLang === 'km' ? 'ជម្រើសទី ១' : 'First Choice' %></p>
                  <p class="text-sm font-medium text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? application.major_name_kh : application.major_name_en %></p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-full bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center flex-shrink-0"><i class="bi bi-2-circle text-emerald-600 dark:text-emerald-400 text-sm"></i></div>
                <div>
                  <p class="text-xs text-gray-400 dark:text-gray-500"><%= currentLang === 'km' ? 'ជម្រើសទី ២' : 'Second Choice' %></p>
                  <p class="text-sm font-medium text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? application.major2_name_kh : (application.major2_name_en || '—') %></p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-full bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center flex-shrink-0"><i class="bi bi-mortarboard text-emerald-600 dark:text-emerald-400 text-sm"></i></div>
                <div class="min-w-0">
                  <p class="text-xs text-gray-400 dark:text-gray-500"><%= currentLang === 'km' ? 'កម្មវិធីអាហារូបករណ៍' : 'Scholarship Program' %></p>
                  <p class="text-sm font-medium text-gray-900 dark:text-gray-100 break-words"><%= currentLang === 'km' ? (application.scholarship_name_kh || '—') : (application.scholarship_name_en || application.scholarship_name_kh || '—') %></p>
                  <% if (application.scholarship_percentage) { %>
                  <p class="text-xs text-gray-400 dark:text-gray-500 break-words"><%= application.scholarship_percentage %>% · <%= application.scholarship_duration %> <%= currentLang === 'km' ? 'ឆ្នាំ' : 'yrs' %><% if (application.scholarship_provider) { %> · <%= application.scholarship_provider %><% } %></p>
                  <% } %>
                </div>
              </div>
            </div>
            <div class="space-y-3.5">
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-full bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center flex-shrink-0"><i class="bi bi-tag text-emerald-600 dark:text-emerald-400 text-sm"></i></div>
                <div>
                  <p class="text-xs text-gray-400 dark:text-gray-500"><%= currentLang === 'km' ? 'ប្រភេទ' : 'Category' %></p>
                  <p class="text-sm font-medium text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? application.category_name_kh : application.category_name_en %></p>
                </div>
              </div>
              <%
                var optVal = application.scholarship_option ? String(application.scholarship_option) : '';
                var kmDigitMap = { '0': '០', '1': '១', '2': '២', '3': '៣', '4': '៤', '5': '៥', '6': '៦', '7': '៧', '8': '៨', '9': '៩' };
                var optParts = optVal.split('/');
                var optPct = optParts[0] || '';
                var optYears = optParts[1] || '';
                var optLabel = optPct ? (currentLang === 'km'
                  ? optPct.replace(/[0-9]/g, function (d) { return kmDigitMap[d]; }) + '%' + (optYears ? ' · ' + optYears.replace(/[0-9]/g, function (d) { return kmDigitMap[d]; }) + ' ឆ្នាំ' : '')
                  : optPct + '%' + (optYears ? ' · ' + optYears + ' years' : '')) : '';
              %>
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-full bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center flex-shrink-0"><i class="bi bi-percent text-emerald-600 dark:text-emerald-400 text-sm"></i></div>
                <div class="min-w-0">
                  <p class="text-xs text-gray-400 dark:text-gray-500"><%= currentLang === 'km' ? 'កម្រិតអាហារូបករណ៍' : 'Scholarship Level' %></p>
                  <p class="text-sm font-medium text-gray-900 dark:text-gray-100 break-words"><%= optLabel || '—' %></p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-full bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center flex-shrink-0"><i class="bi bi-info-circle text-emerald-600 dark:text-emerald-400 text-sm"></i></div>
                <div>
                  <p class="text-xs text-gray-400 dark:text-gray-500"><%= currentLang === 'km' ? 'ស្ថានភាព' : 'Status' %></p>
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-bold rounded-full <%= application.status === 'approved' ? 'bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300' : application.status === 'rejected' ? 'bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300' : application.status === 'pending' ? 'bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-300' : application.status === 'correction_requested' ? 'bg-orange-100 dark:bg-orange-900/30 text-orange-700 dark:text-orange-300' : 'bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300' %>">
                    <span class="w-1.5 h-1.5 rounded-full <%= application.status === 'approved' ? 'bg-green-500' : application.status === 'rejected' ? 'bg-red-500' : application.status === 'pending' ? 'bg-yellow-500' : application.status === 'correction_requested' ? 'bg-orange-500' : 'bg-blue-500' %>"></span>
                    <%= application.status === 'pending' ? (currentLang === 'km' ? 'រង់ចាំ' : 'PENDING') : application.status === 'approved' ? (currentLang === 'km' ? 'អនុម័ត' : 'APPROVED') : application.status === 'rejected' ? (currentLang === 'km' ? 'បដិសេធ' : 'REJECTED') : application.status === 'under_review' ? (currentLang === 'km' ? 'កំពុងពិនិត្យ' : 'REVIEW') : application.status === 'correction_requested' ? (currentLang === 'km' ? 'តម្រូវកែ' : 'CORRECT') : application.status.replace('_', ' ').toUpperCase() %>
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
        <div class="px-6 py-3.5 border-b border-gray-100 dark:border-gray-700 flex items-center gap-2.5">
          <div class="w-8 h-8 bg-gray-100 dark:bg-gray-900/40 rounded-lg flex items-center justify-center">
            <i class="bi bi-files text-gray-600 dark:text-gray-400 text-sm"></i>
          </div>
          <span class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ឯកសារដែលបានបង្ហោះ' : 'Uploaded Documents' %></span>
        </div>
        <div class="p-6">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

            <% function renderDoc(docPath, label, iconClass, colorClass) { %>
              <div class="flex items-center gap-3 p-3 border border-gray-100 dark:border-gray-700 rounded-xl hover:border-gray-300 dark:hover:border-gray-600 transition-all">
                <% if (docPath) { %>
                  <% var isImg = /\.(jpg|jpeg|png|gif|webp)$/i.test(docPath); %>
                  <% if (isImg) { %>
                    <div class="doc-thumb relative w-12 h-12 rounded-xl overflow-hidden border-2 border-gray-200 dark:border-gray-600 shadow-sm cursor-pointer hover:shadow-lg hover:scale-110 hover:border-green-400 dark:hover:border-green-500 transition-all duration-200 flex-shrink-0" onclick="openDocPreview('<%= docPath %>', '<%= label %>')">
                      <img src="<%= docPath %>" alt="<%= label %>" class="w-full h-full object-cover">
                      <div class="absolute inset-0 bg-black/0 hover:bg-black/20 transition-all flex items-center justify-center">
                        <i class="bi bi-arrows-fullscreen text-white text-xs opacity-0 hover:opacity-100 drop-shadow-lg"></i>
                      </div>
                    </div>
                  <% } else { %>
                    <div class="w-12 h-12 rounded-xl bg-red-50 dark:bg-red-900/20 border-2 border-red-200 dark:border-red-800 flex items-center justify-center flex-shrink-0">
                      <i class="bi bi-file-earmark-pdf text-red-500 text-lg"></i>
                    </div>
                  <% } %>
                  <div class="min-w-0 flex-1">
                    <p class="text-sm font-semibold text-gray-900 dark:text-gray-100 truncate"><%= label %></p>
                    <p class="text-xs text-gray-400 dark:text-gray-500 truncate"><%= docPath.split('/').pop() %></p>
                  </div>
                  <% if (isImg) { %>
                    <button onclick="openDocPreview('<%= docPath %>', '<%= label %>')" class="p-2 rounded-lg text-gray-400 hover:text-green-600 dark:hover:text-green-400 hover:bg-green-50 dark:hover:bg-green-900/20 transition-all flex-shrink-0" title="<%= currentLang === 'km' ? 'មើល' : 'Preview' %>">
                      <i class="bi bi-eye-fill text-lg"></i>
                    </button>
                  <% } else { %>
                    <a href="<%= docPath %>" target="_blank" class="p-2 rounded-lg text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-all flex-shrink-0" title="<%= currentLang === 'km' ? 'បើក' : 'Open' %>">
                      <i class="bi bi-box-arrow-up-right text-lg"></i>
                    </a>
                  <% } %>
                <% } else { %>
                  <div class="w-12 h-12 rounded-xl bg-gray-50 dark:bg-gray-700/30 border-2 border-dashed border-gray-200 dark:border-gray-700 flex items-center justify-center flex-shrink-0">
                    <i class="bi bi-dash text-gray-300 dark:text-gray-600"></i>
                  </div>
                  <div class="min-w-0 flex-1">
                    <p class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= label %></p>
                    <p class="text-xs text-gray-400 dark:text-gray-500"><%= currentLang === 'km' ? 'មិនទាន់បង្ហោះ' : 'Not uploaded' %></p>
                  </div>
                <% } %>
              </div>
            <% } %>

            <%- renderDoc(application.photo_path, (currentLang === 'km' ? 'រូបថត 4×6' : 'Photo 4x6'), 'bi-image', 'blue') %>
            <%- renderDoc(application.photo_3x4_path, (currentLang === 'km' ? 'រូបថត 3×4' : 'Photo 3x4'), 'bi-image', 'blue') %>
            <%- renderDoc(application.transcript_path, (currentLang === 'km' ? 'សំណុំបែបបទ' : 'Transcript'), 'bi-file-text', 'green') %>
            <%
              var extraDocs = (application.additional_documents_path || '').split(',').filter(Boolean);
              extraDocs.forEach(function(docUrl, di) {
            %>
              <%- renderDoc(docUrl, (currentLang === 'km' ? 'ឯកសារបន្ថែម' : 'Additional Document') + (extraDocs.length > 1 ? ' ' + (di + 1) : ''), 'bi-file-earmark', 'blue') %>
            <% }); %>

          </div>
        </div>
      </div>
    </div>

    <div class="space-y-6">
      <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
        <div class="px-6 py-3.5 border-b border-gray-100 dark:border-gray-700 flex items-center gap-2.5">
          <div class="w-8 h-8 bg-blue-100 dark:bg-blue-900/40 rounded-lg flex items-center justify-center">
            <i class="bi bi-clock-history text-blue-600 dark:text-blue-400 text-sm"></i>
          </div>
          <span class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ប្រវត្តិស្ថានភាព' : 'Status History' %></span>
        </div>
        <div class="p-6">
          <% if (history && history.length > 0) { %>
            <div class="space-y-4">
              <% history.forEach(function(h) { %>
                <div class="relative pl-4 border-l-2 border-green-500">
                  <div class="absolute -left-[5px] top-1 w-2 h-2 rounded-full bg-green-500"></div>
                  <p class="text-sm font-bold text-gray-800 dark:text-gray-100"><%= h.new_status.replace('_', ' ').toUpperCase() %></p>
                  <p class="text-xs text-gray-500 dark:text-gray-400"><%= h.notes || '—' %></p>
                  <p class="text-xs text-gray-400 dark:text-gray-500 mt-0.5">
                    <i class="bi bi-person"></i> <%= h.changed_by_name || 'System' %>
                    <span class="mx-1">·</span>
                    <i class="bi bi-clock"></i> <%= h.created_at ? new Date(h.created_at).toLocaleString() : '—' %>
                  </p>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <div class="flex flex-col items-center gap-2 py-4">
              <i class="bi bi-clock text-3xl text-gray-300 dark:text-gray-600"></i>
              <p class="text-sm text-gray-400 dark:text-gray-500"><%= currentLang === 'km' ? 'មិនមានប្រវត្តិ' : 'No history' %></p>
            </div>
          <% } %>
        </div>
      </div>

      <% if (application.status === 'pending' || application.status === 'under_review') { %>
        <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
          <div class="px-6 py-3.5 border-b border-gray-100 dark:border-gray-700 flex items-center gap-2.5">
            <div class="w-8 h-8 bg-green-100 dark:bg-green-900/40 rounded-lg flex items-center justify-center">
              <i class="bi bi-gear text-green-600 dark:text-green-400 text-sm"></i>
            </div>
            <span class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'សកម្មភាព' : 'Actions' %></span>
          </div>
          <div class="p-6 space-y-4">
            <% if (application.status === 'pending') { %>
              <form action="/admin/applications/<%= application.id %>/under-review" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="w-full px-4 py-2.5 bg-blue-500 text-white rounded-xl text-sm font-bold hover:bg-blue-600 transition-all flex items-center justify-center gap-2"><i class="bi bi-eye"></i><%= currentLang === 'km' ? 'ដាក់ក្រោមការពិនិត្យ' : 'Mark Under Review' %></button>
              </form>
              <hr class="border-gray-100 dark:border-gray-700">
            <% } %>

            <form action="/admin/applications/<%= application.id %>/approve" method="POST" class="space-y-3">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div>
                <textarea name="admin_remark" placeholder="<%= currentLang === 'km' ? 'កំណត់សម្គាល់អនុម័ត...' : 'Approval remark...' %>" rows="2" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm resize-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none"></textarea>
              </div>
              <div>
                <label class="block text-xs font-medium text-gray-600 dark:text-gray-300 mb-1"><%= currentLang === 'km' ? 'កាលបរិច្ឆេទប្រឡង' : 'Exam Date' %></label>
                <input type="date" name="exam_date" class="w-full px-4 py-2 border border-gray-200 dark:border-gray-700 rounded-xl text-sm bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none">
              </div>
              <div>
                <label class="block text-xs font-medium text-gray-600 dark:text-gray-300 mb-1"><%= currentLang === 'km' ? 'ម៉ោងប្រឡង' : 'Exam Time' %></label>
                <input type="time" name="exam_time" class="w-full px-4 py-2 border border-gray-200 dark:border-gray-700 rounded-xl text-sm bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none">
              </div>
              <div>
                <label class="block text-xs font-medium text-gray-600 dark:text-gray-300 mb-1"><%= currentLang === 'km' ? 'ទីកន្លែងប្រឡង' : 'Exam Venue' %></label>
                <input type="text" name="exam_venue" placeholder="<%= currentLang === 'km' ? 'ឧ. សាលប្រជុំ ABC' : 'e.g. Conference Hall ABC' %>" class="w-full px-4 py-2 border border-gray-200 dark:border-gray-700 rounded-xl text-sm bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none">
              </div>
              <button type="submit" class="w-full px-4 py-2.5 bg-gradient-to-r from-green-600 to-emerald-500 text-white rounded-xl text-sm font-bold hover:from-green-700 hover:to-emerald-600 transition-all shadow-sm flex items-center justify-center gap-2"><i class="bi bi-check-circle"></i><%= currentLang === 'km' ? 'អនុម័ត' : 'Approve' %></button>
            </form>

            <form action="/admin/applications/<%= application.id %>/reject" method="POST" class="space-y-3">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div>
                <textarea name="admin_remark" placeholder="<%= currentLang === 'km' ? 'មូលហេតុបដិសេធ...' : 'Rejection reason...' %>" rows="2" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm resize-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-red-500 focus:border-transparent outline-none" required></textarea>
              </div>
              <button type="submit" class="w-full px-4 py-2.5 bg-red-500 text-white rounded-xl text-sm font-bold hover:bg-red-600 transition-all shadow-sm flex items-center justify-center gap-2"><i class="bi bi-x-circle"></i><%= currentLang === 'km' ? 'បដិសេធ' : 'Reject' %></button>
            </form>

            <form action="/admin/applications/<%= application.id %>/correction" method="POST" class="space-y-3">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div>
                <textarea name="correction_notes" placeholder="<%= currentLang === 'km' ? 'កំណត់សម្គាល់កែប្រែ...' : 'Correction notes...' %>" rows="2" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm resize-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-orange-500 focus:border-transparent outline-none" required></textarea>
              </div>
              <button type="submit" class="w-full px-4 py-2.5 bg-orange-500 text-white rounded-xl text-sm font-bold hover:bg-orange-600 transition-all shadow-sm flex items-center justify-center gap-2"><i class="bi bi-pencil"></i><%= currentLang === 'km' ? 'ស្នើកែប្រែ' : 'Request Correction' %></button>
            </form>
          </div>
        </div>
      <% } %>

      <% if (application.admin_remark) { %>
        <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
          <div class="px-6 py-3.5 border-b border-gray-100 dark:border-gray-700 flex items-center gap-2.5">
            <div class="w-8 h-8 bg-orange-100 dark:bg-orange-900/40 rounded-lg flex items-center justify-center">
              <i class="bi bi-chat-dots text-orange-600 dark:text-orange-400 text-sm"></i>
            </div>
            <span class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'កំណត់សម្គាល់អ្នកគ្រប់គ្រង' : 'Admin Remark' %></span>
          </div>
          <div class="p-6">
            <p class="text-sm text-gray-600 dark:text-gray-300"><%= application.admin_remark %></p>
          </div>
        </div>
      <% } %>

      <% if (application.status === 'approved' && (application.exam_date || application.exam_time || application.exam_venue)) { %>
        <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
          <div class="px-6 py-3.5 border-b border-gray-100 dark:border-gray-700 flex items-center gap-2.5">
            <div class="w-8 h-8 bg-purple-100 dark:bg-purple-900/40 rounded-lg flex items-center justify-center">
              <i class="bi bi-calendar-check text-purple-600 dark:text-purple-400 text-sm"></i>
            </div>
            <span class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ព័ត៌មានប្រឡង' : 'Exam Information' %></span>
          </div>
          <div class="p-6 space-y-3 text-sm">
            <% if (application.exam_date) { %>
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center"><i class="bi bi-calendar text-purple-600 dark:text-purple-400"></i></div>
                <div>
                  <p class="text-xs text-gray-400 dark:text-gray-500"><%= currentLang === 'km' ? 'កាលបរិច្ឆេទ' : 'Date' %></p>
                  <p class="font-medium text-gray-900 dark:text-gray-100"><%= application.exam_date %></p>
                </div>
              </div>
            <% } %>
            <% if (application.exam_time) { %>
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center"><i class="bi bi-clock text-purple-600 dark:text-purple-400"></i></div>
                <div>
                  <p class="text-xs text-gray-400 dark:text-gray-500"><%= currentLang === 'km' ? 'ម៉ោង' : 'Time' %></p>
                  <p class="font-medium text-gray-900 dark:text-gray-100"><%= application.exam_time %></p>
                </div>
              </div>
            <% } %>
            <% if (application.exam_venue) { %>
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center"><i class="bi bi-geo-alt text-purple-600 dark:text-purple-400"></i></div>
                <div>
                  <p class="text-xs text-gray-400 dark:text-gray-500"><%= currentLang === 'km' ? 'ទីកន្លែង' : 'Venue' %></p>
                  <p class="font-medium text-gray-900 dark:text-gray-100"><%= application.exam_venue %></p>
                </div>
              </div>
            <% } %>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>

<div id="docPreviewModal" class="fixed inset-0 z-[9999] hidden items-center justify-center p-4" onclick="closeDocPreview()">
  <div class="absolute inset-0 bg-black/80 backdrop-blur-md transition-opacity"></div>
  <div class="relative max-w-5xl w-full transform transition-all" onclick="event.stopPropagation()">
    <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-2xl overflow-hidden border border-gray-200 dark:border-gray-700">
      <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 dark:border-gray-800">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-green-100 dark:bg-green-900/30 flex items-center justify-center"><i class="bi bi-image text-green-600 dark:text-green-400 text-sm"></i></div>
          <h5 id="docPreviewTitle" class="font-bold text-gray-900 dark:text-gray-100"></h5>
        </div>
        <div class="flex items-center gap-2">
          <a id="docPreviewLink" href="" target="_blank" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700 transition-all flex items-center gap-1.5"><i class="bi bi-box-arrow-up-right"></i><%= currentLang === 'km' ? 'បើកក្នុងTabថ្មី' : 'New tab' %></a>
          <button onclick="closeDocPreview()" class="w-8 h-8 rounded-full bg-gray-100 dark:bg-gray-800 flex items-center justify-center text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 hover:bg-gray-200 dark:hover:bg-gray-700 transition-all"><i class="bi bi-x-lg text-sm"></i></button>
        </div>
      </div>
      <div class="flex items-center justify-center bg-gray-50 dark:bg-gray-950 p-2" style="min-height: 200px; max-height: 72vh;">
        <img id="docPreviewImg" src="" class="max-w-full max-h-[70vh] object-contain rounded-lg shadow-sm">
      </div>
    </div>
  </div>
</div>

<script>
function openDocPreview(src, title) {
  var modal = document.getElementById('docPreviewModal');
  document.getElementById('docPreviewImg').src = src;
  document.getElementById('docPreviewTitle').textContent = title;
  document.getElementById('docPreviewLink').href = src;
  modal.classList.remove('hidden');
  modal.classList.add('flex');
  document.body.style.overflow = 'hidden';
}
function closeDocPreview() {
  var modal = document.getElementById('docPreviewModal');
  modal.classList.add('hidden');
  modal.classList.remove('flex');
  document.body.style.overflow = '';
}
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') closeDocPreview();
});
</script>