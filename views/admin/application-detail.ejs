              <button type="submit" class="w-full px-4 py-2.5 bg-red-500 hover:bg-red-600 text-white rounded-xl text-sm font-bold transition-all shadow-sm flex items-center justify-center gap-2"><i class="bi bi-x-circle-fill"></i><%= currentLang === 'km' ? 'បដិសេធ' : 'Reject' %></button>
            </form>

            <form action="/admin/applications/<%= application.id %>/correction" method="POST" class="space-y-3"
