                  <div class="absolute -left-[5px] top-1 w-2 h-2 rounded-full <%= hInfo.dot %>"></div>
                  <p class="text-sm font-bold <%= hInfo.txt %>"><%= currentLang === 'km' ? hInfo.km : String(h.new_status || '').replace('_', ' ').toUpperCase() %></p>
                  <p class="text-xs text-gray-500 dark:text-gray-400"><%= h.notes || '—' %></p>
                  <p class="text-xs text-gray-400 dark:text-gray-500 mt-0.5">
