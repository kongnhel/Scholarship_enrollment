            <div class="w-8 h-8 bg-green-100 dark:bg-green-900/40 rounded-lg flex items-center justify-center">
              <i class="bi bi-gear text-green-600 dark:text-green-400 text-sm"></i>
            </div>
            <span class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'សកម្មភាព' : 'Actions' %></span>
          </div>
          <div class="p-6 space-y-5">
