          <% } else { %>
            <div class="flex flex-col items-center gap-2 py-4">
              <i class="bi bi-clock text-3xl text-gray-300 dark:text-gray-600"></i>
              <p class="text-sm text-gray-400 dark:text-gray-500"><%= currentLang === 'km' ? 'មិនមានប្រវត្តិ' : 'No history' %></p>
            </div>
          <% } %>
        </div>
      </div>

      <% if (application.admin_remark) { %>
        <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
          <div class="px-6 py-3.5 border-b border-gray-100 dark:border-gray-700 flex items-center gap-2.5">
            <div class="w-8 h-8 bg-orange-100 dark:bg-orange-900/40 rounded-lg flex items-center justify-center">
              <i class="bi bi-chat-dots text-orange-600 dark:text-orange-400 text-sm"></i>
            </div>
            <span class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'កំណត់សម្គាល់អ្នកគ្រប់គ្រង' : 'Admin Remark' %></span>
