                    data-confirm-title="<%= currentLang === 'km' ? 'ដាក់ក្រោមការពិនិត្យ' : 'Mark under review' %>"
                    data-confirm-type="info">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="w-full px-4 py-2.5 bg-blue-500 hover:bg-blue-600 text-white rounded-xl text-sm font-bold transition-all flex items-center justify-center gap-2"><i class="bi bi-eye"></i><%= currentLang === 'km' ? 'ដាក់ក្រោមការពិនិត្យ' : 'Mark Under Review' %></button>
              </form>
            <% } %>

            <form action="/admin/applications/<%= application.id %>/approve" method="POST" class="space-y-3"
                  data-confirm="<%= currentLang === 'km' ? 'អនុម័តពាក្យសុំនេះ? សិស្សនឹងទទួលជំនួបតាមអ៊ីមែលភ្លាម ហើយមិនអាចបញ្ចប់វិញបានទេ។' : 'Approve this application? The student is emailed immediately and this cannot be undone.' %>"
                  data-confirm-title="<%= currentLang === 'km' ? 'អនុម័តពាក្យសុំ' : 'Approve application' %>">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <p class="flex items-center gap-2 text-sm font-bold text-gray-900 dark:text-gray-100">
                <span class="w-7 h-7 rounded-lg bg-green-100 dark:bg-green-900/40 text-green-600 dark:text-green-400 flex items-center justify-center"><i class="bi bi-check-circle"></i></span>
                <%= currentLang === 'km' ? 'អនុម័តពាក្យ' : 'Approve Application' %>
              </p>
              <div>
                <textarea name="admin_remark" placeholder="<%= currentLang === 'km' ? 'កំណត់សម្គាល់អនុម័ត...' : 'Approval remark...' %>" rows="2" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm resize-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none"></textarea>
              </div>
              <!-- <div>
                <label class="block text-xs font-medium text-gray-600 dark:text-gray-300 mb-1"><%= currentLang === 'km' ? 'កាលបរិច្ឆេទប្រឡង' : 'Exam Date' %></label>
                <input type="date" name="exam_date" class="w-full px-4 py-2 border border-gray-200 dark:border-gray-700 rounded-xl text-sm bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none">
              </div>
              <div>
                <label class="block text-xs font-medium text-gray-600 dark:text-gray-300 mb-1"><%= currentLang === 'km' ? 'ម៉ោងប្រឡង' : 'Exam Time' %></label>
                <input type="time" name="exam_time" class="w-full px-4 py-2 border border-gray-200 dark:border-gray-700 rounded-xl text-sm bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none">
              </div>
              <div>
                <label class="block text-xs font-medium text-gray-600 dark:text-gray-300 mb-1"><%= currentLang === 'km' ? 'ទីកន្លែងប្រឡង' : 'Exam Venue' %></label>
                <input type="text" name="exam_venue" placeholder="<%= currentLang === 'km' ? 'ឧ. សាលប្រជុំ ABC' : 'e.g. Conference Hall ABC' %>" class="w-full px-4 py-2 border border-gray-200 dark:border-gray-700 rounded-xl text-sm bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none">
              </div> -->
              <button type="submit" class="w-full px-4 py-2.5 bg-gradient-to-r from-green-600 to-emerald-500 text-white rounded-xl text-sm font-bold hover:from-green-700 hover:to-emerald-600 transition-all shadow-sm flex items-center justify-center gap-2"><i class="bi bi-check-circle-fill"></i><%= currentLang === 'km' ? 'អនុម័ត' : 'Approve' %></button>
            </form>

            <form action="/admin/applications/<%= application.id %>/reject" method="POST" class="space-y-3"
                  data-confirm="<%= currentLang === 'km' ? 'បដិសេធពាក្យសុំនេះ? សិស្សនឹងទទួលមូលហេតុតាមអ៊ីមែលភ្លាម។' : 'Reject this application? The reason below is emailed to the student immediately.' %>"
