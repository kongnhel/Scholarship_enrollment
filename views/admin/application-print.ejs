<%
  var a = application || {};

  var khmerDigitMap = { '0': '០', '1': '១', '2': '២', '3': '៣', '4': '៤', '5': '៥', '6': '៦', '7': '៧', '8': '៨', '9': '៩' };
  function toKhmerDigits(str) {
    return String(str == null ? '' : str).replace(/[0-9]/g, function(d) { return khmerDigitMap[d]; });
  }

  var KHMER_MONTHS = ['មករា', 'កុម្ភៈ', 'មីនា', 'មេសា', 'ឧសភា', 'មិថុនា', 'កក្កដា', 'សីហា', 'កញ្ញា', 'តុលា', 'វិច្ឆិកា', 'ធ្នូ'];

  // date of birth
  var dobDay = '', dobMonthKh = '', dobYear = '', dobShortKh = '';
  if (a.date_of_birth) {
    var dob = new Date(a.date_of_birth);
    if (!isNaN(dob.getTime())) {
      dobDay = dob.getDate();
      dobMonthKh = KHMER_MONTHS[dob.getMonth()] || '';
      dobYear = dob.getFullYear();
      dobShortKh = toKhmerDigits(dobDay) + ' ' + dobMonthKh + ' ' + toKhmerDigits(dobYear);
    }
  }

  // submitted date parts (signature dates)
  var subDayKh = '', subMonthKh = '', subYearKh = '', subBuddPrefix = '', subBuddDigit = '', subDayNum = '', subYearSuffix = '';
  if (a.submitted_at) {
    var sd = new Date(a.submitted_at);
    if (!isNaN(sd.getTime())) {
      subDayKh = toKhmerDigits(sd.getDate());
      subMonthKh = KHMER_MONTHS[sd.getMonth()] || '';
      subYearKh = toKhmerDigits(sd.getFullYear());
      var buddStr = String(sd.getFullYear() + 543);
      subBuddPrefix = toKhmerDigits(buddStr.slice(0, -1));
      subBuddDigit = toKhmerDigits(buddStr.slice(-1));
      subDayNum = toKhmerDigits(sd.getDate());
      subYearSuffix = toKhmerDigits(String(sd.getFullYear()).slice(-1));
    }
  }

  var genderKh = a.gender === 'male' ? 'ប្រុស' : (a.gender === 'female' ? 'ស្រី' : '');
  var khmerName = [a.khmer_last_name, a.khmer_first_name].filter(Boolean).join(' ');
  var englishName = [a.english_first_name, a.english_last_name].filter(Boolean).join(' ');

  // scholarship option combo stored as "p/y" (e.g. "100/4")
  var optParts = String(a.scholarship_option || '').split('/');
  var optPct = optParts[0] || '';
  var optYears = optParts[1] || '';
  var programKh = a.scholarship_name_kh || '';
  var studentType = a.scholarship_type_id
    ? (programKh || 'អាហារូបករណ៍') + (optPct ? ' ' + toKhmerDigits(optPct) + '%' : '') + (optYears ? ' · ' + toKhmerDigits(optYears) + 'ឆ្នាំ' : '')
    : 'បង់ថ្លៃ';

  var majorKh = a.major_name_kh || '';
  var levelText = a.study_level === 'bachelor' ? 'បរិញ្ញាបត្រ' : (a.study_level === 'associate' ? 'បរិញ្ញាបត្ររង' : (a.study_level || ''));
  var schoolProvince = a.province_name_kh || a.address_province || '';

  var EDUCATION_LEVEL_KH = {
    none: 'គ្មាន',
    primary: 'បឋមសិក្សា',
    lower_secondary: 'ឌីប្លូម',
    upper_secondary: 'បាក់ឌុប',
    higher_education: 'ឧត្តមសិក្សា',
    bachelor: 'បរិញ្ញាបត្រ',
    master: 'អនុបណ្ឌិត',
    phd: 'បណ្ឌិត'
  };
  var levelCultureText = EDUCATION_LEVEL_KH[a.education_level] || a.education_level || '';

  var loc = 'បន្ទាយមានជ័យ';
  var studyYearLabel = 'ឆ្នាំសិក្សា ' + toKhmerDigits(new Date().getFullYear()) + ' - ' + toKhmerDigits(new Date().getFullYear() + 1);

  function cb(on) {
    return 'khmer-checkbox' + (on ? ' checked' : '');
  }

  var photoSrc = a.photo_path || a.photo_3x4_path || '';
  var pobText = a.birth_place || [a.address_village, a.address_commune, a.address_district, a.address_province].filter(Boolean).join(' ');
%>
<!DOCTYPE html>
<html lang="km">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>សាកលវិទ្យាល័យជាតិមានជ័យ - Official A4 Forms</title>
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Khmer Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Battambang:wght@400;700&family=Moul&family=Siemreap&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <style>
    :root {
      --font-moul: 'Moul', 'Khmer OS Muol Light', serif;
      --font-body: 'Battambang', 'Khmer OS Battambang', 'Siemreap', sans-serif;
      --sig-height: 70px;
    }

    .font-moul {
      font-family: var(--font-moul);
    }

    .font-body {
      font-family: var(--font-body);
    }

    body {
      font-family: var(--font-body);
      background-color: #334155;
      color: #000;
      line-height: 1.9;
    }

    /* Uniform line spacing for the whole printable document */
    .a4-page,
    .a4-page * {
      line-height: 1.9 !important;
    }

    .a4-page {
      width: 210mm;
      height: 297mm;
      padding: 10mm 15mm;
      margin: 20px auto;
      background: white;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
      box-sizing: border-box;
      position: relative;
      overflow: hidden;
    }

    .dotted-line {
      border-bottom: 1px dotted #222;
      display: inline-block;
      min-width: 40px;
      padding: 0 4px;
      outline: none;
    }

    .dotted-line-full {
      width: 100%;
      border-bottom: 1px dotted #222;
      display: block;
      min-height: 22px;
      margin-top: 2px;
      outline: none;
    }

    .photo-box {
      width: 3.5cm;
      height: 4.5cm;
      border: 1px solid #000;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      font-weight: bold;
      background-color: #fafafa;
      overflow: hidden;
    }

    .photo-box-sm {
      width: 3.2cm;
      height: 4.2cm;
      border: 1px solid #000;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: bold;
      background-color: #fafafa;
      overflow: hidden;
    }

    .photo-box img,
    .photo-box-sm img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    [contenteditable="true"]:hover {
      background-color: #f0f9ff;
      cursor: text;
    }

    [contenteditable="true"]:focus {
      background-color: #e0f2fe;
      outline: 1px dashed #0284c7;
      border-radius: 2px;
    }

    .khmer-checkbox {
      width: 13px;
      height: 13px;
      border: 1px solid #000;
      display: inline-block;
      vertical-align: middle;
      margin-right: 4px;
      cursor: pointer;
      position: relative;
    }

    .khmer-checkbox.checked::after {
      content: "✓";
      position: absolute;
      top: -6px;
      left: 1px;
      font-size: 12px;
      font-weight: bold;
    }

    /* Dedicated clean signature space BELOW the titles */
    .signature-area {
      height: var(--sig-height);
      margin-top: 2px;
      margin-bottom: 2px;
      width: 100%;
    }

    /* Print media configurations */
    @page {
      size: A4 portrait;
      margin: 0;
    }

    @media print {
      body {
        background: white !important;
        padding: 0 !important;
        margin: 0 !important;
      }

      main {
        padding: 0 !important;
        margin: 0 !important;
      }

      .no-print {
        display: none !important;
      }

      .a4-page {
        margin: 0 !important;
        border: none !important;
        box-shadow: none !important;
        width: 210mm !important;
        height: 297mm !important;
        padding: 10mm 15mm !important;
        page-break-after: always;
        page-break-inside: avoid;
      }

      [contenteditable="true"]:hover,
      [contenteditable="true"]:focus {
        background-color: transparent !important;
        outline: none !important;
      }
    }
  </style>
</head>
<body>

  <header class="no-print sticky top-0 z-50 bg-slate-900 text-white shadow-lg px-4 py-3">
    <div class="max-w-6xl mx-auto flex flex-wrap justify-between items-center gap-3">
      <div class="flex items-center space-x-3">
        <i class="fa-solid fa-file-signature text-amber-400 text-xl"></i>
        <div>
          <h1 class="font-moul text-xs sm:text-sm">សាកលវិទ្យាល័យជាតិមានជ័យ</h1>
          <p class="text-[11px] text-slate-400">ពាក្យសុំអាហារូបករណ៍ - ទំព័របោះពុម្ព A4</p>
        </div>
      </div>

      <div class="flex items-center flex-wrap gap-3">
        <!-- Signature Height Control -->
        <div class="flex items-center gap-2 bg-slate-800 px-3 py-1.5 rounded text-xs border border-slate-700">
          <label for="sigSlider" class="text-slate-300">កម្ពស់ហត្ថលេខា (Signature Space):</label>
          <input type="range" id="sigSlider" min="40" max="120" value="70" oninput="updateSigHeight(this.value)" class="w-24 accent-amber-400 cursor-pointer">
          <span id="sigVal" class="w-8 text-amber-300 font-mono text-center">70px</span>
        </div>

        <a href="<%= (typeof backHref !== 'undefined' && backHref) ? backHref : '/admin/applications/' + a.id %>" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 border border-slate-600 rounded text-xs font-medium transition flex items-center gap-1.5 text-white no-underline">
          <i class="fa-solid fa-arrow-left text-amber-300"></i> ត្រឡប់
        </a>

        <button onclick="window.print()" class="px-4 py-1.5 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold rounded text-xs sm:text-sm shadow transition flex items-center gap-2">
          <i class="fa-solid fa-print"></i> បោះពុម្ព A4 (Print PDF)
        </button>
      </div>
    </div>
  </header>

  <main class="py-4">

    <!-- ================= PAGE 1 ================= -->
    <div class="a4-page font-body text-[13px] leading-relaxed flex flex-col justify-between">
      <div>
        <!-- Top Header -->
        <div class="grid grid-cols-12 gap-2 mb-2 items-start">
          <div class="col-span-5 text-center leading-snug">
            <h2 class="font-moul text-[11.5px]">ក្រសួងអប់រំ យុវជន និងកីឡា</h2>
            <h3 class="font-moul text-[10.5px]">សាកលវិទ្យាល័យជាតិមានជ័យ</h3>
          </div>
          <div class="col-span-4 text-center leading-snug">
            <h1 class="font-moul text-[12.5px]">ព្រះរាជាណាចក្រកម្ពុជា</h1>
            <h2 class="font-moul text-[10.5px] mt-0.5">ជាតិ សាសនា ព្រះមហាក្សត្រ</h2>
            <div class="flex justify-center mt-0.5">
              <svg width="70" height="7" viewBox="0 0 70 7" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M2 3.5C18 7 52 7 68 3.5" stroke="black" stroke-width="1" stroke-linecap="round"/>
              </svg>
            </div>
          </div>
          <div class="col-span-3 flex justify-end">
            <div class="photo-box">
              <% if (photoSrc) { %><img src="<%= photoSrc %>" alt="4x6"><% } else { %>4x6<% } %>
            </div>
          </div>
        </div>

        <!-- Document Title -->
        <div class="text-center my-1">
          <h2 class="font-moul text-[13px] tracking-wide mb-0.5">
            ពាក្យសុំចុះឈ្មោះចូលរៀនថ្នាក់ឆ្នាំសិក្សាមូលដ្ឋាន (ឆ្នាំទី១)
          </h2>
          <h3 class="font-moul text-[11.5px] mb-0.5">
            ជំនាន់ទី១៩ នៅសាកលវិទ្យាល័យជាតិមានជ័យ
          </h3>
          <p class="font-moul text-[11.5px] mb-0.5">
            <%= studyYearLabel %>
          </p>
          <div class="text-[12.5px] mt-1">
            <span>ជាសិស្សប្រភេទ</span>
            <span class="dotted-line min-w-[320px] text-center font-bold" contenteditable="true" id="p1_type"><%= studentType %><% if (a.scholarship_leader) { %> · ផ្ដល់ដោយ <%= a.scholarship_leader %><% } %></span>
          </div>
        </div>

        <!-- Section I -->
        <div class="mb-1">
          <h4 class="font-moul text-[11.5px] mb-1">I. ព័ត៌មាននិស្សិត</h4>
          <div class="pl-2 space-y-1">
            <div>
              <span>ខ្ញុំបាទ-នាងខ្ញុំឈ្មោះ</span>
              <span class="dotted-line min-w-[210px] text-center" contenteditable="true" id="p1_name_kh"><%= khmerName %></span>
              <span>អក្សរឡាតាំង</span>
              <span class="dotted-line min-w-[190px] text-center uppercase" contenteditable="true" id="p1_name_latin"><%= englishName %></span>
              <span>ភេទ</span>
              <span class="dotted-line min-w-[45px] text-center" contenteditable="true" id="p1_gender"><%= genderKh %></span>
            </div>
            <div>
              <span>ទីលំនៅបច្ចុប្បន្ន៖ ភូមិ</span>
              <span class="dotted-line min-w-[120px] text-center" contenteditable="true" id="p1_village"><%= a.address_village || '' %></span>
              <span>ឃុំ/សង្កាត់</span>
              <span class="dotted-line min-w-[120px] text-center" contenteditable="true" id="p1_commune"><%= a.address_commune || '' %></span>
              <span>ស្រុក/ក្រុង</span>
              <span class="dotted-line min-w-[120px] text-center" contenteditable="true" id="p1_district"><%= a.address_district || '' %></span>
              <span>ខេត្ត</span>
              <span class="dotted-line min-w-[110px] text-center" contenteditable="true" id="p1_province"><%= a.address_province || '' %></span>
            </div>
            <div>
              <span>ឪពុកឈ្មោះ</span>
              <span class="dotted-line min-w-[270px] text-center" contenteditable="true" id="p1_father"><%= a.parent_name || '' %></span>
              <span>ម្ដាយឈ្មោះ</span>
              <span class="dotted-line min-w-[270px] text-center" contenteditable="true" id="p1_mother"><%= a.mother_name || '' %></span>
            </div>
          </div>
        </div>

        <!-- Section II -->
        <div class="mb-1">
          <h4 class="font-moul text-[11.5px] mb-1">II. ព័ត៌មានអំពីគ្រឹះស្ថានចំណេះដឹងទូទៅ</h4>
          <div class="pl-2 space-y-1">
            <div>
              <span>សម័យប្រឡងមធ្យមសិក្សាទុតិយភូមិ</span>
              <span class="dotted-line min-w-[300px] text-center" contenteditable="true" id="p1_exam_date"><%= a.exam_session || '' %></span>
              <span>និទ្ទេស</span>
              <span class="dotted-line min-w-[90px] text-center font-bold" contenteditable="true" id="p1_grade"><%= a.exam_result || '' %></span>
            </div>
            <div>
              <span>មកពីវិទ្យាល័យ</span>
              <span class="dotted-line min-w-[340px] text-center" contenteditable="true" id="p1_hs_name"><%= a.school_name || '' %></span>
              <span>ខេត្ត</span>
              <span class="dotted-line min-w-[190px] text-center" contenteditable="true" id="p1_hs_prov"><%= schoolProvince %></span>
            </div>
          </div>
        </div>

        <!-- Section III -->
        <div class="mb-1">
          <h4 class="font-moul text-[11.5px] mb-1">III. ព័ត៌មាននៃការចុះឈ្មោះចូលរៀន</h4>
          <div class="pl-2 space-y-1">
            <div>
              <span>១. កម្រិត</span>
              <span class="dotted-line min-w-[230px] text-center" contenteditable="true" id="p1_degree"><%= levelText %></span>
              <span>មុខវិជ្ជា</span>
              <span class="dotted-line min-w-[290px] text-center" contenteditable="true" id="p1_major"><%= majorKh %></span>
            </div>
            <div class="flex items-center flex-wrap gap-x-4">
              <span>២. ពេលសិក្សា៖</span>
              <label class="inline-flex items-center cursor-pointer select-none">
                <span class="<%= cb(a.study_period === 'mon_fri') %>" onclick="toggleCheckbox(this)"></span> ចន្ទ-សុក្រ
              </label>
              <label class="inline-flex items-center cursor-pointer select-none">
                <span class="<%= cb(a.study_period === 'sat_sun') %>" onclick="toggleCheckbox(this)"></span> សៅរ៍-អាទិត្យ
              </label>
              <span class="ml-4">វេលាសិក្សា៖</span>
              <label class="inline-flex items-center cursor-pointer select-none">
                <span class="<%= cb(a.study_shift === 'morning') %>" onclick="toggleCheckbox(this)"></span> ព្រឹក
              </label>
              <label class="inline-flex items-center cursor-pointer select-none">
                <span class="<%= cb(a.study_shift === 'afternoon') %>" onclick="toggleCheckbox(this)"></span> រសៀល
              </label>
            </div>
          </div>
        </div>

        <!-- Section IV -->
        <div class="mb-1">
          <h4 class="font-moul text-[11.5px] mb-1">IV. កិច្ចសន្យាធានាខុសត្រូវរបស់សាមីខ្លួន</h4>
          <div class="pl-2 space-y-1">
            <div class="dotted-line-full" contenteditable="true" id="p1_c1">ខ្ញុំបាទ/នាងខ្ញុំសូមធានាអះអាងថានឹងគោរពតាមបទបញ្ជាផ្ទៃក្នុងរបស់សាកលវិទ្យាល័យយ៉ាងម៉ឺងម៉ាត់បំផុត។</div>
            <div class="dotted-line-full" contenteditable="true" id="p1_c2">ប្រសិនបើខ្ញុំបាទ/នាងខ្ញុំប្រព្រឹត្តខុសឆ្គងនឹងបទបញ្ជា ខ្ញុំសូមទទួលខុសត្រូវចំពោះមុខច្បាប់ជាធរមាន។</div>
          </div>
        </div>

        <!-- Attachments Requirements -->
        <div class="mt-1 pt-1 border-t border-dashed border-gray-400">
          <p class="font-bold text-center underline mb-1 text-[12px]">សូមគោរពជូនភ្ជាប់មកជាមួយនូវ៖</p>
          <div class="max-w-xl mx-auto space-y-1 text-[12px]">
            <div class="flex justify-between">
              <span>- ព្រឹត្តិបត្រពិន្ទុ ឬ សញ្ញាបត្រមធ្យមសិក្សាទុតិយភូមិ ឬ សញ្ញាបត្រដែលមានតម្លៃស្មើ</span>
              <span>ចំនួន ០១ច្បាប់</span>
            </div>
            <div class="flex justify-between">
              <span>- សលាកបត្របេក្ខជន</span>
