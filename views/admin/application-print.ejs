            <div>
              <p>ថ្ងៃ..............ខែ..............ឆ្នាំ.................ព.ស.២៥៦...</p>
              <p class="mt-1">ធ្វើនៅ....................... ថ្ងៃទី...... ខែ......... ឆ្នាំ២០២...</p>
              <p class="font-bold mt-2">អ្នកទទួលពាក្យ</p>
            </div>
            <div class="mt-12 text-sm font-bold">-</div>
          </div>
          <div class="text-center flex flex-col justify-between h-full">
            <div>
              <p><%= sigDateLine || sigDateBlank %></p>
              <p class="mt-1"><%= sigPlaceLine || sigPlaceBlank %></p>
              <p class="font-bold mt-2">ហត្ថលេខា និងឈ្មោះសាមីខ្លួន</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- DIVIDER LINE WITH CUT ICON -->
    <div class="relative my-2 py-1 flex items-center justify-center">
      <div class="w-full border-t border-dashed border-gray-400"></div>
      <span class="absolute bg-white px-2 text-gray-400 text-xs flex items-center gap-1">✂------------------------------------------------------------------------------------------------------</span>
    </div>

    <!-- ================= BOTTOM HALF FORM (IDENTICAL DUP) ================= -->
    <div class="flex-1 flex flex-col justify-between pt-2">
      <div>
        <!-- Header Section -->
        <div class="grid grid-cols-2 text-center mb-1">
          <div class="text-left leading-tight">
            <p class="font-moul text-[11px] font-normal">ក្រសួងអប់រំ យុវជន និងកីឡា</p>
            <p class="font-moul text-[11px] font-normal mt-1">សាកលវិទ្យាល័យជាតិមានជ័យ</p>
          </div>
          <div class="text-center leading-tight">
            <p class="font-moul text-[12px] font-normal">ព្រះរាជាណាចក្រកម្ពុជា</p>
            <p class="font-moul text-[11px] font-normal mt-1">ជាតិ សាសនា ព្រះមហាក្សត្រ</p>
          </div>
        </div>

        <!-- Form Title & Reg No -->
        <div class="relative text-center my-3">
          <h2 class="font-moul text-[14px] text-center">សលាកបត្រឯកត្តជន</h2>
          <div class="absolute right-0 top-0 text-[12px] flex items-center">
            <span>លេខបញ្ជី</span>
            <span class="dotted-line w-28 text-center font-semibold"><%= toKhmerDigits(a.id) %></span>
          </div>
        </div>

        <!-- Form Inputs Container -->
        <div class="space-y-2 mt-4 relative">
          <!-- Photo Box Positioned Absolutely on Right -->
          <div class="absolute right-0 top-1 w-[80px] h-[110px] border-2 border-black flex items-center justify-center font-bold text-sm bg-white overflow-hidden">
            <% if (photoSrc) { %><img src="<%= photoSrc %>" alt="4x6" class="w-full h-full object-cover"><% } else { %>4 x 6<% } %>
          </div>

          <!-- Row 1 -->
          <div class="flex items-end pr-[95px]">
            <span class="whitespace-nowrap">នាមត្រកូល និងនាមខ្លួន</span>
            <span class="dotted-line-fill mx-1 text-center font-semibold"><%= khmerName %></span>
            <span class="whitespace-nowrap ml-1">អក្សរឡាតាំង</span>
            <span class="dotted-line-fill mx-1 text-center font-semibold"><%= englishName %></span>
            <span class="whitespace-nowrap ml-1">ភេទ</span>
            <span class="dotted-line w-12 mx-1 text-center font-semibold"><%= genderKh %></span>
          </div>

          <!-- Row 2 -->
          <div class="flex items-end pr-[95px]">
            <span class="whitespace-nowrap">ថ្ងៃខែឆ្នាំកំណើត</span>
            <span class="dotted-line-fill mx-1 text-center font-semibold"><%= dobLongKh %></span>
          </div>

          <!-- Row 3 -->
          <div class="flex items-end pr-[95px]">
            <span class="whitespace-nowrap">ទីកន្លែងកំណើត</span>
            <span class="dotted-line-fill mx-1 text-center font-semibold"><%= a.birth_place || '' %></span>
          </div>

          <!-- Row 4 -->
          <div class="flex items-end pr-[95px]">
            <span class="whitespace-nowrap">កម្រិតវប្បធម៌</span>
            <span class="dotted-line-fill mx-1 text-center font-semibold"><%= levelCultureText %></span>
          </div>

          <!-- Row 5 -->
          <div class="flex items-end">
            <span class="whitespace-nowrap">មុខរបរសព្វថ្ងៃ</span>
            <span class="dotted-line-fill mx-1 text-center font-semibold"><%= a.occupation || '' %></span>
          </div>

          <!-- Row 6 -->
          <div class="flex items-end">
            <span class="whitespace-nowrap">ឪពុកឈ្មោះ</span>
            <span class="dotted-line-fill mx-1 text-center font-semibold"><%= a.parent_name || '' %></span>
            <span class="whitespace-nowrap ml-1">ម្តាយឈ្មោះ</span>
            <span class="dotted-line-fill mx-1 text-center font-semibold"><%= a.mother_name || '' %></span>
          </div>

          <!-- Row 7 -->
          <div class="flex items-end">
            <span class="whitespace-nowrap">អតីតបេក្ខជនមកពី វិទ្យាល័យ</span>
            <span class="dotted-line-fill mx-1 text-center font-semibold"><%= a.school_name || '' %></span>
            <span class="whitespace-nowrap ml-1">ខេត្ត/រាជធានី</span>
            <span class="dotted-line-fill mx-1 text-center font-semibold"><%= a.province_name_kh || '' %></span>
          </div>

          <!-- Row 8 -->
          <div class="flex items-end">
            <span class="whitespace-nowrap">សម័យប្រឡងសញ្ញាបត្រមធ្យមសិក្សាទុតិយភូមិ</span>
            <span class="dotted-line-fill mx-1 text-center font-semibold"><%= a.exam_session || '' %></span>
            <span class="whitespace-nowrap ml-1">មណ្ឌលប្រឡង</span>
            <span class="dotted-line-fill mx-1 text-center font-semibold"><%= a.exam_center || '' %></span>
          </div>
        </div>

        <!-- Signatures & Dates Section -->
        <div class="grid grid-cols-2 gap-4 mt-4 text-[11.5px] leading-relaxed">
          <div class="text-center flex flex-col justify-between h-full">
            <div>
              <p>ថ្ងៃ..............ខែ..............ឆ្នាំ.................ព.ស.២៥៦...</p>
              <p class="mt-1">ធ្វើនៅ....................... ថ្ងៃទី...... ខែ......... ឆ្នាំ២០២...</p>
              <p class="font-bold mt-2">អ្នកទទួលពាក្យ</p>
            </div>
            <div class="mt-12 text-sm font-bold">-</div>
          </div>
          <div class="text-center flex flex-col justify-between h-full">
            <div>
              <p><%= sigDateLine || sigDateBlank %></p>
              <p class="mt-1"><%= sigPlaceLine || sigPlaceBlank %></p>
              <p class="font-bold mt-2">ហត្ថលេខា និងឈ្មោះសាមីខ្លួន</p>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>

</body>
</html>
