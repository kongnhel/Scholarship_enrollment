<div class="max-w-4xl mx-auto space-y-6 print:space-y-4">
  <div class="flex items-center justify-between print:hidden">
    <div class="flex items-center gap-3">
      <a href="/admin/enrollments" class="w-10 h-10 bg-gray-100 dark:bg-gray-700 rounded-xl flex items-center justify-center hover:bg-gray-200 dark:hover:bg-gray-600 transition-all">
        <i class="bi bi-arrow-left text-gray-600 dark:text-gray-300"></i>
      </a>
      <div>
        <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ព័ត៌មានការចុះឈ្មោះ' : 'Enrollment Detail' %></h1>
        <p class="text-sm text-gray-500 dark:text-gray-400">#<%= enrollment.id %></p>
      </div>
    </div>
    <button onclick="window.print()" class="px-4 py-2 bg-gradient-to-r from-blue-600 to-indigo-500 text-white rounded-xl text-sm font-semibold hover:from-blue-700 hover:to-indigo-600 transition-all flex items-center gap-2">
      <i class="bi bi-printer"></i><%= currentLang === 'km' ? 'ព្រីន' : 'Print' %>
    </button>
  </div>

  <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
    <div class="px-6 py-4 bg-gradient-to-r from-blue-600 to-indigo-500 text-white">
      <h5 class="font-bold flex items-center gap-2"><i class="bi bi-person-badge"></i><%= currentLang === 'km' ? 'ព័ត៌មាននិស្សិត' : 'Student Information' %></h5>
    </div>
    <div class="p-6">
      <div class="flex items-start gap-6">
        <% if (enrollment.profile_pic) { %>
          <img src="<%= enrollment.profile_pic %>" alt="" class="w-24 h-24 rounded-xl object-cover shadow-sm ring-2 ring-gray-100 dark:ring-gray-700">
        <% } else { %>
          <div class="w-24 h-24 rounded-xl bg-gradient-to-br from-blue-400 to-indigo-500 flex items-center justify-center text-white font-bold text-3xl shadow-sm">
            <%= (enrollment.english_name || 'U').charAt(0).toUpperCase() %>
          </div>
        <% } %>
        <div class="flex-1 grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="text-xs text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'ឈ្មោះខ្មែរ' : 'Khmer Name' %></label>
            <p class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= enrollment.khmer_name || 'N/A' %></p>
          </div>
          <div>
            <label class="text-xs text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'ឈ្មោះអង់គ្លេស' : 'English Name' %></label>
            <p class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= enrollment.english_name || 'N/A' %></p>
          </div>
          <div>
            <label class="text-xs text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'អ៊ីមែល' : 'Email' %></label>
            <p class="text-sm text-gray-700 dark:text-gray-200"><%= enrollment.email || 'N/A' %></p>
          </div>
          <div>
            <label class="text-xs text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'ទូរស័ព្ទ' : 'Phone' %></label>
            <p class="text-sm text-gray-700 dark:text-gray-200"><%= enrollment.phone || 'N/A' %></p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
    <div class="px-6 py-4 bg-gradient-to-r from-indigo-600 to-purple-500 text-white">
      <h5 class="font-bold flex items-center gap-2"><i class="bi bi-mortarboard"></i><%= currentLang === 'km' ? 'ព័ត៌មានការសិក្សា' : 'Academic Information' %></h5>
    </div>
    <div class="p-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="text-xs text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'ឆ្នាំសិក្សា' : 'Academic Year' %></label>
          <p class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= enrollment.academic_year %></p>
        </div>
        <div>
          <label class="text-xs text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'ឆ្នាំទី' : 'Year' %></label>
          <p class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ឆ្នាំទី ' + enrollment.semester : 'Year ' + enrollment.semester %></p>
        </div>
        <div>
          <label class="text-xs text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'ជំនាញ' : 'Major' %></label>
          <p class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? (enrollment.major_name_kh || 'N/A') : (enrollment.major_name_en || 'N/A') %></p>
        </div>
        <div>
          <label class="text-xs text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'ប្រភេទអាហារូបត្ថម្ភ' : 'Scholarship Category' %></label>
          <p class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? (enrollment.category_name_kh || 'N/A') : (enrollment.category_name_en || 'N/A') %></p>
        </div>
        <div>
          <label class="text-xs text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'ប្រភេទអាហារូបត្ថម្ភ' : 'Scholarship Type' %></label>
          <p class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? (enrollment.scholarship_name_kh || 'N/A') : (enrollment.scholarship_name_en || 'N/A') %> (<%= enrollment.scholarship_percentage || 0 %>%)</p>
        </div>
        <div>
          <label class="text-xs text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'ស្ថានភាព' : 'Status' %></label>
          <% if (enrollment.status === 'approved') { %>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-bold rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300">
              <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span><%= currentLang === 'km' ? 'អនុម័ត' : 'Approved' %>
            </span>
          <% } else if (enrollment.status === 'rejected') { %>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-bold rounded-full bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300">
              <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span><%= currentLang === 'km' ? 'បដិសេធ' : 'Rejected' %>
            </span>
          <% } else { %>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-bold rounded-full bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-300">
              <span class="w-1.5 h-1.5 rounded-full bg-yellow-500"></span><%= currentLang === 'km' ? 'រង់ចាំ' : 'Pending' %>
            </span>
          <% } %>
        </div>
        <div>
          <label class="text-xs text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'ថ្ងៃចុះឈ្មោះ' : 'Enrolled Date' %></label>
          <p class="text-sm text-gray-700 dark:text-gray-200"><%= enrollment.enrolled_at ? new Date(enrollment.enrolled_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : 'N/A' %></p>
        </div>
        <% if (enrollment.admin_notes) { %>
          <div class="sm:col-span-2">
            <label class="text-xs text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'កំណត់សម្គាល់របស់អ្នកគ្រប់គ្រង' : 'Admin Notes' %></label>
            <p class="text-sm text-gray-700 dark:text-gray-200"><%= enrollment.admin_notes %></p>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
    <div class="px-6 py-4 bg-gradient-to-r from-emerald-600 to-green-500 text-white">
      <h5 class="font-bold flex items-center gap-2"><i class="bi bi-cash-stack"></i><%= currentLang === 'km' ? 'ការទូទាត់' : 'Payments' %><% if (enrollment.total_paid > 0) { %> (<%= Number(enrollment.total_paid).toLocaleString() %>៛)<% } %></h5>
    </div>
    <div class="p-6">
      <% if (payments.length === 0) { %>
        <p class="text-sm text-gray-500 dark:text-gray-400 text-center py-4"><%= currentLang === 'km' ? 'មិនមានការទូទាត់ទេ' : 'No payments found' %></p>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-gray-100 dark:border-gray-700">
                <th class="text-left py-2 text-xs text-gray-500 dark:text-gray-400">#</th>
                <th class="text-left py-2 text-xs text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'ប្រភេទ' : 'Type' %></th>
                <th class="text-left py-2 text-xs text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'ចំនួន' : 'Amount' %></th>
                <th class="text-left py-2 text-xs text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'ការពិនិត្យ' : 'Status' %></th>
                <th class="text-left py-2 text-xs text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'ថ្ងៃ' : 'Date' %></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-50 dark:divide-gray-700">
              <% payments.forEach(function(p, i) { %>
                <tr>
                  <td class="py-2.5 text-gray-700 dark:text-gray-200"><%= i + 1 %></td>
                  <td class="py-2.5 text-gray-700 dark:text-gray-200"><%= currentLang === 'km' ? p.fee_name_kh : p.fee_name_en %></td>
                  <td class="py-2.5 font-semibold text-emerald-600 dark:text-emerald-400"><%= Number(p.amount).toLocaleString() %>៛</td>
                  <td class="py-2.5">
                    <% if (p.status === 'verified') { %>
                      <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs font-bold rounded-full bg-green-100 text-green-700"><%= currentLang === 'km' ? 'បញ្ជាក់' : 'Verified' %></span>
                    <% } else if (p.status === 'rejected') { %>
                      <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs font-bold rounded-full bg-red-100 text-red-700"><%= currentLang === 'km' ? 'បដិសេធ' : 'Rejected' %></span>
                    <% } else { %>
                      <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs font-bold rounded-full bg-yellow-100 text-yellow-700"><%= currentLang === 'km' ? 'រង់ចាំ' : 'Pending' %></span>
                    <% } %>
                  </td>
                  <td class="py-2.5 text-gray-500 dark:text-gray-400"><%= new Date(p.created_at).toLocaleDateString() %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<style>
  @media print {
    body * { visibility: hidden; }
    .print\:space-y-4, .print\:space-y-4 * { visibility: visible; }
    .print\:space-y-4 { position: absolute; left: 0; top: 0; width: 100%; }
    .print\:hidden { display: none !important; }
  }
</style>
