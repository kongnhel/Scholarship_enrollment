<script>
function openAddTypeModal() {
  document.querySelectorAll('#addTypeModal input[name="major_ids"]').forEach(function(cb) { cb.checked = false; });
  document.getElementById('add_major_panel').classList.add('hidden');
  updateMajorSummary('add');
  document.getElementById('add_tier_options').value = '[]';
  ['add_tier_input', 'add_tier_years', 'add_tier_seats'].forEach(function(id) { document.getElementById(id).value = ''; });
  renderTiers('add');
  document.getElementById('addTypeModal').classList.remove('hidden');
}

function previewPoster(input, previewId) {
  var img = document.getElementById(previewId);
  if (input.files && input.files[0]) {
    var reader = new FileReader();
    reader.onload = function (e) { img.src = e.target.result; img.classList.remove('hidden'); };
    reader.readAsDataURL(input.files[0]);
  } else {
    img.src = '';
    img.classList.add('hidden');
  }
}

var LANG_KM = <%= currentLang === 'km' ? 'true' : 'false' %>;

function parseTierRaw(raw) {
  var s = String(raw == null ? '' : raw).trim();
  if (!s) return [];
  if (s.charAt(0) === '[') {
    try { var a = JSON.parse(s); return Array.isArray(a) ? a : []; } catch (e) { return []; }
  }
  return s.split(/[^0-9]+/).filter(Boolean).map(Number).filter(function (n) { return n >= 1 && n <= 100; })
    .map(function (p) { return { p: p, y: null, s: null }; });
}

function tierList(prefix) {
  var hidden = document.getElementById(prefix + '_tier_options');
  return parseTierRaw(hidden ? hidden.value : '');
}

function tierKey(t) { return t.p + '/' + (t.y || 0); }

function saveTiers(prefix, list) {
  var clean = [];
  list.forEach(function (t) {
    if (t && Number(t.p) >= 1 && Number(t.p) <= 100) {
      var y = Number(t.y), s = Number(t.s);
      clean.push({ p: Number(t.p), y: (y >= 1 && y <= 10) ? y : null, s: (s >= 1 && s <= 999) ? s : null });
    }
  });
  var uniq = [];
  clean.forEach(function (t) {
    if (!uniq.some(function (u) { return u.p === t.p && u.y === t.y; })) uniq.push(t);
  });
  document.getElementById(prefix + '_tier_options').value = JSON.stringify(uniq.slice(0, 12));
  renderTiers(prefix);
}

function tierLabel(t) {
  var label = t.p + '%';
  if (t.y) label += ' · ' + t.y + (LANG_KM ? 'ឆ្នាំ' : 'y');
  if (t.s) label += ' · ' + t.s + (LANG_KM ? 'កន្លែង' : ' seats');
  return label;
}

function renderTiers(prefix) {
  var box = document.getElementById(prefix + '_tier_chips');
  var list = tierList(prefix);
  box.innerHTML = list.map(function (t) {
    return '<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-bold bg-green-50 dark:bg-green-900/30 text-green-700 dark:text-green-300 border border-green-200 dark:border-green-800">' + tierLabel(t) +
      '<button type="button" onclick="removeTier(\'' + prefix + '\',\'' + tierKey(t) + '\')" class="text-green-500 hover:text-red-500 font-bold">&times;</button></span>';
  }).join('');
}

function addTier(prefix) {
  var pEl = document.getElementById(prefix + '_tier_input');
  var yEl = document.getElementById(prefix + '_tier_years');
  var sEl = document.getElementById(prefix + '_tier_seats');
  var p = parseInt(pEl.value, 10), y = parseInt(yEl.value, 10), s = parseInt(sEl.value, 10);
  if (!p || p < 1 || p > 100) { pEl.classList.add('border-red-400'); return; }
  pEl.classList.remove('border-red-400');
  var list = tierList(prefix);
  var entry = { p: p, y: (y >= 1 && y <= 10) ? y : null, s: (s >= 1 && s <= 999) ? s : null };
  if (!list.some(function (t) { return tierKey(t) === tierKey(entry); })) {
    list.push(entry);
    list.sort(function (a, b) { return (b.y || 0) - (a.y || 0) || b.p - a.p; });
  }
  pEl.value = ''; yEl.value = ''; sEl.value = '';
  saveTiers(prefix, list);
  renderTierSuggestions(prefix);
}

function removeTier(prefix, key) {
  var list = tierList(prefix).filter(function (t) { return tierKey(t) !== key; });
  saveTiers(prefix, list);
}

function renderTierSuggestions(prefix) {
  var pInput = document.getElementById(prefix + '_tier_input');
  var yInput = document.getElementById(prefix + '_tier_years');
  var box = document.getElementById(prefix + '_tier_suggest');
  if (!box) return;
  var base = parseInt(pInput && pInput.value, 10);
  if (!base || base < 1 || base > 100) { box.innerHTML = ''; return; }
  var y = parseInt(yInput && yInput.value, 10) || null;
  var vals = [1, 0.6, 0.4].map(function (f) { return Math.round(base * f); }).filter(function (v, i, a) { return v >= 1 && a.indexOf(v) === i; });
  box.innerHTML = vals.map(function (v) {
    var label = v + '%' + (y ? ' · ' + y + (LANG_KM ? 'ឆ្នាំ' : 'y') : '');
    return '<button type="button" onclick="suggestCombo(\'' + prefix + '\',' + v + ',' + (y || 0) + ')" class="px-2 py-0.5 rounded-lg text-xs font-bold border border-dashed border-green-300 dark:border-green-700 text-green-700 dark:text-green-300 bg-green-50/60 dark:bg-green-900/20 hover:bg-green-100 dark:hover:bg-green-900/40 transition-all">' + label + '</button>';
  }).join('');
}

function suggestCombo(prefix, p, y) {
  var list = tierList(prefix);
  var entry = { p: p, y: (y >= 1 && y <= 10) ? y : null, s: null };
  if (!list.some(function (t) { return tierKey(t) === tierKey(entry); })) {
    list.push(entry);
    list.sort(function (a, b) { return (b.y || 0) - (a.y || 0) || b.p - a.p; });
  }
  saveTiers(prefix, list);
}

function toggleMajorDropdown(prefix) {
  document.getElementById(prefix + '_major_panel').classList.toggle('hidden');
}

var MAJOR_PLACEHOLDER = '<%= currentLang === "km" ? "ជ្រើសរើសជំនាញ..." : "Select majors..." %>';

function updateMajorSummary(prefix) {
  var modalId = prefix === 'add' ? 'addTypeModal' : 'editTypeModal';
  var boxes = document.querySelectorAll('#' + modalId + ' input[name="major_ids"]');
  var picked = [];
  boxes.forEach(function (cb) {
    if (cb.checked) picked.push(cb.parentNode.querySelector('span').textContent.trim());
  });
  var el = document.getElementById(prefix + '_major_summary');
  if (!picked.length) {
    el.textContent = MAJOR_PLACEHOLDER;
    el.classList.add('text-gray-400');
  } else {
    var txt = picked.slice(0, 2).join(', ');
    if (picked.length > 2) txt += ' +' + (picked.length - 2);
    el.textContent = txt;
    el.classList.remove('text-gray-400');
  }
}

function editType(st) {
  document.getElementById('editTypeForm').action = '/admin/scholarship-types/' + st.id + '/edit';
  document.getElementById('edit_name_kh').value = st.name_kh;
  document.getElementById('edit_name_en').value = st.name_en || '';
  document.getElementById('edit_tier_options').value = JSON.stringify(parseTierRaw(st.tier_options || ''));
  document.getElementById('edit_tier_input').value = '';
  document.getElementById('edit_tier_years').value = '';
  document.getElementById('edit_tier_seats').value = '';
  renderTiers('edit');
  renderTierSuggestions('edit');
  var editMajorIds = String(st.major_ids || '').split(',').filter(Boolean);
  document.querySelectorAll('#editTypeModal input[name="major_ids"]').forEach(function(cb) {
    cb.checked = editMajorIds.indexOf(cb.value) !== -1;
  });
  document.getElementById('edit_major_panel').classList.add('hidden');
  updateMajorSummary('edit');
  document.getElementById('edit_leader').value = st.leader_name || '';
  document.getElementById('edit_provider').value = st.provider_name;
  document.getElementById('edit_description').value = st.description || '';
  document.getElementById('edit_poster_path').value = st.poster_path || '';
  var pv = document.getElementById('edit_poster_preview');
  if (st.poster_path) { pv.src = st.poster_path; pv.classList.remove('hidden'); } else { pv.src = ''; pv.classList.add('hidden'); }
  document.getElementById('editTypeModal').classList.remove('hidden');
}

function confirmDelete(id, name, e) {
  var pop = document.getElementById('deleteTypePopover');
  document.getElementById('deleteTypeForm').action = '/admin/scholarship-types/' + id + '/delete';
  document.getElementById('deleteTypeName').textContent = name;
  pop.classList.remove('hidden');
  var rect = e.currentTarget.getBoundingClientRect();
  var popW = 288;
  var popH = pop.offsetHeight || 140;
  var left = rect.right + 8;
  if (left + popW > window.innerWidth) left = rect.left - popW - 8;
  var top = rect.top + (rect.height / 2) - (popH / 2);
  if (top < 8) top = 8;
  if (top + popH > window.innerHeight - 8) top = window.innerHeight - popH - 8;
  pop.style.left = left + 'px';
  pop.style.top = top + 'px';
}

function closeDeleteTypePopover() {
  document.getElementById('deleteTypePopover').classList.add('hidden');
}

document.addEventListener('click', function(e) {
  var pop = document.getElementById('deleteTypePopover');
  if (!pop.classList.contains('hidden') && !pop.contains(e.target) && !e.target.closest('[onclick*="confirmDelete"]')) {
    closeDeleteTypePopover();
  }
});
document.addEventListener('click', function(e) {
  ['add', 'edit'].forEach(function(p) {
    var panel = document.getElementById(p + '_major_panel');
    if (panel && !panel.classList.contains('hidden') && !panel.contains(e.target) && !e.target.closest('[onclick*="toggleMajorDropdown"]')) {
      panel.classList.add('hidden');
    }
  });
});

document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') closeDeleteTypePopover();
});
</script>
