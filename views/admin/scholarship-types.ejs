<%
  var majorNameMap = {}; (typeof majorsList !== 'undefined' ? majorsList : []).forEach(function(m) { majorNameMap[m.id] = m; });
  var parseTierList = function (raw, defY0) {
    var defY = (Number(defY0) >= 1 && Number(defY0) <= 10) ? Number(defY0) : null;
    var s = String(raw == null ? '' : raw).trim();
    var out = [];
    if (s.charAt(0) === '[') {
      try {
        var arr = JSON.parse(s);
        if (Array.isArray(arr)) arr.forEach(function (t) {
          var p = Number(t && t.p), y = Number(t && t.y), q = Number(t && t.s);
          if (p >= 1 && p <= 100) out.push({ p: p, y: (y >= 1 && y <= 10) ? y : defY, s: (q >= 1 && q <= 999) ? q : null });
        });
      } catch (e) { out = []; }
    } else {
      s.split(/[^0-9]+/).filter(Boolean).map(Number).filter(function (n) { return n >= 1 && n <= 100; })
        .forEach(function (p) { out.push({ p: p, y: defY, s: null }); });
    }
    return out;
  };
%>
<div class="max-w-6xl mx-auto space-y-6">
  <div class="relative overflow-hidden rounded-3xl bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 shadow-sm">
    <div class="absolute top-0 right-0 w-40 h-40 bg-green-50 dark:bg-green-900/20 rounded-bl-[6rem] -mr-10 -mt-10"></div>
    <div class="relative px-6 py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 bg-gradient-to-br from-green-500 to-emerald-600 rounded-2xl flex items-center justify-center shadow-md shadow-green-500/20 flex-shrink-0">
          <i class="bi bi-award text-white text-xl"></i>
        </div>
        <div>
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-green-100 dark:bg-green-900/40 text-green-700 dark:text-green-300 text-xs font-bold mb-1">
            <i class="bi bi-collection"></i>
            <%= totalRecords %> <%= currentLang === 'km' ? 'ប្រភេទ' : 'types' %>
          </div>
          <h1 class="text-xl font-bold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ប្រភេទអាហារូបករណ៍' : 'Scholarship Types' %></h1>
          <p class="text-sm text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'គ្រប់គ្រងប្រភេទអាហារូបករណ៍ទាំងអស់' : 'Manage all scholarship types' %></p>
        </div>
      </div>
      <button onclick="openAddTypeModal()" class="px-5 py-2.5 bg-gradient-to-r from-green-600 to-emerald-500 text-white rounded-xl text-sm font-semibold hover:from-green-700 hover:to-emerald-600 transition-all shadow-sm flex items-center gap-2 self-start sm:self-auto">
        <i class="bi bi-plus-circle"></i><%= currentLang === 'km' ? 'បន្ថែមប្រភេទថ្មី' : 'Add New Type' %>
      </button>
    </div>
  </div>

  <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
    <div class="px-6 py-3.5 border-b border-gray-100 dark:border-gray-700 flex items-center gap-2.5">
      <div class="w-8 h-8 bg-green-100 dark:bg-green-900/40 rounded-lg flex items-center justify-center">
        <i class="bi bi-funnel text-green-600 dark:text-green-400 text-sm"></i>
      </div>
      <span class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'តម្រង' : 'Filters' %></span>
    </div>
    <form action="/admin/scholarship-types" method="GET" class="p-5">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <div class="relative sm:col-span-2 lg:col-span-2">
          <i class="bi bi-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 dark:text-gray-500 pointer-events-none"></i>
          <input type="text" class="w-full pl-9 pr-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" name="search" placeholder="<%= currentLang === 'km' ? 'ស្វែងរកតាមឈ្មោះ ឬអ្នកផ្តល់...' : 'Search by name or provider...' %>" value="<%= filters.search || '' %>">
        </div>
        <div>
          <select name="status" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
            <option value=""><%= currentLang === 'km' ? 'ស្ថានភាពទាំងអស់' : 'All Status' %></option>
            <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>><%= currentLang === 'km' ? 'សកម្ម' : 'Active' %></option>
            <option value="inactive" <%= filters.status === 'inactive' ? 'selected' : '' %>><%= currentLang === 'km' ? 'មិនសកម្ម' : 'Inactive' %></option>
          </select>
        </div>
        <div class="flex gap-2 items-end">
          <button type="submit" class="px-5 py-2.5 bg-gradient-to-r from-green-600 to-emerald-500 text-white rounded-xl text-sm font-semibold hover:from-green-700 hover:to-emerald-600 transition-all shadow-sm flex items-center gap-2">
            <i class="bi bi-search"></i><%= currentLang === 'km' ? 'ត្រង' : 'Filter' %>
          </button>
          <a href="/admin/scholarship-types" class="px-5 py-2.5 border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-400 rounded-xl text-sm font-medium hover:bg-gray-50 dark:hover:bg-gray-700 hover:text-gray-900 dark:hover:text-white transition-all flex items-center gap-1">
            <i class="bi bi-x-lg"></i><%= currentLang === 'km' ? 'សម្អាត' : 'Clear' %>
          </a>
        </div>
      </div>
    </form>
  </div>

  <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="bg-gray-50 dark:bg-gray-800/50 border-b border-gray-100 dark:border-gray-700">
            <th class="px-5 py-3.5 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= currentLang === 'km' ? 'លំដាប់លេខរៀង' : 'No.' %></th>
            <th class="px-5 py-3.5 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= currentLang === 'km' ? 'ឈ្មោះប្រភេទ' : 'Scholarship Name' %></th>
            <th class="px-5 py-3.5 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= currentLang === 'km' ? 'ថ្លៃសិក្សា' : 'Coverage' %></th>
            <th class="px-5 py-3.5 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= currentLang === 'km' ? 'រយៈពេល' : 'Duration' %></th>
            <th class="px-5 py-3.5 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= currentLang === 'km' ? 'អ្នកផ្តល់' : 'Provider' %></th>
            <th class="px-5 py-3.5 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= currentLang === 'km' ? 'ជំនាញ' : 'Majors' %></th>
            <th class="px-5 py-3.5 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= currentLang === 'km' ? 'ស្ថានភាព' : 'Status' %></th>
            <th class="px-5 py-3.5 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= currentLang === 'km' ? 'សកម្មភាព' : 'Actions' %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50 dark:divide-gray-700">
          <% if (types.length === 0) { %>
            <tr>
              <td colspan="8" class="px-5 py-12 text-center">
                <div class="flex flex-col items-center gap-2">
                  <i class="bi bi-award text-4xl text-gray-300 dark:text-gray-600"></i>
                  <p class="text-sm text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'មិនមានប្រភេទទេ' : 'No scholarship types found' %></p>
                </div>
              </td>
            </tr>
          <% } else { %>
            <% types.forEach(function(st, index) { %>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
                <td class="px-5 py-4">
                  <span class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-gray-100 dark:bg-gray-700 text-xs font-bold text-gray-500 dark:text-gray-400"><%= (currentPage - 1) * 10 + index + 1 %></span>
                </td>
                <td class="px-5 py-4">
                  <div class="flex items-center gap-3">
                    <% if (st.poster_path) { %>
                      <img src="<%= st.poster_path %>" alt="" class="w-10 h-14 object-cover object-top rounded-lg border border-gray-200 dark:border-gray-700 flex-shrink-0">
                    <% } else { %>
                      <div class="w-10 h-14 rounded-lg bg-gray-100 dark:bg-gray-700 flex items-center justify-center flex-shrink-0"><i class="bi bi-image text-gray-300 dark:text-gray-600"></i></div>
                    <% } %>
                    <div class="max-w-xs">
                      <p class="text-sm font-medium text-gray-900 dark:text-gray-100 truncate"><%= currentLang === 'km' ? st.name_kh : (st.name_en || st.name_kh) %></p>
                      <% if (st.name_en && currentLang === 'km') { %>
                        <p class="text-xs text-gray-400 dark:text-gray-500 truncate mt-0.5"><%= st.name_en %></p>
                      <% } %>
                    </div>
                  </div>
                </td>
                <td class="px-5 py-4">
                  <span class="inline-flex items-center gap-1 px-3 py-1 text-xs font-bold rounded-full <%= st.coverage_percentage >= 100 ? 'bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300' : st.coverage_percentage >= 50 ? 'bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300' : 'bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-300' %>">
                    <%= st.coverage_percentage %>%
                  </span>
                </td>
                <td class="px-5 py-4 text-sm text-gray-700 dark:text-gray-200">
                  <p><%= st.duration_years %> <%= currentLang === 'km' ? 'ឆ្នាំ' : 'yr' %></p>
                  <% var stTiers = parseTierList(st.tier_options, st.duration_years); %>
                  <% if (stTiers.length) { %>
                    <p class="text-xs text-gray-400 dark:text-gray-500 mt-0.5"><%= stTiers.map(function(t) { return t.p + '%' + (t.y ? ' · ' + t.y + (currentLang === 'km' ? 'ឆ្នាំ' : 'y') : '') + (t.s ? ' · ' + t.s + (currentLang === 'km' ? 'កន្លែង' : ' seats') : ''); }).join(' / ') %></p>
                  <% } %>
                </td>
                <td class="px-5 py-4 text-sm text-gray-700 dark:text-gray-200 max-w-[200px]">
                  <p class="truncate"><%= st.provider_name || '—' %></p>
                  <% if (st.leader_name) { %>
                    <p class="text-xs text-gray-400 dark:text-gray-500 truncate mt-0.5"><i class="bi bi-person-badge"></i> <%= st.leader_name %></p>
                  <% } %>
                </td>
                <td class="px-5 py-4 text-sm text-gray-700 dark:text-gray-200 max-w-[220px] truncate">
                  <% var stMajors = String(st.major_ids || '').split(',').filter(Boolean).map(function(id) { var m = majorNameMap[id]; return m ? (currentLang === 'km' ? m.name_kh : (m.name_en || m.name_kh)) : ''; }).filter(Boolean).join(', '); %>
                  <%= stMajors || '—' %>
                </td>
                <td class="px-5 py-4">
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-bold rounded-full <%= st.is_active ? 'bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300' : 'bg-gray-100 dark:bg-gray-700 text-gray-500 dark:text-gray-400' %>">
                    <span class="w-1.5 h-1.5 rounded-full <%= st.is_active ? 'bg-green-500' : 'bg-gray-400' %>"></span>
                    <%= st.is_active ? (currentLang === 'km' ? 'សកម្ម' : 'Active') : (currentLang === 'km' ? 'មិនសកម្ម' : 'Inactive') %>
                  </span>
                </td>
                <td class="px-5 py-4">
                  <div class="flex gap-1.5 flex-wrap">
                    <button onclick='editType(<%= JSON.stringify(st) %>)' class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-green-200 text-green-600 dark:text-green-400 hover:bg-green-50 dark:hover:bg-green-900/20 transition-all flex items-center gap-1"><i class="bi bi-pencil"></i><%= currentLang === 'km' ? 'កែ' : 'Edit' %></button>
                    <form action="/admin/scholarship-types/<%= st.id %>/toggle" method="POST" class="inline">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="px-3 py-1.5 rounded-lg text-xs font-semibold border transition-all flex items-center gap-1 <%= st.is_active ? 'border-orange-200 text-orange-600 hover:bg-orange-50 dark:hover:bg-orange-900/20' : 'border-green-200 text-green-600 dark:text-green-400 hover:bg-green-50 dark:hover:bg-green-900/20' %>">
                        <i class="bi <%= st.is_active ? 'bi-pause-circle' : 'bi-play-circle' %>"></i>
                        <%= st.is_active ? (currentLang === 'km' ? 'បិទ' : 'Off') : (currentLang === 'km' ? 'បើក' : 'On') %>
                      </button>
                    </form>
                    <button type="button" onclick="confirmDelete(<%= st.id %>, '<%= currentLang === 'km' ? st.name_kh.replace(/'/g, "\\'") : (st.name_en || st.name_kh).replace(/'/g, "\\'") %>', event)" class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-red-200 text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 transition-all flex items-center gap-1"><i class="bi bi-trash"></i><%= currentLang === 'km' ? 'លុប' : 'Delete' %></button>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>

    <% if (totalPages > 1) { %>
      <div class="px-6 py-4 border-t border-gray-100 dark:border-gray-700 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <p class="text-sm text-gray-500 dark:text-gray-400">
          <%= currentLang === 'km' ? 'ទំព័រ' : 'Page' %> <%= currentPage %> <%= currentLang === 'km' ? 'នៃ' : 'of' %> <%= totalPages %>
        </p>
        <div class="flex gap-1">
          <% const stQs = 'search=' + encodeURIComponent(filters.search || '') + '&status=' + encodeURIComponent(filters.status || ''); %>
          <a href="?page=<%= currentPage - 1 %>&<%= stQs %>" class="px-4 py-2 rounded-xl text-sm font-medium transition-all <%= currentPage === 1 ? 'text-gray-300 dark:text-gray-600 cursor-not-allowed' : 'text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 hover:text-gray-900 dark:hover:text-white' %>">
            <i class="bi bi-chevron-left"></i>
            <span class="hidden sm:inline ml-1"><%= currentLang === 'km' ? 'មុន' : 'Previous' %></span>
          </a>
          <%
            let stPages = [];
            if (totalPages <= 7) {
              for (let i = 1; i <= totalPages; i++) stPages.push(i);
            } else {
              stPages.push(1);
              if (currentPage > 3) stPages.push('...');
              for (let i = Math.max(2, currentPage - 1); i <= Math.min(totalPages - 1, currentPage + 1); i++) {
                stPages.push(i);
              }
              if (currentPage < totalPages - 2) stPages.push('...');
              stPages.push(totalPages);
            }
          %>
          <% stPages.forEach(function(p) { %>
            <% if (p === '...') { %>
              <span class="px-2 py-2 text-sm text-gray-400 dark:text-gray-500">...</span>
            <% } else { %>
              <a href="?page=<%= p %>&<%= stQs %>" class="px-3.5 py-2 rounded-xl text-sm font-bold transition-all <%= currentPage === p ? 'bg-gradient-to-r from-green-600 to-emerald-500 text-white shadow-md' : 'text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 hover:text-gray-900 dark:hover:text-white' %>"><%= p %></a>
            <% } %>
          <% }); %>
          <a href="?page=<%= currentPage + 1 %>&<%= stQs %>" class="px-4 py-2 rounded-xl text-sm font-medium transition-all <%= currentPage === totalPages ? 'text-gray-300 dark:text-gray-600 cursor-not-allowed' : 'text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 hover:text-gray-900 dark:hover:text-white' %>">
            <span class="hidden sm:inline mr-1"><%= currentLang === 'km' ? 'បន្ទាប់' : 'Next' %></span>
            <i class="bi bi-chevron-right"></i>
          </a>
        </div>
      </div>
    <% } %>
  </div>
</div>

<div id="addTypeModal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4" onclick="if(event.target===this)this.classList.add('hidden')">
  <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl w-full max-w-lg" onclick="event.stopPropagation()">
    <form action="/admin/scholarship-types" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="px-6 py-4 bg-gradient-to-r from-green-600 to-emerald-500 text-white flex items-center justify-between rounded-t-2xl">
        <h5 class="font-bold flex items-center gap-2"><i class="bi bi-plus-circle"></i><%= currentLang === 'km' ? 'បន្ថែមប្រភេទអាហារូបករណ៍ថ្មី' : 'Add New Scholarship Type' %></h5>
        <button type="button" onclick="this.closest('[id$=Modal]').classList.add('hidden')" class="text-white/80 hover:text-white"><i class="bi bi-x-lg"></i></button>
      </div>
      <div class="p-6 space-y-4 max-h-[70vh] overflow-y-auto">
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'ឈ្មោះប្រភេទ (ខ្មែរ)' : 'Scholarship Name (Khmer)' %> <span class="text-red-500">*</span></label>
          <input type="text" name="name_kh" required placeholder="<%= currentLang === 'km' ? 'ឧ. អាហារូបករណ៍៥០% សិក្សារយៈពេល២ឆ្នាំ' : 'e.g. 50% Scholarship for 2 Years' %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'ឈ្មោះប្រភេទ (អង់គ្លេស)' : 'Scholarship Name (English)' %></label>
          <input type="text" name="name_en" placeholder="e.g. 50% Scholarship for 2 Years - NMU" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'កម្រិតអាហារូបករណ៍ (%) — បញ្ចូលម្តងមួយៗ' : 'Scholarship levels (%) — add one by one' %> <span class="text-red-500">*</span></label>
          <div class="flex gap-2">
            <input type="number" id="add_tier_input" min="1" max="100" oninput="renderTierSuggestions('add')" placeholder="<%= currentLang === 'km' ? 'ភាគរយ' : '%' %>" class="w-20 px-3 py-2 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" onkeydown="if(event.key==='Enter'){event.preventDefault();addTier('add');}">
            <input type="number" id="add_tier_years" min="1" max="10" oninput="renderTierSuggestions('add')" placeholder="<%= currentLang === 'km' ? 'ឆ្នាំ' : 'yrs' %>" class="w-20 px-3 py-2 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" onkeydown="if(event.key==='Enter'){event.preventDefault();addTier('add');}">
            <input type="number" id="add_tier_seats" min="1" placeholder="<%= currentLang === 'km' ? 'កន្លែង' : 'seats' %>" class="w-24 px-3 py-2 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" onkeydown="if(event.key==='Enter'){event.preventDefault();addTier('add');}">
            <button type="button" onclick="addTier('add')" class="px-3.5 py-2 bg-green-50 dark:bg-green-900/30 border border-green-200 dark:border-green-800 text-green-700 dark:text-green-300 rounded-xl text-sm font-bold hover:bg-green-100 dark:hover:bg-green-900/50 transition-all"><i class="bi bi-plus-lg"></i></button>
          </div>
          <div class="flex flex-wrap items-center gap-1.5 mt-2">
            <span class="text-[11px] font-semibold text-gray-400 dark:text-gray-500"><%= currentLang === 'km' ? 'ជម្រើសរួចរាល់តាមភាគរយថ្លៃសិក្សា (ចុចដើម្បីបន្ថែម)' : 'Suggested from coverage % (click to add)' %></span>
            <span id="add_tier_suggest" class="flex flex-wrap gap-1.5"></span>
          </div>
