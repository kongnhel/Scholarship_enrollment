<div class="max-w-6xl mx-auto space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 bg-gradient-to-br from-green-500 to-emerald-600 rounded-xl flex items-center justify-center shadow-lg shadow-green-500/20">
        <i class="bi bi-award text-white text-lg"></i>
      </div>
      <div>
        <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ប្រភេទអាហារូបករណ៍' : 'Scholarship Types' %></h1>
        <p class="text-sm text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'គ្រប់គ្រងប្រភេទអាហារូបករណ៍ទាំងអស់' : 'Manage all scholarship types' %></p>
      </div>
    </div>
    <div class="flex items-center gap-3">
      <div class="flex items-center gap-2 px-4 py-2 bg-white dark:bg-gray-800 rounded-xl border border-gray-100 dark:border-gray-700 shadow-sm">
        <i class="bi bi-award text-gray-400"></i>
        <span class="text-sm text-gray-600 dark:text-gray-300"><%= totalRecords %> <%= currentLang === 'km' ? 'ប្រភេទ' : 'types' %></span>
      </div>
      <button onclick="document.getElementById('addTypeModal').classList.remove('hidden')" class="px-5 py-2.5 bg-gradient-to-r from-green-600 to-emerald-500 text-white rounded-xl text-sm font-semibold hover:from-green-700 hover:to-emerald-600 transition-all shadow-sm flex items-center gap-2">
        <i class="bi bi-plus-circle"></i><%= currentLang === 'km' ? 'បន្ថែមប្រភេទថ្មី' : 'Add New Type' %>
      </button>
    </div>
  </div>

  <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
    <div class="px-6 py-3 bg-gradient-to-r from-green-600 to-emerald-500 flex items-center gap-2">
      <i class="bi bi-sliders text-white/80 text-sm"></i>
      <span class="text-sm font-semibold text-white"><%= currentLang === 'km' ? 'តម្រង' : 'Filters' %></span>
    </div>
    <form action="/admin/scholarship-types" method="GET" class="p-5">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <div class="relative sm:col-span-2 lg:col-span-2">
          <i class="bi bi-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 dark:text-gray-500 pointer-events-none"></i>
          <input type="text" class="w-full pl-9 pr-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" name="search" placeholder="<%= currentLang === 'km' ? 'ស្វែងរកតាមឈ្មោះ ឬអ្នកផ្តល់...' : 'Search by name or provider...' %>" value="<%= filters.search || '' %>">
        </div>
        <div>
          <select name="status" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
            <option value=""><%= currentLang === 'km' ? 'ស្ថានភាពទាំងអស់' : 'All Status' %></option>
            <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>><%= currentLang === 'km' ? 'សកម្ម' : 'Active' %></option>
            <option value="inactive" <%= filters.status === 'inactive' ? 'selected' : '' %>><%= currentLang === 'km' ? 'មិនសកម្ម' : 'Inactive' %></option>
          </select>
        </div>
        <div class="flex gap-2 items-end">
          <button type="submit" class="px-5 py-2.5 bg-gradient-to-r from-green-600 to-emerald-500 text-white rounded-xl text-sm font-semibold hover:from-green-700 hover:to-emerald-600 transition-all shadow-sm flex items-center gap-2">
            <i class="bi bi-search"></i><%= currentLang === 'km' ? 'ត្រង' : 'Filter' %>
          </button>
          <a href="/admin/scholarship-types" class="px-5 py-2.5 border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-400 rounded-xl text-sm font-medium hover:bg-gray-50 dark:hover:bg-gray-700 hover:text-gray-900 dark:hover:text-white transition-all flex items-center gap-1">
            <i class="bi bi-x-lg"></i><%= currentLang === 'km' ? 'សម្អាត' : 'Clear' %>
          </a>
        </div>
      </div>
    </form>
  </div>

  <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="bg-gray-50 dark:bg-gray-800/50 border-b border-gray-100 dark:border-gray-700">
            <th class="px-5 py-3.5 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">ID</th>
            <th class="px-5 py-3.5 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= currentLang === 'km' ? 'ឈ្មោះប្រភេទ' : 'Scholarship Name' %></th>
            <th class="px-5 py-3.5 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= currentLang === 'km' ? 'ថ្លៃសិក្សា' : 'Coverage' %></th>
            <th class="px-5 py-3.5 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= currentLang === 'km' ? 'រយៈពេល' : 'Duration' %></th>
            <th class="px-5 py-3.5 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= currentLang === 'km' ? 'អ្នកផ្តល់' : 'Provider' %></th>
            <th class="px-5 py-3.5 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= currentLang === 'km' ? 'ស្ថានភាព' : 'Status' %></th>
            <th class="px-5 py-3.5 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= currentLang === 'km' ? 'សកម្មភាព' : 'Actions' %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50 dark:divide-gray-700">
          <% if (types.length === 0) { %>
            <tr>
              <td colspan="7" class="px-5 py-12 text-center">
                <div class="flex flex-col items-center gap-2">
                  <i class="bi bi-award text-4xl text-gray-300 dark:text-gray-600"></i>
                  <p class="text-sm text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'មិនមានប្រភេទទេ' : 'No scholarship types found' %></p>
                </div>
              </td>
            </tr>
          <% } else { %>
            <% types.forEach(function(st) { %>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
                <td class="px-5 py-4">
                  <span class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-gray-100 dark:bg-gray-700 text-xs font-bold text-gray-500 dark:text-gray-400"><%= st.id %></span>
                </td>
                <td class="px-5 py-4">
                  <div class="max-w-xs">
                    <p class="text-sm font-medium text-gray-900 dark:text-gray-100 truncate"><%= currentLang === 'km' ? st.name_kh : (st.name_en || st.name_kh) %></p>
                    <% if (st.name_en && currentLang === 'km') { %>
                      <p class="text-xs text-gray-400 dark:text-gray-500 truncate mt-0.5"><%= st.name_en %></p>
                    <% } %>
                  </div>
                </td>
                <td class="px-5 py-4">
                  <span class="inline-flex items-center gap-1 px-3 py-1 text-xs font-bold rounded-full <%= st.coverage_percentage >= 100 ? 'bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300' : st.coverage_percentage >= 50 ? 'bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300' : 'bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-300' %>">
                    <%= st.coverage_percentage %>%
                  </span>
                </td>
                <td class="px-5 py-4 text-sm text-gray-700 dark:text-gray-200"><%= st.duration_years %> <%= currentLang === 'km' ? 'ឆ្នាំ' : 'yr' %></td>
                <td class="px-5 py-4 text-sm text-gray-700 dark:text-gray-200 max-w-[200px] truncate"><%= st.provider_name %></td>
                <td class="px-5 py-4">
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-bold rounded-full <%= st.is_active ? 'bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300' : 'bg-gray-100 dark:bg-gray-700 text-gray-500 dark:text-gray-400' %>">
                    <span class="w-1.5 h-1.5 rounded-full <%= st.is_active ? 'bg-green-500' : 'bg-gray-400' %>"></span>
                    <%= st.is_active ? (currentLang === 'km' ? 'សកម្ម' : 'Active') : (currentLang === 'km' ? 'មិនសកម្ម' : 'Inactive') %>
                  </span>
                </td>
                <td class="px-5 py-4">
                  <div class="flex gap-1.5 flex-wrap">
                    <button onclick='editType(<%= JSON.stringify(st) %>)' class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-green-200 text-green-600 dark:text-green-400 hover:bg-green-50 dark:hover:bg-green-900/20 transition-all flex items-center gap-1"><i class="bi bi-pencil"></i><%= currentLang === 'km' ? 'កែ' : 'Edit' %></button>
                    <form action="/admin/scholarship-types/<%= st.id %>/toggle" method="POST" class="inline">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="px-3 py-1.5 rounded-lg text-xs font-semibold border transition-all flex items-center gap-1 <%= st.is_active ? 'border-orange-200 text-orange-600 hover:bg-orange-50 dark:hover:bg-orange-900/20' : 'border-green-200 text-green-600 dark:text-green-400 hover:bg-green-50 dark:hover:bg-green-900/20' %>">
                        <i class="bi <%= st.is_active ? 'bi-pause-circle' : 'bi-play-circle' %>"></i>
                        <%= st.is_active ? (currentLang === 'km' ? 'បិទ' : 'Off') : (currentLang === 'km' ? 'បើក' : 'On') %>
                      </button>
                    </form>
                    <button type="button" onclick="confirmDelete(<%= st.id %>, '<%= currentLang === 'km' ? st.name_kh.replace(/'/g, "\\'") : (st.name_en || st.name_kh).replace(/'/g, "\\'") %>', event)" class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-red-200 text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 transition-all flex items-center gap-1"><i class="bi bi-trash"></i><%= currentLang === 'km' ? 'លុប' : 'Delete' %></button>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>

    <% if (totalPages > 1) { %>
      <div class="px-6 py-4 border-t border-gray-100 dark:border-gray-700 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <p class="text-sm text-gray-500 dark:text-gray-400">
          <%= currentLang === 'km' ? 'ទំព័រ' : 'Page' %> <%= currentPage %> <%= currentLang === 'km' ? 'នៃ' : 'of' %> <%= totalPages %>
        </p>
        <div class="flex gap-1">
          <% const stQs = 'search=' + encodeURIComponent(filters.search || '') + '&status=' + encodeURIComponent(filters.status || ''); %>
          <a href="?page=<%= currentPage - 1 %>&<%= stQs %>" class="px-4 py-2 rounded-xl text-sm font-medium transition-all <%= currentPage === 1 ? 'text-gray-300 dark:text-gray-600 cursor-not-allowed' : 'text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 hover:text-gray-900 dark:hover:text-white' %>">
            <i class="bi bi-chevron-left"></i>
            <span class="hidden sm:inline ml-1"><%= currentLang === 'km' ? 'មុន' : 'Previous' %></span>
          </a>
          <%
            let stPages = [];
            if (totalPages <= 7) {
              for (let i = 1; i <= totalPages; i++) stPages.push(i);
            } else {
              stPages.push(1);
              if (currentPage > 3) stPages.push('...');
              for (let i = Math.max(2, currentPage - 1); i <= Math.min(totalPages - 1, currentPage + 1); i++) {
                stPages.push(i);
              }
              if (currentPage < totalPages - 2) stPages.push('...');
              stPages.push(totalPages);
            }
          %>
          <% stPages.forEach(function(p) { %>
            <% if (p === '...') { %>
              <span class="px-2 py-2 text-sm text-gray-400 dark:text-gray-500">...</span>
            <% } else { %>
              <a href="?page=<%= p %>&<%= stQs %>" class="px-3.5 py-2 rounded-xl text-sm font-bold transition-all <%= currentPage === p ? 'bg-gradient-to-r from-green-600 to-emerald-500 text-white shadow-md' : 'text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 hover:text-gray-900 dark:hover:text-white' %>"><%= p %></a>
            <% } %>
          <% }); %>
          <a href="?page=<%= currentPage + 1 %>&<%= stQs %>" class="px-4 py-2 rounded-xl text-sm font-medium transition-all <%= currentPage === totalPages ? 'text-gray-300 dark:text-gray-600 cursor-not-allowed' : 'text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 hover:text-gray-900 dark:hover:text-white' %>">
            <span class="hidden sm:inline mr-1"><%= currentLang === 'km' ? 'បន្ទាប់' : 'Next' %></span>
            <i class="bi bi-chevron-right"></i>
          </a>
        </div>
      </div>
    <% } %>
  </div>
</div>

<div id="addTypeModal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4" onclick="if(event.target===this)this.classList.add('hidden')">
  <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl w-full max-w-lg" onclick="event.stopPropagation()">
    <form action="/admin/scholarship-types" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="px-6 py-4 bg-gradient-to-r from-green-600 to-emerald-500 text-white flex items-center justify-between rounded-t-2xl">
        <h5 class="font-bold flex items-center gap-2"><i class="bi bi-plus-circle"></i><%= currentLang === 'km' ? 'បន្ថែមប្រភេទអាហារូបករណ៍ថ្មី' : 'Add New Scholarship Type' %></h5>
        <button type="button" onclick="this.closest('[id$=Modal]').classList.add('hidden')" class="text-white/80 hover:text-white"><i class="bi bi-x-lg"></i></button>
      </div>
      <div class="p-6 space-y-4 max-h-[70vh] overflow-y-auto">
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'ឈ្មោះប្រភេទ (ខ្មែរ)' : 'Scholarship Name (Khmer)' %> <span class="text-red-500">*</span></label>
          <input type="text" name="name_kh" required placeholder="<%= currentLang === 'km' ? 'ឧ. អាហារូបករណ៍៥០% សិក្សារយៈពេល២ឆ្នាំ' : 'e.g. 50% Scholarship for 2 Years' %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'ឈ្មោះប្រភេទ (អង់គ្លេស)' : 'Scholarship Name (English)' %></label>
          <input type="text" name="name_en" placeholder="e.g. 50% Scholarship for 2 Years - NMU" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'ភាគរយថ្លៃសិក្សា (%)' : 'Coverage Percentage (%)' %> <span class="text-red-500">*</span></label>
            <input type="number" name="coverage_percentage" min="0" max="100" required placeholder="0-100" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'រយៈពេល (ឆ្នាំ)' : 'Duration (Years)' %> <span class="text-red-500">*</span></label>
            <input type="number" name="duration_years" min="1" max="10" required placeholder="1-10" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'អ្នកផ្តល់អាហារូបករណ៍' : 'Scholarship Provider' %> <span class="text-red-500">*</span></label>
          <input type="text" name="provider_name" required placeholder="<%= currentLang === 'km' ? 'ឧ. សាកលវិទ្យាល័យជាតិមានជ័យ' : 'e.g. National Meanchey University' %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'ពិពណ៌នា' : 'Description' %></label>
          <textarea name="description" rows="3" placeholder="<%= currentLang === 'km' ? 'ពិពណ៌នាអំពីអាហារូបករណ៍នេះ...' : 'Describe this scholarship type...' %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 resize-none"></textarea>
        </div>
      </div>
      <div class="px-6 py-4 bg-gray-50 dark:bg-gray-800/50 flex justify-end gap-2 border-t border-gray-100 dark:border-gray-700 rounded-b-2xl">
        <button type="button" onclick="this.closest('[id$=Modal]').classList.add('hidden')" class="px-4 py-2 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-200 rounded-xl text-sm font-medium hover:bg-gray-200 dark:hover:bg-gray-600 transition-all"><%= currentLang === 'km' ? 'បោះបង់' : 'Cancel' %></button>
        <button type="submit" class="px-5 py-2 bg-gradient-to-r from-green-600 to-emerald-500 text-white rounded-xl text-sm font-semibold hover:from-green-700 hover:to-emerald-600 transition-all shadow-sm flex items-center gap-1.5"><i class="bi bi-check-lg"></i><%= currentLang === 'km' ? 'រក្សាទុក' : 'Save' %></button>
      </div>
    </form>
  </div>
</div>

<div id="editTypeModal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4" onclick="if(event.target===this)this.classList.add('hidden')">
  <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl w-full max-w-lg" onclick="event.stopPropagation()">
    <form id="editTypeForm" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="px-6 py-4 bg-gradient-to-r from-green-600 to-emerald-500 text-white flex items-center justify-between rounded-t-2xl">
        <h5 class="font-bold flex items-center gap-2"><i class="bi bi-pencil"></i><%= currentLang === 'km' ? 'កែប្រែប្រភេទអាហារូបករណ៍' : 'Edit Scholarship Type' %></h5>
        <button type="button" onclick="document.getElementById('editTypeModal').classList.add('hidden')" class="text-white/80 hover:text-white"><i class="bi bi-x-lg"></i></button>
      </div>
      <div class="p-6 space-y-4 max-h-[70vh] overflow-y-auto">
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'ឈ្មោះប្រភេទ (ខ្មែរ)' : 'Scholarship Name (Khmer)' %> <span class="text-red-500">*</span></label>
          <input type="text" name="name_kh" id="edit_name_kh" required class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'ឈ្មោះប្រភេទ (អង់គ្លេស)' : 'Scholarship Name (English)' %></label>
          <input type="text" name="name_en" id="edit_name_en" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'ភាគរយថ្លៃសិក្សា (%)' : 'Coverage (%)' %> <span class="text-red-500">*</span></label>
            <input type="number" name="coverage_percentage" id="edit_coverage" min="0" max="100" required class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'រយៈពេល (ឆ្នាំ)' : 'Duration (Years)' %> <span class="text-red-500">*</span></label>
            <input type="number" name="duration_years" id="edit_duration" min="1" max="10" required class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'អ្នកផ្តល់អាហារូបករណ៍' : 'Provider' %> <span class="text-red-500">*</span></label>
          <input type="text" name="provider_name" id="edit_provider" required class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'ពិពណ៌នា' : 'Description' %></label>
          <textarea name="description" id="edit_description" rows="3" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 resize-none"></textarea>
        </div>
      </div>
      <div class="px-6 py-4 bg-gray-50 dark:bg-gray-800/50 flex justify-end gap-2 border-t border-gray-100 dark:border-gray-700 rounded-b-2xl">
        <button type="button" onclick="document.getElementById('editTypeModal').classList.add('hidden')" class="px-4 py-2 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-200 rounded-xl text-sm font-medium hover:bg-gray-200 dark:hover:bg-gray-600 transition-all"><%= currentLang === 'km' ? 'បោះបង់' : 'Cancel' %></button>
        <button type="submit" class="px-5 py-2 bg-gradient-to-r from-green-600 to-emerald-500 text-white rounded-xl text-sm font-semibold hover:from-green-700 hover:to-emerald-600 transition-all shadow-sm flex items-center gap-1.5"><i class="bi bi-check-lg"></i><%= currentLang === 'km' ? 'អាប់ដេត' : 'Update' %></button>
      </div>
    </form>
  </div>
</div>

<div id="deleteTypePopover" class="hidden fixed z-50 bg-white dark:bg-gray-800 rounded-xl shadow-2xl border border-gray-200 dark:border-gray-700 p-4 w-72" onclick="event.stopPropagation()">
  <div class="flex items-center gap-3 mb-3">
    <div class="w-10 h-10 bg-red-100 dark:bg-red-900/30 rounded-full flex items-center justify-center flex-shrink-0">
      <i class="bi bi-exclamation-triangle text-red-600 dark:text-red-400"></i>
    </div>
    <div>
      <p class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'លុបប្រភេទអាហារូបករណ៍' : 'Delete Scholarship Type' %></p>
      <p class="text-xs text-gray-500 dark:text-gray-400 truncate max-w-[180px]" id="deleteTypeName"></p>
    </div>
  </div>
  <div class="flex gap-2">
    <button onclick="closeDeleteTypePopover()" class="flex-1 px-3 py-2 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-lg text-xs font-semibold hover:bg-gray-200 dark:hover:bg-gray-600 transition"><%= currentLang === 'km' ? 'បោះបង់' : 'Cancel' %></button>
    <form id="deleteTypeForm" method="POST" class="flex-1">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="w-full px-3 py-2 bg-red-600 text-white rounded-lg text-xs font-semibold hover:bg-red-700 transition shadow-sm"><%= currentLang === 'km' ? 'លុប' : 'Delete' %></button>
    </form>
  </div>
</div>

<script>
function editType(st) {
  document.getElementById('editTypeForm').action = '/admin/scholarship-types/' + st.id + '/edit';
  document.getElementById('edit_name_kh').value = st.name_kh;
  document.getElementById('edit_name_en').value = st.name_en || '';
  document.getElementById('edit_coverage').value = st.coverage_percentage;
  document.getElementById('edit_duration').value = st.duration_years;
  document.getElementById('edit_provider').value = st.provider_name;
  document.getElementById('edit_description').value = st.description || '';
  document.getElementById('editTypeModal').classList.remove('hidden');
}

function confirmDelete(id, name, e) {
  var pop = document.getElementById('deleteTypePopover');
  document.getElementById('deleteTypeForm').action = '/admin/scholarship-types/' + id + '/delete';
  document.getElementById('deleteTypeName').textContent = name;
  pop.classList.remove('hidden');
  var rect = e.currentTarget.getBoundingClientRect();
  var popW = 288;
  var popH = pop.offsetHeight || 140;
  var left = rect.right + 8;
  if (left + popW > window.innerWidth) left = rect.left - popW - 8;
  var top = rect.top + (rect.height / 2) - (popH / 2);
  if (top < 8) top = 8;
  if (top + popH > window.innerHeight - 8) top = window.innerHeight - popH - 8;
  pop.style.left = left + 'px';
  pop.style.top = top + 'px';
}

function closeDeleteTypePopover() {
  document.getElementById('deleteTypePopover').classList.add('hidden');
}

document.addEventListener('click', function(e) {
  var pop = document.getElementById('deleteTypePopover');
  if (!pop.classList.contains('hidden') && !pop.contains(e.target) && !e.target.closest('[onclick*="confirmDelete"]')) {
    closeDeleteTypePopover();
  }
});
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') closeDeleteTypePopover();
});
</script>
