<div class="max-w-7xl mx-auto space-y-6">
  <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
    <div class="px-6 py-5">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="flex items-center gap-4">
          <div class="w-14 h-14 rounded-full bg-gradient-to-br from-green-400 to-emerald-500 flex items-center justify-center text-white font-bold text-lg flex-shrink-0 shadow-lg shadow-green-500/20 ring-2 ring-green-100 dark:ring-green-900">
            <i class="bi bi-mortarboard-fill"></i>
          </div>
          <div>
            <h1 class="text-xl font-bold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ប្រព័ន្ធគ្រប់គ្រងអាហារូបករណ៍ និងការចុះឈ្មោះអនឡាញ NMU' : 'NMU Scholarship & Enroll Online Management' %></h1>
            <p class="text-gray-500 dark:text-gray-400 text-sm"><%= currentLang === 'km' ? 'សាកលវិទ្យាល័យជាតិមានជ័យ' : 'National Meanchey University' %> <span class="ml-2 px-2 py-0.5 bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 rounded-full text-xs font-bold"><%= total %></span></p>
          </div>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href="/admin/applications" class="px-4 py-2 bg-gradient-to-r from-green-600 to-emerald-500 text-white rounded-xl text-sm font-semibold hover:from-green-700 hover:to-emerald-600 transition-all shadow-sm flex items-center gap-1.5"><i class="bi bi-eye"></i><%= currentLang === 'km' ? 'មើលពាក្យសុំ' : 'View Applications' %></a>
          <a href="/admin/reports/export/excel" class="px-4 py-2 bg-gradient-to-r from-emerald-600 to-green-500 text-white rounded-xl text-sm font-semibold hover:from-emerald-700 hover:to-green-600 transition-all shadow-sm flex items-center gap-1.5"><i class="bi bi-file-earmark-excel"></i><%= currentLang === 'km' ? 'ទាញយក Excel' : 'Export Excel' %></a>
          <a href="/admin/reports" class="px-4 py-2 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-200 rounded-xl text-sm font-medium hover:bg-gray-200 dark:hover:bg-gray-600 transition-all flex items-center gap-1.5"><i class="bi bi-arrow-repeat"></i><%= currentLang === 'km' ? 'របាយការណ៍' : 'Reports' %></a>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
    <div class="bg-white dark:bg-gray-800 rounded-2xl p-4 shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-md transition-all">
      <div class="w-10 h-10 bg-gradient-to-br from-green-400 to-emerald-500 rounded-xl flex items-center justify-center mb-3 shadow-sm"><i class="bi bi-folder text-white"></i></div>
      <div class="text-2xl font-bold text-gray-900 dark:text-gray-100"><%= total %></div>
      <div class="text-gray-500 dark:text-gray-400 text-xs"><%= currentLang === 'km' ? 'សរុបពាក្យសុំ' : 'Total' %></div>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-2xl p-4 shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-md transition-all">
      <div class="w-10 h-10 bg-gradient-to-br from-yellow-400 to-orange-500 rounded-xl flex items-center justify-center mb-3 shadow-sm"><i class="bi bi-clock text-white"></i></div>
      <div class="text-2xl font-bold text-gray-900 dark:text-gray-100"><%= pending %></div>
      <div class="text-gray-500 dark:text-gray-400 text-xs"><%= currentLang === 'km' ? 'រង់ចាំ' : 'Pending' %></div>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-2xl p-4 shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-md transition-all">
      <div class="w-10 h-10 bg-gradient-to-br from-green-500 to-teal-500 rounded-xl flex items-center justify-center mb-3 shadow-sm"><i class="bi bi-check-circle text-white"></i></div>
      <div class="text-2xl font-bold text-gray-900 dark:text-gray-100"><%= approved %></div>
      <div class="text-gray-500 dark:text-gray-400 text-xs"><%= currentLang === 'km' ? 'អនុម័ត' : 'Approved' %></div>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-2xl p-4 shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-md transition-all">
      <div class="w-10 h-10 bg-gradient-to-br from-red-400 to-rose-500 rounded-xl flex items-center justify-center mb-3 shadow-sm"><i class="bi bi-x-circle text-white"></i></div>
      <div class="text-2xl font-bold text-gray-900 dark:text-gray-100"><%= rejected %></div>
      <div class="text-gray-500 dark:text-gray-400 text-xs"><%= currentLang === 'km' ? 'បដិសេធ' : 'Rejected' %></div>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-2xl p-4 shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-md transition-all">
      <div class="w-10 h-10 bg-gradient-to-br from-blue-400 to-indigo-500 rounded-xl flex items-center justify-center mb-3 shadow-sm"><i class="bi bi-eye text-white"></i></div>
      <div class="text-2xl font-bold text-gray-900 dark:text-gray-100"><%= underReview %></div>
      <div class="text-gray-500 dark:text-gray-400 text-xs"><%= currentLang === 'km' ? 'កំពុងពិនិត្យ' : 'Review' %></div>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-2xl p-4 shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-md transition-all">
      <div class="w-10 h-10 bg-gradient-to-br from-purple-400 to-violet-500 rounded-xl flex items-center justify-center mb-3 shadow-sm"><i class="bi bi-pencil text-white"></i></div>
      <div class="text-2xl font-bold text-gray-900 dark:text-gray-100"><%= correction %></div>
      <div class="text-gray-500 dark:text-gray-400 text-xs"><%= currentLang === 'km' ? 'កែប្រែ' : 'Correction' %></div>
    </div>
  </div>

  <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
    <div class="px-6 py-4 bg-gradient-to-r from-green-600 to-emerald-500 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <i class="bi bi-clock-history text-white/80"></i>
        <h2 class="font-bold text-white"><%= currentLang === 'km' ? 'ពាក្យសុំថ្មីៗ' : 'Recent Applications' %></h2>
      </div>
      <a href="/admin/applications" class="text-sm text-white/80 hover:text-white font-medium transition-all flex items-center gap-1"><%= currentLang === 'km' ? 'មើលទាំងអស់' : 'View All' %> <i class="bi bi-arrow-right"></i></a>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="bg-gray-50 dark:bg-gray-800/50 border-b border-gray-100 dark:border-gray-700">
            <th class="px-5 py-3.5 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= currentLang === 'km' ? 'លេខ' : 'No.' %></th>
            <th class="px-5 py-3.5 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= currentLang === 'km' ? 'ឈ្មោះ' : 'Name' %></th>
            <th class="px-5 py-3.5 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= currentLang === 'km' ? 'ភេទ' : 'Gender' %></th>
            <th class="px-5 py-3.5 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= currentLang === 'km' ? 'ជំនាញ' : 'Major' %></th>
            <th class="px-5 py-3.5 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider hidden md:table-cell"><%= currentLang === 'km' ? 'ប្រភេទ' : 'Category' %></th>
            <th class="px-5 py-3.5 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= currentLang === 'km' ? 'កាលបរិច្ឆេទ' : 'Date' %></th>
            <th class="px-5 py-3.5 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50 dark:divide-gray-700">
          <% if (recent && recent.length > 0) { %>
            <% recent.forEach(function(app, index) { %>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
                <td class="px-5 py-4 text-sm text-gray-500 dark:text-gray-400"><%= index + 1 %></td>
                <td class="px-5 py-4">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full bg-gradient-to-br from-green-400 to-emerald-500 flex items-center justify-center text-white font-bold text-xs flex-shrink-0 shadow-sm">
                      <%= (app.student_name || app.english_first_name || 'N').charAt(0).toUpperCase() %>
                    </div>
                    <span class="font-medium text-gray-900 dark:text-gray-100 text-sm"><%= app.student_name || app.english_first_name + ' ' + app.english_last_name %></span>
                  </div>
                </td>
                <td class="px-5 py-4">
                  <span class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-bold rounded-full <%= app.gender === 'male' ? 'bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300' : 'bg-pink-100 dark:bg-pink-900/30 text-pink-700 dark:text-pink-300' %>">
                    <span class="w-1.5 h-1.5 rounded-full <%= app.gender === 'male' ? 'bg-blue-500' : 'bg-pink-500' %>"></span>
                    <%= app.gender === 'male' ? (currentLang === 'km' ? 'ប្រុស' : 'M') : (currentLang === 'km' ? 'ស្រី' : 'F') %>
                  </span>
                </td>
                <td class="px-5 py-4">
                  <span class="inline-flex items-center px-2.5 py-1 text-xs font-bold rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300"><%= currentLang === 'km' ? app.major_name_kh : app.major_name_en %></span>
                </td>
                <td class="px-5 py-4 text-sm text-gray-600 dark:text-gray-300 hidden md:table-cell"><%= currentLang === 'km' ? app.category_name_kh : app.category_name_en %></td>
                <td class="px-5 py-4 text-sm text-gray-500 dark:text-gray-400"><%= app.submitted_at ? new Date(app.submitted_at).toLocaleDateString() : '—' %></td>
                <td class="px-5 py-4">
                  <a href="/admin/applications/<%= app.id %>" class="p-2 hover:bg-green-50 dark:hover:bg-green-900/20 rounded-lg transition-all text-green-600 dark:text-green-400 inline-flex">
                    <i class="bi bi-arrow-right"></i>
                  </a>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="7" class="px-5 py-12 text-center">
                <div class="flex flex-col items-center gap-2">
                  <i class="bi bi-inbox text-4xl text-gray-300 dark:text-gray-600"></i>
                  <p class="text-gray-500 dark:text-gray-400 font-medium"><%= currentLang === 'km' ? 'មិនទាន់មានពាក្យសុំ' : 'No applications yet' %></p>
                </div>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>