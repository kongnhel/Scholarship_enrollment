<div class="max-w-7xl mx-auto space-y-6">
  <div class="relative overflow-hidden rounded-3xl bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 shadow-sm">
    <div class="absolute top-0 right-0 w-40 h-40 bg-green-50 dark:bg-green-900/20 rounded-bl-[6rem] -mr-10 -mt-10"></div>
    <div class="relative px-6 py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 bg-gradient-to-br from-green-500 to-emerald-600 rounded-2xl flex items-center justify-center shadow-md shadow-green-500/20 flex-shrink-0">
          <i class="bi bi-graph-up text-white text-xl"></i>
        </div>
        <div>
          <h1 class="text-xl font-bold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'របាយការណ៍និងស្ថិតិ' : 'Reports & Statistics' %></h1>
          <p class="text-sm text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'ទិន្នន័យវិភាគស្តីពីពាក្យសុំអាហារូបករណ៍' : 'Analytics and insights on scholarship applications' %></p>
        </div>
      </div>
      <div class="flex gap-2 self-start sm:self-auto">
        <a href="/admin/reports/export/excel" class="px-5 py-2.5 bg-gradient-to-r from-green-600 to-emerald-500 text-white rounded-xl text-sm font-semibold hover:from-green-700 hover:to-emerald-600 transition-all shadow-sm flex items-center gap-2"><i class="bi bi-file-earmark-excel"></i><%= currentLang === 'km' ? 'Excel' : 'Export Excel' %></a>
        <a href="/admin/reports/export/pdf" target="_blank" class="px-5 py-2.5 bg-gradient-to-r from-red-500 to-rose-600 text-white rounded-xl text-sm font-semibold hover:from-red-600 hover:to-rose-700 transition-all shadow-sm flex items-center gap-2"><i class="bi bi-file-earmark-pdf"></i><%= currentLang === 'km' ? 'PDF' : 'Preview PDF' %></a>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
    <div class="bg-gradient-to-br from-green-500 to-emerald-600 rounded-2xl p-5 text-white shadow-lg shadow-green-500/20">
      <div class="flex items-center gap-2 mb-1">
        <i class="bi bi-folder text-green-100"></i>
        <p class="text-green-100 text-xs font-medium"><%= currentLang === 'km' ? 'សរុបពាក្យសុំ' : 'Total' %></p>
      </div>
      <h3 class="text-3xl font-bold mt-1"><%= total %></h3>
    </div>
    <% byStatus.forEach(function(s) { %>
      <div class="bg-white dark:bg-gray-800 rounded-2xl p-5 shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-md transition-all">
        <div class="flex items-center gap-2 mb-1">
          <span class="w-2.5 h-2.5 rounded-full <%= s.status === 'approved' ? 'bg-green-500' : s.status === 'rejected' ? 'bg-red-500' : s.status === 'pending' ? 'bg-yellow-500' : s.status === 'under_review' ? 'bg-blue-500' : 'bg-orange-500' %>"></span>
          <p class="text-xs font-semibold uppercase <%= s.status === 'approved' ? 'text-green-600 dark:text-green-400' : s.status === 'rejected' ? 'text-red-600 dark:text-red-400' : s.status === 'pending' ? 'text-yellow-600' : s.status === 'under_review' ? 'text-blue-600 dark:text-blue-400' : 'text-orange-600 dark:text-orange-400' %>"><%= s.status === 'pending' ? (currentLang === 'km' ? 'រង់ចាំ' : 'Pending') : s.status === 'approved' ? (currentLang === 'km' ? 'អនុម័ត' : 'Approved') : s.status === 'rejected' ? (currentLang === 'km' ? 'បដិសេធ' : 'Rejected') : s.status === 'under_review' ? (currentLang === 'km' ? 'កំពុងពិនិត្យ' : 'Review') : (currentLang === 'km' ? 'កែប្រែ' : 'Correction') %></p>
        </div>
        <h3 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mt-1"><%= s.count %></h3>
      </div>
    <% }); %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 p-5">
      <canvas id="statusChart"></canvas>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 p-5">
      <canvas id="genderChart"></canvas>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 p-5">
      <canvas id="majorChart"></canvas>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 p-5">
      <canvas id="categoryChart"></canvas>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
      <div class="px-6 py-3.5 border-b border-gray-100 dark:border-gray-700 flex items-center gap-2.5">
        <div class="w-8 h-8 bg-green-100 dark:bg-green-900/40 rounded-lg flex items-center justify-center">
          <i class="bi bi-book text-green-600 dark:text-green-400 text-sm"></i>
        </div>
        <h5 class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ពាក្យសុំតាមជំនាញ' : 'Applications by Major' %></h5>
      </div>
      <div class="p-5 overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="bg-gray-50 dark:bg-gray-800/50 border-b border-gray-100 dark:border-gray-700">
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= currentLang === 'km' ? 'ជំនាញ' : 'Major' %></th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= currentLang === 'km' ? 'ចំនួន' : 'Count' %></th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= currentLang === 'km' ? 'ភាគរយ' : 'Percentage' %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-50 dark:divide-gray-700">
            <% byMajor.forEach(function(m) { %>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
                <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-200"><%= currentLang === 'km' ? (m.name_kh || 'N/A') : (m.name_en || 'N/A') %></td>
                <td class="px-4 py-3 text-sm font-semibold text-gray-900 dark:text-gray-100"><%= m.count %></td>
                <td class="px-4 py-3">
                  <div class="flex items-center gap-2">
                    <div class="flex-1 h-2 bg-gray-100 dark:bg-gray-700 rounded-full overflow-hidden">
                      <div class="h-full bg-gradient-to-r from-green-400 to-emerald-500 rounded-full" style="width: <%= total > 0 ? ((m.count / total) * 100) : 0 %>%"></div>
                    </div>
                    <span class="text-sm text-gray-500 dark:text-gray-400"><%= total > 0 ? ((m.count / total) * 100).toFixed(1) : 0 %>%</span>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
      <div class="px-6 py-3.5 border-b border-gray-100 dark:border-gray-700 flex items-center gap-2.5">
        <div class="w-8 h-8 bg-emerald-100 dark:bg-emerald-900/40 rounded-lg flex items-center justify-center">
          <i class="bi bi-tag text-emerald-600 dark:text-emerald-400 text-sm"></i>
        </div>
        <h5 class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ពាក្យសុំតាមប្រភេទ' : 'Applications by Category' %></h5>
      </div>
      <div class="p-5 overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="bg-gray-50 dark:bg-gray-800/50 border-b border-gray-100 dark:border-gray-700">
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= currentLang === 'km' ? 'ប្រភេទ' : 'Category' %></th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= currentLang === 'km' ? 'ចំនួន' : 'Count' %></th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= currentLang === 'km' ? 'ភាគរយ' : 'Percentage' %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-50 dark:divide-gray-700">
            <% byCategory.forEach(function(c) { %>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
                <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-200"><%= currentLang === 'km' ? (c.name_kh || 'N/A') : (c.name_en || 'N/A') %></td>
                <td class="px-4 py-3 text-sm font-semibold text-gray-900 dark:text-gray-100"><%= c.count %></td>
                <td class="px-4 py-3">
                  <div class="flex items-center gap-2">
                    <div class="flex-1 h-2 bg-gray-100 dark:bg-gray-700 rounded-full overflow-hidden">
                      <div class="h-full bg-gradient-to-r from-green-400 to-emerald-500 rounded-full" style="width: <%= total > 0 ? ((c.count / total) * 100) : 0 %>%"></div>
                    </div>
                    <span class="text-sm text-gray-500 dark:text-gray-400"><%= total > 0 ? ((c.count / total) * 100).toFixed(1) : 0 %>%</span>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
      <div class="px-6 py-3.5 border-b border-gray-100 dark:border-gray-700 flex items-center gap-2.5">
        <div class="w-8 h-8 bg-blue-100 dark:bg-blue-900/40 rounded-lg flex items-center justify-center">
          <i class="bi bi-geo-alt text-blue-600 dark:text-blue-400 text-sm"></i>
        </div>
        <h5 class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ពាក្យសុំតាមខេត្ត' : 'Applications by Province' %></h5>
      </div>
      <div class="p-5 overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="bg-gray-50 dark:bg-gray-800/50 border-b border-gray-100 dark:border-gray-700">
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= currentLang === 'km' ? 'ខេត្ត' : 'Province' %></th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= currentLang === 'km' ? 'ចំនួន' : 'Count' %></th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= currentLang === 'km' ? 'ភាគរយ' : 'Percentage' %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-50 dark:divide-gray-700">
            <% byProvince.forEach(function(p) { %>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
                <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-200"><%= currentLang === 'km' ? (p.name_kh || 'N/A') : (p.name_en || 'N/A') %></td>
                <td class="px-4 py-3 text-sm font-semibold text-gray-900 dark:text-gray-100"><%= p.count %></td>
                <td class="px-4 py-3">
                  <div class="flex items-center gap-2">
                    <div class="flex-1 h-2 bg-gray-100 dark:bg-gray-700 rounded-full overflow-hidden">
                      <div class="h-full bg-gradient-to-r from-green-400 to-emerald-500 rounded-full" style="width: <%= total > 0 ? ((p.count / total) * 100) : 0 %>%"></div>
                    </div>
                    <span class="text-sm text-gray-500 dark:text-gray-400"><%= total > 0 ? ((p.count / total) * 100).toFixed(1) : 0 %>%</span>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
      <div class="px-6 py-3.5 border-b border-gray-100 dark:border-gray-700 flex items-center gap-2.5">
        <div class="w-8 h-8 bg-purple-100 dark:bg-purple-900/40 rounded-lg flex items-center justify-center">
          <i class="bi bi-gender-ambiguous text-purple-600 dark:text-purple-400 text-sm"></i>
        </div>
        <h5 class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ពាក្យសុំតាមភេទ' : 'Applications by Gender' %></h5>
      </div>
      <div class="p-5 overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="bg-gray-50 dark:bg-gray-800/50 border-b border-gray-100 dark:border-gray-700">
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= currentLang === 'km' ? 'ភេទ' : 'Gender' %></th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= currentLang === 'km' ? 'ចំនួន' : 'Count' %></th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= currentLang === 'km' ? 'ភាគរយ' : 'Percentage' %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-50 dark:divide-gray-700">
            <% byGender.forEach(function(g) { %>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
                <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-200"><%= g.gender === 'male' ? (currentLang === 'km' ? 'ប្រុស' : 'Male') : (currentLang === 'km' ? 'ស្រី' : 'Female') %></td>
                <td class="px-4 py-3 text-sm font-semibold text-gray-900 dark:text-gray-100"><%= g.count %></td>
                <td class="px-4 py-3">
                  <div class="flex items-center gap-2">
                    <div class="flex-1 h-2 bg-gray-100 dark:bg-gray-700 rounded-full overflow-hidden">
                      <div class="h-full bg-gradient-to-r from-green-400 to-emerald-500 rounded-full" style="width: <%= total > 0 ? ((g.count / total) * 100) : 0 %>%"></div>
                    </div>
                    <span class="text-sm text-gray-500 dark:text-gray-400"><%= total > 0 ? ((g.count / total) * 100).toFixed(1) : 0 %>%</span>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var statusLabels = [<% byStatus.forEach(function(s, i) { %>'<%= (s.status === 'pending' ? (currentLang === 'km' ? 'រង់ចាំ' : 'PENDING') : s.status === 'approved' ? (currentLang === 'km' ? 'អនុម័ត' : 'APPROVED') : s.status === 'rejected' ? (currentLang === 'km' ? 'បដិសេធ' : 'REJECTED') : s.status === 'under_review' ? (currentLang === 'km' ? 'កំពុងពិនិត្យ' : 'REVIEW') : (currentLang === 'km' ? 'កែប្រែ' : 'CORRECTION')) %>'<%= i < byStatus.length - 1 ? ',' : '' %><% }); %>];
  var statusCounts = [<% byStatus.forEach(function(s, i) { %><%= s.count %><%= i < byStatus.length - 1 ? ',' : '' %><% }); %>];
  new Chart(document.getElementById('statusChart'), { type: 'doughnut', data: { labels: statusLabels, datasets: [{ data: statusCounts, backgroundColor: ['#f59e0b', '#3b82f6', '#22c55e', '#ef4444', '#f97316'], borderWidth: 0 }] }, options: { responsive: true, plugins: { legend: { position: 'bottom' }, title: { display: true, text: '<%= currentLang === 'km' ? 'ស្ថានភាពពាក្យសុំ' : 'Application Status' %>', color: '#6b7280', font: { size: 14 } } } } });

  var genderLabels = [<% byGender.forEach(function(g, i) { %>'<%= g.gender === 'male' ? (currentLang === 'km' ? 'ប្រុស' : 'Male') : (currentLang === 'km' ? 'ស្រី' : 'Female') %>'<%= i < byGender.length - 1 ? ',' : '' %><% }); %>];
  var genderCounts = [<% byGender.forEach(function(g, i) { %><%= g.count %><%= i < byGender.length - 1 ? ',' : '' %><% }); %>];
  new Chart(document.getElementById('genderChart'), { type: 'pie', data: { labels: genderLabels, datasets: [{ data: genderCounts, backgroundColor: ['#3b82f6', '#ec4899'], borderWidth: 0 }] }, options: { responsive: true, plugins: { legend: { position: 'bottom' }, title: { display: true, text: '<%= currentLang === 'km' ? 'ពាក្យសុំតាមភេទ' : 'Applications by Gender' %>', color: '#6b7280', font: { size: 14 } } } } });

  var majorLabels = [<% byMajor.forEach(function(m, i) { %>'<%= (currentLang === 'km' ? (m.name_kh || 'N/A') : (m.name_en || 'N/A')) %>'<%= i < byMajor.length - 1 ? ',' : '' %><% }); %>];
  var majorCounts = [<% byMajor.forEach(function(m, i) { %><%= m.count %><%= i < byMajor.length - 1 ? ',' : '' %><% }); %>];
  new Chart(document.getElementById('majorChart'), { type: 'bar', data: { labels: majorLabels, datasets: [{ data: majorCounts, backgroundColor: ['#3b82f6', '#22c55e', '#f59e0b', '#ef4444', '#8b5cf6', '#ec4899', '#14b8a6', '#f97316'], borderWidth: 0 }] }, options: { responsive: true, plugins: { legend: { display: false }, title: { display: true, text: '<%= currentLang === 'km' ? 'ពាក្យសុំតាមជំនាញ' : 'Applications by Major' %>', color: '#6b7280', font: { size: 14 } } }, scales: { y: { beginAtZero: true } } } });

  var categoryLabels = [<% byCategory.forEach(function(c, i) { %>'<%= (currentLang === 'km' ? (c.name_kh || 'N/A') : (c.name_en || 'N/A')) %>'<%= i < byCategory.length - 1 ? ',' : '' %><% }); %>];
  var categoryCounts = [<% byCategory.forEach(function(c, i) { %><%= c.count %><%= i < byCategory.length - 1 ? ',' : '' %><% }); %>];
  new Chart(document.getElementById('categoryChart'), { type: 'bar', data: { labels: categoryLabels, datasets: [{ data: categoryCounts, backgroundColor: ['#3b82f6', '#22c55e', '#f59e0b', '#ef4444', '#8b5cf6', '#ec4899'], borderWidth: 0 }] }, options: { responsive: true, plugins: { legend: { display: false }, title: { display: true, text: '<%= currentLang === 'km' ? 'ពាក្យសុំតាមប្រភេទ' : 'Applications by Category' %>', color: '#6b7280', font: { size: 14 } } }, scales: { y: { beginAtZero: true } } } });
});
</script>