            </div>

            <div>
              <label class="doc-row flex items-start gap-3 p-3 border border-gray-200 dark:border-gray-700 rounded-xl hover:bg-gray-50 dark:hover:bg-gray-700/50 cursor-pointer transition-all">
                <input type="checkbox" name="documents_ready" value="photo_3x4" data-upload="upload-photo-3x4" class="mt-0.5 text-green-600 focus:ring-green-500 rounded">
                <span class="text-sm text-gray-700 dark:text-gray-200"><%= currentLang === 'km' ? 'រូបថតទំហំ 3 × 4 ថតចំពីមុខ ឥតពាក់វ៉ែនតា ចំនួន ០២ សន្លឹក' : '3 × 4 photo, taken from the front, without glasses (2 sheets)' %></span>
              </label>
              <div id="upload-photo-3x4" class="mt-2 ml-4 pl-4 border-l-2 border-green-200 dark:border-green-900 space-y-1.5" style="display:none">
                <p class="text-xs font-semibold text-green-600 dark:text-green-400"><i class="bi bi-cloud-arrow-up mr-1"></i><%= currentLang === 'km' ? 'បង្ហោះរូបថត 3 × 4' : 'Upload 3 × 4 photo' %></p>
                <input type="file" name="photo_3x4" accept=".jpg,.jpeg,.png" class="w-full text-sm text-gray-500 dark:text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-green-50 file:text-green-700 dark:file:bg-green-900/30 dark:file:text-green-300 hover:file:bg-green-100 dark:hover:file:bg-green-900/50">
                <p class="text-xs text-gray-400 dark:text-gray-500">JPG, PNG • Max 5MB</p>
              </div>
            </div>
          </div>
          <p class="text-xs text-gray-400 dark:text-gray-500 mt-3"><%= currentLang === 'km' ? 'សូមធីកឯកសារដែលអ្នកបានត្រៀមរួច បន្ទាប់មកបង្ហោះឯកសារនីមួយៗ។' : 'Tick the documents you have prepared, then upload each file below it.' %></p>
        </div>
      </div>
    </div>

    <!-- V. កិច្ចសន្យា និងការធានាទទួលខុសត្រូវ -->
    <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
      <div class="px-6 py-3.5 border-b border-gray-100 dark:border-gray-700 flex items-center gap-2.5">
        <div class="w-8 h-8 bg-amber-100 dark:bg-amber-900/40 rounded-lg flex items-center justify-center">
          <i class="bi bi-file-earmark-text text-amber-600 dark:text-amber-400 text-sm"></i>
        </div>
        <span class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'V. កិច្ចសន្យា និងការធានាទទួលខុសត្រូវ' : 'V. Contract and Responsibility' %></span>
      </div>
      <div class="p-6 space-y-5">
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '៣០. ព័ត៌មានបន្ថែម / សេចក្តីបញ្ជាក់របស់បេក្ខជន' : '30. Additional Information / Candidate Statement' %></label>
          <textarea name="additional_info" rows="3" placeholder="<%= currentLang === 'km' ? 'ប្រសិនបើមានព័ត៌មានចាំបាច់ផ្សេងទៀត សូមបញ្ជាក់នៅទីនេះ។' : 'If there is any other necessary information, please state it here.' %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none resize-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100"></textarea>
        </div>

        <label class="flex items-start gap-3 p-4 border border-gray-200 dark:border-gray-700 rounded-xl bg-gray-50 dark:bg-gray-900/30 cursor-pointer">
          <input type="checkbox" name="declaration_confirmed" value="1" id="declarationConfirmed" class="mt-0.5 text-green-600 focus:ring-green-500 rounded">
          <span class="text-sm text-gray-700 dark:text-gray-200"><%= currentLang === 'km' ? '៣១. ខ្ញុំសូមបញ្ជាក់ថា ព័ត៌មានដែលខ្ញុំបានបំពេញខាងលើគឺត្រឹមត្រូវ ហើយខ្ញុំទទួលខុសត្រូវចំពោះព័ត៌មានដែលបានផ្តល់។' : '31. I hereby confirm that the information I have provided above is correct, and I take responsibility for the information given.' %> <span class="text-red-500">*</span></span>
        </label>
      </div>
    </div>

    <div class="flex justify-end gap-3">
      <a href="/student/dashboard" class="px-6 py-2.5 border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 rounded-xl hover:bg-gray-50 dark:hover:bg-gray-700 transition-all font-medium text-sm">
        <i class="bi bi-arrow-left mr-1"></i><%= currentLang === 'km' ? 'បោះបង់' : 'Cancel' %>
      </a>
      <button type="submit" class="px-6 py-2.5 bg-gradient-to-r from-green-500 to-emerald-600 text-white rounded-xl hover:from-green-600 hover:to-emerald-700 transition-all font-medium shadow-md hover:shadow-lg text-sm flex items-center gap-1.5">
        <i class="bi bi-send"></i><%= currentLang === 'km' ? 'ដាក់ស្នើពាក្យសុំ' : 'Submit Application' %>
      </button>
    </div>
  </form>
</div>
<style>
  .doc-row:has(input:checked) { border-color:#22c55e; background:#f0fdf4; }
  .dark .doc-row:has(input:checked) { border-color:#16a34a; background:rgba(6,78,59,.25); }
  .doc-row:has(input:checked) span { font-weight:600; color:#166534; }
  .dark .doc-row:has(input:checked) span { color:#86efac; }

  #posterSlideshow.has-poster { border-color:rgba(255,255,255,.14); cursor:grab; }
  #posterSlideshow.has-poster.dragging { cursor:grabbing; user-select:none; -webkit-user-select:none; }

  #posterSlideshow.has-poster .poster-slide { object-position:50% 22%; filter:contrast(1.05) saturate(1.08) brightness(1.03); }
  #posterSlideshow.has-poster .hero-scrim {
    background:
      linear-gradient(to bottom, rgba(2,14,9,.60) 0%, rgba(2,14,9,0) 30%),
      linear-gradient(100deg, rgba(2,14,9,.93) 0%, rgba(3,17,12,.86) 34%, rgba(3,17,12,.58) 58%, rgba(3,17,12,.24) 82%, rgba(3,17,12,.10) 100%),
      linear-gradient(to top, rgba(2,14,9,.80) 0%, rgba(2,14,9,0) 58%);
  }
  #posterSlideshow.has-poster .hero-panel {
    background:rgba(4,20,14,.58);
    border:1px solid rgba(255,255,255,.16);
    border-radius:1rem;
    padding:.8rem 1rem;
    backdrop-filter:blur(10px);
    -webkit-backdrop-filter:blur(10px);
    box-shadow:0 10px 30px rgba(0,0,0,.30);
  }
  #posterSlideshow .hero-panel { min-width:0; }
  #posterSlideshow h1,
  #posterSlideshow .hdr-desc,
  #posterSlideshow .hdr-sub { overflow-wrap:anywhere; min-width:0; }
  #posterSlideshow.has-poster h1 { color:#ffffff; text-shadow:0 2px 10px rgba(0,0,0,.55); }
  #posterSlideshow.has-poster .hdr-sub { color:rgba(255,255,255,.85); font-weight:500; text-shadow:0 1px 6px rgba(0,0,0,.5); }
  #posterSlideshow.has-poster .hdr-desc { color:rgba(255,255,255,.95); text-shadow:0 1px 5px rgba(0,0,0,.45); }
  #posterSlideshow.has-poster .hdr-chip {
    background:linear-gradient(135deg,#16a34a,#10b981);
    color:#ffffff;
    border:1px solid rgba(255,255,255,.28);
    box-shadow:0 4px 14px rgba(16,185,129,.35);
    backdrop-filter:none;
  }
  #posterSlideshow.has-poster .hdr-chip i { color:#ffffff; }
  #posterSlideshow.has-poster .hdr-btn {
    color:#fff;
    border-color:rgba(255,255,255,.38);
    background:rgba(3,17,12,.70);
    backdrop-filter:blur(10px);
    -webkit-backdrop-filter:blur(10px);
    box-shadow:0 6px 18px rgba(0,0,0,.35);
    text-shadow:0 1px 4px rgba(0,0,0,.55);
  }
  #posterSlideshow.has-poster .hdr-btn:hover { background:rgba(3,17,12,.9); border-color:rgba(255,255,255,.8); }
  #posterSlideshow.has-poster .dots-tray {
    background:rgba(3,17,12,.62);
    border:1px solid rgba(255,255,255,.18);
    border-radius:999px;
    padding:6px 10px;
    backdrop-filter:blur(8px);
    -webkit-backdrop-filter:blur(8px);
  }
  #posterSlideshow.has-poster .poster-dot { box-shadow:0 1px 6px rgba(0,0,0,.4); }
  #posterSlideshow.has-poster .poster-dot:hover { background:rgba(255,255,255,.9) !important; }

  #posterSlideshow:not(.has-poster) .hero-panel {
    background:none; border:none; box-shadow:none;
    backdrop-filter:none; -webkit-backdrop-filter:none; padding:0;
  }

  .poster-progress { background:rgba(255,255,255,.22); }
  .poster-progress > span {
    display:block; height:100%; width:100%;
    background:linear-gradient(90deg,#22c55e,#34d399);
    transform:scaleX(0); transform-origin:left center;
  }
  #posterSlideshow.playing .poster-progress > span { animation:posterBar 4.5s linear infinite; }
  @keyframes posterBar { from { transform:scaleX(0); } to { transform:scaleX(1); } }
</style>
<script>
function toggleDocUpload(cb) {
  var box = document.getElementById(cb.getAttribute('data-upload'));
  if (!box) return;
  if (cb.checked) {
    box.style.display = '';
  } else {
    box.style.display = 'none';
    var f = box.querySelector('input[type="file"]');
    if (f) f.value = '';
  }
}
document.querySelectorAll('input[name="documents_ready"]').forEach(function(cb) {
  cb.addEventListener('change', function() { toggleDocUpload(cb); });
});
(function() {
  var box = document.getElementById('posterSlideshow');
  if (!box) return;
  var slides = box.querySelectorAll('.poster-slide');
  var dots = box.querySelectorAll('.poster-dot');
  if (slides.length < 2) return;
  var idx = 0, timer = null, wheelAcc = 0, wheelLock = 0;
  function show(n) {
    idx = (n + slides.length) % slides.length;
    slides.forEach(function(s, i) { s.style.opacity = (i === idx ? 1 : 0); });
    dots.forEach(function(d, i) {
      d.style.width = (i === idx ? 24 : 10) + 'px';
      d.style.background = (i === idx ? '#ffffff' : 'rgba(255,255,255,.45)');
    });
  }
  function next() { show(idx + 1); }
  function prev() { show(idx - 1); }
  function stop() { clearInterval(timer); timer = null; box.classList.remove('playing'); }
  function play() { stop(); timer = setInterval(function() { show(idx + 1); }, 4500); box.classList.add('playing'); }
  function manual(fn) { fn(); play(); }

  dots.forEach(function(d) {
    d.addEventListener('click', function() { manual(function() { show(parseInt(d.getAttribute('data-index'), 10)); }); });
  });
  box.addEventListener('mouseenter', stop);
  box.addEventListener('mouseleave', play);

  var sx = 0, sy = 0;
  box.addEventListener('touchstart', function(e) {
    if (e.touches.length === 1) { sx = e.touches[0].clientX; sy = e.touches[0].clientY; stop(); }
  }, { passive: true });
  box.addEventListener('touchend', function(e) {
    if (!e.changedTouches.length) return;
    var dx = e.changedTouches[0].clientX - sx;
    var dy = e.changedTouches[0].clientY - sy;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) manual(function() { dx < 0 ? next() : prev(); });
    else play();
  }, { passive: true });

  var dragging = false, startX = 0;
  box.addEventListener('mousedown', function(e) {
    if (e.button !== 0) return;
    dragging = true; startX = e.clientX;
    box.classList.add('dragging');
    stop();
  });
  box.addEventListener('mouseup', function(e) {
    if (!dragging) return;
    dragging = false;
    box.classList.remove('dragging');
    var dx = e.clientX - startX;
    if (Math.abs(dx) > 60) manual(function() { dx < 0 ? next() : prev(); });
    else play();
  });
  box.addEventListener('mouseleave', function() {
    if (!dragging) return;
    dragging = false;
    box.classList.remove('dragging');
    play();
  });

  box.addEventListener('wheel', function(e) {
    var d = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
    var now = Date.now();
    if (now < wheelLock) { wheelAcc = 0; return; }
    wheelAcc += d;
    if (Math.abs(wheelAcc) >= 60) {
      manual(wheelAcc > 0 ? next : prev);
      wheelAcc = 0;
      wheelLock = now + 700;
    }
  }, { passive: true });

  show(0);
  play();
})();
document.querySelector('form').addEventListener('submit', function(e) {
  var docs = document.querySelectorAll('input[name="documents_ready"]:checked');
  if (docs.length === 0) {
    e.preventDefault();
    alert('<%= currentLang === "km" ? "សូមធីកឯកសារយ៉ាងហោចណាស់មួយដែលអ្នកបានត្រៀម" : "Please tick at least one document you have prepared" %>');
    return false;
  }
  var declaration = document.getElementById('declarationConfirmed');
  if (declaration && !declaration.checked) {
    e.preventDefault();
    alert('<%= currentLang === "km" ? "សូមបញ្ជាក់ព័ត៌មានមុនដាក់ស្នើ" : "Please confirm the declaration before submitting" %>');
    return false;
  }
});
</script>
