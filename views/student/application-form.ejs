<div class="max-w-4xl mx-auto space-y-6">
  <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
    <div class="px-6 py-6 bg-gradient-to-r from-green-600 to-emerald-600 text-center">
      <div class="flex justify-center mb-3">
        <div class="w-16 h-16 bg-white/20 rounded-full flex items-center justify-center">
          <i class="bi bi-file-earmark-plus text-white text-2xl"></i>
        </div>
      </div>
      <h1 class="text-xl font-bold text-white"><%= currentLang === 'km' ? 'ពាក្យសុំអាហារូបករណ៍ថ្មី' : 'New Scholarship Application' %></h1>
      <p class="text-green-100 text-sm mt-1"><%= currentLang === 'km' ? 'សាកលវិទ្យាល័យជាតិមានជ័យ' : 'National Meanchey University (NMU)' %></p>
      <div class="mt-3 inline-flex items-center gap-2 px-4 py-1.5 bg-white/10 rounded-full">
        <i class="bi bi-calendar3 text-green-200"></i>
        <span class="text-sm text-white font-medium"><%= currentLang === 'km' ? 'ឆ្នាំសិក្សា ២០២៦-២០២៧' : 'Academic Year 2026-2027' %></span>
      </div>
      <p class="text-green-200 text-xs mt-3"><%= currentLang === 'km' ? 'សូមបំពេញព័ត៌មានខាងក្រោមឱ្យបានត្រឹមត្រូវ និងគ្រប់ជ្រុងជ្រោយ។' : 'Please fill in the following information accurately and completely.' %></p>
    </div>
  </div>

  <form method="POST" action="/student/application" enctype="multipart/form-data" class="space-y-6">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
      <div class="px-6 py-4 bg-gradient-to-r from-emerald-500 to-teal-600">
        <h3 class="text-white font-semibold flex items-center gap-2"><i class="bi bi-person"></i><%= currentLang === 'km' ? 'I. ព័ត៌មានផ្ទាល់ខ្លួន' : 'I. Personal Information' %></h3>
      </div>
      <div class="p-6 space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '១. ឈ្មោះខ្មែរ (នាម)' : '1. Khmer First Name' %> *</label>
            <input type="text" name="khmer_first_name" placeholder="<%= currentLang === 'km' ? 'ឧ. វ៉ាន់' : 'e.g. Vann' %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" required>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '២. ឈ្មោះខ្មែរ (នាមត្រកូល)' : '2. Khmer Last Name' %> *</label>
            <input type="text" name="khmer_last_name" placeholder="<%= currentLang === 'km' ? 'ឧ. សុវណ្ណ' : 'e.g. Sovann' %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" required>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '៣. ឈ្មោះអង់គ្លេស (នាម)' : '3. English First Name' %> *</label>
            <input type="text" name="english_first_name" placeholder="<%= currentLang === 'km' ? 'ឧ. Vann' : 'e.g. Vann' %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" required>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '៤. ឈ្មោះអង់គ្លេស (នាមត្រកូល)' : '4. English Last Name' %> *</label>
            <input type="text" name="english_last_name" placeholder="<%= currentLang === 'km' ? 'ឧ. Sovann' : 'e.g. Sovann' %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" required>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '៥. ភេទ' : '5. Gender' %> *</label>
            <select name="gender" required class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
              <option value=""><%= currentLang === 'km' ? 'ជ្រើសរើសភេទ' : 'Select gender' %></option>
              <option value="male"><%= currentLang === 'km' ? 'ប្រុស' : 'Male' %></option>
              <option value="female"><%= currentLang === 'km' ? 'ស្រី' : 'Female' %></option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '៦. ថ្ងៃខែឆ្នាំកំណើត' : '6. Date of Birth' %> *</label>
            <input type="date" name="date_of_birth" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" required>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '៧. សញ្ជាតិ' : '7. Nationality' %> *</label>
            <select id="nationalitySelect" name="nationality" onchange="toggleOtherNationality(this, 'otherNationalityInput')" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" required>
              <option value="Cambodian"><%= currentLang === 'km' ? 'ខ្មែរ' : 'Cambodian' %></option>
              <option value="Vietnamese"><%= currentLang === 'km' ? 'វៀតណាម' : 'Vietnamese' %></option>
              <option value="Other"><%= currentLang === 'km' ? 'ផ្សេងៗ' : 'Other' %></option>
            </select>
            <div id="otherNationalityInput" class="hidden mt-2">
              <input type="text" name="nationality_other" maxlength="50" pattern="[A-Za-z\u1780-\u17FF\s]+" oninput="this.value=this.value.replace(/[^A-Za-z\u1780-\u17FF\s]/g,'')" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" placeholder="<%= currentLang === 'km' ? 'សូមបញ្ចូលសញ្ជាតិរបស់អ្នក' : 'Enter your nationality' %>">
              <p class="text-xs text-gray-400 dark:text-gray-500 mt-1"><%= currentLang === 'km' ? 'អក្ខរាវិរុទ្ធខ្មែរ ឬអង់គ្លេសបាន' : 'Khmer or English letters only' %></p>
            </div>
          </div>
          <div class="md:col-span-2">
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '៨. អាស័យដ្ឋានបច្ចុប្បន្ន' : '8. Current Address' %> *</label>
            <textarea name="current_address" rows="2" placeholder="<%= currentLang === 'km' ? 'ផ្លូវ លេខ សង្កាត់ ខណ្ឌ ក្រុង ខេត្ត' : 'Street, Commune, District, City, Province' %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none resize-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" required></textarea>
            <p class="text-xs text-gray-400 dark:text-gray-500 mt-1"><%= currentLang === 'km' ? 'អាស័យដ្ឋានដែលអ្នករស់នៅបច្ចុប្បន្ន (ផ្ទះលេខ សង្កាត់ ខេត្ត)' : 'Your current living address (house number, commune, province)' %></p>
          </div>
        </div>
        <div class="pt-2 border-t border-gray-100 dark:border-gray-700">
          <p class="text-sm font-semibold text-gray-900 dark:text-gray-100 mb-3"><%= currentLang === 'km' ? 'ទំនាក់ទំនង' : 'Contact' %> *</p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <%- include('../partials/phone-input', { phoneName: 'phone', phoneValue: '', required: true, inputId: 'appPhone', label: currentLang === 'km' ? '៩. លេខទូរស័ព្ទ' : '9. Phone Number', helpText: currentLang === 'km' ? 'លេខទូរស័ព្ទផ្ទាល់ខ្លួនរបស់អ្នក' : 'Your personal phone number' }) %>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '១០. រូបថត (ផ្ទាល់ខ្លួន)' : '10. Photo (Self)' %></label>
              <input type="file" name="photo" accept=".jpg,.jpeg,.png" class="w-full text-sm text-gray-500 dark:text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-green-50 file:text-green-700 dark:file:bg-green-900/30 dark:file:text-green-300 hover:file:bg-green-100 dark:hover:file:bg-green-900/50">
              <p class="text-xs text-gray-400 dark:text-gray-500 mt-1">JPG, PNG • Max 5MB</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
      <div class="px-6 py-4 bg-gradient-to-r from-purple-500 to-pink-600">
        <h3 class="text-white font-semibold flex items-center gap-2"><i class="bi bi-people"></i><%= currentLang === 'km' ? 'ព័ត៌មានគ្រួសារ' : 'Family Information' %></h3>
      </div>
      <div class="p-6 space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '១១. ឈ្មោះឪពុក' : '11. Father\'s Name' %> *</label>
            <input type="text" name="parent_name" placeholder="<%= currentLang === 'km' ? 'ឈ្មោះពេញរបស់ឪពុក' : 'Father\'s full name' %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" required>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '១២. លេខទូរស័ព្ទឪពុក' : '12. Father\'s Phone' %> *</label>
            <input type="tel" name="parent_phone" placeholder="<%= currentLang === 'km' ? 'លេខទូរស័ព្ទឪពុក' : 'Father\'s phone number' %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" required>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '១៣. ឈ្មោះទាក់ទងបន្ទាន់' : '13. Emergency Contact' %> *</label>
            <input type="text" name="emergency_contact" placeholder="<%= currentLang === 'km' ? 'ឈ្មោះអ្នកទាក់ទងបន្ទាន់' : 'Emergency contact name' %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" required>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '១៤. លេខទូរស័ព្ទទាក់ទងបន្ទាន់' : '14. Emergency Phone' %> *</label>
            <input type="tel" name="emergency_phone" placeholder="<%= currentLang === 'km' ? 'លេខទូរស័ព្ទទាក់ទងបន្ទាន់' : 'Emergency phone number' %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" required>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
      <div class="px-6 py-4 bg-gradient-to-r from-teal-500 to-cyan-600">
        <h3 class="text-white font-semibold flex items-center gap-2"><i class="bi bi-book"></i><%= currentLang === 'km' ? 'II. ព័ត៌មានការសិក្សា' : 'II. Education' %></h3>
      </div>
      <div class="p-6 space-y-4">
        <p class="text-sm text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'ព័ត៌មានអំពីការសិក្សា និងការប្រឡងសញ្ញាបត្រមធ្យមសិក្សាទុតិយភូមិ។' : 'Information about your education and high school diploma exam.' %></p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '១៥. ឈ្មោះសាលា' : '15. School Name' %> *</label>
            <input type="text" name="school_name" placeholder="<%= currentLang === 'km' ? 'ឈ្មោះសាលា' : 'School name' %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" required>
            <p class="text-xs text-gray-400 dark:text-gray-500 mt-1"><%= currentLang === 'km' ? 'ឈ្មោះសាលាដែលអ្នកកំពុងសិក្សា ឬបញ្ចប់ការសិក្សា' : 'Name of the school you attended or graduated from' %></p>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '១៦. ខេត្តសាលា' : '16. School Province' %> *</label>
            <select name="school_province_id" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" required>
              <option value=""><%= currentLang === 'km' ? 'ជ្រើសរើសខេត្តសាលា' : 'Select school province' %></option>
              <% provinces.forEach(function(p) { %>
                <option value="<%= p.id %>"><%= currentLang === 'km' ? p.name_kh : p.name_en %></option>
              <% }); %>
            </select>
            <p class="text-xs text-gray-400 dark:text-gray-500 mt-1"><%= currentLang === 'km' ? 'ខេត្តដែលសាលារបស់អ្នកស្ថិតនៅ' : 'The province where your school is located' %></p>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '១៧. ឆ្នាំបញ្ចប់' : '17. Graduation Year' %> *</label>
            <input type="number" name="graduation_year" min="2000" max="2030" placeholder="2024" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" required>
            <p class="text-xs text-gray-400 dark:text-gray-500 mt-1"><%= currentLang === 'km' ? 'ឆ្នាំដែលអ្នកបញ្ចប់ការសិក្សាថ្នាក់ទី ១២' : 'The year you completed grade 12' %></p>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '១៨. លទ្ធផលប្រឡង' : '18. Exam Result' %></label>
            <input type="text" name="exam_result" placeholder="<%= currentLang === 'km' ? 'ឧ. ៨៥%' : 'e.g. 85%' %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
            <p class="text-xs text-gray-400 dark:text-gray-500 mt-1"><%= currentLang === 'km' ? 'ពិន្ទុប្រឡងឌីប្លូម ឬប្រលងបញ្ចប់ថ្នាក់មធ្យមសិក្សា (បើមាន)' : 'Your diploma or high school exam score (if available)' %></p>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '១៩. សំណុំបែបបទ' : '19. Transcript' %></label>
            <input type="file" name="transcript" accept=".pdf,.jpg,.jpeg,.png" class="w-full text-sm text-gray-500 dark:text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-purple-50 file:text-purple-700 dark:file:bg-purple-900/30 dark:file:text-purple-300 hover:file:bg-purple-100 dark:hover:file:bg-purple-900/50">
            <p class="text-xs text-gray-400 dark:text-gray-500 mt-1">PDF, JPG, PNG • Max 5MB</p>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
      <div class="px-6 py-4 bg-gradient-to-r from-indigo-500 to-violet-600">
        <h3 class="text-white font-semibold flex items-center gap-2"><i class="bi bi-star"></i><%= currentLang === 'km' ? 'III. ចំណូលចិត្តអាហារូបករណ៍' : 'III. Scholarship Preferences' %></h3>
      </div>
      <div class="p-6 space-y-4">
        <p class="text-sm text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'សូមជ្រើសរើសជំនាញ និងកម្មវិធីអាហារូបករណ៍ដែលអ្នកចង់ដាក់សុំ។' : 'Choose the major and scholarship program you want to apply for.' %></p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '២០. ជំនាញជម្រើសទី ១' : '20. First Choice Major' %> *</label>
            <select name="major_first_choice_id" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" required>
              <option value=""><%= currentLang === 'km' ? 'ជ្រើសរើសជំនាញជម្រើសទី ១' : 'Select first choice major' %></option>
              <% majors.forEach(function(m) { %>
                <option value="<%= m.id %>"><%= currentLang === 'km' ? m.name_kh : m.name_en %></option>
              <% }); %>
            </select>
            <p class="text-xs text-gray-400 dark:text-gray-500 mt-1"><%= currentLang === 'km' ? 'ជ្រើសរើសជំនាញដែលអ្នកចង់សិក្សាដំបូង' : 'Choose the major you want to study first' %></p>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '២១. ជំនាញជម្រើសទី ២' : '21. Second Choice Major' %></label>
            <select name="major_second_choice_id" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
              <option value=""><%= currentLang === 'km' ? 'ជ្រើសរើសជំនាញជម្រើសទី ២ (ស្រេចចិត្ត)' : 'Select second choice major (optional)' %></option>
              <% majors.forEach(function(m) { %>
                <option value="<%= m.id %>"><%= currentLang === 'km' ? m.name_kh : m.name_en %></option>
              <% }); %>
            </select>
            <p class="text-xs text-gray-400 dark:text-gray-500 mt-1"><%= currentLang === 'km' ? 'ជ្រើសរើសជំនាញជម្រើសទី ២ (មិនចាំបាច់)' : 'Choose a backup major (optional)' %></p>
          </div>
          <div class="md:col-span-2">
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '២២. កម្មវិធីអាហារូបករណ៍' : '22. Scholarship Program' %> *</label>
            <select name="scholarship_type_id" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" required>
              <option value=""><%= currentLang === 'km' ? 'ជ្រើសរើសកម្មវិធីអាហារូបករណ៍' : 'Select scholarship program' %></option>
              <% scholarshipTypes.forEach(function(st) { %>
                <option value="<%= st.id %>"><%= currentLang === 'km' ? st.name_kh : (st.name_en || st.name_kh) %> - <%= st.coverage_percentage %>% (<%= st.duration_years %> <%= currentLang === 'km' ? 'ឆ្នាំ' : 'yr' %>)</option>
              <% }); %>
            </select>
            <p class="text-xs text-gray-400 dark:text-gray-500 mt-1"><%= currentLang === 'km' ? 'ជ្រើសរើសកម្មវិធីអាហារូបករណ៍ដែលអ្នកចង់ដាក់សុំ' : 'Choose the scholarship program you want to apply for' %></p>
          </div>
        </div>
      </div>
    </div>

    <div class="flex justify-end gap-3">
      <a href="/student/dashboard" class="px-6 py-2.5 border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 rounded-xl hover:bg-gray-50 dark:hover:bg-gray-700 transition-all font-medium text-sm">
        <i class="bi bi-arrow-left mr-1"></i><%= currentLang === 'km' ? 'បោះបង់' : 'Cancel' %>
      </a>
      <button type="submit" class="px-6 py-2.5 bg-gradient-to-r from-green-500 to-emerald-600 text-white rounded-xl hover:from-green-600 hover:to-emerald-700 transition-all font-medium shadow-md hover:shadow-lg text-sm flex items-center gap-1.5">
        <i class="bi bi-send"></i><%= currentLang === 'km' ? 'ដាក់ស្នើពាក្យសុំ' : 'Submit Application' %>
      </button>
    </div>
  </form>
</div>
<script>
function toggleOtherNationality(select, inputId) {
  var input = document.getElementById(inputId);
  if (select.value === 'Other') {
    input.classList.remove('hidden');
    input.querySelector('input').required = true;
  } else {
    input.classList.add('hidden');
    input.querySelector('input').required = false;
    input.querySelector('input').value = '';
  }
}
document.querySelector('form').addEventListener('submit', function(e) {
  var sel = document.getElementById('nationalitySelect');
  if (sel.value === 'Other') {
    var custom = document.querySelector('[name="nationality_other"]').value.trim();
    if (!custom) {
      e.preventDefault();
      alert('<%= currentLang === "km" ? "សូមបញ្ចូលសញ្ជាតិរបស់អ្នក" : "Please enter your nationality" %>');
      return false;
    }
  }
});
</script>
