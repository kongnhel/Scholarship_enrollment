<div class="max-w-4xl mx-auto space-y-6">
<%
  var hasPosters = (typeof posters !== 'undefined' && posters && posters.length > 0);
%>
  <div class="relative overflow-hidden rounded-3xl border border-gray-100 dark:border-gray-700 shadow-md <%= hasPosters ? 'has-poster' : 'bg-white dark:bg-gray-800' %>" id="posterSlideshow">
    <% if (hasPosters) { %>
      <% posters.forEach(function(src, i) { %>
        <img src="<%= src %>" alt="" draggable="false" decoding="async" class="poster-slide absolute inset-0 w-full h-full object-cover transition-opacity duration-700 select-none" style="opacity: <%= i === 0 ? 1 : 0 %>;">
      <% }) %>
      <div class="hero-scrim absolute inset-0 pointer-events-none"></div>
    <% } else { %>
      <div class="absolute top-0 right-0 w-40 h-40 bg-green-50 dark:bg-green-900/20 rounded-bl-[6rem] -mr-10 -mt-10"></div>
    <% } %>

    <div class="relative z-10 flex flex-col justify-between gap-4 p-5 sm:p-6 <%= hasPosters ? 'min-h-[300px] sm:min-h-[400px]' : '' %>">
      <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3 sm:gap-5">
        <div class="hero-panel flex items-start gap-4 max-w-2xl">
          <div class="hero-icon w-12 h-12 bg-gradient-to-br from-green-500 to-emerald-600 rounded-2xl flex items-center justify-center shadow-lg shadow-green-600/30 flex-shrink-0">
            <i class="bi bi-file-earmark-plus text-white text-xl"></i>
          </div>
          <div class="min-w-0">
            <div class="hdr-chip inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold mb-2">
              <i class="bi bi-calendar3"></i>
              <%= currentLang === 'km' ? 'ឆ្នាំសិក្សា ២០២៦-២០២៧' : 'Academic Year 2026-2027' %>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight leading-tight text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ពាក្យស្នើសុំចុះឈ្មោះចូលរៀន' : 'Enrollment Application' %></h1>
            <p class="hdr-sub mt-1 text-sm sm:text-[15px] text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'សាកលវិទ្យាល័យជាតិមានជ័យ' : 'National Meanchey University (NMU)' %></p>
          </div>
        </div>

        <div class="flex sm:flex-col items-center sm:items-end gap-3 flex-shrink-0 self-start sm:self-auto">
          <a href="/student/dashboard" class="hdr-btn inline-flex items-center gap-2 px-4 py-2.5 border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 rounded-xl text-sm font-semibold hover:bg-gray-50 dark:hover:bg-gray-700 transition-all">
            <i class="bi bi-arrow-left"></i><%= currentLang === 'km' ? 'បោះបង់' : 'Cancel' %>
          </a>
          <% if (hasPosters && posters.length > 1) { %>
          <div class="dots-tray flex items-center gap-1.5">
            <% posters.forEach(function(src, i) { %>
              <button type="button" class="poster-dot rounded-full transition-all" data-index="<%= i %>" aria-label="Slide <%= i + 1 %>" style="width: <%= i === 0 ? 24 : 10 %>px; height:8px; background:<%= i === 0 ? '#ffffff' : 'rgba(255,255,255,.55)' %>;"></button>
            <% }) %>
          </div>
          <% } %>
        </div>
      </div>

      <div class="hero-panel hdr-desc max-w-3xl text-sm sm:text-[15px] leading-relaxed text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'សូមបំពេញព័ត៌មានខាងក្រោមឱ្យបានត្រឹមត្រូវ និងគ្រប់ជ្រុងជ្រោយ។ ព័ត៌មានដែលបានផ្តល់នឹងត្រូវប្រើប្រាស់សម្រាប់ដំណើរការចុះឈ្មោះចូលរៀននៅសាកលវិទ្យាល័យជាតិមានជ័យ។' : 'Please fill in the following information accurately and completely. The information provided will be used for the enrollment process at National Meanchey University.' %></div>
    </div>

    <% if (hasPosters && posters.length > 1) { %>
    <div class="poster-progress absolute left-0 right-0 bottom-0 h-1 z-20 pointer-events-none"><span></span></div>
    <% } %>
  </div>

  <form method="POST" action="/student/application" enctype="multipart/form-data" class="space-y-6">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <!-- I. ព័ត៌មាននិស្សិត -->
    <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
      <div class="px-6 py-3.5 border-b border-gray-100 dark:border-gray-700 flex items-center gap-2.5">
        <div class="w-8 h-8 bg-emerald-100 dark:bg-emerald-900/40 rounded-lg flex items-center justify-center">
          <i class="bi bi-person text-emerald-600 dark:text-emerald-400 text-sm"></i>
        </div>
        <span class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'I. ព័ត៌មាននិស្សិត' : 'I. Student Information' %></span>
      </div>
      <div class="p-6 space-y-5">
        <p class="text-sm text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'សូមបំពេញព័ត៌មានផ្ទាល់ខ្លួនឱ្យបានត្រឹមត្រូវតាមឯកសារផ្លូវការ។' : 'Please fill in your personal information exactly as it appears on your official documents.' %></p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '១. ឈ្មោះខ្មែរ (នាម)' : '1. Khmer First Name' %> <span class="text-red-500">*</span></label>
            <input type="text" name="khmer_first_name" placeholder="<%= currentLang === 'km' ? 'ឧ. វ៉ាន់' : 'e.g. Vann' %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" required>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '២. ឈ្មោះខ្មែរ (នាមត្រកូល)' : '2. Khmer Last Name' %> <span class="text-red-500">*</span></label>
            <input type="text" name="khmer_last_name" placeholder="<%= currentLang === 'km' ? 'ឧ. សុវណ្ណ' : 'e.g. Sovann' %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" required>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '៣. ឈ្មោះអង់គ្លេស (នាម)' : '3. Full Name in English / Latin (First Name)' %> <span class="text-red-500">*</span></label>
            <input type="text" name="english_first_name" placeholder="<%= currentLang === 'km' ? 'ឧ. Vann' : 'e.g. Vann' %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" required>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '៤. ឈ្មោះអង់គ្លេស (នាមត្រកូល)' : '4. Full Name in English / Latin (Last Name)' %> <span class="text-red-500">*</span></label>
            <input type="text" name="english_last_name" placeholder="<%= currentLang === 'km' ? 'ឧ. Sovann' : 'e.g. Sovann' %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" required>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '៥. ភេទ' : '5. Gender' %> <span class="text-red-500">*</span></label>
            <div class="flex items-center gap-6 h-[42px] px-4 border border-gray-200 dark:border-gray-700 rounded-xl bg-white dark:bg-gray-800">
              <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-200 cursor-pointer">
                <input type="radio" name="gender" value="male" required class="text-green-600 focus:ring-green-500">
                <%= currentLang === 'km' ? 'ប្រុស' : 'Male' %>
              </label>
              <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-200 cursor-pointer">
                <input type="radio" name="gender" value="female" class="text-green-600 focus:ring-green-500">
                <%= currentLang === 'km' ? 'ស្រី' : 'Female' %>
              </label>
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '៦. ថ្ងៃ ខែ ឆ្នាំកំណើត' : '6. Date of Birth' %> <span class="text-red-500">*</span></label>
            <input type="date" name="date_of_birth" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" required>
          </div>
          <div class="md:col-span-2">
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '៧. ទីកន្លែងកំណើត' : '7. Place of Birth' %> <span class="text-red-500">*</span></label>
            <input type="text" name="birth_place" placeholder="<%= currentLang === 'km' ? 'ភូមិ ឃុំ/សង្កាត់ ស្រុក/ក្រុង ខេត្ត/រាជធានី' : 'Village, Commune, District, Province' %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" required>
            <p class="text-xs text-gray-400 dark:text-gray-500 mt-1"><%= currentLang === 'km' ? 'សូមបញ្ជាក់ ភូមិ ឃុំ/សង្កាត់ ស្រុក/ក្រុង និងខេត្ត/រាជធានី។' : 'Please state village, commune, district and province/city.' %></p>
          </div>
        </div>

        <div class="pt-4 border-t border-gray-100 dark:border-gray-700">
          <p class="text-sm font-semibold text-gray-900 dark:text-gray-100 mb-3"><%= currentLang === 'km' ? 'អាសយដ្ឋានបច្ចុប្បន្ន' : 'Current Address' %> <span class="text-red-500">*</span></p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '៨. ភូមិ' : '8. Village' %> <span class="text-red-500">*</span></label>
              <input type="text" name="address_village" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" required>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '៩. ឃុំ / សង្កាត់' : '9. Commune / Sangkat' %> <span class="text-red-500">*</span></label>
              <input type="text" name="address_commune" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" required>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '១០. ស្រុក / ក្រុង / ខណ្ឌ' : '10. District / Municipality / Khan' %> <span class="text-red-500">*</span></label>
              <input type="text" name="address_district" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" required>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '១១. ខេត្ត / រាជធានី' : '11. Province / City' %> <span class="text-red-500">*</span></label>
              <input type="text" name="address_province" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" required>
            </div>
          </div>
        </div>

        <div class="pt-4 border-t border-gray-100 dark:border-gray-700">
          <p class="text-sm font-semibold text-gray-900 dark:text-gray-100 mb-3"><%= currentLang === 'km' ? 'ព័ត៌មានគ្រួសារ' : 'Family Information' %></p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '១២. ឈ្មោះឪពុក' : "12. Father's Name" %> <span class="text-red-500">*</span></label>
              <input type="text" name="parent_name" placeholder="<%= currentLang === 'km' ? 'ឈ្មោះពេញរបស់ឪពុក' : "Father's full name" %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" required>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '១៣. ឈ្មោះម្តាយ' : "13. Mother's Name" %> <span class="text-red-500">*</span></label>
              <input type="text" name="mother_name" placeholder="<%= currentLang === 'km' ? 'ឈ្មោះពេញរបស់ម្តាយ' : "Mother's full name" %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" required>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '១៤. មុខរបរសព្វថ្ងៃរបស់បេក្ខជន' : "14. Candidate's Current Occupation" %></label>
              <input type="text" name="occupation" placeholder="<%= currentLang === 'km' ? 'ឧ. សិស្ស / កសិករ / ពាណិជ្ជករ' : 'e.g. Student / Farmer / Trader' %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '១៥. កម្រិតវប្បធម៌' : '15. Education Level' %></label>
              <input type="text" name="education_level" placeholder="<%= currentLang === 'km' ? 'ឧ. មធ្យមសិក្សាទុតិយភូមិ' : 'e.g. Associate / Bachelor' %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
            </div>
          </div>
        </div>

        <div class="pt-4 border-t border-gray-100 dark:border-gray-700">
          <p class="text-sm font-semibold text-gray-900 dark:text-gray-100 mb-3"><%= currentLang === 'km' ? 'ព័ត៌មានទំនាក់ទំនង' : 'Contact Information' %> <span class="text-red-500">*</span></p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <%- include('../partials/phone-input', { phoneName: 'phone', phoneValue: '', required: true, inputId: 'appPhone', label: currentLang === 'km' ? '១៦. លេខទូរស័ព្ទសាមីខ្លួន' : '16. Own Phone Number', helpText: currentLang === 'km' ? 'លេខទូរស័ព្ទផ្ទាល់ខ្លួនរបស់អ្នក' : 'Your personal phone number' }) %>
            </div>
            <div>
              <%- include('../partials/phone-input', { phoneName: 'parent_phone', phoneValue: '', required: true, inputId: 'parentPhone', label: currentLang === 'km' ? '១៧. លេខទូរស័ព្ទអាណាព្យាបាល' : "17. Guardian's Phone Number", helpText: currentLang === 'km' ? 'សូមបញ្ចូលលេខទូរស័ព្ទដែលអាចទាក់ទងបាន។' : 'Please enter a reachable phone number.' }) %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- II. ព័ត៌មានអំពីប្រវត្តិសិក្សា -->
    <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
      <div class="px-6 py-3.5 border-b border-gray-100 dark:border-gray-700 flex items-center gap-2.5">
        <div class="w-8 h-8 bg-blue-100 dark:bg-blue-900/40 rounded-lg flex items-center justify-center">
          <i class="bi bi-book text-blue-600 dark:text-blue-400 text-sm"></i>
        </div>
        <span class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'II. ព័ត៌មានអំពីប្រវត្តិសិក្សា' : 'II. Education Background' %></span>
      </div>
      <div class="p-6 space-y-4">
        <p class="text-sm text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'ព័ត៌មានអំពីការសិក្សា និងការប្រឡងសញ្ញាបត្រមធ្យមសិក្សាទុតិយភូមិ។' : 'Information about your education and the high school diploma examination.' %></p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '១៨. សម័យប្រឡងមធ្យមសិក្សាទុតិយភូមិ' : '18. High School Diploma Exam Session' %> <span class="text-red-500">*</span></label>
            <input type="text" name="exam_session" placeholder="<%= currentLang === 'km' ? 'ឧ. សម័យប្រឡង ២០២៦' : 'e.g. Exam Session 2026' %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" required>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '១៩. និទ្ទេសរួម' : '19. Overall Grade' %> <span class="text-red-500">*</span></label>
            <input type="text" name="exam_result" placeholder="<%= currentLang === 'km' ? 'ឧ. A' : 'e.g. 85%' %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" required>
            <p class="text-xs text-gray-400 dark:text-gray-500 mt-1"><%= currentLang === 'km' ? 'សូមបញ្ចូលនិទ្ទេសតាមលទ្ធផលប្រឡង។' : 'Enter your grade according to the examination result.' %></p>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '២០. មកពីវិទ្យាល័យ' : '20. High School' %> <span class="text-red-500">*</span></label>
            <input type="text" name="school_name" placeholder="<%= currentLang === 'km' ? 'ឈ្មោះវិទ្យាល័យ' : 'High school name' %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" required>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '២១. ខេត្ត / រាជធានីរបស់វិទ្យាល័យ' : '21. Province / City of High School' %> <span class="text-red-500">*</span></label>
            <select name="school_province_id" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" required>
              <option value=""><%= currentLang === 'km' ? 'ជ្រើសរើសខេត្ត' : 'Select province' %></option>
              <% provinces.forEach(function(p) { %>
                <option value="<%= p.id %>"><%= currentLang === 'km' ? p.name_kh : p.name_en %></option>
              <% }); %>
            </select>
          </div>
          <div class="md:col-span-2">
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '២២. មណ្ឌលប្រឡង' : '22. Exam Center' %></label>
            <input type="text" name="exam_center" placeholder="<%= currentLang === 'km' ? 'ឈ្មោះមណ្ឌលប្រឡង' : 'Exam center name' %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
          </div>
        </div>
      </div>
    </div>

    <!-- III. ព័ត៌មាននៃការចុះឈ្មោះចូលរៀន -->
    <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
      <div class="px-6 py-3.5 border-b border-gray-100 dark:border-gray-700 flex items-center gap-2.5">
        <div class="w-8 h-8 bg-violet-100 dark:bg-violet-900/40 rounded-lg flex items-center justify-center">
          <i class="bi bi-star text-violet-600 dark:text-violet-400 text-sm"></i>
        </div>
        <span class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'III. ព័ត៌មាននៃការចុះឈ្មោះចូលរៀន' : 'III. Enrollment Information' %></span>
      </div>
      <div class="p-6 space-y-4">
        <p class="text-sm text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'សូមបញ្ជាក់កម្រិតសិក្សា មុខជំនាញ និងពេលសិក្សាដែលចង់ជ្រើសរើស។' : 'Please specify the study level, major and study schedule you wish to choose.' %></p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="md:col-span-2">
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '២៣. កម្រិតសិក្សា' : '23. Study Level' %> <span class="text-red-500">*</span></label>
            <select name="study_level" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" required>
              <option value=""><%= currentLang === 'km' ? 'ជ្រើសរើសកម្រិតសិក្សា' : 'Select study level' %></option>
              <option value="bachelor"><%= currentLang === 'km' ? 'ថ្នាក់បរិញ្ញាបត្រ' : 'Bachelor Degree' %></option>
              <option value="associate"><%= currentLang === 'km' ? 'ថ្នាក់បរិញ្ញាបត្ររង' : 'Associate Degree' %></option>
            </select>
            <p class="text-xs text-gray-400 dark:text-gray-500 mt-1"><%= currentLang === 'km' ? 'សូមបញ្ជាក់កម្រិតសិក្សាដែលចង់ចុះឈ្មោះ។' : 'Please specify the level you want to enroll in.' %></p>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '២៤. មុខជំនាញដែលចង់សិក្សា' : '24. Desired Major' %> <span class="text-red-500">*</span></label>
            <select name="major_first_choice_id" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" required>
              <option value=""><%= currentLang === 'km' ? 'ជ្រើសរើសមុខជំនាញ' : 'Select major' %></option>
              <% majors.forEach(function(m) { %>
                <option value="<%= m.id %>"><%= currentLang === 'km' ? m.name_kh : m.name_en %></option>
              <% }); %>
            </select>
            <p class="text-xs text-gray-400 dark:text-gray-500 mt-1"><%= currentLang === 'km' ? 'ជម្រើសទី ១' : 'First choice' %></p>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '២៥. មុខជំនាញជម្រើសទី ២' : '25. Second Choice Major' %></label>
            <select name="major_second_choice_id" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
              <option value=""><%= currentLang === 'km' ? 'ជម្រើសទី ២ (ស្រេចចិត្ត)' : 'Second choice (optional)' %></option>
              <% majors.forEach(function(m) { %>
                <option value="<%= m.id %>"><%= currentLang === 'km' ? m.name_kh : m.name_en %></option>
              <% }); %>
            </select>
          </div>
          <div class="md:col-span-2">
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '២៦. កម្មវិធីអាហារូបករណ៍' : '26. Scholarship Program' %> <span class="text-red-500">*</span></label>
            <select name="scholarship_type_id" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" required>
              <option value=""><%= currentLang === 'km' ? 'ជ្រើសរើសកម្មវិធីអាហារូបករណ៍' : 'Select scholarship program' %></option>
              <% scholarshipTypes.forEach(function(st) {
                var prov = st.provider_name || '';
                var provSuffix = prov && prov.indexOf('សាកលវិទ្យាល័យជាតិមានជ័យ') === -1 ? ' — ' + prov : '';
              %>
                <option value="<%= st.id %>"<%= (typeof selectedScholarshipId !== 'undefined' && Number(selectedScholarshipId) === Number(st.id)) ? ' selected' : '' %>><%= currentLang === 'km' ? st.name_kh : (st.name_en || st.name_kh) %> - <%= st.coverage_percentage %>% (<%= st.duration_years %> <%= currentLang === 'km' ? 'ឆ្នាំ' : 'yr' %>)<%= provSuffix %></option>
              <% }); %>
            </select>
            <div class="flex flex-wrap items-center justify-between gap-2 mt-1.5">
              <p class="text-xs text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'បានជ្រើសរើសរួចជាមុនពីជំហានទី ១។' : 'Pre-selected from Step 1.' %></p>
              <a href="/student/application/select" class="inline-flex items-center gap-1.5 text-xs font-semibold text-green-700 dark:text-green-400 hover:text-green-800 dark:hover:text-green-300 hover:underline">
                <i class="bi bi-arrow-repeat"></i><%= currentLang === 'km' ? 'ផ្លាស់ប្តូរកម្មវិធីអាហារូបករណ៍' : 'Change scholarship program' %>
              </a>
            </div>
            <div class="mt-3 flex flex-wrap items-center gap-2 p-3 rounded-xl bg-green-50 dark:bg-green-900/20 border border-green-100 dark:border-green-800/40">
              <span class="text-xs font-semibold text-green-800 dark:text-green-300"><%= currentLang === 'km' ? 'កម្រិតអាហារូបករណ៍៖' : 'Scholarship level:' %></span>
              <%
                var kmDigits = function (s) { return String(s).replace(/[0-9]/g, function (d) { return { '0': '០', '1': '១', '2': '២', '3': '៣', '4': '៤', '5': '៥', '6': '៦', '7': '៧', '8': '៨', '9': '៩' }[d]; }); };
                var optVal = (typeof selectedScholarshipOption !== 'undefined' && selectedScholarshipOption) ? String(selectedScholarshipOption) : '';
                var optParts = optVal.split('/');
                var optPct = optParts[0] || '';
                var optYears = optParts[1] || '';
                var badgeLabel = optPct ? (currentLang === 'km'
                  ? kmDigits(optPct) + '%' + (optYears ? ' · ' + kmDigits(optYears) + ' ឆ្នាំ' : '')
                  : optPct + '%' + (optYears ? ' · ' + optYears + ' years' : '')) : '';
              %>
              <% if (badgeLabel) { %>
                <span class="px-3 py-1 rounded-lg text-xs font-extrabold text-white" style="background:linear-gradient(135deg,#16a34a,#10b981);"><%= badgeLabel %></span>
              <% } else { %>
                <span class="text-xs text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'មិនទាន់បានជ្រើសរើសទេ' : 'Not selected yet' %></span>
              <% } %>
              <a href="/student/application/select" class="ml-auto inline-flex items-center gap-1.5 text-xs font-semibold text-green-700 dark:text-green-400 hover:text-green-800 dark:hover:text-green-300 hover:underline">
                <i class="bi bi-sliders"></i><%= currentLang === 'km' ? 'ផ្លាស់ប្តូរកម្រិត' : 'Change level' %>
              </a>
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '២៧. ពេលសិក្សា' : '27. Study Period' %> <span class="text-red-500">*</span></label>
            <select name="study_period" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" required>
              <option value=""><%= currentLang === 'km' ? 'ជ្រើសរើសពេលសិក្សា' : 'Select study period' %></option>
              <option value="mon_fri"><%= currentLang === 'km' ? 'ចន្ទ - សុក្រ' : 'Monday - Friday' %></option>
              <option value="sat_sun"><%= currentLang === 'km' ? 'សៅរ៍ - អាទិត្យ' : 'Saturday - Sunday' %></option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '២៨. វេនសិក្សា' : '28. Study Shift' %> <span class="text-red-500">*</span></label>
            <select name="study_shift" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" required>
              <option value=""><%= currentLang === 'km' ? 'ជ្រើសរើសវេនសិក្សា' : 'Select study shift' %></option>
              <option value="morning"><%= currentLang === 'km' ? 'ព្រឹក' : 'Morning' %></option>
              <option value="afternoon"><%= currentLang === 'km' ? 'រសៀល' : 'Afternoon' %></option>
              <option value="weekend"><%= currentLang === 'km' ? 'សៅរ៍អាទិត្យ' : 'Weekend' %></option>
            </select>
          </div>
        </div>
      </div>
    </div>

    <!-- IV. ឯកសារភ្ជាប់ -->
    <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
      <div class="px-6 py-3.5 border-b border-gray-100 dark:border-gray-700 flex items-center gap-2.5">
        <div class="w-8 h-8 bg-purple-100 dark:bg-purple-900/40 rounded-lg flex items-center justify-center">
          <i class="bi bi-paperclip text-purple-600 dark:text-purple-400 text-sm"></i>
