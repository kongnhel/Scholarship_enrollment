<div class="max-w-6xl mx-auto space-y-6">
  <div class="relative overflow-hidden rounded-3xl bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 shadow-sm">
    <div class="absolute top-0 right-0 w-40 h-40 bg-green-50 dark:bg-green-900/20 rounded-bl-[6rem] -mr-10 -mt-10"></div>
    <div class="relative px-6 py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-center gap-4 min-w-0">
        <div class="w-12 h-12 bg-gradient-to-br from-green-500 to-emerald-600 rounded-2xl flex items-center justify-center shadow-md shadow-green-500/20 flex-shrink-0">
          <i class="bi bi-house-door text-white text-xl"></i>
        </div>
        <div class="min-w-0">
          <% if (notificationsCount > 0) { %>
            <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-green-100 dark:bg-green-900/40 text-green-700 dark:text-green-300 text-xs font-bold mb-1">
              <i class="bi bi-bell"></i>
              <%= notificationsCount %> <%= currentLang === 'km' ? 'សារជូនដំណឹងថ្មី' : 'new notifications' %>
            </div>
          <% } %>
          <h1 class="text-xl font-bold text-gray-900 dark:text-gray-100 truncate"><%= currentLang === 'km' ? 'ស្វាគមន៍' : 'Welcome' %>, <%= (currentLang === 'km' && user.khmer_name) ? user.khmer_name : user.english_name %></h1>
          <p class="text-sm text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'តារាងព័ត៌មានសិស្ស' : 'Student Dashboard' %></p>
        </div>
      </div>
      <div class="flex items-center gap-2 self-start sm:self-auto">
        <span class="hidden sm:inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-gray-50 dark:bg-gray-700/50 text-xs font-medium text-gray-500 dark:text-gray-400"><i class="bi bi-calendar3"></i><%= new Date().toLocaleDateString() %></span>
        <a href="/student/notifications" class="relative w-10 h-10 rounded-xl bg-gray-50 dark:bg-gray-700/50 flex items-center justify-center text-gray-500 dark:text-gray-400 hover:text-green-600 dark:hover:text-green-400 hover:bg-green-50 dark:hover:bg-green-900/20 transition-all" title="<%= currentLang === 'km' ? 'ការជូនដំណឹង' : 'Notifications' %>">
          <i class="bi bi-bell text-lg"></i>
          <% if (notificationsCount > 0) { %>
            <span class="absolute -top-1.5 -right-1.5 min-w-[18px] h-[18px] px-1 rounded-full bg-red-500 text-white text-[10px] font-bold flex items-center justify-center shadow"><%= notificationsCount %></span>
          <% } %>
        </a>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
    <a href="/student/notifications" class="group bg-white dark:bg-gray-800 rounded-2xl p-5 shadow-sm border border-gray-100 dark:border-gray-700 text-center hover:shadow-md hover:-translate-y-0.5 transition-all">
      <div class="w-11 h-11 bg-gradient-to-br from-blue-500 to-indigo-500 rounded-2xl flex items-center justify-center mx-auto mb-3 shadow-md shadow-blue-500/20 group-hover:scale-105 transition-transform"><i class="bi bi-bell text-white text-lg"></i></div>
      <h4 class="font-semibold text-gray-900 dark:text-gray-100 mb-1 text-sm"><%= currentLang === 'km' ? 'ការជូនដំណឹង' : 'Notifications' %></h4>
      <% if (notificationsCount > 0) { %>
        <span class="inline-block px-3 py-1 bg-red-100 dark:bg-red-900/30 text-red-600 dark:text-red-400 rounded-full text-xs font-bold"><%= notificationsCount %> <%= currentLang === 'km' ? 'ថ្មី' : 'new' %></span>
      <% } else { %>
        <p class="text-gray-400 dark:text-gray-500 text-sm"><%= currentLang === 'km' ? 'មិនមាន' : 'None' %></p>
      <% } %>
    </a>
    <%
      var usedCount = (typeof applicationsUsed !== 'undefined' ? applicationsUsed : 0);
      var maxCount = (typeof maxApplications !== 'undefined' ? maxApplications : 2);
      var canApplyNew = (typeof canApply !== 'undefined' ? canApply : usedCount < maxCount);
      var usedKm = String(usedCount).replace(/[0-9]/g, function (d) { return '០១២៣៤៥៦៧៨៩'[Number(d)]; });
      var maxKm = String(maxCount).replace(/[0-9]/g, function (d) { return '០១២៣៤៥៦៧៨៩'[Number(d)]; });
    %>
    <% if (canApplyNew && !registrationClosed) { %>
    <a href="/student/application/select" class="group bg-white dark:bg-gray-800 rounded-2xl p-5 shadow-sm border border-gray-100 dark:border-gray-700 text-center hover:shadow-md hover:-translate-y-0.5 transition-all">
      <div class="w-11 h-11 bg-gradient-to-br from-green-500 to-emerald-500 rounded-2xl flex items-center justify-center mx-auto mb-3 shadow-md shadow-green-500/20 group-hover:scale-105 transition-transform"><i class="bi bi-plus-circle text-white text-lg"></i></div>
      <h4 class="font-semibold text-gray-900 dark:text-gray-100 mb-1 text-sm"><%= currentLang === 'km' ? 'ពាក្យសុំថ្មី' : 'New Application' %></h4>
      <span class="text-sm text-green-600 dark:text-green-400 font-medium"><%= currentLang === 'km' ? 'ដាក់ពាក្យ' : 'Apply' %> →</span>
      <span class="block mt-1.5 text-[11px] text-gray-400 dark:text-gray-500"><%= currentLang === 'km' ? 'បានដាក់ ' + usedKm + '/' + maxKm + ' ពាក្យ' : usedCount + '/' + maxCount + ' used' %></span>
    </a>
    <% } else { %>
    <div class="group bg-white dark:bg-gray-800 rounded-2xl p-5 shadow-sm border border-gray-100 dark:border-gray-700 text-center opacity-70 cursor-not-allowed">
      <div class="w-11 h-11 bg-gradient-to-br from-gray-400 to-gray-500 rounded-2xl flex items-center justify-center mx-auto mb-3 shadow-md"><i class="bi bi-plus-circle text-white text-lg"></i></div>
      <h4 class="font-semibold text-gray-900 dark:text-gray-100 mb-1 text-sm"><%= currentLang === 'km' ? 'ពាក្យសុំថ្មី' : 'New Application' %></h4>
      <% if (!canApplyNew) { %>
        <span class="text-sm text-orange-500 dark:text-orange-400 font-medium"><%= currentLang === 'km' ? 'ដាក់ពាក្យបានដល់កន្លិត' : 'Limit reached' %></span>
        <span class="block mt-1.5 text-[11px] text-gray-400 dark:text-gray-500"><%= currentLang === 'km' ? 'អតិបរមា ' + usedKm + '/' + maxKm + ' ពាក្យ' : 'Max ' + usedCount + '/' + maxCount %></span>
      <% } else { %>
        <span class="text-sm text-red-400 dark:text-red-500 font-medium"><%= currentLang === 'km' ? 'បិទហើយ' : 'Closed' %></span>
      <% } %>
    </div>
    <% } %>
    <% if (enrollmentEnabled) { %>
    <a href="/student/enroll" class="group bg-white dark:bg-gray-800 rounded-2xl p-5 shadow-sm border border-gray-100 dark:border-gray-700 text-center hover:shadow-md hover:-translate-y-0.5 transition-all">
      <div class="w-11 h-11 bg-gradient-to-br from-indigo-500 to-violet-500 rounded-2xl flex items-center justify-center mx-auto mb-3 shadow-md shadow-indigo-500/20 group-hover:scale-105 transition-transform"><i class="bi bi-person-check text-white text-lg"></i></div>
      <h4 class="font-semibold text-gray-900 dark:text-gray-100 mb-1 text-sm"><%= currentLang === 'km' ? 'ការចុះឈ្មោះ' : 'Enrollment' %></h4>
      <% if (!enrollmentClosed) { %>
        <span class="text-sm text-indigo-600 dark:text-indigo-400 font-medium"><%= currentLang === 'km' ? 'ចុះឈ្មោះ' : 'Enroll' %> →</span>
      <% } else { %>
        <span class="text-sm text-red-400 dark:text-red-500 font-medium"><%= currentLang === 'km' ? 'បិទហើយ' : 'Closed' %></span>
      <% } %>
    </a>
    <a href="/student/payments" class="group bg-white dark:bg-gray-800 rounded-2xl p-5 shadow-sm border border-gray-100 dark:border-gray-700 text-center hover:shadow-md hover:-translate-y-0.5 transition-all">
      <div class="w-11 h-11 bg-gradient-to-br from-amber-500 to-orange-500 rounded-2xl flex items-center justify-center mx-auto mb-3 shadow-md shadow-amber-500/20 group-hover:scale-105 transition-transform"><i class="bi bi-credit-card text-white text-lg"></i></div>
      <h4 class="font-semibold text-gray-900 dark:text-gray-100 mb-1 text-sm"><%= currentLang === 'km' ? 'ការទូទាត់' : 'Payments' %></h4>
      <span class="text-sm text-amber-600 dark:text-amber-400 font-medium"><%= Math.round(Number(totalPaid)).toLocaleString() %>៛</span>
    </a>
    <% } %>
  </div>

<% var appList = (typeof applications !== 'undefined' && applications) ? applications : (application ? [application] : []); %>
<% if (!canApplyNew && appList.length) { %>
  <div class="flex items-start gap-3 p-4 rounded-2xl bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800/60">
    <i class="bi bi-info-circle-fill text-amber-500 mt-0.5 flex-shrink-0"></i>
    <p class="text-sm text-amber-800 dark:text-amber-200">
      <%= currentLang === 'km'
        ? 'អ្នកបានដាក់ពាក្យសុំអាហារូបករណ៍បានដល់កន្លិតហើយ (អតិបរមា ' + usedKm + '/' + maxKm + ' ដីរ)។ សូមរង់ចាំលទ្ធផលសិនមុនសិរ។'
        : 'You have reached the maximum of ' + maxCount + ' scholarship applications (' + usedCount + '/' + maxCount + '). Please wait for a result before applying again.' %>
    </p>
  </div>
<% } %>
<% if (appList.length) { %>
  <% appList.forEach(function(a, index) { %>
  <%
    var pillCls = a.status === 'approved' ? 'bg-green-100 dark:bg-green-900/40 text-green-700 dark:text-green-300'
      : a.status === 'rejected' ? 'bg-red-100 dark:bg-red-900/40 text-red-700 dark:text-red-300'
      : a.status === 'pending' ? 'bg-yellow-100 dark:bg-yellow-900/40 text-yellow-700 dark:text-yellow-300'
      : a.status === 'correction_requested' ? 'bg-orange-100 dark:bg-orange-900/40 text-orange-700 dark:text-orange-300'
      : 'bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300';
    var dotCls = a.status === 'approved' ? 'bg-green-500'
      : a.status === 'rejected' ? 'bg-red-500'
      : a.status === 'pending' ? 'bg-yellow-500'
      : a.status === 'correction_requested' ? 'bg-orange-500'
      : 'bg-blue-500';
    var statusLabel = a.status === 'pending' ? (currentLang === 'km' ? 'រង់ចាំ' : 'PENDING')
      : a.status === 'approved' ? (currentLang === 'km' ? 'អនុម័ត' : 'APPROVED')
      : a.status === 'rejected' ? (currentLang === 'km' ? 'បដិសេធ' : 'REJECTED')
      : a.status === 'under_review' ? (currentLang === 'km' ? 'កំពុងពិនិត្យ' : 'UNDER REVIEW')
      : a.status === 'correction_requested' ? (currentLang === 'km' ? 'តម្រូវកែ' : 'CORRECTION')
      : String(a.status || '').replace('_', ' ').toUpperCase();
    var s2done = (a.status === 'approved' || a.status === 'rejected');
    var subDate = a.submitted_at ? new Date(a.submitted_at).toLocaleDateString() : '—';
    var kmDigits = function (s) { return String(s).replace(/[0-9]/g, function (d) { return { '0': '០', '1': '១', '2': '២', '3': '៣', '4': '៤', '5': '៥', '6': '៦', '7': '៧', '8': '៨', '9': '៩' }[d]; }); };
    var optParts = String(a.scholarship_option || '').split('/');
    var optPct = optParts[0] || '';
    var optYears = optParts[1] || '';
    var levelPct = optPct || a.coverage_percentage;
    var levelYears = optYears || a.duration_years;
    var levelText = levelPct ? (currentLang === 'km' ? kmDigits(levelPct) : levelPct) + '%'
      + (levelYears ? (currentLang === 'km' ? ' · ' + kmDigits(levelYears) + ' ឆ្នាំ' : ' · ' + levelYears + ' yrs') : '') : '';
  %>
  <div class="bg-white dark:bg-gray-800 rounded-3xl p-6 shadow-sm border border-gray-100 dark:border-gray-700">
    <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
      <div class="flex items-start gap-3 min-w-0">
        <div class="w-11 h-11 bg-gradient-to-br from-green-500 to-emerald-600 rounded-2xl flex items-center justify-center shadow-md shadow-green-500/20 flex-shrink-0">
          <i class="bi bi-file-earmark-text text-white text-lg"></i>
        </div>
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-2 mb-1">
            <h2 class="font-bold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ស្ថានភាពពាក្យសុំ' : 'Application Status' %></h2>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold <%= pillCls %>"><span class="w-1.5 h-1.5 rounded-full <%= dotCls %>"></span><%= statusLabel %></span>
          </div>
          <p class="text-sm text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'លេខរៀង' : 'No.' %> <%= index + 1 %> · <%= currentLang === 'km' ? 'ដាក់ស្នើ' : 'Submitted' %> <%= subDate %></p>
        </div>
      </div>
      <div class="flex flex-wrap gap-2">
        <a href="/student/application/<%= a.id %>" class="px-4 py-2 bg-gradient-to-r from-green-600 to-emerald-500 text-white rounded-xl text-sm font-semibold hover:from-green-700 hover:to-emerald-600 transition-all shadow-sm inline-flex items-center gap-1.5"><i class="bi bi-eye"></i><%= currentLang === 'km' ? 'មើលព័ត៌មាន' : 'View Details' %></a>
        <a href="/student/status" class="px-4 py-2 border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-300 rounded-xl text-sm font-medium hover:bg-gray-50 dark:hover:bg-gray-700 hover:text-gray-900 dark:hover:text-white transition-all inline-flex items-center gap-1.5"><i class="bi bi-clipboard-check"></i><%= currentLang === 'km' ? 'តាមដាន' : 'Track' %></a>
        <a href="/student/application/<%= a.id %>/print" target="_blank" class="px-4 py-2 border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-300 rounded-xl text-sm font-medium hover:bg-gray-50 dark:hover:bg-gray-700 hover:text-gray-900 dark:hover:text-white transition-all inline-flex items-center gap-1.5"><i class="bi bi-printer"></i><%= currentLang === 'km' ? 'បោះពុម្ព' : 'Print' %></a>
      </div>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mt-5">
      <div class="p-3.5 rounded-2xl bg-gray-50 dark:bg-gray-700/40 border border-gray-100 dark:border-gray-700">
        <div class="flex items-center gap-1.5 mb-1"><i class="bi bi-journal-bookmark text-green-500 text-xs"></i><p class="text-xs text-gray-400 dark:text-gray-500"><%= currentLang === 'km' ? 'ជម្រើសមុខវិជ្ជា' : 'Major' %></p></div>
        <p class="text-sm font-semibold text-gray-900 dark:text-gray-100 break-words"><%= (currentLang === 'km' ? a.major_name_kh : a.major_name_en) || '—' %></p>
      </div>
      <div class="p-3.5 rounded-2xl bg-gray-50 dark:bg-gray-700/40 border border-gray-100 dark:border-gray-700">
        <div class="flex items-center gap-1.5 mb-1"><i class="bi bi-mortarboard text-green-500 text-xs"></i><p class="text-xs text-gray-400 dark:text-gray-500"><%= currentLang === 'km' ? 'កម្មវិធី' : 'Program' %></p></div>
        <p class="text-sm font-semibold text-gray-900 dark:text-gray-100 break-words"><%= (currentLang === 'km' ? a.scholarship_name_kh : a.scholarship_name_en) || '—' %></p>
        <% if (a.leader_name) { %><p class="text-xs text-gray-400 dark:text-gray-500 mt-0.5 truncate"><i class="bi bi-person-badge"></i> <%= a.leader_name %></p><% } %>
        <% if (a.provider_name) { %><p class="text-xs text-gray-400 dark:text-gray-500 mt-0.5 truncate"><i class="bi bi-building"></i> <%= a.provider_name %></p><% } %>
      </div>
      <div class="p-3.5 rounded-2xl bg-gray-50 dark:bg-gray-700/40 border border-gray-100 dark:border-gray-700">
        <div class="flex items-center gap-1.5 mb-1"><i class="bi bi-bookmark text-green-500 text-xs"></i><p class="text-xs text-gray-400 dark:text-gray-500"><%= currentLang === 'km' ? 'ប្រភេទ' : 'Category' %></p></div>
        <p class="text-sm font-semibold text-gray-900 dark:text-gray-100 break-words"><%= (currentLang === 'km' ? a.category_name_kh : a.category_name_en) || '—' %></p>
      </div>
      <div class="p-3.5 rounded-2xl bg-gray-50 dark:bg-gray-700/40 border border-gray-100 dark:border-gray-700">
        <div class="flex items-center gap-1.5 mb-1"><i class="bi bi-percent text-green-500 text-xs"></i><p class="text-xs text-gray-400 dark:text-gray-500"><%= currentLang === 'km' ? 'កម្រិតអាហារូបករណ៍' : 'Scholarship' %></p></div>
        <p class="text-sm font-semibold text-gray-900 dark:text-gray-100 break-words"><%= levelText || '—' %></p>
      </div>
    </div>

    <div class="mt-5 pt-5 border-t border-gray-100 dark:border-gray-700 flex flex-col sm:flex-row sm:items-center gap-3">
      <div class="flex items-center gap-2.5 flex-1 min-w-0">
        <div class="w-7 h-7 rounded-full bg-green-500 text-white flex items-center justify-center text-xs flex-shrink-0 shadow-sm"><i class="bi bi-check-lg"></i></div>
        <div class="min-w-0">
          <p class="text-xs font-bold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ដាក់ស្នើ' : 'Submitted' %></p>
          <p class="text-[11px] text-gray-400 dark:text-gray-500 truncate"><%= subDate %></p>
        </div>
      </div>
      <div class="hidden sm:block h-px flex-1 bg-gradient-to-r from-green-300 dark:from-green-800 to-gray-200 dark:to-gray-700"></div>
      <div class="flex items-center gap-2.5 flex-1 min-w-0">
        <div class="w-7 h-7 rounded-full flex items-center justify-center text-xs flex-shrink-0 <%= s2done ? 'bg-green-500 text-white shadow-sm' : a.status === 'correction_requested' ? 'bg-orange-100 text-orange-600 dark:bg-orange-900/50 dark:text-orange-300 ring-2 ring-orange-400 animate-pulse' : 'bg-blue-100 text-blue-600 dark:bg-blue-900/50 dark:text-blue-300 ring-2 ring-blue-400 animate-pulse' %>"><i class="bi <%= s2done ? 'bi-check-lg' : 'bi-search' %>"></i></div>
        <div class="min-w-0">
          <p class="text-xs font-bold <%= s2done ? 'text-gray-900 dark:text-gray-100' : a.status === 'correction_requested' ? 'text-orange-600 dark:text-orange-400' : 'text-blue-600 dark:text-blue-400' %>"><%= currentLang === 'km' ? 'កំពុងពិនិត្យ' : 'Under Review' %></p>
          <p class="text-[11px] text-gray-400 dark:text-gray-500 truncate"><%= s2done ? (currentLang === 'km' ? 'បានពិនិត្យរួច' : 'Completed') : a.status === 'correction_requested' ? (currentLang === 'km' ? 'តម្រូវកែប្រែ' : 'Action needed') : (currentLang === 'km' ? 'កំពុងដំណើរការ' : 'In progress') %></p>
        </div>
      </div>
      <div class="hidden sm:block h-px flex-1 bg-gradient-to-r <%= s2done ? 'from-green-300 dark:from-green-800' : 'from-gray-200 dark:from-gray-700' %> to-gray-200 dark:to-gray-700"></div>
      <div class="flex items-center gap-2.5 flex-1 min-w-0">
        <div class="w-7 h-7 rounded-full flex items-center justify-center text-xs flex-shrink-0 <%= s2done ? (a.status === 'approved' ? 'bg-green-500 text-white shadow-sm' : 'bg-red-500 text-white shadow-sm') : 'bg-gray-200 text-gray-400 dark:bg-gray-700 dark:text-gray-500' %>"><i class="bi <%= s2done ? (a.status === 'approved' ? 'bi-trophy' : 'bi-x-lg') : 'bi-flag' %>"></i></div>
        <div class="min-w-0">
          <p class="text-xs font-bold <%= s2done ? (a.status === 'approved' ? 'text-green-600 dark:text-green-400' : 'text-red-600 dark:text-red-400') : 'text-gray-400 dark:text-gray-500' %>"><%= currentLang === 'km' ? 'លទ្ធផល' : 'Decision' %></p>
          <p class="text-[11px] text-gray-400 dark:text-gray-500 truncate"><%= s2done ? statusLabel : (currentLang === 'km' ? 'រង់ចាំ' : 'Pending') %></p>
        </div>
      </div>
    </div>

    <% if (a.status === 'correction_requested') { %>
      <div class="mt-5 p-4 rounded-2xl bg-orange-50 dark:bg-orange-900/20 border border-orange-200 dark:border-orange-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-start gap-2.5 min-w-0">
          <i class="bi bi-exclamation-triangle-fill text-orange-500 mt-0.5 flex-shrink-0"></i>
          <div class="min-w-0">
            <p class="text-sm font-bold text-orange-700 dark:text-orange-300"><%= currentLang === 'km' ? 'តម្រូវការកែប្រែ' : 'Correction Required' %></p>
            <p class="text-xs text-orange-600 dark:text-orange-400 mt-0.5"><%= a.correction_notes || (currentLang === 'km' ? 'សូមកែប្រែពាក្យសុំរបស់អ្នក។' : 'Please correct your application.') %></p>
          </div>
        </div>
        <a href="/student/application/<%= a.id %>" class="px-4 py-2 bg-gradient-to-r from-orange-500 to-amber-500 text-white rounded-xl text-sm font-bold hover:from-orange-600 hover:to-amber-600 transition-all shadow-sm inline-flex items-center justify-center gap-1.5 flex-shrink-0 whitespace-nowrap"><i class="bi bi-pencil"></i><%= currentLang === 'km' ? 'កែប្រែឥឡូវនេះ' : 'Fix Now' %></a>
      </div>
    <% } %>
  </div>
  <% }); %>
<% } else { %>
  <div class="bg-white dark:bg-gray-800 rounded-3xl p-12 shadow-sm border border-gray-100 dark:border-gray-700 text-center">
    <i class="bi bi-file-earmark-text text-5xl text-gray-300 mb-4 block"></i>
    <h3 class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-2"><%= currentLang === 'km' ? 'មិនទាន់មានពាក្យសុំ' : 'No Application Yet' %></h3>
    <p class="text-gray-500 dark:text-gray-400 mb-6"><%= currentLang === 'km' ? 'អ្នកមិនទាន់បានដាក់ពាក្យសុំអាហារូបករណ៍នៅឡើយទេ។' : "You haven't submitted a scholarship application yet." %></p>
    <% if (!registrationClosed) { %>
      <a href="/student/application/select" class="px-6 py-3 bg-green-500 text-white rounded-xl font-medium hover:bg-green-600 transition-all shadow-sm inline-flex items-center gap-2"><i class="bi bi-plus-circle"></i><%= currentLang === 'km' ? 'ដាក់ពាក្យឥឡូវនេះ' : 'Apply Now' %></a>
    <% } else { %>
      <p class="text-red-500 dark:text-red-400 font-medium"><%= currentLang === 'km' ? 'ការចុះឈ្មោះបានបិទហើយ' : 'Registration is currently closed.' %></p>
    <% } %>
  </div>
<% } %>

<% if (enrollmentEnabled) { %>
<% if (enrollment) { %>
  <div class="bg-white dark:bg-gray-800 rounded-3xl p-6 shadow-sm border border-gray-100 dark:border-gray-700">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h2 class="font-bold text-gray-900 dark:text-gray-100 mb-2 flex items-center gap-2"><i class="bi bi-person-check text-blue-600 dark:text-blue-400"></i><%= currentLang === 'km' ? 'ស្ថានភាពការចុះឈ្មោះ' : 'Enrollment Status' %></h2>
        <span class="px-3 py-1 rounded-full text-sm font-bold <%= enrollment.status === 'approved' ? 'bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300' : enrollment.status === 'rejected' ? 'bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300' : 'bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-300' %>"><%= enrollment.status === 'approved' ? (currentLang === 'km' ? 'អនុម័ត' : 'Approved') : enrollment.status === 'rejected' ? (currentLang === 'km' ? 'បដិសេធ' : 'Rejected') : (currentLang === 'km' ? 'រង់ចាំ' : 'Pending') %></span>
        <div class="mt-3 space-y-1 text-sm text-gray-600 dark:text-gray-300">
          <p><strong><%= currentLang === 'km' ? 'ជំនាញ' : 'Major' %>:</strong> <%= enrollment.major_choice || 'N/A' %></p>
          <p><strong><%= currentLang === 'km' ? 'ឆ្នាំសិក្សា' : 'Academic Year' %>:</strong> <%= enrollment.academic_year %></p>
          <p><strong><%= currentLang === 'km' ? 'ឆ្នាំទី' : 'Year' %>:</strong> <%= currentLang === 'km' ? 'ឆ្នាំទី ' + enrollment.semester : 'Year ' + enrollment.semester %></p>
          <p><strong><%= currentLang === 'km' ? 'ថ្ងៃចុះឈ្មោះ' : 'Enrolled' %>:</strong> <%= enrollment.enrolled_at ? new Date(enrollment.enrolled_at).toLocaleDateString() : 'N/A' %></p>
        </div>
      </div>
      <div class="flex gap-2">
        <a href="/student/enroll" class="px-4 py-2 bg-blue-500 text-white rounded-xl text-sm font-medium hover:bg-blue-600 transition-all"><i class="bi bi-eye mr-1"></i><%= currentLang === 'km' ? 'មើល' : 'View' %></a>
        <a href="/student/payments" class="px-4 py-2 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-200 rounded-xl text-sm font-medium hover:bg-gray-200 transition-all"><i class="bi bi-credit-card mr-1"></i><%= currentLang === 'km' ? 'ទូទាត់' : 'Pay' %></a>
      </div>
    </div>
  </div>
<% } else if (!enrollmentClosed) { %>
  <div class="bg-gradient-to-r from-blue-500 to-indigo-500 rounded-3xl p-6 shadow-sm text-white">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h2 class="font-bold mb-1 flex items-center gap-2"><i class="bi bi-person-check"></i><%= currentLang === 'km' ? 'ចុះឈ្មោះចូលរៀន' : 'Enroll Now' %></h2>
        <p class="text-blue-100 text-sm"><%= currentLang === 'km' ? 'ចុះឈ្មោះជំនាញនិងឆ្នាំសិក្សា ហើយទូទាត់ថ្លៃសិក្សាតាម ACLEDA Bank KHQR។' : 'Choose your major, academic year, and pay tuition via ACLEDA Bank KHQR.' %></p>
      </div>
      <a href="/student/enroll" class="px-6 py-3 bg-white text-blue-600 rounded-xl font-bold hover:bg-blue-50 transition-all shadow-lg inline-flex items-center gap-2 whitespace-nowrap"><i class="bi bi-plus-circle"></i><%= currentLang === 'km' ? 'ចុះឈ្មោះឥឡូវនេះ' : 'Enroll Now' %></a>
    </div>
  </div>
<% } %>
<% } %>

<% if (enrollmentEnabled && payments.length > 0) { %>
  <div class="bg-white dark:bg-gray-800 rounded-3xl p-6 shadow-sm border border-gray-100 dark:border-gray-700">
    <div class="flex items-center justify-between mb-4">
      <h2 class="font-bold text-gray-900 dark:text-gray-100 flex items-center gap-2"><i class="bi bi-credit-card text-amber-600 dark:text-amber-400"></i><%= currentLang === 'km' ? 'ការទូទាត់' : 'Payments' %></h2>
      <div class="flex items-center gap-2 px-3 py-1.5 bg-emerald-50 dark:bg-emerald-900/20 rounded-full">
        <span class="text-xs text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'សរុបផ្ទៀងផ្ទាត់' : 'Total Verified' %></span>
        <span class="text-sm font-bold text-emerald-600 dark:text-emerald-400"><%= Math.round(Number(totalPaid)).toLocaleString() %>៛</span>
      </div>
    </div>
    <div class="space-y-2">
      <% payments.slice(0, 3).forEach(function(p) { %>
        <div class="flex items-center justify-between p-3 rounded-xl bg-gray-50 dark:bg-gray-700/30 hover:bg-gray-100 dark:hover:bg-gray-700/50 transition-all">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg flex items-center justify-center <%= p.status === 'verified' ? 'bg-green-100 dark:bg-green-900/30' : p.status === 'rejected' ? 'bg-red-100 dark:bg-red-900/30' : 'bg-yellow-100 dark:bg-yellow-900/30' %>">
              <i class="bi bi-<%= p.status === 'verified' ? 'check-circle text-green-600 dark:text-green-400' : p.status === 'rejected' ? 'x-circle text-red-600 dark:text-red-400' : 'clock text-yellow-600 dark:text-yellow-400' %> text-sm"></i>
            </div>
            <div>
              <p class="text-sm font-medium text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? p.fee_name_kh : p.fee_name_en %></p>
              <p class="text-xs text-gray-400 dark:text-gray-500"><%= p.created_at ? new Date(p.created_at).toLocaleDateString() : '' %></p>
            </div>
          </div>
          <div class="text-right">
            <p class="text-sm font-bold text-emerald-600 dark:text-emerald-400"><%= Math.round(Number(p.amount)).toLocaleString() %>៛</p>
            <span class="text-xs font-semibold px-2 py-0.5 rounded-full <%= p.status === 'verified' ? 'bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300' : p.status === 'rejected' ? 'bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300' : 'bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-300' %>"><%= p.status === 'verified' ? (currentLang === 'km' ? 'ផ្ទៀងផ្ទាត់' : 'Verified') : p.status === 'rejected' ? (currentLang === 'km' ? 'បដិសេធ' : 'Rejected') : (currentLang === 'km' ? 'រង់ចាំ' : 'Pending') %></span>
          </div>
        </div>
      <% }); %>
    </div>
    <% if (payments.length > 3) { %>
      <a href="/student/payments" class="mt-3 text-sm text-blue-600 dark:text-blue-400 hover:text-blue-700 font-medium inline-flex items-center gap-1"><%= currentLang === 'km' ? 'មើលទាំងអស់' : 'View All' %> (<%= payments.length %>) →</a>
    <% } %>
  </div>
<% } %>
</div>
