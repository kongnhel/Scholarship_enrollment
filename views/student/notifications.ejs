<div class="max-w-4xl mx-auto space-y-6">
  <div class="relative overflow-hidden rounded-3xl bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 shadow-sm">
    <div class="absolute top-0 right-0 w-40 h-40 bg-green-50 dark:bg-green-900/20 rounded-bl-[6rem] -mr-10 -mt-10"></div>
    <div class="relative px-6 py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 bg-gradient-to-br from-green-500 to-emerald-600 rounded-2xl flex items-center justify-center shadow-md shadow-green-500/20 flex-shrink-0">
          <i class="bi bi-bell text-white text-xl"></i>
        </div>
        <div>
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-green-100 dark:bg-green-900/40 text-green-700 dark:text-green-300 text-xs font-bold mb-1">
            <i class="bi bi-collection"></i>
            <%= notifications.length %> <%= currentLang === 'km' ? 'សារ' : 'notifications' %>
          </div>
          <h1 class="text-xl font-bold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'សារជូនដំណឹង' : 'Notifications' %></h1>
          <p class="text-sm text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'ព័ត៌មានជូនដំណឹងពីប្រព័ន្ធអាហារូបករណ៍' : 'Updates from the scholarship system' %></p>
        </div>
      </div>
      <% var hasUnread = notifications.some(function(n) { return !n.is_read; }); %>
      <div class="flex gap-2 self-start sm:self-auto">
        <%# The control keeps its exact footprint whether or not anything is unread.
            It used to be wrapped in `if (hasUnread)`, so the whole form vanished on
            success and the Back link below slid into the gap - which is how a second
            click ended up on /student/dashboard instead of re-marking anything.
            The label is deliberately unchanged so the width cannot shift either. %>
        <form action="/student/notifications/read-all" method="POST" class="flex-shrink-0">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" <%= hasUnread ? '' : 'disabled' %>
                  class="px-4 py-2 bg-gradient-to-r from-green-600 to-emerald-500 text-white rounded-xl text-sm font-semibold hover:from-green-700 hover:to-emerald-600 transition-all shadow-sm flex items-center gap-1.5 <%= hasUnread ? '' : 'opacity-50 cursor-not-allowed hover:from-green-600 hover:to-emerald-500' %>"
                  title="<%= hasUnread
                    ? (currentLang === 'km' ? 'សម្គាល់សារជូនដំណឹងទាំងអស់ថាបានអាន' : 'Mark all notifications as read')
                    : (currentLang === 'km' ? 'សារជូនដំណឹងទាំងអស់ត្រូវបានអានរួចហើយ' : 'All notifications are already read') %>">
            <i class="bi bi-check-all"></i><%= currentLang === 'km' ? 'អានទាំងអស់' : 'Mark All Read' %>
          </button>
        </form>
        <a href="/student/dashboard" class="flex-shrink-0 px-4 py-2 border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-400 rounded-xl text-sm font-medium hover:bg-gray-50 dark:hover:bg-gray-700 hover:text-gray-900 dark:hover:text-white transition-all flex items-center gap-1.5"><i class="bi bi-arrow-left"></i><%= currentLang === 'km' ? 'ត្រឡប់' : 'Back' %></a>
      </div>
  </div>

  <%
    // Localized copy per notification type. The stored `message` is English-only
    // (it is what the admin wrote / what other consumers read), so the template supplies
    // the language and `detail` supplies the committee's own remark, reason or notes.
    var notifTranslations = {
      status: {
        title: { km: 'ស្ថានភាពពាក្យសុំ', en: 'Application Status' },
        msg: { km: 'ពាក្យសុំរបស់អ្នកកំពុងស្ថិតក្រោមការពិនិត្យ។', en: 'Your application is now under review.' }
      },
      approval: {
        title: { km: 'ពាក្យសុំបានអនុម័ត', en: 'Application Approved' },
        msg: { km: 'សូមអបអរសាទរ! ពាក្យសុំអាហារូបករណ៍របស់អ្នកត្រូវបានអនុម័ត។', en: 'Congratulations! Your scholarship application has been approved.' }
      },
      rejection: {
        title: { km: 'ពាក្យសុំត្រូវបានបដិសេធ', en: 'Application Rejected' },
        msg: { km: 'ពាក្យសុំអាហារូបករណ៍របស់អ្នកត្រូវបានបដិសេធ។', en: 'Your scholarship application has been rejected.' }
      },
      correction: {
        title: { km: 'ស្នើកែប្រែពាក្យសុំ', en: 'Correction Requested' },
        msg: { km: 'ពាក្យសុំរបស់អ្នកត្រូវការកែប្រែ។ សូមពិនិត្យមើលកំណត់សម្គាល់និងដាក់សុំឡើងវិញ។', en: 'Your application requires corrections. Please review the notes and resubmit.' }
      },
      exam_notification: {
        title: { km: 'ព័ត៌មានប្រឡង', en: 'Exam Schedule Notification' },
        msg: { km: 'មានព័ត៌មានប្រឡងថ្មី។ សូមពិនិត្យមើលព័ត៌មានលម្អិត។', en: 'New exam schedule information. Please check the details.' }
      },
      enrollment_approval: {
        title: { km: 'ព័ត៌មានចុះឈ្មោះត្រូវបានអនុម័ត', en: 'Enrollment Approved' },
        msg: { km: 'ព័ត៌មានចុះឈ្មោះរបស់អ្នកត្រូវបានអនុម័ត។', en: 'Your enrollment has been approved.' }
      },
      enrollment_rejection: {
        title: { km: 'ព័ត៌មានចុះឈ្មោះត្រូវបានបដិសេធ', en: 'Enrollment Rejected' },
        msg: { km: 'ព័ត៌មានចុះឈ្មោះរបស់អ្នកត្រូវបានបដិសេធ។', en: 'Your enrollment has been rejected.' }
      },
      payment_verified: {
        title: { km: 'ការទូទាត់ត្រូវបានផ្ទៀងផ្ទាត់', en: 'Payment Verified' },
        msg: { km: 'ការទូទាត់របស់អ្នកត្រូវបានផ្ទៀងផ្ទាត់។', en: 'Your payment has been verified.' }
      },
      payment_rejected: {
        title: { km: 'ការទូទាត់ត្រូវបានបដិសេធ', en: 'Payment Rejected' },
        msg: { km: 'ការទូទាត់របស់អ្នកត្រូវបានបដិសេធ។', en: 'Your payment has been rejected.' }
      }
    };
  %>

  <div class="space-y-3">
    <% if (notifications.length === 0) { %>
      <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 p-12 text-center">
        <div class="w-16 h-16 rounded-full bg-gray-100 dark:bg-gray-700 flex items-center justify-center mx-auto mb-4">
          <i class="bi bi-bell-slash text-3xl text-gray-300 dark:text-gray-600"></i>
        </div>
        <p class="text-gray-500 dark:text-gray-400 font-medium"><%= currentLang === 'km' ? 'គ្មានសារជូនដំណឹង' : 'No notifications' %></p>
        <p class="text-sm text-gray-400 dark:text-gray-500 mt-1"><%= currentLang === 'km' ? 'សារជូនដំណឹងនឹងបង្ហាញនៅទីនេះនៅពេលមានព័ត៌មានថ្មី។' : 'Notifications will appear here when there are updates.' %></p>
      </div>
    <% } else { %>
      <% notifications.forEach(function(n) { %>
        <% var t = notifTranslations[n.type] || null; %>
        <% var titleText = t ? (currentLang === 'km' ? t.title.km : t.title.en) : n.title; %>
        <%
          // Language comes from the type template; the committee's own remark, reason or
          // notes come from `detail`. Falling back to the stored English message keeps
          // rows written before this split still readable.
          var storedMsg = (n.message || '').trim();
          var detailText = (n.detail || '').trim();
          var fallback = t ? (currentLang === 'km' ? t.msg.km : t.msg.en) : '';
          var msgText = t ? fallback : (storedMsg || fallback);
        %>
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-4 <%= n.is_read ? '' : 'border-l-4 border-l-blue-500 bg-blue-50/30 dark:bg-blue-900/10' %>">
          <div class="flex items-start justify-between gap-4">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1">
                <% var typeIcon = ['approval','enrollment_approval','payment_verified'].indexOf(n.type) !== -1 ? 'bi-check-circle-fill text-green-500' : ['rejection','enrollment_rejection','payment_rejected'].indexOf(n.type) !== -1 ? 'bi-x-circle-fill text-red-500' : n.type === 'correction' ? 'bi-pencil-fill text-orange-500' : n.type === 'exam_notification' ? 'bi-calendar-event-fill text-purple-500' : 'bi-info-circle-fill text-blue-500'; %>
                <i class="bi <%= typeIcon %> text-sm"></i>
                <span class="font-semibold text-gray-900 dark:text-gray-100 text-sm"><%= titleText %></span>
                <% if (!n.is_read) { %>
                  <span class="w-2 h-2 rounded-full bg-blue-500"></span>
                <% } %>
              </div>
              <p class="text-sm text-gray-600 dark:text-gray-300 whitespace-pre-wrap ml-6"><%= msgText %></p>
              <% if (detailText) { %>
                <div class="ml-6 mt-2 rounded-lg border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800/60 px-3 py-2">
                  <p class="text-[11px] font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-1">
                    <%= currentLang === 'km' ? 'ព័ត៌មានពីអ្នកគ្រប់គ្រងទី២' : 'From the committee' %>
                  </p>
                  <p class="text-sm text-gray-700 dark:text-gray-200 whitespace-pre-wrap"><%= detailText %></p>
                </div>
              <% } %>
              <p class="text-xs text-gray-400 dark:text-gray-500 mt-2 ml-6"><i class="bi bi-clock mr-1"></i><%= formatDateTime(n.created_at) %></p>
            </div>
<%#
              Deep link to the page the notification is about, so the student lands on the
              application / enrollment / payment instead of hunting for it. `n.link` is
              written server-side through safeLink(), so it is always a site-relative path;
              the guard here is belt-and-braces for rows written before that filter existed.
            %>
            <% if (n.link && String(n.link).charAt(0) === '/' && String(n.link).indexOf('//') !== 0) { %>
              <a href="<%= n.link %>" class="flex-shrink-0 inline-flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-semibold border border-blue-200 text-blue-600 dark:text-blue-400 hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-all">
                <i class="bi bi-box-arrow-up-right"></i><%= currentLang === 'km' ? 'មើល' : 'View' %>
              </a>
            <% } %>
            <% if (!n.is_read) { %>
<form action="/student/notification/<%= n.id %>/read" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="p-2 rounded-lg text-blue-500 hover:text-blue-700 hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-all" title="<%= currentLang === 'km' ? 'អានរួច' : 'Mark read' %>"><i class="bi bi-check-circle"></i></button>
              </form>
            <% } %>
          </div>
        </div>
      <% }); %>
    <% } %>
  </div>
</div>
