<div class="max-w-4xl mx-auto space-y-6">
  <div class="flex items-center gap-3">
    <div class="w-10 h-10 bg-gradient-to-br from-amber-500 to-orange-600 rounded-xl flex items-center justify-center shadow-lg shadow-amber-500/20">
      <i class="bi bi-credit-card text-white text-lg"></i>
    </div>
    <div>
      <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ការទូទាត់' : 'Payments' %></h1>
      <p class="text-sm text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'ទូទាត់តាមរយៈ ACLEDA Bank KHQR' : 'Pay via ACLEDA Bank KHQR' %></p>
    </div>
  </div>

  <div class="grid grid-cols-3 gap-4">
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-5 hover:shadow-md transition-all">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 bg-red-100 dark:bg-red-900/30 rounded-xl flex items-center justify-center"><i class="bi bi-wallet2 text-red-600 dark:text-red-400 text-xl"></i></div>
        <div><p class="text-xl font-bold text-gray-900 dark:text-gray-100"><%= Number(totalDue).toLocaleString() %>៛</p><p class="text-xs text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'សរុបថ្លៃដែលត្រូវបង់' : 'Total Due' %></p></div>
      </div>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-5 hover:shadow-md transition-all">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 bg-green-100 dark:bg-green-900/30 rounded-xl flex items-center justify-center"><i class="bi bi-check-circle text-green-600 dark:text-green-400 text-xl"></i></div>
        <div><p class="text-xl font-bold text-green-600 dark:text-green-400"><%= Number(totalPaid).toLocaleString() %>៛</p><p class="text-xs text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'សរុបបានបង់' : 'Total Paid' %></p></div>
      </div>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-5 hover:shadow-md transition-all">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 bg-amber-100 dark:bg-amber-900/30 rounded-xl flex items-center justify-center"><i class="bi bi-clock-history text-amber-600 dark:text-amber-400 text-xl"></i></div>
        <div><p class="text-xl font-bold text-amber-600 dark:text-amber-400"><%= Number(totalDue - totalPaid).toLocaleString() %>៛</p><p class="text-xs text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'នៅសល់' : 'Remaining' %></p></div>
      </div>
    </div>
  </div>

  <% if (totalDue > 0) { %>
    <div class="relative h-3 bg-gray-100 dark:bg-gray-700 rounded-full overflow-hidden">
      <div class="absolute inset-y-0 left-0 bg-gradient-to-r from-green-500 to-emerald-400 rounded-full transition-all" style="width: <%= Math.min(100, (totalPaid / totalDue) * 100) %>%"></div>
    </div>
  <% } %>

  <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
    <div class="px-6 py-4 bg-gradient-to-r from-emerald-500 to-teal-600">
      <h3 class="text-white font-semibold flex items-center gap-2"><i class="bi bi-qr-code"></i><%= currentLang === 'km' ? 'បង់ប្រាក់តាម ACLEDA Bank KHQR' : 'Pay with ACLEDA Bank KHQR' %></h3>
    </div>
    <div class="p-6">
      <% if (enrollments.length === 0) { %>
        <div class="text-center py-8">
          <div class="w-16 h-16 bg-amber-100 dark:bg-amber-900/30 rounded-full flex items-center justify-center mx-auto mb-4"><i class="bi bi-exclamation-triangle text-amber-500 text-3xl"></i></div>
          <p class="text-gray-600 dark:text-gray-300 mb-3"><%= currentLang === 'km' ? 'សូមចុះឈ្មោះជាមុនសិន' : 'Please enroll first before making a payment' %></p>
          <a href="/student/enroll" class="inline-flex items-center gap-2 px-5 py-2.5 bg-blue-500 text-white rounded-xl hover:bg-blue-600 transition-all font-medium text-sm"><i class="bi bi-person-check"></i><%= currentLang === 'km' ? 'ចុះឈ្មោះ' : 'Enroll' %></a>
        </div>
      <% } else { %>
        <div class="text-center">
          <div class="bg-gray-50 dark:bg-gray-700/30 rounded-2xl p-6 mb-4 inline-block">
            <img src="<%= qrPath %>" alt="KHQR Payment" class="mx-auto rounded-xl shadow-md max-w-[260px]">
          </div>
          <p class="text-sm font-bold text-gray-900 dark:text-gray-100 mb-1">NHEL KONG</p>
          <p class="text-xs text-gray-400 dark:text-gray-500 mb-4">ACLEDA Bank</p>
          <div class="bg-blue-50 dark:bg-blue-900/20 rounded-xl p-4 border border-blue-100 dark:border-blue-800 max-w-md mx-auto">
            <p class="text-sm text-blue-800 dark:text-blue-300 font-medium">
              <i class="bi bi-info-circle mr-1"></i>
              <%= currentLang === 'km' ? 'សូមផ្ញើរូបភាពបង្កាក់ការបង់ប្រាក់មក admin ដើម្បីផ្ទៀងផ្ទាត់' : 'Please send your payment confirmation screenshot to admin for verification' %>
            </p>
          </div>
        </div>
      <% } %>
    </div>
  </div>

  <% if (enrollments.length > 0) { %>
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
      <div class="px-6 py-4 bg-gradient-to-r from-blue-500 to-indigo-600">
        <h3 class="text-white font-semibold flex items-center gap-2"><i class="bi bi-upload"></i><%= currentLang === 'km' ? 'ដាក់ស្នើភស្តុតាងការទូទាត់' : 'Submit Payment Proof' %></h3>
      </div>
      <div class="p-6">
        <form action="/student/payments" method="POST" enctype="multipart/form-data" class="space-y-4">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'ការចុះឈ្មោះ' : 'Enrollment' %> *</label>
              <select name="enrollment_id" required class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
                <option value=""><%= currentLang === 'km' ? 'ជ្រើសរើស' : 'Select' %></option>
                <% enrollments.forEach(function(e) { %>
                  <option value="<%= e.id %>"><%= currentLang === 'km' ? 'ឆ្នាំទី ' + e.semester : 'Year ' + e.semester %> - <%= e.academic_year %></option>
                <% }); %>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'ប្រភេទការបង់' : 'Payment Type' %> *</label>
              <select name="fee_type_id" id="fee_type_id" required onchange="autoFillAmount()" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
                <option value=""><%= currentLang === 'km' ? 'ជ្រើសរើស' : 'Select' %></option>
                <% feeTypes.forEach(function(ft) { %>
                  <option value="<%= ft.id %>"><%= currentLang === 'km' ? ft.name_kh : ft.name_en %></option>
                <% }); %>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'រយៈពេលបង់' : 'Pay Period' %> *</label>
              <select id="pay_period" required onchange="autoFillAmount()" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
                <option value="year"><%= currentLang === 'km' ? '១ឆ្នាំ (១០០%)' : '1 Year (100%)' %></option>
                <option value="semester"><%= currentLang === 'km' ? '១ឆមាស (៥០%)' : '1 Semester (50%)' %></option>
              </select>
            </div>
          </div>
          <div class="p-4 bg-emerald-50 dark:bg-emerald-900/20 rounded-xl border border-emerald-100 dark:border-emerald-800 flex items-center justify-between">
            <p class="text-sm text-emerald-800 dark:text-emerald-300"><i class="bi bi-cash-stack mr-1"></i><%= currentLang === 'km' ? 'ចំនួនត្រូវបង់៖ ' : 'Amount to pay: ' %></p>
            <p class="text-lg font-bold text-emerald-600 dark:text-emerald-400" id="displayAmount"><%= yearlyTuition ? Number(yearlyTuition).toLocaleString() : '0' %>៛</p>
          </div>
          <input type="hidden" id="yearlyTuition" value="<%= yearlyTuition || 0 %>">
          <input type="hidden" name="amount" id="payment_amount" value="<%= yearlyTuition || 0 %>">
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'លេខសម្គាល់ប្រតិបត្តិការ' : 'Transaction Reference' %></label>
            <input type="text" name="transaction_ref" placeholder="<%= currentLang === 'km' ? 'លេខសម្គាល់ (ស្រេចចិត្ត)' : 'Reference (optional)' %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'ភស្តុតាងការទូទាត់ (រូបភាព)' : 'Payment Proof (Screenshot)' %> *</label>
            <input type="file" name="proof" accept=".jpg,.jpeg,.png,.pdf" required class="w-full text-sm text-gray-500 dark:text-gray-400 file:mr-4 file:py-2.5 file:px-5 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 dark:file:bg-blue-900/30 dark:file:text-blue-300 hover:file:bg-blue-100 dark:hover:file:bg-blue-900/50">
            <p class="text-xs text-gray-400 dark:text-gray-500 mt-1"><%= currentLang === 'km' ? 'ទម្រង់៖ JPG, PNG, PDF' : 'Format: JPG, PNG, PDF' %></p>
          </div>
          <button type="submit" class="px-6 py-2.5 bg-gradient-to-r from-blue-500 to-indigo-600 text-white rounded-xl hover:from-blue-600 hover:to-indigo-700 transition-all font-medium shadow-md hover:shadow-lg text-sm flex items-center gap-2">
            <i class="bi bi-send"></i><%= currentLang === 'km' ? 'ដាក់ស្នើ' : 'Submit' %>
          </button>
        </form>
        <script>
        function autoFillAmount() {
          var yearly = parseInt(document.getElementById('yearlyTuition').value) || 0;
          var period = document.getElementById('pay_period').value;
          var amount = period === 'semester' ? Math.round(yearly / 2) : yearly;
          document.getElementById('payment_amount').value = amount;
          document.getElementById('displayAmount').textContent = amount.toLocaleString() + '៛';
        }
        </script>
      </div>
    </div>
  <% } %>

  <% if (payments.length > 0) { %>
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
      <div class="px-6 py-4 bg-gradient-to-r from-amber-500 to-orange-500">
        <h3 class="text-white font-semibold flex items-center gap-2"><i class="bi bi-clock-history"></i><%= currentLang === 'km' ? 'ប្រវត្តិនៃការទូទាត់' : 'Payment History' %></h3>
      </div>
      <div class="p-6">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-gray-50 dark:bg-gray-700/50 border-b border-gray-200 dark:border-gray-600">
              <tr>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase">#</th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase"><%= currentLang === 'km' ? 'ប្រភេទថ្លៃ' : 'Fee Type' %></th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase"><%= currentLang === 'km' ? 'ចំនួន' : 'Amount' %></th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase"><%= currentLang === 'km' ? 'វិធីសាស្ត្រ' : 'Method' %></th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase"><%= currentLang === 'km' ? 'ស្ថានភាព' : 'Status' %></th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase"><%= currentLang === 'km' ? 'កាលបរិច្ឆេទ' : 'Date' %></th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase"><%= currentLang === 'km' ? 'ភស្តុតាង' : 'Proof' %></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-50 dark:divide-gray-700">
              <% payments.forEach(function(p) { %>
                <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
                  <td class="px-4 py-3">
                    <span class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-gray-100 dark:bg-gray-700 text-xs font-bold text-gray-500 dark:text-gray-400"><%= p.id %></span>
                  </td>
                  <td class="px-4 py-3 text-sm font-medium text-gray-900 dark:text-gray-100"><%= p.fee_name_kh %></td>
                  <td class="px-4 py-3">
                    <span class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-bold rounded-lg bg-emerald-50 dark:bg-emerald-900/20 text-emerald-600 dark:text-emerald-400"><%= Number(p.amount).toLocaleString() %>៛</span>
                  </td>
                  <td class="px-4 py-3">
                    <span class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-semibold rounded-lg bg-blue-50 dark:bg-blue-900/20 text-blue-600 dark:text-blue-400"><i class="bi bi-qr-code"></i>KHQR</span>
                  </td>
                  <td class="px-4 py-3">
                    <% if (p.status === 'verified') { %>
                      <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-bold rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300"><span class="w-1.5 h-1.5 rounded-full bg-green-500"></span><%= currentLang === 'km' ? 'ផ្ទៀងផ្ទាត់' : 'Verified' %></span>
                    <% } else if (p.status === 'rejected') { %>
                      <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-bold rounded-full bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300"><span class="w-1.5 h-1.5 rounded-full bg-red-500"></span><%= currentLang === 'km' ? 'បដិសេធ' : 'Rejected' %></span>
                    <% } else { %>
                      <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-bold rounded-full bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-300"><span class="w-1.5 h-1.5 rounded-full bg-yellow-500"></span><%= currentLang === 'km' ? 'រង់ចាំ' : 'Pending' %></span>
                    <% } %>
                  </td>
                  <td class="px-4 py-3 text-sm text-gray-500 dark:text-gray-400"><%= new Date(p.created_at).toLocaleDateString() %></td>
                  <td class="px-4 py-3">
                    <% if (p.proof_path) { %>
                      <a href="<%= p.proof_path %>" target="_blank" class="px-2.5 py-1 rounded-lg text-xs font-semibold border border-blue-200 text-blue-600 dark:text-blue-400 hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-all inline-flex items-center gap-1"><i class="bi bi-eye"></i><%= currentLang === 'km' ? 'មើល' : 'View' %></a>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% } %>
</div>
