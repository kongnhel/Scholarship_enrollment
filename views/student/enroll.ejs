<%
  var khmerDigitMap = { '0': '០', '1': '១', '2': '២', '3': '៣', '4': '៤', '5': '៥', '6': '៦', '7': '៧', '8': '៨', '9': '៩' };
  var khmerYear = String(typeof enrollmentYear !== 'undefined' ? enrollmentYear : '').replace(/[0-9]/g, function(d) { return khmerDigitMap[d]; });
  var fundingLabels = {
    gov_scholarship: { km: 'អាហារូបករណ៍រដ្ឋ (អ.យ.ក)', en: 'Government Scholarship (MoEYS)' },
    nmu_scholarship_100: { km: 'អាហារូបករណ៍១០០% របស់សាកលវិទ្យាល័យជាតិមានជ័យ', en: 'NMU 100% Scholarship' },
    nmu_scholarship_50_4y: { km: 'អាហារូបករណ៍៥០% រយៈពេល៤ឆ្នាំ របស់សាកលវិទ្យាល័យជាតិមានជ័យ', en: 'NMU 50% Scholarship (4 Years)' },
    nmu_scholarship_50_2y: { km: 'អាហារូបករណ៍៥០% រយៈពេល២ឆ្នាំ របស់សាកលវិទ្យាល័យជាតិមានជ័យ', en: 'NMU 50% Scholarship (2 Years)' },
    mekong_scholarship_40_4y: { km: 'អាហារូបករណ៍៤០% រយៈពេល៤ឆ្នាំ របស់អង្គការកុមារមេគង្គកម្ពុជា', en: 'Mekong Child Organization 40% Scholarship (4 Years)' },
    self_pay: { km: 'សិក្សាបង់ថ្លៃ', en: 'Pay the Fee (Self-paying)' }
  };
  var fundingLabel = (typeof selectedFunding !== 'undefined' && selectedFunding && fundingLabels[selectedFunding]) ? fundingLabels[selectedFunding] : null;
%>
<div class="max-w-4xl mx-auto space-y-6">
  <div class="relative overflow-hidden rounded-3xl bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 shadow-sm">
    <div class="absolute top-0 right-0 w-40 h-40 bg-green-50 dark:bg-green-900/20 rounded-bl-[6rem] -mr-10 -mt-10"></div>
    <div class="relative px-6 py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 bg-gradient-to-br from-green-500 to-emerald-600 rounded-2xl flex items-center justify-center shadow-md shadow-green-500/20 flex-shrink-0">
          <i class="bi bi-mortarboard text-white text-xl"></i>
        </div>
        <div>
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-green-100 dark:bg-green-900/40 text-green-700 dark:text-green-300 text-xs font-bold mb-1">
            <i class="bi bi-calendar3"></i>
            <%= currentLang === 'km' ? ('ពាក្យស្នើសុំចុះឈ្មោះ ឆ្នាំសិក្សា ' + khmerYear) : ('Registration Year ' + (typeof enrollmentYear !== 'undefined' ? enrollmentYear : '')) %>
          </div>
          <h1 class="text-lg font-bold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ពាក្យស្នើសុំចុះឈ្មោះចូលរៀនថ្នាក់ឆ្នាំសិក្សាមូលដ្ឋាន (ឆ្នាំទី១) ជំនាន់ទី២០' : 'Enrollment Application for Foundation Studies (Year 1) Generation 20' %></h1>
          <p class="text-sm text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'សាកលវិទ្យាល័យជាតិមានជ័យ' : 'National Meanchey University (NMU)' %></p>
        </div>
      </div>
    </div>
    <p class="relative px-6 pb-5 text-sm text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'សូមបេក្ខជនបំពេញព័ត៌មានខាងក្រោមឱ្យបានត្រឹមត្រូវ និងគ្រប់ជ្រុងជ្រោយ។' : 'Please fill in the following information accurately and completely.' %></p>
  </div>

  <% if (enrollment) { %>
    <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
      <div class="px-6 py-3.5 border-b border-gray-100 dark:border-gray-700 flex items-center gap-2.5">
        <div class="w-8 h-8 <%= enrollment.status === 'approved' ? 'bg-green-100 dark:bg-green-900/40' : enrollment.status === 'rejected' ? 'bg-red-100 dark:bg-red-900/40' : 'bg-yellow-100 dark:bg-yellow-900/40' %> rounded-lg flex items-center justify-center">
          <i class="bi bi-<%= enrollment.status === 'approved' ? 'check-circle text-green-600 dark:text-green-400' : enrollment.status === 'rejected' ? 'x-circle text-red-600 dark:text-red-400' : 'hourglass-split text-yellow-600 dark:text-yellow-400' %> text-sm"></i>
        </div>
        <span class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ស្ថានភាពការចុះឈ្មោះ' : 'Enrollment Status' %></span>
      </div>
      <div class="p-6">
        <div class="flex items-center gap-3 mb-4 flex-wrap">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-bold rounded-full <%= enrollment.status === 'approved' ? 'bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300' : enrollment.status === 'rejected' ? 'bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300' : 'bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-300' %>">
            <span class="w-1.5 h-1.5 rounded-full <%= enrollment.status === 'approved' ? 'bg-green-500' : enrollment.status === 'rejected' ? 'bg-red-500' : 'bg-yellow-500' %>"></span>
            <%= enrollment.status === 'approved' ? (currentLang === 'km' ? 'អនុម័ត' : 'Approved') : enrollment.status === 'rejected' ? (currentLang === 'km' ? 'បដិសេធ' : 'Rejected') : (currentLang === 'km' ? 'រង់ចាំ' : 'Pending') %>
          </span>
          <a href="/student/enroll/print" target="_blank" class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-bold rounded-full bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors">
            <i class="bi bi-printer"></i><%= currentLang === 'km' ? 'បោះពុម្ពពាក្យសុំ' : 'Print Form' %>
          </a>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
          <div><span class="text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'ឆ្នាំសិក្សា' : 'Year' %>:</span> <span class="font-medium text-gray-900 dark:text-gray-100"><%= enrollment.academic_year %></span></div>
          <div><span class="text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'ឆ្នាំទី' : 'Semester' %>:</span> <span class="font-medium text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ឆ្នាំទី ' + enrollment.semester : 'Year ' + enrollment.semester %></span></div>
          <div><span class="text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'កាលបរិច្ឆេទ' : 'Date' %>:</span> <span class="font-medium text-gray-900 dark:text-gray-100"><%= new Date(enrollment.enrolled_at).toLocaleDateString() %></span></div>
          <% if (enrollment.khmer_first_name) { %>
            <div><span class="text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'ឈ្មោះ' : 'Name' %>:</span> <span class="font-medium text-gray-900 dark:text-gray-100"><%= enrollment.khmer_first_name %> <%= enrollment.khmer_last_name %></span></div>
          <% } %>
          <% if (enrollment.admin_notes) { %>
            <div class="col-span-2 md:col-span-4"><span class="text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'កំណត់សម្គាល់' : 'Notes' %>:</span> <span class="font-medium text-gray-700 dark:text-gray-200"><%= enrollment.admin_notes %></span></div>
          <% } %>
        </div>
        <% if (enrollment.status === 'approved' || enrollment.status === 'pending') { %>
          <div class="mt-4 p-4 bg-blue-50 dark:bg-blue-900/20 rounded-xl border border-blue-100 dark:border-blue-800">
            <p class="text-sm text-blue-800 dark:text-blue-300"><i class="bi bi-info-circle mr-1"></i>
              <%= currentLang === 'km' ? 'អ្នកបានចុះឈ្មោះរួចហើយ។ សូមបង់ថ្លៃតាមការណែនាំខាងក្រោម។' : 'You have already enrolled. Please pay the fees as instructed below.' %>
            </p>
          </div>
        <% } %>
      </div>
    </div>
  <% } %>

  <% if (!enrollment || enrollment.status === 'rejected') { %>
    <% if (typeof enrollClosed !== 'undefined' && enrollClosed) { %>
      <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 p-8 text-center">
        <div class="w-16 h-16 bg-red-100 dark:bg-red-900/30 rounded-full flex items-center justify-center mx-auto mb-4">
          <i class="bi bi-x-circle text-red-500 text-3xl"></i>
        </div>
        <h3 class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-2"><%= currentLang === 'km' ? 'ការចុះឈ្មោះចូលរៀនបានបិទ' : 'Enrollment is Closed' %></h3>
        <p class="text-gray-500 dark:text-gray-400 text-sm mb-4"><%= currentLang === 'km' ? 'រយៈពេលចុះឈ្មោះចូលរៀនបានបិទ។ សូមព្យាយាមម្តងទៀតនៅពេលក្រោយ។' : 'The enrollment period has ended. Please try again later.' %></p>
        <a href="/student/dashboard" class="inline-flex items-center gap-2 px-6 py-2.5 bg-blue-500 text-white rounded-xl font-medium hover:bg-blue-600 transition-all"><i class="bi bi-arrow-left"></i><%= currentLang === 'km' ? 'ត្រឡប់ទៅតារាងព័ត៌មាន' : 'Back to Dashboard' %></a>
      </div>
    <% } else if (!selectedFunding) { %>
    <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
      <div class="px-6 py-3.5 border-b border-gray-100 dark:border-gray-700 flex items-center gap-2.5">
        <div class="w-8 h-8 bg-green-100 dark:bg-green-900/40 rounded-lg flex items-center justify-center">
          <i class="bi bi-1-circle text-green-600 dark:text-green-400 text-sm"></i>
        </div>
        <span class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ជំហានទី១៖ ជ្រើសរើសប្រភេទអាហារូបករណ៍ ឬបង់ថ្លៃ' : 'Step 1: Choose Scholarship or Pay the Fee' %></span>
      </div>
      <div class="p-6">
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-4"><%= currentLang === 'km' ? 'សូមជ្រើសរើសមុនដើម្បីបើកទម្រង់ចុះឈ្មោះ។' : 'Please choose one option below to open the enrollment form.' %></p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <a href="/student/enroll?funding=gov_scholarship" class="group p-5 rounded-2xl border-2 border-gray-100 dark:border-gray-700 hover:border-green-400 dark:hover:border-green-500 bg-gray-50 dark:bg-gray-900/40 hover:bg-green-50 dark:hover:bg-green-900/20 transition-all">
            <div class="w-11 h-11 bg-gradient-to-br from-green-500 to-emerald-600 rounded-xl flex items-center justify-center shadow-md shadow-green-500/20 mb-3">
              <i class="bi bi-award text-white text-xl"></i>
            </div>
            <h4 class="text-sm font-bold text-gray-900 dark:text-gray-100 mb-1"><%= currentLang === 'km' ? 'អាហារូបករណ៍រដ្ឋ (អ.យ.ក)' : 'Government Scholarship (MoEYS)' %></h4>
            <p class="text-xs text-gray-500 dark:text-gray-400 mb-3"><%= currentLang === 'km' ? 'អាហារូបករណ៍ពេញថ្លៃ ១០០% ពីក្រសួងអប់រំ យុវជន និងកីឡា។ បង់ថ្លៃរដ្ឋបាល ៥០ ដុល្លារ។' : '100% tuition waived by the Ministry of Education, Youth and Sport. $50 administrative fee applies.' %></p>
            <span class="inline-flex items-center gap-1 text-xs font-bold text-green-600 dark:text-green-400"><%= currentLang === 'km' ? 'ជ្រើសរើស' : 'Choose' %><i class="bi bi-arrow-right group-hover:translate-x-0.5 transition-transform"></i></span>
          </a>
          <a href="/student/enroll?funding=nmu_scholarship_100" class="group p-5 rounded-2xl border-2 border-gray-100 dark:border-gray-700 hover:border-indigo-400 dark:hover:border-indigo-500 bg-gray-50 dark:bg-gray-900/40 hover:bg-indigo-50 dark:hover:bg-indigo-900/20 transition-all">
            <div class="w-11 h-11 bg-gradient-to-br from-indigo-500 to-blue-600 rounded-xl flex items-center justify-center shadow-md shadow-indigo-500/20 mb-3">
              <i class="bi bi-mortarboard text-white text-xl"></i>
            </div>
            <h4 class="text-sm font-bold text-gray-900 dark:text-gray-100 mb-1"><%= currentLang === 'km' ? 'អាហារូបករណ៍១០០% របស់សាកលវិទ្យាល័យ' : 'NMU 100% Scholarship' %></h4>
            <p class="text-xs text-gray-500 dark:text-gray-400 mb-3"><%= currentLang === 'km' ? 'អាហារូបករណ៍១០០% របស់សាកលវិទ្យាល័យជាតិមានជ័យ។' : 'Full 100% scholarship from National Meanchey University.' %></p>
            <span class="inline-flex items-center gap-1 text-xs font-bold text-indigo-600 dark:text-indigo-400"><%= currentLang === 'km' ? 'ជ្រើសរើស' : 'Choose' %><i class="bi bi-arrow-right group-hover:translate-x-0.5 transition-transform"></i></span>
          </a>
          <a href="/student/enroll?funding=nmu_scholarship_50_4y" class="group p-5 rounded-2xl border-2 border-gray-100 dark:border-gray-700 hover:border-blue-400 dark:hover:border-blue-500 bg-gray-50 dark:bg-gray-900/40 hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-all">
            <div class="w-11 h-11 bg-gradient-to-br from-blue-500 to-cyan-600 rounded-xl flex items-center justify-center shadow-md shadow-blue-500/20 mb-3">
              <i class="bi bi-graph-up-arrow text-white text-xl"></i>
            </div>
            <h4 class="text-sm font-bold text-gray-900 dark:text-gray-100 mb-1"><%= currentLang === 'km' ? 'អាហារូបករណ៍៥០% (៤ ឆ្នាំ) របស់សាកលវិទ្យាល័យ' : 'NMU 50% Scholarship (4 Years)' %></h4>
            <p class="text-xs text-gray-500 dark:text-gray-400 mb-3"><%= currentLang === 'km' ? 'អាហារូបករណ៍៥០% រយៈពេល៤ឆ្នាំ របស់សាកលវិទ្យាល័យជាតិមានជ័យ។' : '50% scholarship for 4 years from National Meanchey University.' %></p>
            <span class="inline-flex items-center gap-1 text-xs font-bold text-blue-600 dark:text-blue-400"><%= currentLang === 'km' ? 'ជ្រើសរើស' : 'Choose' %><i class="bi bi-arrow-right group-hover:translate-x-0.5 transition-transform"></i></span>
          </a>
          <a href="/student/enroll?funding=nmu_scholarship_50_2y" class="group p-5 rounded-2xl border-2 border-gray-100 dark:border-gray-700 hover:border-teal-400 dark:hover:border-teal-500 bg-gray-50 dark:bg-gray-900/40 hover:bg-teal-50 dark:hover:bg-teal-900/20 transition-all">
            <div class="w-11 h-11 bg-gradient-to-br from-teal-500 to-emerald-600 rounded-xl flex items-center justify-center shadow-md shadow-teal-500/20 mb-3">
              <i class="bi bi-calendar2-check text-white text-xl"></i>
            </div>
            <h4 class="text-sm font-bold text-gray-900 dark:text-gray-100 mb-1"><%= currentLang === 'km' ? 'អាហារូបករណ៍៥០% (២ ឆ្នាំ) របស់សាកលវិទ្យាល័យ' : 'NMU 50% Scholarship (2 Years)' %></h4>
            <p class="text-xs text-gray-500 dark:text-gray-400 mb-3"><%= currentLang === 'km' ? 'អាហារូបករណ៍៥០% រយៈពេល២ឆ្នាំ របស់សាកលវិទ្យាល័យជាតិមានជ័យ។' : '50% scholarship for 2 years from National Meanchey University.' %></p>
            <span class="inline-flex items-center gap-1 text-xs font-bold text-teal-600 dark:text-teal-400"><%= currentLang === 'km' ? 'ជ្រើសរើស' : 'Choose' %><i class="bi bi-arrow-right group-hover:translate-x-0.5 transition-transform"></i></span>
          </a>
          <a href="/student/enroll?funding=mekong_scholarship_40_4y" class="group p-5 rounded-2xl border-2 border-gray-100 dark:border-gray-700 hover:border-purple-400 dark:hover:border-purple-500 bg-gray-50 dark:bg-gray-900/40 hover:bg-purple-50 dark:hover:bg-purple-900/20 transition-all">
            <div class="w-11 h-11 bg-gradient-to-br from-purple-500 to-fuchsia-600 rounded-xl flex items-center justify-center shadow-md shadow-purple-500/20 mb-3">
              <i class="bi bi-patch-check text-white text-xl"></i>
            </div>
            <h4 class="text-sm font-bold text-gray-900 dark:text-gray-100 mb-1"><%= currentLang === 'km' ? 'អាហារូបករណ៍៤០% (៤ ឆ្នាំ) កុមារមេគង្គកម្ពុជា' : 'Mekong Child 40% Scholarship (4 Years)' %></h4>
            <p class="text-xs text-gray-500 dark:text-gray-400 mb-3"><%= currentLang === 'km' ? 'អាហារូបករណ៍៤០% រយៈពេល៤ឆ្នាំ របស់អង្គការកុមារមេគង្គកម្ពុជា។' : '40% scholarship for 4 years from Mekong Child Organization Cambodia.' %></p>
            <span class="inline-flex items-center gap-1 text-xs font-bold text-purple-600 dark:text-purple-400"><%= currentLang === 'km' ? 'ជ្រើសរើស' : 'Choose' %><i class="bi bi-arrow-right group-hover:translate-x-0.5 transition-transform"></i></span>
          </a>
          <a href="/student/enroll?funding=self_pay" class="group p-5 rounded-2xl border-2 border-gray-100 dark:border-gray-700 hover:border-amber-400 dark:hover:border-amber-500 bg-gray-50 dark:bg-gray-900/40 hover:bg-amber-50 dark:hover:bg-amber-900/20 transition-all">
            <div class="w-11 h-11 bg-gradient-to-br from-amber-500 to-orange-600 rounded-xl flex items-center justify-center shadow-md shadow-amber-500/20 mb-3">
              <i class="bi bi-credit-card text-white text-xl"></i>
            </div>
            <h4 class="text-sm font-bold text-gray-900 dark:text-gray-100 mb-1"><%= currentLang === 'km' ? 'សិក្សាបង់ថ្លៃ' : 'Pay the Fee' %></h4>
            <p class="text-xs text-gray-500 dark:text-gray-400 mb-3"><%= currentLang === 'km' ? 'សិក្សាបង់ថ្លៃ បង់តាមរយៈ KHQR បន្ទាប់ពីដាក់ស្នើ។' : 'Self-paying: pay tuition via KHQR after submitting.' %></p>
            <span class="inline-flex items-center gap-1 text-xs font-bold text-amber-600 dark:text-amber-400"><%= currentLang === 'km' ? 'ជ្រើសរើស' : 'Choose' %><i class="bi bi-arrow-right group-hover:translate-x-0.5 transition-transform"></i></span>
          </a>
        </div>
      </div>
    </div>
    <% } else { %>
    <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
