<div class="max-w-4xl mx-auto space-y-6">
  <div class="relative overflow-hidden rounded-3xl bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 shadow-sm">
    <div class="absolute top-0 right-0 w-40 h-40 bg-green-50 dark:bg-green-900/20 rounded-bl-[6rem] -mr-10 -mt-10"></div>
    <div class="relative px-6 py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 bg-gradient-to-br from-green-500 to-emerald-600 rounded-2xl flex items-center justify-center shadow-md shadow-green-500/20 flex-shrink-0">
          <i class="bi bi-mortarboard text-white text-xl"></i>
        </div>
        <div>
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-green-100 dark:bg-green-900/40 text-green-700 dark:text-green-300 text-xs font-bold mb-1">
            <i class="bi bi-calendar3"></i>
            <%= currentLang === 'km' ? 'ពាក្យស្នើសុំចុះឈ្មោះ ឆ្នាំសិក្សា ២០២៦-២០២៧' : 'Registration Year 2026-2027' %>
          </div>
          <h1 class="text-lg font-bold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ពាក្យស្នើសុំចុះឈ្មោះចូលរៀនថ្នាក់ឆ្នាំសិក្សាមូលដ្ឋាន (ឆ្នាំទី១) ជំនាន់ទី២០' : 'Enrollment Application for Foundation Studies (Year 1) Generation 20' %></h1>
          <p class="text-sm text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'សាកលវិទ្យាល័យជាតិមានជ័យ' : 'National Meanchey University (NMU)' %></p>
        </div>
      </div>
    </div>
    <p class="relative px-6 pb-5 text-sm text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'សូមបេក្ខជនបំពេញព័ត៌មានខាងក្រោមឱ្យបានត្រឹមត្រូវ និងគ្រប់ជ្រុងជ្រោយ។' : 'Please fill in the following information accurately and completely.' %></p>
  </div>

  <% if (enrollment) { %>
    <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
      <div class="px-6 py-3.5 border-b border-gray-100 dark:border-gray-700 flex items-center gap-2.5">
        <div class="w-8 h-8 <%= enrollment.status === 'approved' ? 'bg-green-100 dark:bg-green-900/40' : enrollment.status === 'rejected' ? 'bg-red-100 dark:bg-red-900/40' : 'bg-yellow-100 dark:bg-yellow-900/40' %> rounded-lg flex items-center justify-center">
          <i class="bi bi-<%= enrollment.status === 'approved' ? 'check-circle text-green-600 dark:text-green-400' : enrollment.status === 'rejected' ? 'x-circle text-red-600 dark:text-red-400' : 'hourglass-split text-yellow-600 dark:text-yellow-400' %> text-sm"></i>
        </div>
        <span class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ស្ថានភាពការចុះឈ្មោះ' : 'Enrollment Status' %></span>
      </div>
      <div class="p-6">
        <div class="flex items-center gap-3 mb-4">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-bold rounded-full <%= enrollment.status === 'approved' ? 'bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300' : enrollment.status === 'rejected' ? 'bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300' : 'bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-300' %>">
            <span class="w-1.5 h-1.5 rounded-full <%= enrollment.status === 'approved' ? 'bg-green-500' : enrollment.status === 'rejected' ? 'bg-red-500' : 'bg-yellow-500' %>"></span>
            <%= enrollment.status === 'approved' ? (currentLang === 'km' ? 'អនុម័ត' : 'Approved') : enrollment.status === 'rejected' ? (currentLang === 'km' ? 'បដិសេធ' : 'Rejected') : (currentLang === 'km' ? 'រង់ចាំ' : 'Pending') %>
          </span>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
          <div><span class="text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'ឆ្នាំសិក្សា' : 'Year' %>:</span> <span class="font-medium text-gray-900 dark:text-gray-100"><%= enrollment.academic_year %></span></div>
          <div><span class="text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'ឆ្នាំទី' : 'Semester' %>:</span> <span class="font-medium text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ឆ្នាំទី ' + enrollment.semester : 'Year ' + enrollment.semester %></span></div>
          <div><span class="text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'កាលបរិច្ឆេទ' : 'Date' %>:</span> <span class="font-medium text-gray-900 dark:text-gray-100"><%= new Date(enrollment.enrolled_at).toLocaleDateString() %></span></div>
          <% if (enrollment.khmer_first_name) { %>
            <div><span class="text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'ឈ្មោះ' : 'Name' %>:</span> <span class="font-medium text-gray-900 dark:text-gray-100"><%= enrollment.khmer_first_name %> <%= enrollment.khmer_last_name %></span></div>
          <% } %>
          <% if (enrollment.admin_notes) { %>
            <div class="col-span-2 md:col-span-4"><span class="text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'កំណត់សម្គាល់' : 'Notes' %>:</span> <span class="font-medium text-gray-700 dark:text-gray-200"><%= enrollment.admin_notes %></span></div>
          <% } %>
        </div>
        <% if (enrollment.status === 'approved' || enrollment.status === 'pending') { %>
          <div class="mt-4 p-4 bg-blue-50 dark:bg-blue-900/20 rounded-xl border border-blue-100 dark:border-blue-800">
            <p class="text-sm text-blue-800 dark:text-blue-300"><i class="bi bi-info-circle mr-1"></i>
              <%= currentLang === 'km' ? 'អ្នកបានចុះឈ្មោះរួចហើយ។ សូមបង់ថ្លៃតាមការណែនាំខាងក្រោម។' : 'You have already enrolled. Please pay the fees as instructed below.' %>
            </p>
          </div>
        <% } %>
      </div>
    </div>
  <% } %>

  <% if (!enrollment || enrollment.status === 'rejected') { %>
    <% if (typeof enrollClosed !== 'undefined' && enrollClosed) { %>
      <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 p-8 text-center">
        <div class="w-16 h-16 bg-red-100 dark:bg-red-900/30 rounded-full flex items-center justify-center mx-auto mb-4">
          <i class="bi bi-x-circle text-red-500 text-3xl"></i>
        </div>
        <h3 class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-2"><%= currentLang === 'km' ? 'ការចុះឈ្មោះចូលរៀនបានបិទ' : 'Enrollment is Closed' %></h3>
        <p class="text-gray-500 dark:text-gray-400 text-sm mb-4"><%= currentLang === 'km' ? 'រយៈពេលចុះឈ្មោះចូលរៀនបានបិទ។ សូមព្យាយាមម្តងទៀតនៅពេលក្រោយ។' : 'The enrollment period has ended. Please try again later.' %></p>
        <a href="/student/dashboard" class="inline-flex items-center gap-2 px-6 py-2.5 bg-blue-500 text-white rounded-xl font-medium hover:bg-blue-600 transition-all"><i class="bi bi-arrow-left"></i><%= currentLang === 'km' ? 'ត្រឡប់ទៅតារាងព័ត៌មាន' : 'Back to Dashboard' %></a>
      </div>
    <% } else { %>
    <form action="/student/enroll" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
        <div class="px-6 py-3.5 border-b border-gray-100 dark:border-gray-700 flex items-center gap-2.5">
          <div class="w-8 h-8 bg-emerald-100 dark:bg-emerald-900/40 rounded-lg flex items-center justify-center">
            <i class="bi bi-person text-emerald-600 dark:text-emerald-400 text-sm"></i>
          </div>
          <span class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'I. ព័ត៌មាននិស្សិត' : 'I. Student Information' %></span>
        </div>
        <div class="p-6 space-y-4">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '២. គោត្តនាម និងនាម - ជាអក្សរខ្មែរ' : '2. Full Name in Khmer' %> *</label>
              <input type="text" name="khmer_name" placeholder="<%= currentLang === 'km' ? 'ឧទាហរណ៍៖ សុខ ដារ៉ា' : 'e.g. SOK Dara' %>" value="<%= (application && application.khmer_last_name) ? (application.khmer_first_name + ' ' + application.khmer_last_name) : (userData ? userData.khmer_name : '') %>" required class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '៣. Full Name in English / Latin' : '3. Full Name in English / Latin' %> *</label>
              <input type="text" name="english_name" placeholder="<%= currentLang === 'km' ? 'ឧទាហរណ៍៖ SOK DARA' : 'e.g. SOK DARA' %>" value="<%= (application && application.english_first_name) ? (application.english_first_name + ' ' + application.english_last_name) : (userData ? userData.english_name : '') %>" required class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
            </div>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '៤. ភេទ' : '4. Gender' %> *</label>
              <select name="gender" required class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
                <option value=""><%= currentLang === 'km' ? 'ជ្រើសរើសភេទ' : 'Select gender' %></option>
                <option value="male" <%= (application && application.gender === 'male') ? 'selected' : '' %>><%= currentLang === 'km' ? 'ប្រុស' : 'Male' %></option>
                <option value="female" <%= (application && application.gender === 'female') ? 'selected' : '' %>><%= currentLang === 'km' ? 'ស្រី' : 'Female' %></option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '៥. ថ្ងៃ ខែ ឆ្នាំកំណើត' : '5. Date of Birth' %> *</label>
              <input type="date" name="date_of_birth" value="<%= (application && application.date_of_birth) ? new Date(application.date_of_birth).toISOString().split('T')[0] : '' %>" required class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '៦. ទីកន្លែងកំណើត' : '6. Place of Birth' %> *</label>
            <input type="text" name="place_of_birth" placeholder="<%= currentLang === 'km' ? 'សូមបញ្ជាក់ ភូមិ ឃុំ/សង្កាត់ ស្រុក/ក្រុង និងខេត្ត/រាជធានី' : 'Village, Commune, District, Province' %>" value="<%= (application && application.place_of_birth) ? application.place_of_birth : '' %>" required class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
          </div>

          <div class="pt-2 border-t border-gray-100 dark:border-gray-700">
            <p class="text-sm font-semibold text-gray-900 dark:text-gray-100 mb-3"><%= currentLang === 'km' ? 'អាសយដ្ឋានបច្ចុប្បន្ន' : 'Current Address' %> *</p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '៧. ភូមិ' : '7. Village' %> *</label>
                <input type="text" name="village" placeholder="<%= currentLang === 'km' ? 'ភូមិ' : 'Village' %>" value="<%= (application && application.village) ? application.village : '' %>" required class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '៨. ឃុំ / សង្កាត់' : '8. Commune / Sangkat' %> *</label>
                <input type="text" name="commune" placeholder="<%= currentLang === 'km' ? 'ឃុំ ឬ សង្កាត់' : 'Commune or Sangkat' %>" value="<%= (application && application.commune) ? application.commune : '' %>" required class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '៩. ស្រុក / ក្រុង / ខណ្ឌ' : '9. District / City / Khan' %> *</label>
                <input type="text" name="district" placeholder="<%= currentLang === 'km' ? 'ស្រុក ក្រុង ឬ ខណ្ឌ' : 'District, City, or Khan' %>" value="<%= (application && application.district) ? application.district : '' %>" required class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '១០. ខេត្ត / រាជធានី' : '10. Province / City' %> *</label>
                <input type="text" name="province" placeholder="<%= currentLang === 'km' ? 'ខេត្ត ឬ រាជធានី' : 'Province or City' %>" value="<%= (application && application.province) ? application.province : '' %>" required class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden mt-6">
        <div class="px-6 py-3.5 border-b border-gray-100 dark:border-gray-700 flex items-center gap-2.5">
          <div class="w-8 h-8 bg-purple-100 dark:bg-purple-900/40 rounded-lg flex items-center justify-center">
            <i class="bi bi-people text-purple-600 dark:text-purple-400 text-sm"></i>
          </div>
          <span class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ព័ត៌មានគ្រួសារ' : 'Family Information' %></span>
        </div>
        <div class="p-6 space-y-4">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '១១. ឈ្មោះឪពុក' : '11. Father\'s Name' %> *</label>
              <input type="text" name="father_name" placeholder="<%= currentLang === 'km' ? 'ឈ្មោះពេញរបស់ឪពុក' : 'Father\'s full name' %>" value="<%= (application && application.parent_name && application.parent_relationship === 'father') ? application.parent_name : '' %>" required class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '១២. ឈ្មោះម្តាយ' : '12. Mother\'s Name' %> *</label>
              <input type="text" name="mother_name" placeholder="<%= currentLang === 'km' ? 'ឈ្មោះពេញរបស់ម្តាយ' : 'Mother\'s full name' %>" value="" required class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
            </div>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '១៣. មុខរបរសព្វថ្ងៃរបស់បេក្ខជន' : '13. Current Occupation' %></label>
              <input type="text" name="occupation" placeholder="<%= currentLang === 'km' ? 'មុខរបរបច្ចុប្បន្ន' : 'Current occupation' %>" value="" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '១៤. កម្រិតវប្បធម៌' : '14. Education Level' %></label>
              <select name="education_level" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
                <option value=""><%= currentLang === 'km' ? 'ជ្រើសរើសកម្រិតវប្បធម៌' : 'Select education level' %></option>
                <option value="none"><%= currentLang === 'km' ? 'គ្មាន' : 'None' %></option>
                <option value="primary"><%= currentLang === 'km' ? 'បឋមសិក្សា' : 'Primary School' %></option>
                <option value="lower_secondary"><%= currentLang === 'km' ? 'អនុវិទ្យាល័យ' : 'Lower Secondary' %></option>
                <option value="upper_secondary"><%= currentLang === 'km' ? 'វិទ្យាល័យ' : 'Upper Secondary' %></option>
                <option value="bachelor"><%= currentLang === 'km' ? 'បរិញ្ញាបត្រ' : 'Bachelor\'s Degree' %></option>
                <option value="master"><%= currentLang === 'km' ? 'បរិញ្ញាបត្ររង' : 'Master\'s Degree' %></option>
                <option value="phd"><%= currentLang === 'km' ? 'បណ្ឌិត' : 'PhD' %></option>
              </select>
            </div>
          </div>
        </div>
      </div>

      <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden mt-6">
        <div class="px-6 py-3.5 border-b border-gray-100 dark:border-gray-700 flex items-center gap-2.5">
          <div class="w-8 h-8 bg-amber-100 dark:bg-amber-900/40 rounded-lg flex items-center justify-center">
            <i class="bi bi-telephone text-amber-600 dark:text-amber-400 text-sm"></i>
          </div>
          <span class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ព័ត៌មានទំនាក់ទំនង' : 'Contact Information' %></span>
        </div>
        <div class="p-6">
