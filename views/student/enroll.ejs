      <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden mt-6">
        <div class="px-6 py-3.5 border-b border-gray-100 dark:border-gray-700 flex items-center gap-2.5">
          <div class="w-8 h-8 bg-rose-100 dark:bg-rose-900/40 rounded-lg flex items-center justify-center">
            <i class="bi bi-file-earmark-check text-rose-600 dark:text-rose-400 text-sm"></i>
          </div>
          <span class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ឯកសារភ្ជាប់' : 'Attached Documents' %></span>
        </div>
        <div class="p-6 space-y-3">
          <p class="text-sm text-gray-500 dark:text-gray-400"><%= currentLang === 'km' ? 'សូមពិនិត្យ និងត្រៀមឯកសារតាមតម្រូវការរបស់សាកលវិទ្យាល័យជាតិមានជ័យ។' : 'Please check and prepare the required documents for NMU.' %></p>
          <div class="space-y-3">

            <div class="p-3 bg-gray-50 dark:bg-gray-700/30 rounded-xl">
              <label class="flex items-start gap-3 cursor-pointer">
                <input type="checkbox" name="doc_transcript" value="1" class="mt-0.5 w-4 h-4 text-blue-600 bg-white dark:bg-gray-800 border-gray-300 dark:border-gray-600 rounded focus:ring-blue-500" onchange="toggleDocUpload('transcript')">
                <span class="text-sm text-gray-700 dark:text-gray-200"><%= currentLang === 'km' ? 'ព្រឹត្តិបត្រពិន្ទុ ឬ សញ្ញាបត្រមធ្យមសិក្សាទុតិយភូមិ ឬ សញ្ញាបត្រដែលមានតម្លៃស្មើ ចំនួន ០១ ច្បាប់' : 'Transcript or High School Diploma or equivalent, 01 copy' %></span>
              </label>
              <div id="upload-transcript" class="hidden mt-3 ml-7">
                <input type="file" name="doc_transcript_file" accept=".pdf,.jpg,.jpeg,.png" class="w-full text-sm text-gray-500 dark:text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 dark:file:bg-blue-900/30 dark:file:text-blue-300 hover:file:bg-blue-100 dark:hover:file:bg-blue-900/50">
                <p class="text-xs text-gray-400 dark:text-gray-500 mt-1"><%= currentLang === 'km' ? 'ទម្រង់៖ PDF, JPG, PNG' : 'Format: PDF, JPG, PNG' %></p>
              </div>
            </div>

            <div class="p-3 bg-gray-50 dark:bg-gray-700/30 rounded-xl">
              <label class="flex items-start gap-3 cursor-pointer">
                <input type="checkbox" name="doc_birth_cert" value="1" class="mt-0.5 w-4 h-4 text-blue-600 bg-white dark:bg-gray-800 border-gray-300 dark:border-gray-600 rounded focus:ring-blue-500" onchange="toggleDocUpload('birth_cert')">
                <span class="text-sm text-gray-700 dark:text-gray-200"><%= currentLang === 'km' ? 'សំបុត្រកំណើត / សំបុត្របញ្ជាក់កំណើត ឬ ឯកសារឯកត្តជន ចំនួន ០២ ច្បាប់' : 'Birth Certificate / Birth Confirmation / Personal Document, 02 copies' %></span>
              </label>
              <div id="upload-birth_cert" class="hidden mt-3 ml-7">
                <input type="file" name="doc_birth_cert_file" accept=".pdf,.jpg,.jpeg,.png" class="w-full text-sm text-gray-500 dark:text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 dark:file:bg-blue-900/30 dark:file:text-blue-300 hover:file:bg-blue-100 dark:hover:file:bg-blue-900/50">
                <p class="text-xs text-gray-400 dark:text-gray-500 mt-1"><%= currentLang === 'km' ? 'ទម្រង់៖ PDF, JPG, PNG' : 'Format: PDF, JPG, PNG' %></p>
              </div>
            </div>

            <div class="p-3 bg-gray-50 dark:bg-gray-700/30 rounded-xl">
              <label class="flex items-start gap-3 cursor-pointer">
                <input type="checkbox" name="doc_photo_4x6" value="1" class="mt-0.5 w-4 h-4 text-blue-600 bg-white dark:bg-gray-800 border-gray-300 dark:border-gray-600 rounded focus:ring-blue-500" onchange="toggleDocUpload('photo_4x6')">
                <span class="text-sm text-gray-700 dark:text-gray-200"><%= currentLang === 'km' ? 'រូបថតទំហំ ៤ × ៦ ថតចំពីមុខ ឥតពាក់វ៉ែនតា ចំនួន ០២ សន្លឹក' : 'Photo 4x6, front-facing, no glasses, 02 photos' %></span>
              </label>
              <div id="upload-photo_4x6" class="hidden mt-3 ml-7">
                <input type="file" name="doc_photo_4x6_file" accept=".jpg,.jpeg,.png" class="w-full text-sm text-gray-500 dark:text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 dark:file:bg-blue-900/30 dark:file:text-blue-300 hover:file:bg-blue-100 dark:hover:file:bg-blue-900/50">
                <p class="text-xs text-gray-400 dark:text-gray-500 mt-1"><%= currentLang === 'km' ? 'ទម្រង់៖ JPG, PNG' : 'Format: JPG, PNG' %></p>
              </div>
            </div>

            <div class="p-3 bg-gray-50 dark:bg-gray-700/30 rounded-xl">
              <label class="flex items-start gap-3 cursor-pointer">
                <input type="checkbox" name="doc_photo_3x4" value="1" class="mt-0.5 w-4 h-4 text-blue-600 bg-white dark:bg-gray-800 border-gray-300 dark:border-gray-600 rounded focus:ring-blue-500" onchange="toggleDocUpload('photo_3x4')">
                <span class="text-sm text-gray-700 dark:text-gray-200"><%= currentLang === 'km' ? 'រូបថតទំហំ ៣ × ៤ ថតចំពីមុខ ឥតពាក់វ៉ែនតា ចំនួន ០២ សន្លឹក' : 'Photo 3x4, front-facing, no glasses, 02 photos' %></span>
              </label>
              <div id="upload-photo_3x4" class="hidden mt-3 ml-7">
                <input type="file" name="doc_photo_3x4_file" accept=".jpg,.jpeg,.png" class="w-full text-sm text-gray-500 dark:text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 dark:file:bg-blue-900/30 dark:file:text-blue-300 hover:file:bg-blue-100 dark:hover:file:bg-blue-900/50">
                <p class="text-xs text-gray-400 dark:text-gray-500 mt-1"><%= currentLang === 'km' ? 'ទម្រង់៖ JPG, PNG' : 'Format: JPG, PNG' %></p>
              </div>
            </div>

          </div>
        </div>
      </div>

      <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden mt-6">
        <div class="px-6 py-3.5 border-b border-gray-100 dark:border-gray-700 flex items-center gap-2.5">
          <div class="w-8 h-8 bg-gray-100 dark:bg-gray-700/40 rounded-lg flex items-center justify-center">
            <i class="bi bi-shield-check text-gray-600 dark:text-gray-400 text-sm"></i>
          </div>
          <span class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'V. កិច្ចសន្យា និងការធានាទទួលខុសត្រូវ' : 'V. Agreement & Responsibility' %></span>
        </div>
        <div class="p-6 space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? '២៧. ព័ត៌មានបន្ថែម / សេចក្តីបញ្ជាក់របស់បេក្ខជន' : '27. Additional Information / Candidate Statement' %></label>
            <textarea name="additional_info" rows="3" placeholder="<%= currentLang === 'km' ? 'ប្រសិនបើមានព័ត៌មានចាំបាច់ផ្សេងទៀត សូមបញ្ជាក់នៅទីនេះ។' : 'If there is any other necessary information, please specify here.' %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 resize-none"></textarea>
          </div>
          <div class="p-4 bg-blue-50 dark:bg-blue-900/20 rounded-xl border border-blue-100 dark:border-blue-800">
            <label class="flex items-start gap-3 cursor-pointer">
              <input type="checkbox" name="confirmation" value="1" required class="mt-0.5 w-4 h-4 text-blue-600 bg-white dark:bg-gray-800 border-gray-300 dark:border-gray-600 rounded focus:ring-blue-500">
              <span class="text-sm text-blue-800 dark:text-blue-300 font-medium"><%= currentLang === 'km' ? '២៨. ខ្ញុំសូមបញ្ជាក់ថា ព័ត៌មានដែលខ្ញុំបានបំពេញខាងលើគឺត្រឹមត្រូវ ហើយខ្ញុំទទួលខុសត្រូវចំពោះព័ត៌មានដែលបានផ្តល់។' : '28. I confirm that the information provided above is correct and I take full responsibility for the information given.' %></span>
            </label>
          </div>
        </div>
      </div>

      <div class="flex justify-end gap-3 mt-6">
        <a href="/student/enroll" class="px-6 py-2.5 border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 rounded-xl hover:bg-gray-50 dark:hover:bg-gray-700 transition-all font-medium text-sm">
          <i class="bi bi-arrow-left mr-1"></i><%= currentLang === 'km' ? 'ត្រឡប់' : 'Back' %>
        </a>
        <button type="submit" class="px-6 py-2.5 bg-gradient-to-r from-blue-500 to-indigo-600 text-white rounded-xl hover:from-blue-600 hover:to-indigo-700 transition-all font-medium shadow-md hover:shadow-lg text-sm flex items-center gap-1.5">
          <i class="bi bi-check-lg"></i><%= currentLang === 'km' ? 'ដាក់ស្នើសុំចុះឈ្មោះ' : 'Submit Enrollment' %>
        </button>
      </div>
    </form>
    <% } %>
  <% } %>

  <% if (payments.length > 0) { %>
    <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
      <div class="px-6 py-3.5 border-b border-gray-100 dark:border-gray-700 flex items-center gap-2.5">
        <div class="w-8 h-8 bg-amber-100 dark:bg-amber-900/40 rounded-lg flex items-center justify-center">
          <i class="bi bi-clock-history text-amber-600 dark:text-amber-400 text-sm"></i>
        </div>
        <span class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ប្រវត្តិនៃការទូទាត់' : 'Payment History' %></span>
      </div>
      <div class="p-6">
        <div class="text-sm text-gray-600 dark:text-gray-400 mb-4">
          <%= currentLang === 'km' ? 'សរុបប្រាក់ដែលបានផ្ទៀងផ្ទាត់៖ ' : 'Total Verified: ' %>
          <span class="font-bold text-emerald-600 dark:text-emerald-400"><%= Math.round(Number(payments.filter(p => p.status === 'verified').reduce((s, p) => s + Number(p.amount), 0)) / 4000).toLocaleString() %>$</span>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-gray-50 dark:bg-gray-700/50 border-b border-gray-200 dark:border-gray-600">
              <tr>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase">#</th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase"><%= currentLang === 'km' ? 'ប្រភេទថ្លៃ' : 'Fee Type' %></th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase"><%= currentLang === 'km' ? 'ចំនួន' : 'Amount' %></th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase"><%= currentLang === 'km' ? 'វិធីសាស្ត្រ' : 'Method' %></th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase"><%= currentLang === 'km' ? 'ស្ថានភាព' : 'Status' %></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-50 dark:divide-gray-700">
              <% payments.forEach(function(p) { %>
                <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                  <td class="px-4 py-3 text-sm text-gray-500 dark:text-gray-400"><%= p.id %></td>
                  <td class="px-4 py-3 text-sm font-medium text-gray-900 dark:text-gray-100"><%= p.fee_name_kh %></td>
                  <td class="px-4 py-3 text-sm font-bold text-emerald-600 dark:text-emerald-400"><%= Math.round(Number(p.amount) / 4000).toLocaleString() %>$</td>
                  <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-300 capitalize"><%= p.payment_method %></td>
                  <td class="px-4 py-3">
                    <% if (p.status === 'verified') { %>
                      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-bold rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300"><span class="w-1.5 h-1.5 rounded-full bg-green-500"></span><%= currentLang === 'km' ? 'ផ្ទៀងផ្ទាត់' : 'Verified' %></span>
                    <% } else if (p.status === 'rejected') { %>
                      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-bold rounded-full bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300"><span class="w-1.5 h-1.5 rounded-full bg-red-500"></span><%= currentLang === 'km' ? 'បដិសេធ' : 'Rejected' %></span>
                    <% } else { %>
                      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-bold rounded-full bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-300"><span class="w-1.5 h-1.5 rounded-full bg-yellow-500"></span><%= currentLang === 'km' ? 'រង់ចាំ' : 'Pending' %></span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% } %>
</div>

<script>
function toggleDocUpload(docType) {
  const uploadDiv = document.getElementById('upload-' + docType);
  const checkbox = document.querySelector('input[name="doc_' + docType + '"]');
  if (checkbox.checked) {
    uploadDiv.classList.remove('hidden');
  } else {
    uploadDiv.classList.add('hidden');
    const fileInput = uploadDiv.querySelector('input[type="file"]');
    if (fileInput) fileInput.value = '';
  }
}
</script>
