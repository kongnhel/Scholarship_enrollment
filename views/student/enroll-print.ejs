<%
  var e = enrollment || {};
  var u = userData || {};
  var maj = major || null;
  var app = application || {};

  var khmerDigitMap = { '0': '០', '1': '១', '2': '២', '3': '៣', '4': '៤', '5': '៥', '6': '៦', '7': '៧', '8': '៨', '9': '៩' };
  function toKhmerDigits(str) {
    return String(str == null ? '' : str).replace(/[0-9]/g, function(d) { return khmerDigitMap[d]; });
  }

  var KHMER_MONTHS = ['មករា', 'កុម្ភៈ', 'មីនា', 'មេសា', 'ឧសភា', 'មិថុនា', 'កក្កដា', 'សីហា', 'កញ្ញា', 'តុលា', 'វិច្ឆិកា', 'ធ្នូ'];

  // Date of birth, read on a Cambodia clock.
  var dobDay = '', dobMonthKh = '', dobYear = '', dobShortKh = '', dobLongKh = '';
  var dobParts = cambodiaDateParts(e.date_of_birth);
  if (dobParts) {
    dobDay = dobParts.day;
    dobMonthKh = KHMER_MONTHS[dobParts.month - 1] || '';
    dobYear = dobParts.year;
    dobShortKh = toKhmerDigits(dobDay) + ' ' + dobMonthKh + ' ' + toKhmerDigits(dobYear);
    dobLongKh = 'ថ្ងៃទី' + toKhmerDigits(dobDay) + ' ខែ' + dobMonthKh + ' ឆ្នាំ' + toKhmerDigits(dobYear);
  }

  // enrolled_at is a TIMESTAMP: MySQL hands back naive UTC, so the parts have to be read
  // on a Cambodia clock or the signature date lands up to 7 hours early.
  var sigDay = '', sigMonthKh = '', sigYearKh = '', sigBeYear = '';
  var enParts = cambodiaDateParts(e.enrolled_at);
  if (enParts) {
    sigDay = toKhmerDigits(enParts.day);
    sigMonthKh = KHMER_MONTHS[enParts.month - 1] || '';
    sigYearKh = toKhmerDigits(enParts.year);
    sigBeYear = toKhmerDigits(String(enParts.year + 543).slice(-1));
  }

  var academicYearKh = toKhmerDigits(e.academic_year).replace('-', ' - ');
  var startYear = parseInt(String(e.academic_year || '').split('-')[0], 10);
  var generationKh = toKhmerDigits(isNaN(startYear) ? 20 : startYear - 2006);
  var studyYearLabel = academicYearKh;

  var genderKh = e.gender === 'male' ? 'ប្រុស' : (e.gender === 'female' ? 'ស្រី' : '');
  var khmerName = [e.khmer_first_name, e.khmer_last_name].filter(Boolean).join(' ');
  var englishName = [e.english_first_name, e.english_last_name].filter(Boolean).join(' ');

  var fmtPhone = function (v) {
    if (!v) return '';
    var cleaned = String(v).replace(/[^\d+]/g, '');
    var m = cleaned.match(/^(\+\d{1,4})(\d+)$/);
    if (!m) return String(v);
    var rest = m[2], groups = [];
    while (rest.length > 4) { groups.push(rest.slice(0, 3)); rest = rest.slice(3); }
    groups.push(rest);
    return m[1] + ' ' + groups.join(' ');
  };

  var fundingType = e.funding_type;
  var isGov = fundingType === 'gov_scholarship';
  var isSelfPay = fundingType === 'self_pay';
  var fullPay = isGov && e.funding_payment_mode !== 'partial_pay';
  var feePay = isGov && e.funding_payment_mode === 'partial_pay';
  var requestTitle = isSelfPay
    ? 'ពាក្យស្នើសុំចុះឈ្មោះចូលរៀនថ្នាក់ឆ្នាំសិក្សាមូលដ្ឋាន (ឆ្នាំទី១)'
    : 'ពាក្យសុំចុះឈ្មោះអាហារូបករណ៍ចូលរៀនថ្នាក់ឆ្នាំសិក្សាមូលដ្ឋាន (ឆ្នាំទី១)';

  var FUNDING_VARIANTS = {
    gov_scholarship: {
      paren: '( អាហារូបករណ៍ក្រសួងអប់រំ យុវជន និងកីឡា )',
      request: 'អាហារូបករណ៍រដ្ឋ(អ.យ.ក)',
      label: 'អាហារូបករណ៍អ.យ.ក',
      requestStyle: 'gov'
    },
    nmu_scholarship_100: {
      paren: '( អាហារូបករណ៍១០០%របស់សាកលវិទ្យាល័យជាតិមានជ័យ )',
      request: 'អាហារូបករណ៍១០០% របស់សាកលវិទ្យាល័យជាតិមានជ័យ',
      label: 'អាហារូបករណ៍របស់៖ សាកលវិទ្យាល័យជាតិមានជ័យ',
      requestStyle: 'plain'
    },
    nmu_scholarship_50_4y: {
      paren: '( អាហារូបករណ៍៥០%រយៈពេល៤ឆ្នាំ របស់សាកលវិទ្យាល័យជាតិមានជ័យ )',
      request: 'អាហារូបករណ៍៥០%រយៈពេល៤ឆ្នាំ របស់សាកលវិទ្យាល័យជាតិមានជ័យ',
      label: 'អាហារូបករណ៍៥០% របស់សាកលវិទ្យាល័យជាតិមានជ័យ',
      requestStyle: 'plain'
    },
    nmu_scholarship_50_2y: {
      paren: '( អាហារូបករណ៍៥០%សិក្សារយៈពេល២ឆ្នាំ របស់សាកលវិទ្យាល័យជាតិមានជ័យ )',
      request: 'អាហារូបករណ៍៥០%សិក្សារយៈពេល២ឆ្នាំ របស់សាកលវិទ្យាល័យជាតិមានជ័យ',
      label: 'អាហារូបករណ៍៥០% សិក្សារយៈពេល២ឆ្នាំ របស់សាកលវិទ្យាល័យជាតិមានជ័យ',
      requestStyle: 'plain'
    },
    mekong_scholarship_40_4y: {
      paren: '( អាហារូបករណ៍៤០%សិក្សារយៈពេល៤ឆ្នាំ របស់អង្គការកុមារមេគង្គកម្ពុជា )',
      request: 'អាហារូបករណ៍៤០% រយៈពេល៤ឆ្នាំ របស់អង្គការកុមារមេគង្គកម្ពុជា',
      label: 'អាហារូបករណ៍៤០% របស់អង្គការកុមារមេគង្គកម្ពុជា',
      requestStyle: 'plain'
    },
    self_pay: {
      paren: '( បង់ថ្លៃ )',
      request: 'សិក្សាបង់ថ្លៃ',
      label: 'បង់ថ្លៃ',
      requestStyle: 'self'
    }
  };
  var fv = FUNDING_VARIANTS[fundingType] || FUNDING_VARIANTS.self_pay;

  var majorKh = maj ? maj.name_kh : '';
  var levelText = e.education_level_enroll === 'bachelor' ? 'បរិញ្ញាបត្រ' : (e.education_level_enroll === 'associate' ? 'បរិញ្ញាបត្ររង' : '');
  var fundingLabelP2 = fv.label;

  var EDUCATION_LEVEL_KH = {
    none: 'គ្មាន',
    primary: 'បឋមសិក្សា (ថ្នាក់ទី ១ ដល់ ៦)',
    lower_secondary: 'មធ្យមសិក្សាបឋមភូមិ (ឌីប្លូម) ថ្នាក់ទី ៧ ដល់ ៩',
    upper_secondary: 'មធ្យមសិក្សាទុតិយភូមិ (បាក់ឌុប) ថ្នាក់ទី ១០ ដល់ ១២',
    higher_education: 'ឧត្តមសិក្សា (បរិញ្ញាបត្ររង បរិញ្ញាបត្រ អនុបណ្ឌិត)',
    bachelor: 'បរិញ្ញាបត្រ',
    master: 'បរិញ្ញាបត្ររង',
    phd: 'បណ៌ឌិត'
  };
  var levelCultureText = EDUCATION_LEVEL_KH[e.education_level] || e.education_level || '';

  var STUDY_PERIOD_KH = { mon_fri: 'ចន្ទ-សុក្រ', sat_sun: 'សៅរ៍-អាទិត្យ' };
  var STUDY_SHIFT_KH = { morning: 'ព្រឹក', afternoon: 'រសៀល' };
  var STUDY_LEVEL_KH = { bachelor: 'បរិញ្ញាបត្រ', associate: 'បរិញ្ញាបត្ររង', master: 'អនុបណ្ឌិត', phd: 'បណ៌ឌិត' };

  // Study period / shift / level come from the linked scholarship application when the
  // enrollment row does not carry them; the route joins it as the source of truth.
  var studyPeriod = e.study_schedule || app.study_period || '';
  var studyShift = e.study_shift || app.study_shift || '';
  var studyLevel = app.study_level || e.education_level_enroll || '';
  var studyLevelText = STUDY_LEVEL_KH[studyLevel] || studyLevel || '';
  var nationality = u.nationality || app.nationality || 'ខ្មែរ';
  var nationalId = u.national_id || app.national_id || '';

  function cb(on) {
    return 'khmer-checkbox' + (on ? ' checked' : '');
  }

  function parseJsonVal(v) {
    try { return v ? JSON.parse(v) : null; } catch (err) { return null; }
  }

  var siblingsParsed = parseJsonVal(e.siblings_info);
  if (!Array.isArray(siblingsParsed)) siblingsParsed = [];
  var siblingRows = [];
  for (var si = 1; si <= 3; si++) {
    var sib = siblingsParsed[si - 1] || {};
    siblingRows.push({
      name: sib.name || '',
      genderKh: sib.gender === 'male' ? 'ប្រុស' : (sib.gender === 'female' ? 'ស្រី' : (sib.gender || '')),
      job: sib.job || '',
      phone: sib.phone || ''
    });
  }

  var studyParsed = parseJsonVal(e.study_history);
  if (!studyParsed || typeof studyParsed !== 'object') studyParsed = {};
  function studyEntry(lv, fbSchool, fbDiploma) {
    var r = studyParsed[lv] || {};
    return {
      years: r.years || '-',
      cls: r['class'] || r.cls || '-',
      school: r.school || fbSchool || '',
      diploma: r.diploma || fbDiploma || ''
    };
  }
  var studyRows = {
    primary: studyEntry('primary'),
    lower: studyEntry('lower'),
    upper: studyEntry('upper', e.high_school, e.overall_grade),
    university: studyEntry('university')
  };

  var photoSrc = u.profile_pic || e.doc_photo_4x6_path || '';
  var loc = 'បន្ទាយមានជ័យ';
  var regNo = registrationNumber || '';
  var backHref = (typeof user !== 'undefined' && user && user.role === 'admin')
    ? '/admin/enrollments/' + (e.id || '')
    : '/student/enroll';
%>
<!DOCTYPE html>
<html lang="km">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>សាកលវិទ្យាល័យជាតិមានជ័យ - Official A4 Forms</title>
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Khmer Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Battambang:wght@400;700&family=Moul&family=Siemreap&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <style>
    :root {
      --font-moul: 'Moul', 'Khmer OS Muol Light', serif;
      --font-body: 'Battambang', 'Khmer OS Battambang', 'Siemreap', sans-serif;
      --sig-height: 58px;
    }

    .font-moul {
      font-family: var(--font-moul);
    }

    .font-body {
      font-family: var(--font-body);
    }

    body {
      font-family: var(--font-body);
      background-color: #334155;
      color: #000;
      line-height: 1.9;
    }

    /* Uniform line spacing for the whole printable document */
    .a4-page,
    .a4-page * {
      line-height: 1.9 !important;
    }

    /* Page 1 carries a fuller form than the scholarship reference (seven identity rows plus
       the request prose and section III), so at 1.9 its tail spilled onto a second sheet
       while the on-screen preview still read as one page. Tightening only this page keeps
       it to a single A4 without shrinking the type; page 2 keeps the reference spacing. */
    .a4-page.dense,
    .a4-page.dense * {
      line-height: 1.7 !important;
    }

    /* Fixed height, matching the scholarship print: the page must occupy exactly one A4
       sheet. min-height let page 1 run a few millimetres past 297mm (the trailing contact
       block spilled onto a second sheet when printing, while the on-screen preview still
       looked like one page). Height + overflow:hidden now contains it. */
    .a4-page {
      width: 210mm;
      height: 297mm;
      padding: 10mm 15mm;
      margin: 20px auto;
      background: white;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
      box-sizing: border-box;
      position: relative;
      overflow: hidden;
    }

    .dotted-line {
      border-bottom: 1px dotted #222;
      display: inline-block;
      min-width: 40px;
      padding: 0 4px;
      outline: none;
    }

    .dotted-line-full {
      width: 100%;
      border-bottom: 1px dotted #222;
      display: block;
      min-height: 22px;
      margin-top: 2px;
      outline: none;
    }

    /* Grows to absorb the remaining width of a flex row; the scholarship print uses
       fixed min-w values instead, both draw the same 1px dotted rule. */
    .dotted-line-fill {
      border-bottom: 1px dotted #222;
      flex-grow: 1;
      display: inline-block;
      min-width: 40px;
      padding: 0 4px;
      outline: none;
    }

    .photo-box {
      width: 3.5cm;
      height: 4.5cm;
      border: 1px solid #000;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      font-weight: bold;
      background-color: #fafafa;
      overflow: hidden;
    }

    .photo-box-sm {
      width: 3.2cm;
      height: 4.2cm;
      border: 1px solid #000;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: bold;
      background-color: #fafafa;
      overflow: hidden;
    }

    .photo-box img,
    .photo-box-sm img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    [contenteditable="true"]:hover {
      background-color: #f0f9ff;
      cursor: text;
    }

    [contenteditable="true"]:focus {
      background-color: #e0f2fe;
      outline: 1px dashed #0284c7;
      border-radius: 2px;
    }

    .khmer-checkbox {
      width: 13px;
      height: 13px;
      border: 1px solid #000;
      display: inline-block;
      vertical-align: middle;
      margin-right: 4px;
      cursor: pointer;
      position: relative;
    }

    .khmer-checkbox.checked::after {
      content: "✓";
      position: absolute;
      top: -6px;
      left: 1px;
      font-size: 12px;
      font-weight: bold;
    }

    /* Dedicated clean signature space BELOW the titles */
    .signature-area {
      height: var(--sig-height);
      margin-top: 2px;
      margin-bottom: 2px;
      width: 100%;
    }

    /* Study-history grid on the biography page */
    .form-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 6px;
    }

    .form-table th,
    .form-table td {
      border: 1px solid #111827;
      padding: 2px 6px;
      text-align: center;
      font-size: 12px;
      line-height: 1.5 !important;
    }

    .form-table th {
      font-weight: bold;
      background-color: #f8fafc;
    }

    /* Print media configurations */
    @page {
      size: A4 portrait;
      margin: 0;
    }

    @media print {
      body {
        background: white !important;
        padding: 0 !important;
        margin: 0 !important;
      }

      main {
        padding: 0 !important;
        margin: 0 !important;
      }

      .no-print {
        display: none !important;
      }

      .a4-page {
        margin: 0 !important;
        border: none !important;
        box-shadow: none !important;
        width: 210mm !important;
        height: 297mm !important;
        padding: 10mm 15mm !important;
        page-break-after: always;
        page-break-inside: avoid;
      }

      [contenteditable="true"]:hover,
      [contenteditable="true"]:focus {
        background-color: transparent !important;
        outline: none !important;
      }
    }
  </style>
</head>
<body>

  <header class="no-print sticky top-0 z-50 bg-slate-900 text-white shadow-lg px-4 py-3">
    <div class="max-w-6xl mx-auto flex flex-wrap justify-between items-center gap-3">
      <div class="flex items-center space-x-3">
        <i class="fa-solid fa-file-signature text-amber-400 text-xl"></i>
        <div>
          <h1 class="font-moul text-xs sm:text-sm">សាកលវិទ្យាល័យជាតិមានជ័យ</h1>
          <p class="text-[11px] text-slate-400">ពាក្យចុះឈ្មោះ - ទំព័របោះពុម្ព A4</p>
        </div>
      </div>

      <div class="flex items-center flex-wrap gap-3">
        <!-- Signature Height Control -->
        <div class="flex items-center gap-2 bg-slate-800 px-3 py-1.5 rounded text-xs border border-slate-700">
          <label for="sigSlider" class="text-slate-300">កម្ពស់ហត្ថលេខា (Signature Space):</label>
          <input type="range" id="sigSlider" min="40" max="120" value="70" oninput="updateSigHeight(this.value)" class="w-24 accent-amber-400 cursor-pointer">
          <span id="sigVal" class="w-8 text-amber-300 font-mono text-center">70px</span>
        </div>

        <a href="<%= backHref %>" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 border border-slate-600 rounded text-xs font-medium transition flex items-center gap-1.5 text-white no-underline">
          <i class="fa-solid fa-arrow-left text-amber-300"></i> ត្រឡប់
        </a>

        <button onclick="window.print()" class="px-4 py-1.5 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold rounded text-xs sm:text-sm shadow transition flex items-center gap-2">
          <i class="fa-solid fa-print"></i> បោះពុម្ព A4 (Print PDF)
        </button>
      </div>
    </div>
  </header>

  <main class="py-4">

    <!-- ================= PAGE 1 ================= -->
    <div class="a4-page dense font-body text-[12px] leading-relaxed flex flex-col justify-between">
      <div>
        <!-- Top Header -->
        <div class="grid grid-cols-12 gap-2 mb-2 items-start">
          <div class="col-span-5 text-center leading-snug">
            <h2 class="font-moul text-[11.5px]">ក្រសួងអប់រំ យុវជន និងកីឡា</h2>
            <h3 class="font-moul text-[10.5px]">សាកលវិទ្យាល័យជាតិមានជ័យ</h3>
          </div>
          <div class="col-span-4 text-center leading-snug">
            <h1 class="font-moul text-[12.5px]">ព្រះរាជាណាចក្រកម្ពុជា</h1>
            <h2 class="font-moul text-[10.5px] mt-0.5">ជាតិ សាសនា ព្រះមហាក្សត្រ</h2>
            <div class="flex justify-center mt-0.5">
              <img src="/images/khmer-floral-divider.png" alt="" style="width:22mm;height:auto;">
            </div>
          </div>
          <div class="col-span-3 flex justify-end">
            <div class="photo-box">
              <% if (photoSrc) { %><img src="<%= photoSrc %>" alt="4x6"><% } else { %>4x6<% } %>
            </div>
          </div>
        </div>

        <!-- Document Title -->
        <div class="text-center my-0.5">
          <h2 class="font-moul text-[13px] tracking-wide mb-0.5"><%= requestTitle %></h2>
          <h3 class="font-moul text-[11.5px] mb-0.5">ជំនាន់ទី<%= generationKh %> នៅសាកលវិទ្យាល័យជាតិមានជ័យ</h3>
          <p class="font-moul text-[11.5px] mb-0.5">ឆ្នាំសិក្សា <%= studyYearLabel %></p>
          <p class="font-moul text-[11.5px] mb-0.5"><%= fv.paren %></p>
        </div>

        <!-- Section I -->
        <div class="mb-1">
          <h4 class="font-moul text-[11.5px] mb-0.5">I. ព័ត៌មាននិស្សិត</h4>
          <div class="pl-2 space-y-1">
            <div>
              <span>ខ្ញុំបាទ-នាងខ្ញុំឈ្មោះ</span>
              <span class="dotted-line min-w-[210px] text-center" contenteditable="true" id="e1_name_kh"><%= khmerName %></span>
              <span>អក្សរឡាតាំង</span>
              <span class="dotted-line min-w-[190px] text-center uppercase" contenteditable="true" id="e1_name_latin"><%= englishName %></span>
              <span>ភេទ</span>
              <span class="dotted-line min-w-[45px] text-center" contenteditable="true" id="e1_gender"><%= genderKh %></span>
            </div>
            <div>
              <span>សញ្ជាតិ</span>
              <span class="dotted-line min-w-[70px] text-center" contenteditable="true" id="e1_nationality"><%= nationality %></span>
              <span>ជនជាតិ</span>
              <span class="dotted-line min-w-[60px] text-center" contenteditable="true" id="e1_ethnicity">ខ្មែរ</span>
              <span>លេខសញ្ញាបត្រ</span>
              <span class="dotted-line min-w-[120px] text-center" contenteditable="true" id="e1_nid"><%= toKhmerDigits(nationalId) %></span>
            </div>
            <div>
              <span>កើតថ្ងៃទី</span>
              <span class="dotted-line min-w-[45px] text-center" contenteditable="true" id="e1_dob_d"><%= toKhmerDigits(dobDay) %></span>
              <span>ខែ</span>
              <span class="dotted-line min-w-[75px] text-center" contenteditable="true" id="e1_dob_m"><%= dobMonthKh %></span>
              <span>ឆ្នាំ</span>
              <span class="dotted-line min-w-[55px] text-center" contenteditable="true" id="e1_dob_y"><%= toKhmerDigits(dobYear) %></span>
              <span>នៅភូមិ</span>
              <span class="dotted-line min-w-[160px] text-center" contenteditable="true" id="e1_village"><%= e.village || '' %></span>
            </div>
            <div>
              <span>ឃុំ/សង្កាត់</span>
              <span class="dotted-line min-w-[130px] text-center" contenteditable="true" id="e1_commune"><%= e.commune || '' %></span>
              <span>ស្រុក/ក្រុង</span>
              <span class="dotted-line min-w-[130px] text-center" contenteditable="true" id="e1_district"><%= e.district || '' %></span>
              <span>ខេត្ត/រាជធានី</span>
              <span class="dotted-line min-w-[120px] text-center" contenteditable="true" id="e1_province"><%= e.province || '' %></span>
            </div>
            <div>
              <span>អតីតសិស្សមកពីវិទ្យាល័យ</span>
              <span class="dotted-line min-w-[280px] text-center" contenteditable="true" id="e1_school"><%= e.high_school || '' %></span>
              <span>ខេត្ត/រាជធានី</span>
              <span class="dotted-line min-w-[150px] text-center" contenteditable="true" id="e1_school_prov"><%= e.high_school_province || '' %></span>
            </div>
            <div>
              <span>មុខរបរបច្ចុប្បន្ន</span>
              <span class="dotted-line min-w-[200px] text-center" contenteditable="true" id="e1_job"><%= e.occupation || 'សិស្ស' %></span>
              <span>លេខទូរស័ព្ទ</span>
              <span class="dotted-line min-w-[140px] text-center" contenteditable="true" id="e1_phone"><%= fmtPhone(e.phone) %></span>
            </div>
            <div>
              <span>ឪពុកឈ្មោះ</span>
              <span class="dotted-line min-w-[270px] text-center" contenteditable="true" id="e1_father"><%= e.father_name || '' %></span>
              <span>ម្ដាយឈ្មោះ</span>
              <span class="dotted-line min-w-[270px] text-center" contenteditable="true" id="e1_mother"><%= e.mother_name || '' %></span>
            </div>
          </div>
        </div>

        <!-- Section II: the request itself -->
        <div class="mb-0.5">
          <h4 class="font-moul text-[11.5px] mb-0.5">II. សេចក្តីស្នើសុំ</h4>
          <div class="pl-2 space-y-0.5 text-justify">
            <% if (fv.requestStyle === 'gov') { %>
            <div>
              ខ្ញុំបាទ-នាងខ្ញុំ មានបំណងចូលរៀនថ្នាក់ឆ្នាំសិក្សាមូលដ្ឋាន(ឆ្នាំទី១) នៅសាកលវិទ្យាល័យជាតិមានជ័យ ជំនាញ
              <span class="dotted-line min-w-[230px] text-center" contenteditable="true" id="e2_major"><%= majorKh %></span>
              អាហារូបករណ៍រដ្ឋ(អ.យ.ក)
              <label class="inline-flex items-center cursor-pointer select-none">
                <span class="<%= cb(fullPay) %>" onclick="toggleCheckbox(this)"></span> ពេញថ្លៃ /
              </label>
              <label class="inline-flex items-center cursor-pointer select-none">
                <span class="<%= cb(feePay) %>" onclick="toggleCheckbox(this)"></span> បង់ថ្លៃ
              </label>។
            </div>
            <% } else if (fv.requestStyle === 'plain') { %>
            <div>
              ខ្ញុំបាទ-នាងខ្ញុំ មានបំណងចូលរៀនថ្នាក់ឆ្នាំសិក្សាមូលដ្ឋាន(ឆ្នាំទី១) នៅសាកលវិទ្យាល័យជាតិមានជ័យ ជំនាញ
              <span class="dotted-line min-w-[230px] text-center" contenteditable="true" id="e2_major"><%= majorKh %></span>
              <%= fv.request %>។
            </div>
            <% } else { %>
            <div>
              ខ្ញុំបាទ-នាងខ្ញុំ មានបំណងចូលរៀនថ្នាក់ឆ្នាំសិក្សាមូលដ្ឋាន(ឆ្នាំទី១) នៅសាកលវិទ្យាល័យជាតិមានជ័យ ជំនាញ
              <span class="dotted-line min-w-[230px] text-center" contenteditable="true" id="e2_major"><%= majorKh %></span>
              សិក្សាបង់ថ្លៃ។
            </div>
            <% } %>
            <div>
              អាស្រ័យហេតុនេះ សូម<span class="font-moul">ឯកឧត្តមបណ្ឌិតសភាចារ្យ ឧបនាយករដ្ឋមន្ត្រី រដ្ឋមន្ត្រី</span> មេត្តាពិនិត្យនិងស្ដារលទ្ធភាពអនុញ្ញាត ឱ្យខ្ញុំបាទ-នាងខ្ញុំ បានចុះឈ្មោះក្នុងបញ្ជីបេក្ខជនចូលរៀនដោយអនុគ្រោះ។
            </div>
          </div>
        </div>

        <!-- Section III: the enrollment itself -->
        <div class="mb-0.5">
          <h4 class="font-moul text-[11.5px] mb-0.5">III. ព័ត៌មាននៃការចុះឈ្មោះចូលរៀន</h4>
          <div class="pl-2 space-y-0.5">
            <div>
              <span>១. កម្រិត</span>
              <span class="dotted-line min-w-[110px] text-center" contenteditable="true" id="e1_level"><%= studyLevelText %></span>
              <span>មុខជំនាញ</span>
              <span class="dotted-line min-w-[240px] text-center" contenteditable="true" id="e1_major"><%= majorKh %></span>
            </div>
            <div>
              <span class="font-moul text-[11px]">ជាសិស្សប្រភេទ៖</span>
              <span class="dotted-line-fill text-center" contenteditable="true" id="e1_type"><%= fv.label %></span>
            </div>
            <div class="flex items-center flex-wrap gap-x-4">
              <span>២. ពេលសិក្សា៖</span>
              <label class="inline-flex items-center cursor-pointer select-none">
                <span class="<%= cb(studyPeriod === 'mon_fri') %>" onclick="toggleCheckbox(this)"></span> ចន្ទ-សុក្រ
              </label>
              <label class="inline-flex items-center cursor-pointer select-none">
                <span class="<%= cb(studyPeriod === 'sat_sun') %>" onclick="toggleCheckbox(this)"></span> សៅរ៍-អាទិត្យ
              </label>
              <span>វេនសិក្សា៖</span>
              <label class="inline-flex items-center cursor-pointer select-none">
                <span class="<%= cb(studyShift === 'morning') %>" onclick="toggleCheckbox(this)"></span> ព្រឹក
              </label>
              <label class="inline-flex items-center cursor-pointer select-none">
                <span class="<%= cb(studyShift === 'afternoon') %>" onclick="toggleCheckbox(this)"></span> រសៀល
              </label>
            </div>
          </div>
        </div>

        <!-- Section IV: declarations -->
        <div class="mb-1">
          <h4 class="font-moul text-[11.5px] mb-1">IV. កិច្ចសន្យានិងការធានាខុសត្រូវរបស់សាមីខ្លួន</h4>
          <div class="pl-2 space-y-1">
            <div class="dotted-line-full" contenteditable="true" id="e1_c1">ខ្ញុំបាទ/នាងខ្ញុំសូមធានាថានឹងអនុលោមភាពត្រូវបានទទួលខុសត្រូវចំពោះមុខច្បាប់ និងបទបញ្ជាផ្ទឃ្នងរបស់សាកលវិទ្យាល័យជាតិមានជ័យ។</div>
          </div>
        </div>

        <!-- Attachments -->
        <div class="mt-0.5 pt-1 border-t border-dashed border-gray-400">
          <p class="font-bold text-center underline mb-1 text-[12px]">សូមគោរពជូនភ្ជាប់មកជាមួយនូវ៖</p>
          <div class="max-w-xl mx-auto space-y-0.5 text-[11.5px]">
            <div class="flex justify-between">
              <span>- ព្រឹត្តិបត្រពិន្ទុ ឬ សញ្ញាបត្រមធ្យមសិក្សាទុតិយភូមិ ឬ សញ្ញាបត្រដែលមានតម្លៃស្មើ</span>
              <span>ចំនួន ០១ច្បាប់</span>
            </div>
            <div class="flex justify-between">
              <span>- ជីវប្រវត្តិសង្ខេប ( បិទរូបថត ៤x៦ )</span>
              <span>ចំនួន ០១ច្បាប់</span>
            </div>
            <div class="flex justify-between">
              <span>- បង្កាន់ដៃបង់ថ្លៃសិក្សា និងសលាកបត្រកត្អជន</span>
              <span>ចំនួន ០១សន្លឹក</span>
            </div>
            <div class="flex justify-between">
              <span>- សលាកបត្រឯកត្តជន</span>
              <span>ចំនួន ០២ច្បាប់</span>
            </div>
            <div class="flex justify-between">
              <span>- រូបថតទំហំ ៤x៦ ( ថតចំពីមុខ ឥតពាក់វ៉ែនតា )</span>
              <span>ចំនួន ០២សន្លឹក</span>
            </div>
            <div class="flex justify-between">
              <span>- រូបថតទំហំ ៣x៤ ( ថតចំពីមុខ ឥតពាក់វ៉ែនតា )</span>
              <span>ចំនួន ០២សន្លឹក</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Signature block -->
      <div class="pt-0.5">
        <div class="grid grid-cols-2 text-center text-[12px]">
          <div></div>
          <div class="space-y-1">
            <div>
              <span>ថ្ងៃ</span><span class="dotted-line min-w-[45px]" contenteditable="true" id="e1_day"><%= sigDay %></span>
              <span>ខែ</span><span class="dotted-line min-w-[75px]" contenteditable="true" id="e1_month"><%= sigMonthKh %></span>
              <span>ឆ្នាំ</span><span class="dotted-line min-w-[55px]" contenteditable="true" id="e1_year"><%= sigYearKh %></span>
              <span>ព.ស.២៥៦</span><span class="dotted-line min-w-[25px]" contenteditable="true" id="e1_be"><%= sigBeYear %></span>
            </div>
            <div>
              <span>ធ្វើនៅ</span><span class="dotted-line min-w-[100px] font-bold" contenteditable="true" id="e1_loc"><%= loc %></span>
              <span>ថ្ងៃទី</span><span class="dotted-line min-w-[35px]" contenteditable="true" id="e1_d"></span>
              <span>ខែ</span><span class="dotted-line min-w-[65px]" contenteditable="true" id="e1_m"></span>
              <span>ឆ្នាំ២០២</span><span class="dotted-line min-w-[25px]" contenteditable="true" id="e1_y"></span>
            </div>

            <!-- TITLE HEADER FIRST -->
            <div class="font-moul text-[11px] mt-1">ហត្ថលេខា និងឈ្មោះសាមីខ្លួន</div>

            <!-- CLEAN SIGNATURE SPACE BELOW TITLE -->
            <div class="signature-area"></div>
          </div>
        </div>

        <div class="grid grid-cols-1 mt-0.5 items-end text-[11.5px]">
          <div class="space-y-1 text-left">
            <div>
              <span class="font-bold">លេខអាណាព្យាបាល៖</span>
              <span class="dotted-line min-w-[150px]"><%= fmtPhone(e.guardian_phone) %></span>
            </div>
            <div>
              <span class="font-bold">លេខសាមីខ្លួន៖</span>
              <span class="dotted-line min-w-[150px]"><%= fmtPhone(e.phone) %></span>
            </div>
            <div>
              <span class="font-bold">លេខបញ្ជី៖</span>
              <span class="dotted-line min-w-[150px]"><%= toKhmerDigits(regNo) %></span>
            </div>
          </div>
        </div>
      </div>
    </div>


    <!-- ================= PAGE 2 ================= -->
    <div class="a4-page font-body text-[12px] leading-relaxed flex flex-col justify-between">

      <!-- TOP CARD -->
      <div class="pb-2 border-b-2 border-dashed border-slate-600 relative flex flex-col justify-between h-[49%]">
        <div>
          <!-- Card Header -->
          <div class="grid grid-cols-12 gap-1 items-start mb-1">
            <div class="col-span-4 text-center leading-tight">
              <h2 class="font-moul text-[10.5px]">ក្រសួងអប់រំ យុវជន និងកីឡា</h2>
              <h3 class="font-moul text-[9.5px]">សាកលវិទ្យាល័យជាតិមានជ័យ</h3>
            </div>
            <div class="col-span-5 text-center leading-tight">
              <h1 class="font-moul text-[11.5px]">ព្រះរាជាណាចក្រកម្ពុជា</h1>
              <h2 class="font-moul text-[9.5px]">ជាតិ សាសនា ព្រះមហាក្សត្រ</h2>
<div class="flex justify-center mt-0.5">
                  <img src="/images/khmer-floral-divider.png" alt="" style="width:15mm;height:auto;">
                </div>
            </div>
            <div class="col-span-3 text-right">
              <div class="text-[10.5px] font-bold mb-1">
                លេខបញ្ជី<span class="dotted-line min-w-[85px] text-center" contenteditable="true" id="e4_top_reg"><%= toKhmerDigits(regNo) %></span>
              </div>
            </div>
          </div>

          <div class="text-center my-0.5">
            <h2 class="font-moul text-[12px]">សលាកបត្រឯកត្តជន</h2>
          </div>

          <!-- Body & Photo Layout -->
          <div class="grid grid-cols-12 gap-2">
            <div class="col-span-9 space-y-1">
              <div>
                <span>នាមត្រកូល និងនាមខ្លួន</span>
                <span class="dotted-line min-w-[160px] text-center" contenteditable="true" id="e4_top_name_kh"><%= khmerName %></span>
                <span>អក្សរឡាតាំង</span>
                <span class="dotted-line min-w-[140px] text-center uppercase" contenteditable="true" id="e4_top_name_latin"><%= englishName %></span>
                <span>ភេទ</span>
                <span class="dotted-line min-w-[35px] text-center" contenteditable="true" id="e4_top_gender"><%= genderKh %></span>
              </div>
              <div>
                <span>ថ្ងៃខែឆ្នាំកំណើត</span>
                <span class="dotted-line min-w-[380px] text-center" contenteditable="true" id="e4_top_dob"><%= dobShortKh %></span>
              </div>
              <div>
                <span>ទីកន្លែងកំណើត</span>
                <span class="dotted-line min-w-[380px] text-center" contenteditable="true" id="e4_top_pob"><%= e.place_of_birth || '' %></span>
              </div>
              <div>
                <span>កម្រិតវប្បធម៌</span>
                <span class="dotted-line min-w-[380px] text-center" contenteditable="true" id="e4_top_edu"><%= levelCultureText %></span>
              </div>
              <div>
                <span>មុខរបរបច្ចុប្បន្ន</span>
                <span class="dotted-line min-w-[380px] text-center" contenteditable="true" id="e4_top_job"><%= e.occupation || 'សិស្ស' %></span>
              </div>
