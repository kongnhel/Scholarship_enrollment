<div class="min-h-[60vh] flex items-center justify-center">
  <div class="w-full max-w-md">
    <div class="text-center mb-6">
      <img src="/images/nmu-logo.jpg" alt="NMU" class="w-16 h-16 rounded-full mx-auto mb-4 ring-4 ring-green-100 shadow-lg">
      <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'ភ្លេចពាក្យសម្ងាត់' : 'Forgot Password' %></h1>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-2xl p-8 shadow-lg border border-gray-100 dark:border-gray-700">
      <form method="POST" action="/auth/forgot-password" class="space-y-4">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div>
          <label for="email" class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'អ៊ីមែល' : 'Email' %></label>
          <input type="email" id="email" name="email" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none" required>
        </div>
        <button type="submit" class="w-full px-6 py-3 bg-green-500 text-white rounded-xl font-bold hover:bg-green-600 transition-all shadow-sm"><%= currentLang === 'km' ? 'ផ្ញើតំណភ្ជាប់កំណត់ឡើងវិញ' : 'Send Reset Link' %></button>
      </form>
      <div class="mt-4 text-center">
        <a href="/auth/login" class="text-sm text-green-600 dark:text-green-400 hover:text-green-700"><%= currentLang === 'km' ? 'ត្រឡប់ទៅចូល' : 'Back to Login' %></a>
      </div>
    </div>
  </div>
</div>
