<div class="min-h-[60vh] flex items-center justify-center">
  <div class="w-full max-w-md">
    <div class="text-center mb-6">
      <img src="/images/nmu-logo.jpg" alt="NMU" class="w-16 h-16 rounded-full mx-auto mb-4 ring-4 ring-green-100 shadow-lg">
      <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100"><%= currentLang === 'km' ? 'កំណត់ពាក្យសម្ងាត់ឡើងវិញ' : 'Reset Password' %></h1>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-2xl p-8 shadow-lg border border-gray-100 dark:border-gray-700">
      <form method="POST" action="/auth/reset-password/<%= token %>" class="space-y-4">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div>
          <label for="password" class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'ពាក្យសម្ងាត់ថ្មី' : 'New Password' %></label>
          <input type="password" id="password" name="password" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none" required minlength="6">
        </div>
        <div>
          <label for="confirm_password" class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'បញ្ជាក់ពាក្យសម្ងាត់' : 'Confirm Password' %></label>
          <input type="password" id="confirm_password" name="confirm_password" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none" required minlength="6">
        </div>
        <button type="submit" class="w-full px-6 py-3 bg-green-500 text-white rounded-xl font-bold hover:bg-green-600 transition-all shadow-sm"><%= currentLang === 'km' ? 'កំណត់ពាក្យសម្ងាត់ឡើងវិញ' : 'Reset Password' %></button>
      </form>
    </div>
  </div>
</div>

<script>
document.querySelector('form').addEventListener('submit', function(e) {
  var password = document.getElementById('password').value;
  var confirmPassword = document.getElementById('confirm_password').value;
  if (password !== confirmPassword) {
    e.preventDefault();
    Swal.fire({
      title: '<%= currentLang === "km" ? "កំហុស" : "Error" %>',
      text: '<%= currentLang === "km" ? "ពាក្យសម្ងាត់មិនដូចគ្នាទេ" : "Passwords do not match" %>',
      icon: 'error',
      confirmButtonText: 'OK',
      showCloseButton: true
    });
  }
});
</script>
