<div class="max-w-3xl mx-auto space-y-6">

  <!-- Edit Profile Card -->
  <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-100 dark:border-gray-700">
      <h3 class="font-bold text-gray-900 dark:text-gray-100 flex items-center gap-2">
        <i class="bi bi-person-gear text-green-500"></i><%= currentLang === 'km' ? 'កែប្រែព័ត៌មានផ្ទាល់ខ្លួន' : 'Edit Profile' %>
      </h3>
    </div>
    <div class="p-6">
      <form action="/auth/profile" method="POST" enctype="multipart/form-data" class="space-y-5" id="profileForm">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="file" name="photo" id="photoInput" accept=".jpg,.jpeg,.png" class="hidden">

        <!-- Profile Picture Upload (Facebook Style) -->
        <div class="flex items-center gap-4 p-4 bg-gray-50 dark:bg-gray-700/30 rounded-xl">
          <div class="relative group flex-shrink-0">
            <div class="w-20 h-20 rounded-full overflow-hidden bg-gray-200 dark:bg-gray-600 border-2 border-white dark:border-gray-600 shadow-sm">
              <img id="formPreview" src="<%= profile.profile_pic || '' %>" alt="" class="w-full h-full object-cover <%= profile.profile_pic ? '' : 'hidden' %>">
              <div id="formPlaceholder" class="w-full h-full flex items-center justify-center <%= profile.profile_pic ? 'hidden' : '' %>">
                <i class="bi bi-person-fill text-2xl text-gray-400 dark:text-gray-500"></i>
              </div>
            </div>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-semibold text-gray-900 dark:text-gray-100 truncate"><%= profile.english_name || profile.username || 'User' %></p>
            <p class="text-xs text-gray-500 dark:text-gray-400 mb-2"><%= currentLang === 'km' ? 'រូបភាពប្រវត្តិរូប' : 'Profile picture' %></p>
            <button type="button" onclick="document.getElementById('photoInput').click()" class="inline-flex items-center gap-1.5 px-4 py-1.5 bg-green-500 text-white text-xs font-semibold rounded-lg hover:bg-green-600 transition-all shadow-sm">
              <i class="bi bi-camera-fill"></i><%= currentLang === 'km' ? 'ផ្លាស់ប្តូររូបភាព' : 'Upload Photo' %>
            </button>
            <p class="text-[11px] text-gray-400 dark:text-gray-500 mt-1.5"><%= currentLang === 'km' ? 'អតិបរមា 5MB · JPG, PNG' : 'Max 5MB · JPG, PNG' %></p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'ឈ្មោះខ្មែរ' : 'Khmer Name' %></label>
            <input type="text" name="khmer_name" value="<%= profile.khmer_name || '' %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none transition-all">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'ឈ្មោះឡាតាំង' : 'Latin Name' %></label>
            <input type="text" name="english_name" value="<%= profile.english_name || '' %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none transition-all">
          </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'អ៊ីមែល' : 'Email' %></label>
            <input type="email" name="email" value="<%= profile.email %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none transition-all">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'ទូរស័ព្ទ' : 'Phone' %></label>
            <%- include('../partials/phone-input', { phoneName: 'phone', phoneValue: profile.phone || '', required: false, inputId: 'profilePhone', showLabel: false }) %>
          </div>
        </div>
        <div class="flex items-center gap-3 pt-2">
          <button type="submit" class="px-6 py-2.5 bg-green-500 text-white rounded-xl font-medium hover:bg-green-600 transition-all shadow-sm flex items-center gap-2">
            <i class="bi bi-check-lg text-lg"></i><%= currentLang === 'km' ? 'រក្សាទុក' : 'Save Changes' %>
          </button>
          <button type="button" onclick="document.getElementById('photoInput').value='';document.getElementById('formPreview').classList.add('hidden');document.getElementById('formPlaceholder').classList.remove('hidden');" class="px-4 py-2.5 bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 rounded-xl font-medium hover:bg-gray-200 dark:hover:bg-gray-600 transition-all text-sm">
            <%= currentLang === 'km' ? 'បោះបង់' : 'Cancel' %>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Change Password Card -->
  <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-100 dark:border-gray-700">
      <h3 class="font-bold text-gray-900 dark:text-gray-100 flex items-center gap-2">
        <i class="bi bi-key text-yellow-500"></i><%= currentLang === 'km' ? 'ផ្លាស់ប្តូរពាក្យសម្ងាត់' : 'Change Password' %>
      </h3>
    </div>
    <div class="p-6">
      <form action="/auth/profile/password" method="POST" class="space-y-4">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'ពាក្យសម្ងាត់បច្ចុប្បន្ន' : 'Current Password' %></label>
          <input type="password" name="current_password" placeholder="<%= currentLang === 'km' ? 'បញ្ចូលពាក្យសម្ងាត់បច្ចុប្បន្ន' : 'Enter current password' %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none transition-all" required>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'ពាក្យសម្ងាត់ថ្មី' : 'New Password' %></label>
            <input type="password" name="new_password" placeholder="<%= currentLang === 'km' ? 'ពាក្យសម្ងាត់យ៉ាងតិច ៦ អក្ខរា' : 'Min 6 characters' %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none transition-all" required minlength="6">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1.5"><%= currentLang === 'km' ? 'បញ្ជាក់ពាក្យសម្ងាត់ថ្មី' : 'Confirm New Password' %></label>
            <input type="password" name="confirm_password" placeholder="<%= currentLang === 'km' ? 'សូមបញ្ចូលពាក្យសម្ងាត់ម្តងទៀត' : 'Re-enter new password' %>" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none transition-all" required minlength="6">
          </div>
        </div>
        <button type="submit" class="px-6 py-2.5 bg-yellow-500 text-white rounded-xl font-medium hover:bg-yellow-600 transition-all shadow-sm flex items-center gap-2">
          <i class="bi bi-key mr-1"></i><%= currentLang === 'km' ? 'ផ្លាស់ប្តូរពាក្យសម្ងាត់' : 'Change Password' %>
        </button>
      </form>
    </div>
  </div>
</div>

<script>
(function() {
  var input = document.getElementById('photoInput');
  var formPreview = document.getElementById('formPreview');
  var formPlaceholder = document.getElementById('formPlaceholder');
  var sidebarImg = document.getElementById('sidebarAvatar');
  var sidebarPlaceholder = document.getElementById('sidebarAvatarPlaceholder');

  if (!input) return;

  input.addEventListener('change', function() {
    var file = this.files[0];
    if (!file) return;
    if (!file.type.match(/^image\/(jpeg|png)$/)) {
      Swal.fire({title: 'Error', text: 'Only JPG and PNG files are allowed.', icon: 'error', confirmButtonText: 'OK'});
      this.value = '';
      return;
    }
    if (file.size > 5 * 1024 * 1024) {
      Swal.fire({title: 'Error', text: 'File is too large. Max 5MB.', icon: 'error', confirmButtonText: 'OK'});
      this.value = '';
      return;
    }
    var reader = new FileReader();
    reader.onload = function(e) {
      formPreview.src = e.target.result;
      formPreview.classList.remove('hidden');
      formPlaceholder.classList.add('hidden');

      if (sidebarImg) {
        sidebarImg.src = e.target.result;
      } else if (sidebarPlaceholder) {
        var newImg = document.createElement('img');
        newImg.src = e.target.result;
        newImg.alt = 'Profile';
        newImg.className = 'w-full h-full object-cover';
        newImg.id = 'sidebarAvatar';
        sidebarPlaceholder.parentNode.replaceChild(newImg, sidebarPlaceholder);
      }
    };
    reader.readAsDataURL(file);
  });
})();
</script>
