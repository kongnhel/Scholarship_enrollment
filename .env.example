PORT=3000

# REQUIRED IN PRODUCTION. server.js reads NODE_ENV for two things that matter:
#   - cookie.secure, which adds the Secure flag to the session cookie. Without it the
#     session id travels on plaintext requests, and an http:// link or injected subresource
#     is enough to harvest one.
#   - the fatal guard on SESSION_SECRET. It only aborts the boot when NODE_ENV is exactly
#     'production', so leaving this unset means the app runs on the published fallback
#     constant 'fallback-secret-key-change-me' -- which is in the repository, and which
#     would let anyone forge a session cookie for any account.
# If you are not certain whether the deployment sets it, set it here.
NODE_ENV=development

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=scholarship_system
DB_PORT=3306
DB_SSL=false

# When DB_SSL is true, the connection is encrypted but currently does NOT verify the
# server's certificate (config/database.js sets rejectUnauthorized: false). A host on the
# network path can therefore present any certificate and read the whole session -- the
# sessions table lives in this same database.
# To fix, download the provider's CA certificate (Aiven: Connect -> SSL -> ca.crt) and set:
#   DB_SSL_CA=/absolute/path/to/ca.crt
# config/database.js will then verify against it and require TLS 1.2 or better.
# DB_SSL_CA=

# Must be long and random, not a word or a phrase. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=your_session_secret_here
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_SERVICE=gmail
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Resend API (for production email sending)
RESEND_API_KEY=your_resend_api_key_here

# OTP Settings
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_API_ID=your_telegram_api_id_here
TELEGRAM_API_HASH=your_telegram_api_hash_here

# Tuition payments
# There is no payment-gateway configuration. Students pay by scanning a QR code that an
# admin uploads in /admin/settings (stored in the `payment_qr_path` setting), then submit
# a payment screenshot to /student/payments. An admin verifies it from /admin/payments.

# ImageKit (for file uploads - profiles, payments, documents)
IMAGEKIT_URL_ENDPOINT=your_imagekit_url_endpoint
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key

# App Base URL (for email verification links)
https://register.nmu.edu.kh
