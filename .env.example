PORT=3000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=scholarship_system
DB_PORT=3306
DB_SSL=false
SESSION_SECRET=your_session_secret_here
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_SERVICE=gmail
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Resend API (for production email sending)
RESEND_API_KEY=your_resend_api_key_here

# OTP Settings
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_API_ID=your_telegram_api_id_here
TELEGRAM_API_HASH=your_telegram_api_hash_here

# Bakong KHQR Payment
BAKONG_API_URL=https://sit-api-bakong.nbc.org.kh
BAKONG_API_TOKEN=your_bakong_api_token_here
BAKONG_MERCHANT_ID=your_merchant_id
BAKONG_MERCHANT_NAME=National University of Management
BAKONG_MERCHANT_CITY=PHNOM PENH
BAKONG_ACQUIRING_BANK=Bakong
BAKONG_ACCOUNT_ID=your_account_id

# ImageKit (for file uploads - profiles, payments, documents)
IMAGEKIT_URL_ENDPOINT=your_imagekit_url_endpoint
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key

# App Base URL (for email verification links)
APP_URL=http://10.10.6.9:8082
