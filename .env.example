PORT=3000

# REQUIRED IN PRODUCTION. server.js reads NODE_ENV for two things that matter:
#   - cookie.secure, which adds the Secure flag to the session cookie. Without it the
#     session id travels on plaintext requests, and an http:// link or injected subresource
#     is enough to harvest one.
#   - the fatal guard on SESSION_SECRET. It only aborts the boot when NODE_ENV is exactly
#     'production', so leaving this unset means the app runs on the published fallback
#     constant 'fallback-secret-key-change-me' -- which is in the repository, and which
#     would let anyone forge a session cookie for any account.
# If you are not certain whether the deployment sets it, set it here.
NODE_ENV=development

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=scholarship_system
DB_PORT=3306
DB_SSL=false

# When DB_SSL is true, the connection is encrypted but currently does NOT verify the
# server's certificate (config/database.js sets rejectUnauthorized: false). A host on the
# network path can therefore present any certificate and read the whole session -- the
# sessions table lives in this same database.
# To fix, download the provider's CA certificate (Aiven: Connect -> SSL -> ca.crt) and set:
#   DB_SSL_CA=/absolute/path/to/ca.crt
# config/database.js will then verify against it and require TLS 1.2 or better.
# DB_SSL_CA=

# Must be long and random, not a word or a phrase. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=your_session_secret_here
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_SERVICE=gmail
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Resend API (for production email sending)
RESEND_API_KEY=your_resend_api_key_here

# OTP Settings
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_API_ID=your_telegram_api_id_here
TELEGRAM_API_HASH=your_telegram_api_hash_here

# Tuition payments
# There is no payment-gateway configuration. Students pay by scanning a QR code that an
# admin uploads in /admin/settings (stored in the `payment_qr_path` setting), then submit
# a payment screenshot to /student/payments. An admin verifies it from /admin/payments.

# ImageKit (for file uploads - profiles, payments, documents)
IMAGEKIT_URL_ENDPOINT=your_imagekit_url_endpoint
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key

# App Base URL -- the host that verification and password-reset links in outgoing email point
# at. It must be the same server that holds the token, and it must be reachable by whoever
# receives the mail.
#
# Note the KEY= prefix: this line used to have no prefix, so dotenv ignored it and every link
# silently pointed at localhost:3000.
APP_URL=https://register.nmu.edu.kh

# Rate limits -- set a cap, or 0 to disable that limiter. Omit a line to keep the default
# shown. A value that is not a plain integer is ignored and the default is used, so a typo
# can never accidentally leave a limiter off.
#
# Lift these to 0 when you need to create a lot of accounts at once for testing, then put
# the real numbers back: they are what stop one inbox being flooded and what keep an
# attacker from spending your Resend quota.
#
# RATE_LIMIT_REGISTER_ADDRESS=3       registrations per email, per hour
# RATE_LIMIT_REGISTER_IP=30           registrations per IP, per hour (loose: campus NAT)
# RATE_LIMIT_RESEND_ADDRESS=3         resend-verification per email, per hour
# RATE_LIMIT_RESEND_IP=20             resend-verification per IP, per 15 min
# RATE_LIMIT_FORGOT_ADDRESS=3         password resets per email, per hour
# RATE_LIMIT_FORGOT_IP=5              password resets per IP, per 15 min
# AUTH_RATE_LIMIT=50                  POSTs to /auth, per 15 min
# GENERAL_RATE_LIMIT=200              POSTs to /student, /admin, /committee, per 15 min

# Development only. Set this to true in your LOCAL .env if you want registration emails to
# point at the machine you are testing on instead of APP_URL -- otherwise a token minted on
# localhost is mailed as a link to production, which does not have it, and reports
# "Invalid or expired verification token" for a link that was never expired.
#
# Leave it UNSET in production. Behind IIS/ARR the Host header reaching Node is the
# rewritten internal address, so enabling this there mails links to http://127.0.0.1:5000.
# It is also ignored automatically when NODE_ENV=production.
# LINK_BASE_FROM_REQUEST=true
