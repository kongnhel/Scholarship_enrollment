<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <webSocket enabled="false" />

    <rewrite>
      <rules>
        <!-- Rule 1: Force HTTPS -->
        <!--
          {HTTP_HOST} is supplied by the client, so redirecting to it unvalidated lets
          anyone who controls a Host header pin a PERMANENT, browser-cached 301 to a domain
          of their choosing: a durable phishing link that looks like it came from the real
          site, and survives the cache. The host is therefore checked against the canonical
          name first, and anything else is refused with 400 rather than redirected.

          Keep register.nmu.edu.kh in step with APP_URL in .env.
        -->
        <rule name="Block unknown Host" enabled="true" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^(register\.nmu\.edu\.kh|localhost|127\.0\.0\.1)(:\d+)?$" negate="true" ignoreCase="true" />
          </conditions>
          <action type="CustomResponse" statusCode="400" statusReason="Bad Request" statusDescription="Unknown host" />
        </rule>
        <rule name="Force HTTPS" enabled="true" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- Rule 2: Reverse proxy to Node.js on 127.0.0.1:5000 -->
        <rule name="ReverseProxy" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{REQUEST_URI}" pattern="^/\.well-known/" negate="true" />
          </conditions>
          <action type="Rewrite" url="http://127.0.0.1:5000/{R:1}" />
        </rule>
      </rules>

      <outboundRules>
        <rule name="Rewrite Location Header" preCondition="IsRedirect">
          <match serverVariable="RESPONSE_LOCATION" pattern="http://127\.0\.0\.1:5000/(.*)" />
          <action type="Rewrite" value="/{R:1}" />
        </rule>
        <preConditions>
          <preCondition name="IsRedirect">
            <add input="{RESPONSE_STATUS}" pattern="3\d\d" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>

    <security>
      <requestFiltering>
        <!-- Allow IIS to access the .well-known hidden segment -->
        <hiddenSegments>
          <remove segment=".well-known" />
        </hiddenSegments>
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>

    <httpErrors existingResponse="PassThrough" />

  </system.webServer>
</configuration>